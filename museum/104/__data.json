13,"atMost":613},"2",{"type":89,"l":615,"from":92,"to":616,"h":617,"unit":78,"atLeast":618,"atMost":613},"Interlineation line 2 to 3","line3","1-2","1",{"_":620,"notBefore":557,"notAfter":621,"evidence":236},"4th century CE",400,[623,624],{"_":99,"type":100,"ref":101,"region":102},{"_":104,"type":105,"ref":106,"region":102},[626],[109,110],[],{"_":4,"role":3,"ref":5},{"_":115,"mainLang":116,"languages":630},[115],[632,634,636,638],{"atLeast":633,"atMost":633},12,{"atLeast":633,"atMost":635},14,{"atLeast":637,"atMost":637},2,{"atLeast":639,"atMost":637},1,[641,642],"Tréziny, 2011, À propos d’une inscription funéraire paléochrétienne de Mégara Hyblaea","Tréziny, 2018, Mégara Hyblaea. 7, La ville classique, hellénistique et romaine",[644,645],"DFXDQ8GT","5UHWUE4K",[647,648,649,171,592,650,149,150,151,152,149,153,154,116],"isic004390","fragmentary early christian funerary inscription",{"_":583},"marble","\u003Cspan class=\"textpartnumber\" id=\"aba\">fragment (physical) a\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"diva--interpretive\">  \u003Ca id=\"aa-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>τ]ό παιδὶον \u003Cbr id=\"aa-l2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[ὃς ἀπὲθανε] τῇ πρό \u003Cspan class=\"supraline\" title=\"line above\">ε\u003C/span>  \u003Cbr id=\"aa-l3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[εἰδῶν Σεπτε]μβρὶων \u003Cbr id=\"aa-l4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>[ζῆσας ἔτη\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cspan class=\"textpartnumber\" id=\"abb\">fragment (physical) b\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"divb--interpretive\">  \u003Ca id=\"ab-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>φα[\u003Cspan dir=\"ltr\" class