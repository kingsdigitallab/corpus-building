20,"places":623,"geo":626,"country":102,"provenance":99,"provenanceGeo":628,"region":112,"settlement":99,"repository":629,"textLang":630,"tmNumber":181,"letterHeights":632,"publications":641,"zotero":644,"keywords":647,"html":652,"idnoSort":161,"languageSort":115,"materialSort":597,"originSort":99,"typeSort":176},"ISic004390","Fragmentary early Christian funerary inscription",{"_":584},"edited",[586,587,588,589,590],{"type":24},{"type":26},{"type":28},{"type":31},{"type":34},{"_":176,"ana":177,"ref":178},{"_":593,"ana":594,"ref":595},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259.html",{"_":597,"ana":226,"type":227,"subtype":598,"ref":599},"marble\n                                    ",[58],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":601},{"p":602,"rs":603,"damage":181},"Remains of three lines of Greek letters, with small space to the margin at top, and vacat to the right and a roughly consistent right margin, suggesting line ends are preserved. The letters on the fourth fragment are smaller, and preserve vacat to the left suggesting line beginning. A further line is partially preserved on the fourth fragment.",{"_":65,"ana":66,"ref":67},{"lettering":605,"dimensions":606},"The letters are fairly regularly cut, with almost no serifs/terminations to the strokes, excpt for the slight extension of the apex of alpha and delta. Alpha has broken bar; omicron is slightly ovoid and full size; pi has equal length verticals; epsilon is lunate; phi is rhomboid.",[607,609,613,615],{"type":73,"l":188,"from":91,"to":91,"h":608,"unit":78,"atLeast":608,"atMost":608},"12",{"type":73,"l":610,"from":92,"to":92,"h":611,"unit":78,"atLeast":608,"atMost":612},"Line 2","12-14","14",{"type":89,"l":90,"from":91,"to":92,"h":614,"unit":78,"atLeast":614,"atMost":614},"2",{"type":89,"l":616,"from":92,"to":617,"h":618,"unit":78,"atLeast":619,"atMost":614},"Interlineation line 2 to 3","line3","1-2","1",{"_":621,"notBefore":558,"notAfter":622,"evidence":241},"4th century CE",400,[624,625],{"_":99,"type":100,"ref":101,"region":102},{"_":104,"type":105,"ref":106,"region":102},[627],[109,110],[],{"_":4,"role":3,"ref":5},{"_":115,"mainLang":116,"languages":631},[115],[633,635,637,639],{"atLeast":634,"atMost":634},12,{"atLeast":634,"atMost":636},14,{"atLeast":638,"atMost":638},2,{"atLeast":640,"atMost":638},1,[642,643],"Tréziny, 2011, À propos d’une inscription funéraire paléochrétienne de Mégara Hyblaea","Tréziny, 2018, Mégara Hyblaea. 7, La ville classique, hellénistique et romaine",[645,646],"DFXDQ8GT","5UHWUE4K",[648,649,650,176,593,651,154,155,156,157,154,158,159,116],"isic004390","fragmentary early christian funerary inscription",{"_":584},"marble","\u003Cspan class=\"textpartnumber\" id=\"aba\">fragment (physical) a\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"diva--interpretive\">  \u003Ca id=\"aa-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>τ]ό παιδὶον \u003Cbr id=\"aa-l2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[ὃς ἀπὲθανε] τῇ πρό \u003Cspan class=\"supraline\" title=\"line above\">ε\u003C/span>  \u003Cbr id=\"aa-l3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[εἰδῶν Σεπτε]μβρὶων \u003Cbr id=\"aa-l4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>[ζῆσας ἔτη\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cspan class=\"textpartnumber\" id=\"abb\">fragment (physical) b\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"divb--interpretive\">  \u003Ca id=\"ab-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>φα[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":654,"uri":654,"title":655,"status":656,"editions":657,"editionAuthor":45,"type":663,"objectType":667,"mat