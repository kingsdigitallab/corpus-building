e\">\u003Cspan class=\"linenumber\">4\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":581,"uri":581,"title":582,"status":583,"editions":585,"editionAuthor":45,"type":591,"objectType":592,"material":596,"condition":177,"layoutDesc":602,"handNote":606,"date":622,"places":625,"geo":628,"country":103,"provenance":100,"provenanceGeo":630,"region":113,"settlement":100,"repository":631,"textLang":632,"tmNumber":177,"letterHeights":634,"publications":643,"zotero":646,"keywords":649,"html":653,"idnoSort":157,"languageSort":116,"materialSort":597,"originSort":100,"typeSort":172},"ISic004390","Fragmentary early Christian funerary inscription",{"_":584},"edited",[586,587,588,589,590],{"type":24},{"type":26},{"type":28},{"type":31},{"type":34},{"_":172,"ana":173,"ref":174},{"_":593,"ana":594,"ref":595},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259.html",{"_":597,"ana":598,"type":599,"subtype":600,"ref":601},"marble","#material.inorganic.stone.metamorphic_rock.marble","stone.marble",[59],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":603},{"p":604,"rs":605,"damage":177},"Remains of three lines of Greek letters, with small space to the margin at top, and vacat to the right and a roughly consistent right margin, suggesting line ends are preserved. The letters on the fourth fragment are smaller, and preserve vacat to the left suggesting line beginning. A further line is partially preserved on the fourth fragment.",{"_":66,"ana":67,"ref":68},{"lettering":607,"dimensions":608},"The letters are fairly regularly cut, with almost no serifs/terminations to the strokes, excpt for the slight extension of the apex of alpha and delta. Alpha has broken bar; omicron is slightly ovoid and full size; pi has equal length verticals; epsilon is lunate; phi is rhomboid.",[609,611,615,617],{"type":74,"l":184,"from":92,"to":92,"h":610,"unit":79,"atLeast":610,"atMost":610},"12",{"type":74,"l":612,"from":93,"to":93,"h":613,"unit":79,"atLeast":610,"atMost":614},"Line 2","12-14","14",{"type":90,"l":91,"from":92,"to":93,"h":616,"unit":79,"atLeast":616,"atMost":616},"2",{"type":90,"l":618,"from":93,"to":619,"h":620,"unit":79,"atLeast":621,"atMost":616},"Interlineation line 2 to 3","line3","1-2","1",{"_":623,"notBefore":558,"notAfter":624,"evidence":237},"4th century CE",400,[626,627],{"_":100,"type":101,"ref":102,"region":103},{"_":105,"type":106,"ref":107,"region":103},[629],[110,111],[],{"_":4,"role":3,"ref":5},{"_":116,"mainLang":117,"languages":633},[116],[635,637,639,641],{"atLeast":636,"atMost":636},12,{"atLeast":636,"atMost":638},14,{"atLeast":640,"atMost":640},2,{"atLeast":642,"atMost":640},1,[644,645],"Tréziny, 2011, À propos d’une inscription funéraire paléochrétienne de Mégara Hyblaea","Tréziny, 2018, Mégara Hyblaea. 7, La ville classique, hellénistique et romaine",[647,648],"DFXDQ8GT","5UHWUE4K",[650,651,652,172,593,597,150,151,152,153,150,154,155,117],"isic004390","fragmentary early christian funerary inscription",{"_":584},"\u003Cspan class=\"textpartnumber\" id=\"aba\">fragment (physical) a\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"diva--interpretive\">  \u003Ca id=\"aa-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>τ]ό παιδὶον \u003Cbr id=\"aa-l2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[ὃς ἀπὲθανε] τῇ πρό \u003Cspan class=\"supraline\" title=\"line above\">ε\u003C/span>  \u003Cbr id=\"aa-l3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[εἰδῶν Σεπτε]μβρὶων \u003Cbr id=\"aa-l4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>[ζῆσας ἔτη\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cspan class=\"textpartnumber\" id=\"abb\">fragment (physical) b\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan clas