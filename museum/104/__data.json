th-7th century CE",301,700,[544,545],{"_":99,"type":100,"ref":101,"region":102},{"_":104,"type":105,"ref":106,"region":102},[547],[109,110],[549,550],37.204307,15.181053,{"_":4,"role":3,"ref":5},{"_":115,"mainLang":116,"languages":553},[115],[555],{"atLeast":121,"atMost":121},[126,129],[136,139],[559,560,561,522,51,55,149,150,151,152,149,153,154,116],"isic003698","i.sicily inscription 003698",{"_":20},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΞΕΝ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΒΑΣ̣Λ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":564,"uri":564,"title":565,"status":566,"editions":568,"editionAuthor":45,"type":574,"objectType":575,"material":579,"condition":176,"layoutDesc":583,"handNote":587,"date":603,"places":606,"geo":609,"country":102,"provenance":99,"provenanceGeo":611,"region":112,"settlement":99,"repository":612,"textLang":613,"tmNumber":176,"letterHeights":615,"publications":624,"zotero":627,"keywords":630,"html":635,"idnoSort":156,"languageSort":115,"materialSort":580,"originSort":99,"typeSort":171},"ISic004390","Fragmentary early Christian funerary inscription",{"_":567},"edited",[569,570,571,572,573],{"type":24},{"type":26},{"type":28},{"type":31},{"type":34},{"_":171,"ana":172,"ref":173},{"_":576,"ana":577,"ref":578},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259.html",{"_":580,"ana":221,"type":222,"subtype":581,"ref":582},"marble\n                                    ",[58],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":584},{"p":585,"rs":586,"damage":176},"Remains of three lines of Greek letters, with small space to the margin at top, and vacat to the right and a roughly consistent right margin, suggesting line ends are preserved. The letters on the fourth fragment are smaller, and preserve vacat to the left suggesting line beginning. A further line is partially preserved on the fourth fragment.",{"_":65,"ana":66,"ref":67},{"lettering":588,"dimensions":589},"The letters are fairly regularly cut, with almost no serifs/terminations to the strokes, excpt for the slight extension of the apex of alpha and delta. Alpha has broken bar; omicron is slightly ovoid and full size; pi has equal length verticals; epsilon is lunate; phi is rhomboid.",[590,592,596,598],{"type":73,"l":183,"from":91,"to":91,"h":591,"unit":78,"atLeast":591,"atMost":591},"12",{"type":73,"l":593,"from":92,"to":92,"h":594,"unit":78,"atLeast":591,"atMost":595},"Line 2","12-14","14",{"type":89,"l":90,"from":91,"to":92,"h":597,"unit":78,"atLeast":597,"atMost":597},"2",{"type":89,"l":599,"from":92,"to":600,"h":601,"unit":78,"atLeast":602,"atMost":597},"Interlineation line 2 to 3","line3","1-2","1",{"_":604,"notBefore":541,"notAfter":605,"evidence":236},"4th century CE",400,[607,608],{"_":99,"type":100,"ref":101,"region":102},{"_":104,"type":105,"ref":106,"region":102},[610],[109,110],[],{"_":4,"role":3,"ref":5},{"_":115,"mainLang":116,"languages":614},[115],[616,618,620,622],{"atLeast":617,"atMost":617},12,{"atLeast":617,"atMost":619},14,{"atLeast":621,"atMost":621},2,{"atLeast":623,"atMost":621},1,[625,626],"Tréziny, 2011, À propos d’une inscription funéraire paléochrétienne de Mégara Hyblaea","Tréziny, 2018, Mégara Hyblaea. 7, La ville classique, hellénistique et romaine",[628,629],"DFXDQ8GT","5UHWUE4K",[631,632,633,171,576,634,149,150,151,152,149,153,154,116],"isic004390","fragmentary early christian funerary inscription",{"_":567},"marble","\u003Cspan class=\"textpartnumber\" id=\"aba\">fragment (physical) a\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"diva--interpretive\">  \u003Ca id=\"aa-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>τ]ό παιδὶον \u003Cbr id=\"aa-l2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[ὃς ἀπὲθανε] τῇ πρό \u003Cspan class=\"supraline\" title=\"line above\">ε\u003C/span>  \u003Cbr id=\"aa-l3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[εἰδῶν Σεπτε]μβρὶων \u003Cbr id=\"aa-l4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>[ζῆσας ἔτη\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cspan class=\"textpartnumber\" id=\"abb\">fragment (physical) b\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"divb--interpretive\">  \u003Ca id=\"ab-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>φα[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":637,"uri":637,"title":638,"status":639,"editions":640,"editionAuthor":45,"type":646,"objectType":650,"material":654,"condition":176,"layoutDesc":656,"handNote":660,"date":674,"places":678,"geo":681,"country":102,"provenance":99,"provenanceGeo":683,"region":112,"settlement":99,"repository":686,"idno":687,"textLang":690,"tmNumber":176,"letterHeights":692,"publications":700,"zotero":701,"keywords":702,"html":706,"idnoSort":-3,"languageSort":115,"materialSort":55,"originSort":99,"typeSort":647},"ISic004405","Small altar dedicated to Aphrodite",{"_":20},[641,642,643,644,645],{"type":24},{"type":26},{"type":28},{"type":31},{"type":34},{"_":647,"ana":648,"ref":649},"dedication","#function.dedic