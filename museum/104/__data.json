03Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":585,"uri":585,"title":586,"status":587,"editions":589,"editionAuthor":45,"type":595,"objectType":596,"material":600,"condition":176,"layoutDesc":604,"handNote":608,"date":624,"places":627,"geo":630,"country":102,"provenance":99,"provenanceGeo":632,"region":112,"settlement":99,"repository":633,"textLang":634,"tmNumber":176,"facsimile":636,"letterHeights":638,"publications":647,"zotero":650,"keywords":653,"html":658,"idnoSort":156,"languageSort":115,"materialSort":601,"originSort":99,"typeSort":171},"ISic004390","Fragmentary early Christian funerary inscription",{"_":588},"edited",[590,591,592,593,594],{"type":24},{"type":26},{"type":28},{"type":31},{"type":34},{"_":171,"ana":172,"ref":173},{"_":597,"ana":598,"ref":599},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259.html",{"_":601,"ana":228,"type":229,"subtype":602,"ref":603},"marble\n                                    ",[58],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":605},{"p":606,"rs":607,"damage":176},"Remains of three lines of Greek letters, with small space to the margin at top, and vacat to the right and a roughly consistent right margin, suggesting line ends are preserved. The letters on the fourth fragment are smaller, and preserve vacat to the left suggesting line beginning. A further line is partially preserved on the fourth fragment.",{"_":65,"ana":66,"ref":67},{"lettering":609,"dimensions":610},"The letters are fairly regularly cut, with almost no serifs/terminations to the strokes, excpt for the slight extension of the apex of alpha and delta. Alpha has broken bar; omicron is slightly ovoid and full size; pi has equal length verticals; epsilon is lunate; phi is rhomboid.",[611,613,617,619],{"type":73,"l":183,"from":91,"to":91,"h":612,"unit":78,"atLeast":612,"atMost":612},"12",{"type":73,"l":614,"from":92,"to":92,"h":615,"unit":78,"atLeast":612,"atMost":616},"Line 2","12-14","14",{"type":89,"l":90,"from":91,"to":92,"h":618,"unit":78,"atLeast":618,"atMost":618},"2",{"type":89,"l":620,"from":92,"to":621,"h":622,"unit":78,"atLeast":623,"atMost":618},"Interlineation line 2 to 3","line3","1-2","1",{"_":625,"notBefore":560,"notAfter":626,"evidence":243},"4th century CE",400,[628,629],{"_":99,"type":100,"ref":101,"region":102},{"_":104,"type":105,"ref":106,"region":102},[631],[109,110],[],{"_":4,"role":3,"ref":5},{"_":115,"mainLang":116,"languages":635},[115],{"n":197,"url":637,"height":199,"width":200,"desc":201,"surfaceType":202},"ISic004390_tiled.tif",[639,641,643,645],{"atLeast":640,"atMost":640},12,{"atLeast":640,"atMost":642},14,{"atLeast":644,"atMost":644},2,{"atLeast":646,"atMost":644},1,[648,649],"Tréziny, 2011, À propos d’une inscription funéraire paléochrétienne de Mégara Hyblaea","Tréziny, 2018, Mégara Hyblaea. 7, La ville classique, hellénistique et romaine",[651,652],"DFXDQ8GT","5UHWUE4K",[654,655,656,171,597,657,149,150,151,152,149,153,154,116],"isic004390","fragmentary early christian funerary inscription",{"_":588},"marble","\u003Cspan class=\"textpartnumber\" id=\"aba\">fragment (physical) a\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"diva--interpretive\">  \u003Ca id=\"aa-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>τ]ό παιδὶον \u003Cbr id=\"aa-l2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[ὃς ἀπὲθανε] τῇ πρό \u003Cspan class=\"supraline\" title=\"line above\">ε\u003C/span>  \u003Cbr id=\"aa-l3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[εἰδῶν Σεπτε]μβρὶων \u003Cbr id=\"aa-l4-interpretive\">\u003Cspan class=\"linenu