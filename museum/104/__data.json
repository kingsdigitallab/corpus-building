oid.",[437,439,443,445],{"type":49,"l":156,"from":67,"to":67,"h":438,"unit":54,"atLeast":438,"atMost":438},"12",{"type":49,"l":440,"from":68,"to":68,"h":441,"unit":54,"atLeast":438,"atMost":442},"Line 2","12-14","14",{"type":65,"l":66,"from":67,"to":68,"h":444,"unit":54,"atLeast":444,"atMost":444},"2",{"type":65,"l":446,"from":68,"to":447,"h":448,"unit":54,"atLeast":449,"atMost":444},"Interlineation line 2 to 3","line3","1-2","1",{"_":451,"notBefore":391,"notAfter":452,"evidence":162},"4th century CE",400,[454,455],{"_":75,"type":76,"ref":77,"region":78},{"_":80,"type":81,"ref":82,"region":78},[457],[85,86],[],{"_":4,"role":3,"ref":5},{"_":91,"mainLang":92,"languages":461},[91],{"n":174,"url":463,"height":176,"width":177,"desc":178,"surfaceType":179},"ISic004390_tiled.tif",[465,467,469,471],{"atLeast":466,"atMost":466},12,{"atLeast":466,"atMost":468},14,{"atLeast":470,"atMost":470},2,{"atLeast":472,"atMost":470},1,[474,475],"Tréziny, 2011, À propos d’une inscription funéraire paléochrétienne de Mégara Hyblaea","Tréziny, 2018, Mégara Hyblaea. 7, La ville classique, hellénistique et romaine",[477,478],"DFXDQ8GT","5UHWUE4K",[480,481,482,139,423,483,126,127,128,129,126,130,131,92],"isic004390","fragmentary early christian funerary inscription",{"_":420},"marble","\u003Cspan class=\"textpartnumber\" id=\"aba\">fragment (physical) a\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"diva--interpretive\">  \u003Ca id=\"aa-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>τ]ό παιδὶον \u003Cbr id=\"aa-l2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[ὃς ἀπὲθανε] τῇ πρό \u003Cspan class=\"supraline\" title=\"line above\">ε\u003C/span>  \u003Cbr id=\"aa-l3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[εἰδῶν Σεπτε]μβρὶων \u003Cbr id=\"aa-l4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>[ζῆσας ἔτη\u003Cspan dir=\"ltr\