ype":586,"ref":587},"marble\n                                    ",[58],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":589},{"p":590,"rs":591,"damage":181},"Remains of three lines of Greek letters, with small space to the margin at top, and vacat to the right and a roughly consistent right margin, suggesting line ends are preserved. The letters on the fourth fragment are smaller, and preserve vacat to the left suggesting line beginning. A further line is partially preserved on the fourth fragment.",{"_":65,"ana":66,"ref":67},{"lettering":593,"dimensions":594},"The letters are fairly regularly cut, with almost no serifs/terminations to the strokes, excpt for the slight extension of the apex of alpha and delta. Alpha has broken bar; omicron is slightly ovoid and full size; pi has equal length verticals; epsilon is lunate; phi is rhomboid.",[595,597,601,603],{"type":73,"l":188,"from":91,"to":91,"h":596,"unit":78,"atLeast":596,"atMost":596},"12",{"type":73,"l":598,"from":92,"to":92,"h":599,"unit":78,"atLeast":596,"atMost":600},"Line 2","12-14","14",{"type":89,"l":90,"from":91,"to":92,"h":602,"unit":78,"atLeast":602,"atMost":602},"2",{"type":89,"l":604,"from":92,"to":605,"h":606,"unit":78,"atLeast":607,"atMost":602},"Interlineation line 2 to 3","line3","1-2","1",{"_":609,"notBefore":546,"notAfter":610,"evidence":241},"4th century CE",400,[612,613],{"_":99,"type":100,"ref":101,"region":102},{"_":104,"type":105,"ref":106,"region":102},[615],[109,110],[],{"_":4,"role":3,"ref":5},{"_":115,"mainLang":116,"languages":619},[115],[621,623,625,627],{"atLeast":622,"atMost":622},12,{"atLeast":622,"atMost":624},14,{"atLeast":626,"atMost":626},2,{"atLeast":628,"atMost":626},1,[630,631],"Tréziny, 2011, À propos d’une inscription funéraire paléochrétienne de Mégara Hyblaea","Tréziny, 2018, Mégara Hyblaea. 7, La ville classique, hellénistique et romaine",[633,634],"DFXDQ8GT","5UHWUE4K",[636,637,638,176,581,639,154,155,156,157,154,158,159,116],"isic004390","fragmentary 