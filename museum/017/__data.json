"provenance":76,"provenanceGeo":680,"region":88,"settlement":8,"repository":681,"textLang":682,"tmNumber":639,"facsimile":684,"letterHeights":686,"publications":693,"zotero":695,"keywords":697,"html":702,"idnoSort":192,"languageSort":94,"materialSort":648,"originSort":76,"typeSort":564},"ISic003420","Fragment of an imperial honorific",{"_":19},[638,640,641,642,643],{"_":639,"type":23},"644815",{"type":25},{"type":27},{"type":30},{"type":32},{"_":564,"ana":565,"ref":645},"https://www.eagle-network.eu/voc/objtyp/lod/69.html",{"_":139,"ana":140,"ref":141},{"_":648,"ana":649,"type":145,"subtype":650,"resp":149,"ref":48},"Coarse-grained, homogeneous, white marble, likely Aphrodisian, Parian-2, Parian-3, Parian-4, Proconnesian, Thasian-3 (identification based on digital microscopy)","#material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Aphrodisian #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Parian-2 #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Parian-3 #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Parian-4 #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Proconnesian #material.inorganic.stone.metamorphic_rock.marble.dolomitic_marble.Thasian-3",[651,652,653,654,655,656],"Aphrodisian","Parian-2","Parian-3","Parian-4","Proconnesian","Thasian-3",{"ana":151},{"layout":659},{"p":660,"rs":661,"damage":662},"The beginning of two lines of monumental letters are preserved on the stone. A substantial left margin is preserved at the start of each line. Unless the lines below were substantially further indented, there was no text below; the preserved vacat above line 1 (90mm)  is significantly greater than that between lines 1 and 2 (57mm), so it is unclear if another line originally stood above (the top of the stone appears intact) - if it did, it was either significantly above the preserved first line and/or indented several letters to the right.",{"_":53,"ana":54,"ref":55},{"ana":157},{"lettering":664,"dimensions":665},"Deep, very regular, v-cut letters, with a broad v-cut, hair-line extensions to wedge serifs, and a quite wide square module. The I in line one is extended.",[666,669,672],{"type":59,"l":60,"from":61,"to":61,"h":667,"unit":63,"atLeast":668,"atMost":668},"68 (I = 87)","68",{"type":59,"l":670,"from":67,"to":67,"h":671,"unit":63,"atLeast":671,"atMost":671},"Line 2","58",{"type":65,"l":66,"from":61,"to":67,"h":673,"unit":63,"atLeast":673,"atMost":673},"57",{"_":165,"notBefore":166,"notAfter":167,"evidence":73},[676,677],{"_":76,"type":77,"ref":78,"corresp":170,"region":79},{"_":8,"type":81,"ref":82,"region":79},[679],[85,86],[],{"_":4,"role":3,"ref":5},{"_":94,"mainLang":95,"languages":683},[94],{"n":98,"url":685,"height":181,"width":180,"desc":182,"surfaceType":103},"ISic003420_tiled.tif",[687,689,691],{"atLeast":688,"atMost":688},68,{"atLeast":690,"atMost":690},58,{"atLeast":692,"atMost":692},57,[694,614],"Korhonen, 2004, La cultura epigrafica della colonia di Catina nell'alto impero",[696,622],"NMS48IZF",[698,699,700,564,139,701,118,119,120,121,119,122,123,95],"isic003420","fragment of an imperial honorific",{"_":19},"coarse-grained, homogeneous, white marble, likely aphrodisian, parian-2, parian-3, parian-4, proconnesian, thasian-3 (identification based on digital microscopy)","\u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>div[o \u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>tri[bunicia potestate \u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>"],"uses":{"params":["slug"]}}]}
