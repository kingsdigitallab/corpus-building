{"type":"data","nodes":[{"type":"data","data":[{"debug":1},true],"uses":{}},{"type":"data","data":[{"museum":1,"inscriptions":18},{"slug":2,"type":3,"name":4,"uri":5,"description":6,"location":7,"idno":15},"186","site","Necropoli di Abakainon","http://sicily.classics.ox.ac.uk/museum/186","Partially uncovered Hellenistic necropolis",{"settlement":8,"region":9,"country":10,"address":11,"geo":12},"Tripi","Messina","","contrada Carusa",{"lat":13,"lon":14},38.06519,15.11438,{"type":16,"url":17},"Pleiades","https://pleiades.stoa.org/places/462062",[19,129,176,224,268,313,360],{"file":20,"uri":20,"title":21,"status":22,"editions":24,"editionAuthor":35,"type":36,"objectType":40,"material":44,"condition":10,"layoutDesc":51,"handNote":58,"date":72,"places":77,"geo":88,"country":83,"provenance":79,"provenanceGeo":92,"region":93,"settlement":8,"repository":94,"idno":95,"textLang":97,"tmNumber":10,"facsimile":101,"letterHeights":108,"publications":111,"zotero":114,"keywords":117,"html":127,"idnoSort":128,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004415","Epitaph for Krimma, child of Aunakos",{"_":23},"edited",[25,27,29,31,33],{"type":26},"TM",{"type":28},"EDR",{"type":30},"EDH",{"type":32},"EDCS",{"type":34},"PHI",null,{"_":37,"ana":38,"ref":39},"funerary","#function.funerary","https://ontology.inscriptiones.org/type_of_inscription/Funerary",{"_":41,"ana":42,"ref":43},"plinth","#object.arch_element.plinth","https://www.eagle-network.eu/voc/objtyp/lod/1910.html",{"_":45,"ana":46,"type":47,"subtype":48,"ref":50},"sandstone","#material.inorganic.stone","stone.unspecified",[49],"unverified","http://www.eagle-network.eu/voc/material/lod/75.html",{"layout":52},{"p":53,"rs":54,"damage":10},"Single line of greek letters approximately centred on the face of the plinth",{"_":55,"ana":56,"ref":57},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"lettering":59,"dimensions":60},"Small simple letters. Kappa has short equal arms, attached to the vertical; rho has small closed eye; mu has slanting first and final strokes, with the mid-strokes joining as a curve and only descending half-way; alpha is broad with straight bar, in one case slightly curved with the apex extending at the top; nu has shorter right vertical joining the diagonal above the line; omicron is small and mid-line.",[61,67],{"type":62,"l":63,"from":64,"to":64,"h":65,"unit":66,"atLeast":65,"atMost":65},"letterHeight","Line 1","line1","30","mm",{"type":68,"l":69,"from":64,"to":70,"h":71,"unit":66},"interlinear","Interlineation line 1 to 2","line2","NA",{"_":73,"notBefore":74,"notAfter":75,"evidence":76},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",-350,-201,"archaeological-context",[78,84],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},"Abacaenum","ancient","http://pleiades.stoa.org/places/462062","#findspot","Sicilia",{"_":8,"type":85,"ref":86,"offset":87,"region":83},"modern","http://sws.geonames.org/2522853","near",[89],[90,91],38.05191,15.10158,[13,14],"Sicily",{"_":4,"role":3,"ref":5},{"type":96},"inventory",{"_":98,"mainLang":99,"languages":100},"Ancient Greek","grc",[98],{"n":102,"url":103,"height":104,"width":105,"desc":106,"surfaceType":107},"screen","ISic004415_tiled.tif","3680px","5520px","I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana","front",[109],{"atLeast":110,"atMost":110},30,[112,113],"Bacci, Coppolino, 2009, La Necropoli di Abakainon: primi dati","Sofia, 2018, Nuove iscrizioni funerarie dalla necropoli di Abakainon",[115,116],"DX8AWC9Q","JQQKI6JP",[118,119,120,37,41,45,121,122,123,124,122,125,126,99],"isic004415","epitaph for krimma, child of aunakos",{"_":23},"abacaenum","tripi","sicilia","sicily","necropoli di abakainon","ancient greek","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κριμμα Αυνακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",9999999999,{"file":130,"uri":130,"title":131,"status":132,"editions":133,"editionAuthor":35,"type":139,"objectType":140,"material":141,"condition":10,"layoutDesc":143,"handNote":147,"date":153,"places":154,"geo":157,"country":83,"provenance":79,"provenanceGeo":159,"region":93,"settlement":8,"repository":160,"idno":161,"textLang":162,"tmNumber":10,"facsimile":164,"letterHeights":166,"publications":169,"zotero":170,"keywords":171,"html":175,"idnoSort":128,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004416","Epitaph for Philon, son Aunakos",{"_":23},[134,135,136,137,138],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":142,"ref":50},[49],{"layout":144},{"p":145,"rs":146,"damage":10},"Single line of greek letters approximately centred on the face of the plinth, descending to right",{"_":55,"ana":56,"ref":57},{"lettering":148,"dimensions":149},"Crude and irregularly carved large letters. Phi has a small eye, seemingly formed of two small loops; omega is small, mid-line, open, with outward/downward sloping tails; nu is large and uneven; alpha is broad, but the form of the bar is illegible; kappa has short equal arms joined to the vertical; omicron appears small and midline.",[150,152],{"type":62,"l":63,"from":64,"to":64,"h":151,"unit":66,"atLeast":151,"atMost":151},"59",{"type":68,"l":69,"from":64,"to":70,"h":71,"unit":66},{"_":73,"notBefore":74,"notAfter":75,"evidence":76},[155,156],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[158],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":163},[98],{"n":102,"url":165,"height":104,"width":105,"desc":106,"surfaceType":107},"ISic004416_tiled.tif",[167],{"atLeast":168,"atMost":168},59,[112,113],[115,116],[172,173,174,37,41,45,121,122,123,124,122,125,126,99],"isic004416","epitaph for philon, son aunakos",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Φίλων Αυ̣νακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":177,"uri":177,"title":178,"status":179,"editions":180,"editionAuthor":35,"type":186,"objectType":187,"material":188,"condition":10,"layoutDesc":190,"handNote":194,"date":200,"places":201,"geo":204,"country":83,"provenance":79,"provenanceGeo":206,"region":93,"settlement":8,"repository":207,"idno":208,"textLang":209,"tmNumber":10,"facsimile":211,"letterHeights":213,"publications":215,"zotero":217,"keywords":219,"html":223,"idnoSort":128,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004417","Epitaph for [-?-], child of Gerontios",{"_":23},[181,182,183,184,185],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":189,"ref":50},[49],{"layout":191},{"p":192,"rs":193,"damage":10},"Remains of two lines of Greek letters, apparently centred on the face of the plinth; the second line sits directly above the lower moulding",{"_":55,"ana":56,"ref":57},{"lettering":195,"dimensions":196},"Simple, widely spaced letters. Omega is wide and open, with horizontal tails; rho has a large, closed eye; omicron is small and mid-line; nu is regular and with both verticals full length",[197,199],{"type":62,"l":198,"from":64,"to":70,"h":65,"unit":66,"atLeast":65,"atMost":65},"Line 1-2",{"type":68,"l":69,"from":64,"to":70,"unit":66},{"_":73,"notBefore":74,"notAfter":75,"evidence":76},[202,203],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[205],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":210},[98],{"n":102,"url":212,"height":104,"width":105,"desc":106,"surfaceType":107},"ISic004417_tiled.tif",[214],{"atLeast":110,"atMost":110},[112,216,113],"Sofia, 2015, Abakainon. Nella dimora di Ade. La necropoli in contrada Cardusa a Tripi",[115,218,116],"9QTE4E3Z",[220,221,222,37,41,45,121,122,123,124,122,125,126,99],"isic004417","epitaph for [-?-], child of gerontios",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ω\u003Cspan dir=\"ltr\" class=\"gap\">.\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[Γ]ε̣ρόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":225,"uri":225,"title":178,"status":226,"editions":227,"editionAuthor":35,"type":233,"objectType":234,"material":235,"condition":10,"layoutDesc":237,"handNote":241,"date":246,"places":248,"geo":251,"country":83,"provenance":79,"provenanceGeo":253,"region":93,"settlement":8,"repository":254,"idno":255,"textLang":256,"tmNumber":10,"facsimile":258,"letterHeights":260,"publications":262,"zotero":263,"keywords":264,"html":267,"idnoSort":128,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004418",{"_":23},[228,229,230,231,232],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":236,"ref":50},[49],{"layout":238},{"p":239,"rs":240,"damage":10},"Most of the lower line of Greek text is preserved, centred on the front face of the plinth; traces of a preceding line are visible.",{"_":55,"ana":56,"ref":57},{"lettering":242,"dimensions":243},"Neat, regular, simply cut, widely spaced letters. Epsilon has shorter middle bar; rho has closed, regular eye; omicron is small and mid-line; nu is broad with verticals of equal length.",[244,245],{"type":62,"l":198,"from":64,"to":70,"h":151,"unit":66,"atLeast":151,"atMost":151},{"type":68,"l":69,"from":64,"to":70,"unit":66},{"_":247,"notBefore":74,"notAfter":75,"evidence":76},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[249,250],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[252],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":257},[98],{"n":102,"url":259,"height":104,"width":105,"desc":106,"surfaceType":107},"ISic004418_tiled.tif",[261],{"atLeast":168,"atMost":168},[112,216,113],[115,218,116],[265,221,266,37,41,45,121,122,123,124,122,125,126,99],"isic004418",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ς̣ \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>Γ̣ερόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":269,"uri":269,"title":270,"status":271,"editions":272,"editionAuthor":35,"type":278,"objectType":279,"material":280,"condition":10,"layoutDesc":282,"handNote":286,"date":291,"places":292,"geo":295,"country":83,"provenance":79,"provenanceGeo":297,"region":93,"settlement":8,"repository":298,"idno":299,"textLang":300,"tmNumber":10,"facsimile":302,"letterHeights":304,"publications":306,"zotero":307,"keywords":308,"html":312,"idnoSort":128,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004419","Epitaph for Aristarchos",{"_":23},[273,274,275,276,277],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":281,"ref":50},[49],{"layout":283},{"p":284,"rs":285,"damage":10},"Remains of a single line of Greek letters, somewhat irregularly laid out and not following the horizontal",{"_":55,"ana":56,"ref":57},{"lettering":287,"dimensions":288},"Somewhat irregular plainly cut, widely spaced letters. Rho has closed and regular eye; sigma has horizontal upper and lower strokes, the intermediate strokes joined by a curve; alpha is broad with straight bar; omicron is small and mid-line.",[289,290],{"type":62,"l":63,"from":64,"to":64,"h":65,"unit":66,"atLeast":65,"atMost":65},{"type":68,"l":69,"from":64,"to":70,"h":71,"unit":66},{"_":247,"notBefore":74,"notAfter":75,"evidence":76},[293,294],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[296],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":301},[98],{"n":102,"url":303,"height":104,"width":105,"desc":106,"surfaceType":107},"ISic004419_tiled.tif",[305],{"atLeast":110,"atMost":110},[113],[116],[309,310,311,37,41,45,121,122,123,124,122,125,126,99],"isic004419","epitaph for aristarchos",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[Ἀ]ρισταρχου̣ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":314,"uri":314,"title":315,"status":316,"editions":317,"editionAuthor":35,"type":323,"objectType":324,"material":325,"condition":10,"layoutDesc":327,"handNote":331,"date":337,"places":338,"geo":341,"country":83,"provenance":79,"provenanceGeo":343,"region":93,"settlement":8,"repository":344,"idno":345,"textLang":346,"tmNumber":10,"facsimile":348,"letterHeights":350,"publications":353,"zotero":354,"keywords":355,"html":359,"idnoSort":128,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004420","Epitaph for Aristokrates",{"_":23},[318,319,320,321,322],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":326,"ref":50},[49],{"layout":328},{"p":329,"rs":330,"damage":10},"Two lines of Greek letters rather irregularly laid out (not strictly observing the horizontal) and not strictly centred; the single word is split across two lines",{"_":55,"ana":56,"ref":57},{"lettering":332,"dimensions":333},"Somewhat irregular plainly cut, widely spaced letters, poorly laid out. Alpha is broad with straight bar; rho has closed eye, somewhat angular in the first instance, more curved in the second; sigma has horizontal top and bottom strokes, angular mid-strokes, very crudely done in the first instance; omicron is very small and mid-line; kappa has short equal bars joined to the vertical; epsilon has shorter middle bar.",[334,336],{"type":62,"l":198,"from":64,"to":70,"h":335,"unit":66,"atLeast":335,"atMost":335},"49",{"type":68,"l":69,"from":64,"to":70,"unit":66},{"_":247,"notBefore":74,"notAfter":75,"evidence":76},[339,340],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[342],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":347},[98],{"n":102,"url":349,"height":104,"width":105,"desc":106,"surfaceType":107},"ISic004420_tiled.tif",[351],{"atLeast":352,"atMost":352},49,[113],[116],[356,357,358,37,41,45,121,122,123,124,122,125,126,99],"isic004420","epitaph for aristokrates",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">\u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοκρά \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>τεος \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":361,"uri":361,"title":362,"status":363,"editions":364,"editionAuthor":35,"type":370,"objectType":371,"material":372,"condition":10,"layoutDesc":374,"handNote":378,"date":384,"places":386,"geo":389,"country":83,"provenance":79,"provenanceGeo":391,"region":93,"settlement":8,"repository":392,"idno":393,"textLang":394,"tmNumber":10,"facsimile":396,"letterHeights":398,"publications":401,"zotero":402,"keywords":403,"html":407,"idnoSort":128,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004421","Epitaph for Athanippos",{"_":23},[365,366,367,368,369],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":373,"ref":50},[49],{"layout":375},{"p":376,"rs":377,"damage":10},"A single line of Greek letters filling the width of the stele, approximately 20 cm from the top of the stele.",{"_":55,"ana":56,"ref":57},{"lettering":379,"dimensions":380},"Plainly cut and fairly regular squarish letters. Alpha has broken bar (and in the first instance, shows a slight apex at the top); theta is smaller than other letters and mid-line, with a single central dot; nu has equal length vertical strokes (the right slightly off vertical); pi is quadrate in form with nearly equal length vertical strokes and slightly overlapping horizontal; omicron is slightly smaller than other letters and mid-line.",[381,383],{"type":62,"l":63,"from":64,"to":64,"h":382,"unit":66,"atLeast":382,"atMost":382},"29",{"type":68,"l":69,"from":64,"to":70,"h":71,"unit":66},{"_":385,"notBefore":74,"notAfter":75,"evidence":76},"The tomb has not been excavated, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[387,388],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[390],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":395},[98],{"n":102,"url":397,"height":104,"width":105,"desc":106,"surfaceType":107},"ISic004421_tiled.tif",[399],{"atLeast":400,"atMost":400},29,[113],[116],[404,405,406,37,41,45,121,122,123,124,122,125,126,99],"isic004421","epitaph for athanippos",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀθανίππου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>"],"uses":{"params":["slug"]}}]}
