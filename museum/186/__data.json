:98,"mainLang":99,"languages":246},[98],[248],{"atLeast":159,"atMost":159},[105,205,106],[108,207,109],[252,210,253,37,41,45,114,115,116,117,115,118,119,99],"isic004418",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ς̣ \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>Γ̣ερόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":256,"uri":256,"title":257,"status":258,"editions":259,"editionAuthor":35,"type":265,"objectType":266,"material":267,"condition":10,"layoutDesc":269,"handNote":273,"date":278,"places":279,"geo":282,"country":83,"provenance":79,"provenanceGeo":284,"region":93,"settlement":8,"repository":285,"idno":286,"textLang":287,"tmNumber":10,"letterHeights":289,"publications":291,"zotero":292,"keywords":293,"html":297,"idnoSort":121,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004419","Epitaph for Aristarchos",{"_":23},[260,261,262,263,264],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":268,"ref":50},[49],{"layout":270},{"p":271,"rs":272,"damage":10},"Remains of a single line of Greek letters, somewhat irregularly laid out and not following the horizontal",{"_":55,"ana":56,"ref":57},{"lettering":274,"dimensions":275},"Somewhat irregular plainly cut, widely spaced letters. Rho has closed and regular eye; sigma has horizontal upper and lower strokes, the intermediate strokes joined by a curve; alpha is broad with straight bar; omicron is small and mid-line.",[276,277],{"type":62,"l":63,"from":64,"to":64,"h":65,"unit":66,"atLeast":65,"atMost":65},{"type":68,"l":69,"from":64,"to":70,"h":71,"unit":66},{"_":236,"notBefore":74,"notAfter":75,"evidence":76},[280,281],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[283],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":288},[98],[290],{"atLeast":103,"atMost":103},[106],[109],[294,295,296,37,41,45,114,115,116,117,115,118,119,99],"isic004419","epitaph for aristarchos",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[Ἀ]ρισταρχου̣ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":299,"uri":299,"title":300,"status":301,"editions":302,"editionAuthor":35,"type":308,"objectType":309,"material":310,"condition":10,"layoutDesc":312,"handNote":316,"date":322,"places":323,"geo":326,"country":83,"provenance":79,"provenanceGeo":328,"region":93,"settlement":8,"repository":329,"idno":330,"textLang":331,"tmNumber":10,"letterHeights":333,"publications":336,"zotero":337,"keywords":338,"html":342,"idnoSort":121,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004420","Epitaph for Aristokrates",{"_":23},[303,304,305,306,307],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":311,"ref":50},[49],{"layout":313},{"p":314,"rs":315,"damage":10},"Two lines of Greek letters rather irregularly laid out (not strictly observing the horizontal) and not strictly centred; the single word is split across two lines",{"_":55,"ana":56,"ref":57},{"lettering":317,"dimensions":318},"Somewhat irregular plainly cut, widely spaced letters, poorly laid out. Alpha is broad with straight bar; rho has closed eye, somewhat angular in the first instance, more curved in the second; sigma has horizontal top and bottom strokes, angular mid-strokes, very crudely done in the first instance; omicron is very small and mid-line; kappa has short equal bars joined to the vertical; epsilon has shorter middle bar.",[319,321],{"type":62,"l":189,"from":64,"to":70,"h":320,"unit":66,"atLeast":320,"atMost":320},"49",{"type":68,"l":69,"from":64,"to":70,"unit":66},{"_":236,"notBefore":74,"notAfter":75,"evidence":76},[324,325],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[327],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":332},[98],[334],{"atLeast":335,"atMost":335},49,[106],[109],[339,340,341,37,41,45,114,115,116,117,115,118,119,99],"isic004420","epitaph for aristokrates",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">\u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοκρά \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>τεος \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"file":344,"uri":344,"title":345,"status":346,"editions":347,"editionAuthor":35,"type":353,"objectType":354,"material":355,"condition":10,"layoutDesc":357,"handNote":361,"date":367,"places":369,"geo":372,"country":83,"provenance":79,"provenanceGeo":374,"region":93,"settlement":8,"repository":375,"idno":376,"textLang":377,"tmNumber":10,"letterHeights":379,"publications":382,"zotero":383,"keywords":384,"html":388,"idnoSort":121,"languageSort":98,"materialSort":45,"originSort":79,"typeSort":37},"ISic004421","Epitaph for Athanippos",{"_":23},[348,349,350,351,352],{"type":26},{"type":28},{"type":30},{"type":32},{"type":34},{"_":37,"ana":38,"ref":39},{"_":41,"ana":42,"ref":43},{"_":45,"ana":46,"type":47,"subtype":356,"ref":50},[49],{"layout":358},{"p":359,"rs":360,"damage":10},"A single line of Greek letters filling the width of the stele, approximately 20 cm from the top of the stele.",{"_":55,"ana":56,"ref":57},{"lettering":362,"dimensions":363},"Plainly cut and fairly regular squarish letters. Alpha has broken bar (and in the first instance, shows a slight apex at the top); theta is smaller than other letters and mid-line, with a single central dot; nu has equal length vertical strokes (the right slightly off vertical); pi is quadrate in form with nearly equal length vertical strokes and slightly overlapping horizontal; omicron is slightly smaller than other letters and mid-line.",[364,366],{"type":62,"l":63,"from":64,"to":64,"h":365,"unit":66,"atLeast":365,"atMost":365},"29",{"type":68,"l":69,"from":64,"to":70,"h":71,"unit":66},{"_":368,"notBefore":74,"notAfter":75,"evidence":76},"The tomb has not been excavated, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[370,371],{"_":79,"type":80,"ref":81,"corresp":82,"region":83},{"_":8,"type":85,"ref":86,"offset":87,"region":83},[373],[90,91],[13,14],{"_":4,"role":3,"ref":5},{"type":96},{"_":98,"mainLang":99,"languages":378},[98],[380],{"atLeast":381,"atMost":381},29,[106],[109],[385,386,387,37,41,45,114,115,116,117,115,118,119,99],"isic004421","epitaph for athanippos",{"_":23},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀθανίππου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>"],"uses":{"params":["slug"]}}]}
