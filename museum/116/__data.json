r\" class=\"gap\">---\u003C/span>]]] \u003Cbr id=\"a1-l6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>[[[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]]] \u003Cbr id=\"a1-l7-interpretive\">\u003Cspan class=\"linenumber\">7\u003C/span>το͂ν ͱιαρο͂ν ͱα θυσία πρὸ Ϙοτυτίον καὶ τᾶς ἐχεχερίας πένπ̣[τοι] \u003Cbr id=\"a1-l8-interpretive\">\u003Cspan class=\"linenumber\">8\u003C/span> ϝέτει ͱο͂ιπερ ͱόκα ͱα Ὀλυνπιὰς ποτείε· το͂ι Διὶ ⁚ το͂ι Εὐμενεῖ θύ[ε]ν̣ [καὶ] \u003Cbr id=\"a1-l9-interpretive\">\u003Cspan class=\"linenumber\">9\u003C/span> ταῖς ⁚ Εὐμενίδεσι ⁚ τέλεον, καὶ το͂ι Διὶ ⁚ το͂ι Μιλιχίοι το͂ι ⁚ ἐν Μύσϙο ⁚ τέλεον ⁚ τοῖς Τρ-\u003Cbr id=\"a1-l10-interpretive\">\u003Cspan class=\"linenumber\">10\u003C/span>ιτοπατρεῦσι · τοῖς · μιαροῖς ͱόσπερ τοῖς ͱερόεσι, ϝοῖνον ͱυπολͱεί-\u003Cbr id=\"a1-l11-interpretive\">\u003Cspan class=\"linenumber\">11\u003C/span>ψας · δι’ ὀρόφο · καὶ τᾶν μοιρᾶν τᾶν ἐνάταν · κατακα-\u003Cbr id=\"a1-l12-interpretive\">\u003Cspan class=\"linenumber\">12\u003C/span>ίεν · μίαν. θυόντο θῦμα ⁚ καὶ καταγιζόντο ͱοῖς ͱοσία · καὶ περιρά-\u003Cbr id=\"a1-l13-interpretive\">\u003Cspan class=\"linenumber\">13\u003C/span>ναντες καταλινάντο ⁚ κἔπειτα ⁚ τοῖς κ&lt;α&gt;θαροῖς ⁚ τέλεον θυόντο̄ ⁚ μελίκρατα ͱυπο \u003Cbr id=\"a1-l14-interpretive\">\u003Cspan class=\"linenumber\">14\u003C/span>λείβον · καὶ τράπεζαν καὶ κλίναν κἐνβαλέτο καθαρὸν ͱε͂μα καὶ στεφά-\u003Cbr id=\"a1-l15-interpretive\">\u003Cspan class=\"linenumber\">15\u003C/span>νος ἐλαίας καὶ μελίκρατα ἐν καιναῖς ποτε̄ρίδε̣[σ]ι καὶ ⁚ πλάσματα καὶ κρᾶ κἀπ-\u003Cbr id=\"a1-l16-interpretive\">\u003Cspan class=\"linenumber\">16\u003C/span>αρξάμενοι κατακαάντο καὶ καταλινάντο τ̣ὰς ποτε̄ρίδας ἐνθέντες̣. \u003Cbr id=\"a1-l17-interpretive\">\u003Cspan class=\"linenumber\">17\u003C/span>θυόντ̣ο̄ ͱό̄σπερ τοῖς θεοῖς τὰ πατρο͂ια ⁚ το͂ι ἐν Εὐθυδάμο̄ Μιλιχίο̄ι ⁚ κριὸν θ̣[υ-]\u003Cbr id=\"a1-l18-interpretive\">\u003Cspan class=\"linenumber\">18\u003C/span>όντο̄. ἔστο̄ δὲ καὶ θῦμα πεδὰ ϝέτος θύε̄ν. τὰ δὲ ͱιαρὰ τὰ δαμόσια ἐξͱ&lt;α&gt;ιρέτο̄ καὶ τρά[πεζα-]\u003Cbr id=\"a1-l19-interpretive\">\u003Cspan class=\"linenumber\">19\u003C/span>ν ⁚ προθέμεν καὶ ϙολέαν καὶ τἀπὸ τᾶς τραπέζας ⁚ ἀπάργματα καὶ τὀστέα κα[τα-]\u003Cbr id=\"a1-l20-interpretive\">\u003Cspan class=\"linenumber\">20\u003C/span>κᾶαι · τὰ κρᾶ μἐχφερέτο̄. καλέ̄το̄ [ͱ]όντινα λε͂ι. ἔστο̄ δὲ καὶ πεδὰ ϝέτ[ος ϝ-]\u003Cbr id=\"a1-l21-interpretive\">\u003Cspan class=\"linenumber\">21\u003C/span>οίϙοι θύεν ⁚ σφαζόντο δὲ ⁚ καὶ β[ν πρ]ὸ ἀγαλμάτο̄ν [\u003Cspan dir=\"ltr\" class=\"gap\">...\u003C/span>]Δ̣ΕΣ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"a1-l22-interpretive\">\u003Cspan class=\"linenumber\">22\u003C/span> Ο θῦμα ͱότι κα προχο̄ρε͂ι τὰ πατρο͂[ια\u003Cspan dir=\"ltr\" class=\"gap\">.\u003C/span>]ΕΞΑΙ\u003Cspan dir=\"ltr\" class=\"gap\">.\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"a1-l23-interpretive\">\u003Cspan class=\"linenumber\">23\u003C/span>Τ̣[\u003Cspan dir=\"ltr\" class=\"gap\">..\u003C/span>]ΙΤΟΙΑΠΤΟΧΟΙ τρίτοι ϝέτ̣[ει] Ε̣[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"a1-l24-interpretive\">\u003Cspan class=\"linenumber\">24\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">. 7-8.\u003C/span>]Ε̣ΥΣΥΝΒ̣[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cspan class=\"textpartnumber\" id=\"ab2\">column 2\u003C/span>  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div2--interpretive\">  \u003Cspan class=\"textpartnumber\" style=\"left: -4em;\">Col. 2\u003Cbr>\u003C/span>  \u003Ca id=\"a2-l1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[αἴ] κ̣᾿ ἄν̣θρο̣̄π̣ο̣ς [αὐτορέκ]τ[ας ἐλ]αστέρο̄ν ἀποκα[θαίρεσθαι] \u003Cbr id=\"a2-l2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[λε͂ι], προειπὸ̄ν hόπο̄ κα λε͂ικ̣̣αὶ το͂ ϝέ̣[τ]ε̣ος hοπ〈εί〉ο̄ κα λε͂ι καὶ [το͂ με̄νὸς] \u003Cbr id=\"a2-l3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>hοπείο̄ κα λε͂ι καὶ ἀμέραι hοπείαι κα λ&lt;ε͂&gt;ι, ποροειπὸ̄ν hὸπυι κα λε͂ι, καθαιρέσθο̄, [Hο hυ-]\u003Cbr id=\"a2-l4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>ποδεκόμενος ἀπονίψασθαι δότο̄ κἀκρατίξασθαι καὶ hάλα το͂ι αὐ[τορέκ-]\u003Cbr id=\"a2-l5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>[τ]α θύσας το͂ι Δὶ χοῖρον ἐξ αὐτο͂ ἴτο καὶ περιστιραφέσθο̄ \u003Cbr id=\"a2-l6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>καὶ ποταγορέ̄σθο̄ καὶ σῖτον hαιρέ̄σθο καὶ καθευδέτο̄ hοπε̄ κ̣-\u003Cbr id=\"a2-l7-interpretive\">\u003Cspan class=\"linenumber\">7\u003C/span>α λε͂ι. αἴ τίς κα λε͂ι ξενικὸν ἒ πατρο͂ιον ἒ ᾿πακουστὸν ἒ ᾿φορατὸν \u003Cbr id=\"a2-l8-interpretive\">\u003Cspan class=\"linenumber\">8\u003C/span>ἒ καὶ χὄντινα καθαίρεσθαι, τὸν αὐτὸν τρόπον̣ κ̣αθαιρέσθο̄ \u003Cbr id=\"a2-l9-interpretive\">\u003Cspan class=\"linenumber\">9\u003C/span>hόνπερ hοὐτορέκτας ἐπεί κ᾿ἐλαστέρο̄ ἀποκαθάρε̄ται. \u003Cbr id=\"a2-l10-interpretive\">\u003Cspan class=\"linenumber\">10\u003C/span>hιαρεῖον τέλεον ἐπὶ το͂ι βομο͂ι το͂ι δαμασίο̄ι θύσας καθαρὸ-\u003Cbr id=\"a2-l11-interpretive\">\u003Cspan class=\"linenumber\">11\u003C/span>ς ἔστο̄. διορίξας hαλὶ καὶ χρυσο͂ι ἀπορανάμενος ἀπίτο̄. \u003Cbr id=\"a2-l12-interpretive\">\u003Cspan class=\"linenumber\">12\u003C/span>hόκα το͂ι Ἐλαστέρο̄ι χρέ̄ζει θύε̄ν, θύε̄ν hό̄σπερ τοῖς \u003Cbr id=\"a2-l13-interpretive\">\u003Cspan class=\"linenumber\">13\u003C/span>ἀθανάτοισι. σφαζέτο̄ δ᾿ ἐς γᾶν. \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>"],"uses":{"params":["slug"]}}]}
