{"type":"data","nodes":[{"type":"data","data":[{"debug":1},true],"uses":{}},{"type":"data","data":[{"museum":1,"inscriptions":15},{"slug":2,"type":3,"name":4,"uri":5,"description":6,"location":7},"079","museum","Museo Civico Pippo Rizzo","http://sicily.classics.ox.ac.uk/museum/079","Arranged across 2 floors and a series of rooms, the upper floor follows a chronological arrangement beginning with the Neolithic and Bronze Age, the 5-4 century BC site of Montagna Vecchia, then some Hellenistic and Roman finds (including the famous milestone). The lower floor is a lapidarium with some reconstructed pithoi. Several columns and architrave pieces come from 2 Roman peristyle houses",{"settlement":8,"region":9,"country":10,"address":11,"geo":12},"Corleone","Palermo","Italy","Via orfanotrofio 4, Palazzo Proenzano, 90034 - Corleone (PA)",{"lat":13,"lon":14},37.8138168,13.298785,[16],{"file":17,"uri":17,"title":18,"status":19,"editions":21,"editionAuthor":35,"type":36,"objectType":40,"material":44,"condition":52,"layoutDesc":53,"handNote":59,"date":89,"places":93,"geo":98,"country":97,"provenance":8,"provenanceGeo":102,"region":105,"settlement":8,"repository":106,"textLang":107,"tmNumber":23,"facsimile":111,"letterHeights":118,"publications":129,"zotero":139,"keywords":149,"html":158,"idnoSort":159,"languageSort":108,"materialSort":45,"originSort":8,"typeSort":37},"ISic000610","Milestone of Aurelius Cotta",{"_":20},"edited",[22,25,28,30,33],{"_":23,"type":24},"175816","TM",{"_":26,"type":27},"074316","EDR",{"type":29},"EDH",{"_":31,"type":32},"13600220","EDCS",{"type":34},"PHI",null,{"_":37,"ana":38,"ref":39},"milestone","#function.milestone","https://ontology.inscriptiones.org/type_of_inscription/Milestone",{"_":41,"ana":42,"ref":43},"block","#object.block","http://www.eagle-network.eu/voc/objtyp/lod/189.html",{"_":45,"ana":46,"type":47,"subtype":48,"resp":50,"ref":51},"limestone","#material.inorganic.stone.sedimentary_rock.limestone.calcarenite","stone.calcarenite",[49],"unsp