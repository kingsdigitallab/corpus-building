iting/lod/1",{"lettering":58,"dimensions":59},"Tall, regular, narrow letters, v-cut, with small serifs on the termination of strokes. Small deep triangular interpuncts. Alpha has broken bar; epsilon tall, narrow, with equal short horizontals; theta and omicron are rhomboid; mu has vertical first and last, with the diagonals starting below the top and only desencing to the mid-point; nu is similar; rho has small curved, closed loop; sigma is lunate but rectilinear, with very short horizontals.",[60,67],{"type":61,"l":62,"from":63,"to":64,"h":65,"unit":66,"atLeast":65,"atMost":65},"letterHeight","Line 1-2","line1","line2","110","mm",{"type":68,"l":69,"from":63,"to":64,"h":70,"unit":66,"atLeast":70,"atMost":70},"interlinear","Interlineation line 1 to 2","20",{"_":72,"notBefore":73,"notAfter":74,"evidence":75},"Dated by reference to Flavius Martinianos, consularis of Sicily between 352 and 358 CE (Soraci)",352,358,"prosopography",[77,82],{"_":78,"type":79,"ref":80,"region":81},"Agrigentum","ancient","http://pleiades.stoa.org/places/462086","Sicilia",{"_":8,"type":83,"ref":84,"region":81},"modern","http://sws.geonames.org/6541860",[86],[87,88],37.32084,13.58876,[90,91],37.297649,13.591579,"Sicily",{"_":4,"role":3,"ref":5},{"type":95},"inventory",{"_":97,"mainLang":98,"languages":99},"Ancient Greek","grc",[97],{"n":101,"url":102,"height":103,"width":104,"desc":6,"surfaceType":105},"screen","ISic001830_tiled.tif","5520px","3680px","front",[107,109],{"atLeast":108,"atMost":108},110,{"atLeast":110,"atMost":110},20,[112],"Caminneci, Parello, Soraci, 2023, Un documento epigrafico inedito sulle terme di Agrigento",[114],"A7HRWIUH",[116,117,118,36,40,44,119,120,121,122,120,123,124,98],"isic001830","building inscription of martinianos",{"_":22},"agrigentum","agrigento","sicilia","sicily","parco archeologico valle dei templi","ancient greek","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u0