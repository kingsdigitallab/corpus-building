    \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n            \t   \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n            \t   \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n            \t\t\u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n\t    \u003Cchange when=\"2020-12-23\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n            \t\u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2025-12-17\" who=\"#JP\">Jonathan Prag made provisional revisions, pending autopsy\u003C/change>\n                \u003Cchange when=\"2026-09-25\" who=\"#JP\">Jonathan Prag revised on the basis of Fuduli 2025\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!-- \n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic003399_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic003399.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/5HRB8SR7\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cexpan>\u003Cabbr>Aug\u003C/abbr>\u003Cex>usto\u003C/ex>\u003C/expan> \u003Csupplied reason=\"lost\">\u003Cexpan>\u003Cabbr>sacr\u003C/abbr>\u003Cex>um\u003C/ex>\u003C/expan>\u003C/supplied>\n                    \u003Clb n=\"2\"/>Papirius Isidor\u003Csupplied reason=\"lost\">us\u003C/supplied> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"3\"/>\u003Cexpan>\u003Cabbr>dupl\u003C/abbr>\u003Cex>icarius\u003C/ex>\u003C/expan> \u003Cexpan>\u003Cabbr>itemq\u003C/abbr>\u003Cex>ue\u003C/ex>\u003C/expan> in \u003Cexpan>\u003Cabbr>cor\u003Csupplied reason=\"lost\">p\u003C/supplied>\u003C/abbr>\u003Csupplied reason=\"lost\">\u003Cex>ore\u003C/ex>\u003C/supplied>\u003C/expan> \u003Csupplied reason=\"lost\">\u003Cexpan>\u003Cabbr>Aug\u003C/abbr>\u003Cex>ustalium\u003C/ex>\u003C/expan>\u003C/supplied>\n                    \u003Clb n=\"4\"/>immunis triclinos \u003Cw part=\"I\">v\u003C/w>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"5\"/>Genis Miseni a nov\u003Cunclear>o\u003C/unclear> \u003Csupplied reason=\"lost\">\u003Cw part=\"I\" cert=\"low\">fact\u003C/w>\u003C/supplied>\u003Cgap reason=\"lost\" unit=\"character\" extent=\"unknown\"/>\n                    \u003Clb n=\"6\"/>sigillum p\u003Csupplied reason=\"lost\" cert=\"low\">osuit\u003C/supplied>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003Cp>\u003C!--external apparatus criticus (if applicable)-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>Fuduli convincingly demonstrates that this piece is a dedication by an Augustalis of a statue of the Genius of Misenum and consequently cannot originally have been set up at ancient Mylae / modern Milazzo, but must have ended up at some point subsequently at Milazzo (but there is no record of an antiquarian collection to which it could have belonged), most likely transported as ballast (or simply marble spolia) at some point after the collapse/destruction of the original display in Misenum.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Tigano\u003C/author>\n                        \u003Cdate>2009\u003C/date>\n                        \u003CcitedRange>236 fig.8\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/RXD2XUXU\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001560\">https://biblio.inscriptiones.org/epig10001560\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Fuduli\u003C/author>\n                        \u003Cdate>2025\u003C/date>\n                        \u003CcitedRange>285-288 with fig. 1\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/5HRB8SR7\"/>\n                    \u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
