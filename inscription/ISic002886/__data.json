ni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>-->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname type=\"praenomen\">\u003Cexpan>\u003Cabbr>Κ\u003C/abbr>\u003Cex>οΐντου\u003C/ex>\u003C/expan>\u003C/name> \u003Cname type=\"nomen\">Λυτατίου\u003C/name> \u003Cname>Ελε\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003C/name>\u003C/persName>\n                    \u003Clb n=\"2\"/>\u003Corig>\u003Cunclear>ΚΛΛ\u003C/unclear>\u003C/orig>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text of I.Lipara\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--K. Lutatiou Ele[- - - | KLL.  Upper part of a marble block with a cornice. Small amounts of line 2 perceivable. Re-used in late-Roman context. Note that there is actually a second marble fr. (113bis), which is not mentioned outside the catalogue itself. There is a K. Loutatiou Dorou known in another Liparitan inscr. (I.Lipara 705: ML II, p.52, cf. Calderone, Diz. Epig. IV (1964), p.1409.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1995\u003C/date>\n     