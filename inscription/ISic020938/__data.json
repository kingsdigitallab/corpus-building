 2012-->\n                                \u003C/support>\n                                \u003Ccondition ana=\"#condition.fragment\"/>\n                            \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\n                                    \u003Crs ana=\"#execution.scratched\" ref=\"https://www.eagle-network.eu/voc/writing/lod/9.html\">scratched\u003C/rs>\n                                    \u003Cp>The graffito is placed on the preserved floor of the vessel.\u003C/p>\n                                    \u003Cdamage ana=\"#text_condition.complete\"/>\n                                \u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\n                                \u003Clocus from=\"line1\" to=\"line1\">Line 1\u003C/locus>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace cert=\"low\">\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462503\">Syracusae\u003C/placeName>\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2523083\">Siracusa\u003C/placeName>\n                                \u003Cgeo>37.0599531, 15.2932725\u003C/geo>\n                            \u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" evidence=\"material-context\" notBefore-custom=\"-0490\" notAfter-custom=\"-0480\" precision=\"low\">c. 490–480 BCE\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\">Found with Roman-period material in a fill layer in the eastern area of the excavation, outside the municipal building, in the archaeological complex of the Ionic temple at Ortygia, Syracuse\u003Cgeo>37.0599531, 15.2932725\u003C/geo>\u003C/provenance>\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">None; edited from the published photograph.\u003C/provenance>\n                        \u003Cprovenance/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n            \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n            \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                \u003Cxi:fallback>\n                    \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                \u003C/xi:fallback>\n            \u003C/xi:include>\n            \u003Cxi:include href=\"../alists/charDecl.xml\">\n                \u003Cxi:fallback>\n                    \u003Cp>ISicily glyphs authority list\u003C/p>\n                \u003C/xi:fallback>\n            \u003C/xi:include>\n        \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language>\n                \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.attribution.ownership\" cert=\"low\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Ownership\">ownership (?)\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2026-08-04\" who=\"#VM\">File added and EpiDoc encoding\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#VM\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname type=\"idionym\">Θέξενος\u003C/name>\u003C/persName>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\u003Cnote>Text after photograph (Guzzardi 2012, 174 fig. 16).\u003C/note>\u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#VM\">\n                \u003Cp>Thexenos.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" resp=\"#VM\">\n                \u003Cp>Thexenos.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\" resp=\"#VM\">\n                \u003Cp>The graffito preserves the personal name Θέξενος. Guzzardi compares this form with the well-attested name Θεόξενος. \n                    The name Θέξενος is listed by Pape and Benseler (1911, 274 s.v.) and is independently attested at Delphi in \u003Cref target=\"https://epigraphy.packhum.org/text/241664\">SGDI II 2156, l. 6\u003C/ref>, \n                    as Θέξενος Φιλαιτώλου. The use of Ξ for /ks/ is particularly significant for assigning the graffito to the Syracusan alphabet since contemporary \n                    Attic writing represented /ks/ with the digraph ΧΣ (see for comparison Dubois, IGDS I, no. 96). The forms of the other letters, including theta, \n                    are also compatible with the Syracusan alphabet, although they are not independently diagnostic. The palaeography therefore favours a Syracusan attribution \n                    for the inscription, despite the probable Attic manufacture of the kylix. An ownership function is plausible for an isolated personal name scratched \n                    on a drinking vessel, but it remains uncertain. Guzzardi regards the vessel as contemporary with the phase of the Ionic temple dated to c. 490–480 BCE, \n                    although it was recovered as residual material together with Roman-period finds in a fill layer east of the excavation and outside the municipal building. \n                    The same archaeological complex also preserves three signs incised on architectural blocks, recorded as \u003Cref target=\"http://sicily.classics.ox.ac.uk/inscription/ISic004516\">ISic004516\u003C/ref> (sigma, or possibly mu), \u003Cref target=\"http://sicily.classics.ox.ac.uk/inscription/ISic004517\">ISic004517\u003C/ref> (pi) and \u003Cref target=\"http://sicily.classics.ox.ac.uk/inscription/ISic004518\">ISic004518\u003C/ref> (theta).\n                    \u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Guzzardi\u003C/author>\n                        \u003Cdate>2012\u003C/date>\n                        \u003CcitedRange>173–174, fig. 16\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/RW3TZH5H\"/>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl type=\"corpus\" n=\"SGDI\">\n                        \u003CcitedRange>II 2156, l. 6\u003C/citedRange>\n                        \u003Cptr target=\"https://epigraphy.packhum.org/text/241664\"/>\n                    \u003C/bibl>\n                    \u003Cbibl n=\"Pape-Benseler\">\n                        \u003Cauthor>Pape\u003C/author>\n                        \u003Cauthor>Benseler\u003C/author>\n                        \u003Cdate>1911\u003C/date>\n                        \u003CcitedRange>274, s.v. Θέξενος\u003C/citedRange>\n                        \u003Cptr target=\"https://anemi.lib.uoc.gr/metadata/0/b/4/metadata-02-0000515.tkl\"/>\n                    \u003C/bibl>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>"],"uses":{"params":["slug"]}}]}
