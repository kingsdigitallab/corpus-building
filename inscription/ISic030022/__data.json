\"/>ροκες Ͱιπίας\n                    \u003Clb n=\"4\"/>\u003Corig>ΛΝ\u003Cunclear>Ο\u003C/unclear>Α\u003Cunclear>Ο\u003C/unclear>ΙΟΣ\u003C/orig> Σάσαμος\n                    \u003Clb n=\"5\"/>\u003Corig>\u003Cunclear>Α\u003C/unclear>Μ\u003Cunclear>Σ\u003C/unclear>ΙΤΥΣΤΓΔΝ\u003C/orig> Ἀρέτα\n                    \u003Clb n=\"6\"/>\u003Corig>ΠΑΓ\u003C/orig>\u003Cgap reason=\"illegible\" unit=\"character\" quantity=\"1\"/>\u003Corig>ΤΟΙ\u003C/orig>\u003Cgap reason=\"illegible\" unit=\"character\" quantity=\"2\"/>\u003Corig>ΕΡΙ\u003C/orig>\u003Cgap reason=\"illegible\" unit=\"character\" quantity=\"2\"/>\u003Corig>ΓΑ\u003C/orig>\n                \u003C/ab>\n            \u003C/div>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\" resp=\"#JP\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of Dubois IGDS 2.77\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"a.4\">\u003Cnote>Dubois notes as possible: ἔργα τοιούτο̄\u003C/note>\u003C/app>\n                    \u003Capp loc=\"a.6\">\u003Cnote>Dubois notes Ϙ as alternative for Ο\u003C/note>\u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\u003C!-- ISicDef0008 -->\n                \u003C!-- Arch. Class., 27, 1, 1975, p. 46-47, tav. 21, con facsimile (M. Pandolfini) \nArch. Class., 27,1, 1975, p. 47-49 (F. Crevatin)\nKokalos, 24, 1978, p. 48 (M. Lejeune)\nKokalos, 24, 1978, p. 63-68, fig. 1, con facsimile (A. Brugnone) -->\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n