iciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic030332.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/9QAG5NVA\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>Μακάριως ἀνὴρ ὥς οὐ\n                    \u003Clb n=\"2\" break=\"no\"/>κ αἰπορεύθ\u003Csupplied reason=\"omitted\">η\u003C/supplied> ἐν βουλῆ ἀσε\n                    \u003Clb n=\"3\" break=\"no\"/>βῶν καὶ ἐν ὡδῷ ἁμαρ\n                    \u003Clb n=\"4\" break=\"no\"/>τολν ο\u003Csupplied reason=\"lost\">ὐ\u003C/supplied>κ ἔστην καἰ ἐπὶ\n                    \u003Clb n=\"5\"/>καθέδρᾳ λυμῶν οὐκ αἰκά\n                    \u003Clb n=\"6\" break=\"no\"/>θισε ἀλλὰ ἐν νόμοͅ \u003Cexpan>\u003Cabbr>Κ\u003C/abbr>\u003Cex>υρίο\u003C/ex>\u003Cabbr>υ\u003C/abbr>\u003C/expan>\n                    \u003Clb n=\"7\"/>τὸ θέλη\u003Csupplied reason=\"lost\">μ\u003C/supplied>α αὐτοῦ καὶ ἐν τ νό\n                    \u003Clb n=\"8\" break=\"no\"/>μοͅ αὐτο\u003Csupplied reason=\"omitted\">ῦ\u003C/supplied> μελ\u003Csupplied reason=\"lost\">ε\u003C/supplied>τᾷ ἡμέρας καἰ\n                    \u003Clb n=\"9\"/>νυκτός καἰ ἔστε ὡ\u003Csupplied reason=\"lost\">ς\u003C/supplied> τὸ ξύλον τὸ\n                    \u003Clb n=\"10\"/>πεφυ\u003Csupplied reason=\"lost\">τευ\u003C/supplied>μέν\u003Csupplied reason=\"lost\">ον\u003C/supplied> τὸ παρὰ τὰς διεξόδο\u003Csupplied reason=\"omitted\">υ\u003C/supplied>ς\n                    \u003Clb n=\"11\"/>τῶν ὑδάτων \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/> τὼν καρπὸν αὐ\n                    \u003Clb n=\"12\" break=\"no\"/>τοῦ δό\u003Csupplied reason=\"lost\">σ\u003C/supplied>ει ἐν κερῷ αὐτοῦ καὶ πά\u003Csupplied reason=\"lost\">ν\u003C/supplied>τα\n                    \u003Clb n=\"13\"/>ἄν πυͅ κατευδοτίσετε \u003Csupplied reason=\"lost\">οὐχ\u003C/supplied>\n                    \u003Clb n=\"14\"/>οὕτο\u003Csupplied reason=\"lost\">ς\u003C/supplied> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"15\"/>ἀναλυτικὸν καἰ ἀ\n                    \u003Clb n=\"16\" break=\"no\"/>ποδιοκτικὸν\n                    \u003Clb n=\"17\"/>πρὸς πᾶσαν\n                    \u003Clb n=\"18\"/>φαρμακίαν\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of Rizzone 2023 after Libertini 1927\u003C/note>\n                    \u003C/app>\n                    \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp>\u003C!--No translation currently agreed-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp>\u003C!--No translation currently agreed-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\">\n                \u003Cp>Rizzone notes that lines 1-14 are a quotation of the book of Psalms, 1.1-4\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Libertini\u003C/author>\n                        \u003Cdate>1927\u003C/date>\n                        \u003CcitedRange>105-109\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/YW76PZNK\"/>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                      \u003Cauthor>Rizzone\u003C/author>\n                        \u003Cdate>2023\u003C/date>\n                        \u003CcitedRange>501-502 no.1\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/9QAG5NVA\"/>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
