3C/profileDesc>\n        \u003CrevisionDesc status=\"edited\">\n            \u003ClistChange>\n                \u003Cchange when=\"2025-12-01\" who=\"#JP\">Jonathan Prag created file based upon scheda provided by Rossana De Simone\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic002005_tiled.tif\" height=\"1362px\" width=\"836px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic002005.jpg\" height=\"1362px\" width=\"836px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"transliteration-primary\" xml:space=\"preserve\" xml:lang=\"xpu-Latn\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/EGNUE9CZ\">\n                \u003Cab>\n                    \u003Clb n=\"1\" style=\"text-direction:r-to-l\"/>qbr\n                    \u003Clb n=\"2\" style=\"text-direction:r-to-l\"/>\u003CpersName type=\"attested\">\u003Cname>ʿbd\n                    \u003Clb n=\"3\" style=\"text-direction:r-to-l\"/>mlqrt\u003C/name>\n                    \u003Clb n=\"4\" style=\"text-direction:r-to-l\"/>\u003Cunclear>bn\u003C/unclear> \u003Cgap reason=\"lost\" unit=\"character\" extent=\"unknown\"/>\u003C/persName>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnot