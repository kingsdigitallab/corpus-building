om=\"0301\" notAfter-custom=\"0500\">4th — 5th century CE\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\">Original discovery not recorded, but from Catania (Ferrua 1958, 172), previously thought to have come from Agrigento (Frey 1931, 122-125; Lifshitz 1963, 258-259).\u003C/provenance>\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">None\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n             \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n             \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                 \u003Cxi:fallback>\n                     \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                 \u003C/xi:fallback>\n             \u003C/xi:include>\n\t  \u003Cxi:include href=\"../alists/charDecl.xml\">\n\t     \u003Cxi:fallback>\n\t       \u003Cp>ISicily glyphs authority list\u003C/p>\n\t     \u003C/xi:fallback>\n\t   \u003C/xi:include>\n         \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language>\n                \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.funerary\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Funerary\">funerary\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n                \u003Cchange when=\"2020-03-07\" who=\"#JP\">Jonathan Prag added image and edited EpiDoc\u003C/change>\n            \t   \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n            \t   \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n            \t\u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n\t\t\u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n\t    \u003Cchange when=\"2020-12-18\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n            \t\u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2025-12-18\" who=\"#ZG\">Zoe Greblunas tagged names and persons\u003C/change>\n\t\t\t\t\u003Cchange when=\"2026-08-03\" who=\"#martaf\">Marta Fogagnolo revised the text encoding, added the translation and the commentary\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001547_tiled.tif\" height=\"2832px\" width=\"3764px\">\n                \u003Cdesc>Photo J. Prag, courtesy  Museo Archeologico Regionale Antonino Salinas\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001547.jpg\" height=\"2832px\" width=\"3764px\">\n                \u003Cdesc>Photo J. Prag, courtesy  Museo Archeologico Regionale Antonino Salinas\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname>Ζωσιμιανοῦ\u003C/name>\u003C/persName>\n                    \u003Clb n=\"2\"/>\u003Cw>ἀγορασεία\u003C/w>\n                    \u003Clb n=\"3\"/>\u003Cw>ἐνβάσεως\u003C/w>\n                    \u003Clb n=\"4\"/>\u003Cg ref=\"#menorah\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text checked against photograph, and as per IGPalermo\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#martaf\">\n                \u003Cp>Purchase of a loculus by Zosimianos.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#martaf\">\n                \u003Cp>The inscription records the purchase of a tomb by the deceased Zosimianos (the name is not attested elsewhere in Sicily, for the form \u003Cforeign xml:lang=\"grc\">Ζώσιμος\u003C/foreign>, see LGPN IIIA 191). The purchase is expressed by the noun \u003Cforeign xml:lang=\"grc\">ἀγορασεία\u003C/foreign>, a term attested at Catania (see IG XIV 530b, 552; SEG IV 60; Libertini 1931, 369 no. 1). The burial place was most likely a loculus, as suggested by the small dimensions of the slab, and is designated by the term \u003Cforeign xml:lang=\"grc\">ἔμβασις\u003C/foreign> (for this term at Catania, see IGCVO 866; SEG XLVI 1261; IMusCatania 176; cf. Ferrua 1958, 172). Formulae expressing the purchase of a tomb by means of \u003Cforeign xml:lang=\"grc\">ἀγορασία\u003C/foreign> followed by the genitive of the purchaser's — or, in funerary contexts, the deceased's — name are particularly common at Syracuse, but are also attested at Catania (SEG IV 60). In the present inscription, the genitive of the object purchased also appears, as is perhaps likewise the case in Libertini 1931, 369 no. 1 (see Korhonen 2004, 109 n. 152). The menorah engraved at the end of the inscription identifies it as belonging to the corpus of Jewish inscriptions. For the Jewish presence in Sicily, and particularly at Catania, during Late Antiquity, see Gebbia 1996.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"BE\">\n                        \u003Cdate>1964\u003C/date>\n                        \u003CcitedRange>631\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/77P5MNIR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001282\">https://biblio.inscriptiones.org/epig10001282\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IGMusPalermo\">\n                         \u003Cauthor>Manni Piraino\u003C/author>\n                         \u003Cdate>1973\u003C/date> \n                        \u003CcitedRange>10\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F66S4X3M\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000531\">https://biblio.inscriptiones.org/epig10000531\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"CIJ\">\n                        \u003CcitedRange>1.654\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/ACIZXQF2\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000582\">https://biblio.inscriptiones.org/epig10000582\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Frey\u003C/author>\n                        \u003Cdate>1931\u003C/date>\n                        \u003CcitedRange>122-125 ph\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R4EUTP6G\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001980\">https://biblio.inscriptiones.org/epig10001980\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Frey\u003C/author>\n                        \u003Cdate>1936\u003C/date>\n                        \u003CcitedRange>n. 654\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/ACIZXQF2\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000582\">https://biblio.inscriptiones.org/epig10000582\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Ferrua\u003C/author>\n                        \u003Cdate>1958\u003C/date>\n                        \u003CcitedRange>172\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/TUW3AZ49\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001998\">https://biblio.inscriptiones.org/epig10001998\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Lifshitz\u003C/author>\n                        \u003Cdate>1963\u003C/date>\n                        \u003CcitedRange>258-259 no.3\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/G88TZD3U\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001861\">https://biblio.inscriptiones.org/epig10001861\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Noy\u003C/author>\n                        \u003Cdate>1993\u003C/date>\n                        \u003CcitedRange>no.150\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/IBA4JMAN\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000166\">https://biblio.inscriptiones.org/epig10000166\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\n\t       \u003Cbibl>\n\t           \u003Cauthor>Gebbia\u003C/author>\n\t           \u003Cdate>1996\u003C/date>\n\t           \u003Cptr target=\"http://zotero.org/groups/382445/items/6GQC2QD5\"/>\n\t           \u003Cref target=\"https://biblio.inscriptiones.org/epig10000582\">https://biblio.inscriptiones.org/epig10000582\u003C/ref>\n\t       \u003C/bibl>\n\t       \u003Cbibl>\n\t           \u003Cauthor>Korhonen\u003C/author>\n\t           \u003Cdate>2004\u003C/date>\n\t           \u003CcitedRange>109 n. 152\u003C/citedRange>\n\t           \u003Cptr target=\"http://zotero.org/groups/382445/items/2EUC82DH\"/>\n\t           \u003Cref target=\"https://biblio.inscriptiones.org/epig10000028\">https://biblio.inscriptiones.org/epig10000028\u003C/ref>\n\t       \u003C/bibl>\n\t   \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
