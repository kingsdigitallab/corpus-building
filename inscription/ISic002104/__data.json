                      \u003Cdepth unit=\"cm\">13-11\u003C/depth>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition ana=\"#condition.complete\"/>\n\t\t    \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\u003Cp>Text is boustrophedon, running retrograde vertically from bottom to top up the right side of the front wide face, and then orthograde from top to bottom down the left side of the front face.\u003C/p>\n                                    \u003Crs ana=\"#execution.chiselled\" ref=\"http://www.eagle-network.eu/voc/writing/lod/1\">chiselled\u003C/rs>\n                                \t\u003Cdamage ana=\"#text_condition.complete\"/>\n\t\t\t\u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\u003Cp>The script employs the Euboean alphabet\u003C/p>\n                                \u003Clocus from=\"line1\" to=\"line2\">Line 1-2\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"40\" atMost=\"75\">40-75\u003C/height>\n                                \u003C/dimensions>\n                                \u003Clocus from=\"line1\" to=\"line2\">Interlineation line 1 to 2\u003C/locus>\n                                \u003Cdimensions type=\"interlinear\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462379\">Mylai\u003C/placeName>\t\t\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2524155\">Milazzo\u003C/placeName>\n                            \t\u003Cgeo>38.22008, 15.24023\u003C/geo>\n\t\t\u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" notBefore-custom=\"-0550\" notAfter-custom=\"-0501\" evidence=\"archaeological-context lettering\">The necropolis dates beginning of C6 to c.480 BCE, but lacking direct association with a tomb the stele cannot be more tightly dated; Boffa proposes second half of the sixth century on the basis of the letter forms.\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\">Found in excavations (US139) in 2022 of a section of the southern necropolis (cda San Giovanni), in close proximity to tomb 1040; undertaken  in anticipation of new building work\u003Cgeo>38.2148083,15.2328688\u003C/geo>\u003C/provenance>\u003C!-- approx location of the necropolis / cda San Giovanni -->\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">none\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n             \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n             \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                 \u003Cxi:fallback>\n                     \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                 \u003C/xi:fallback>\n             \u003C/xi:include>\n\t  \u003Cxi:include href=\"../alists/charDecl.xml\">\n\t     \u003Cxi:fallback>\n\t       \u003Cp>ISicily glyphs authority list\u003C/p>\n\t     \u003C/xi:fallback>\n\t   \u003C/xi:include>\n         \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language>\n                \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2025-12-17\" who=\"#JP\">Jonathan Prag created draft file\u003C/change>\n                \u003Cchange when=\"2026-07-10\" who=\"#JP\">Jonathan Prag revised file from ed. pr.\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!-- \n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic003399_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic003399.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/LHNEVHEN\">\n                \u003Cab>\n                    \u003Clb n=\"1\"  style=\"text-direction:r-to-l\"/>Ͱε̄γέ̄σιπός ἐ̄μ\n                    \u003Clb n=\"2\"  style=\"text-direction:l-to-r\"/>ι τὺ Βύλιος\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n               \u003ClistApp>\u003Capp>\u003Cnote>Text of Boffa\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>I am Hegesipos, (son) of Bulis\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" source=\"https://www.zotero.org/groups/382445/items/LHNEVHEN\">\n                \u003Cp>Hegesippos sono, (figlio) di Bulis\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>A number of other uninscribed stele have been found in the necropolis, but this is the only funerary inscription from ancient Mylai to date, and parallels in the Euboean alphabet in the region are rare.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Ollà\u003C/author>\n                        \u003Cauthor>Ravesi\u003C/author>\n                        \u003Cauthor>Sardella\u003C/author>\n                        \u003Cauthor>Zavettieri\u003C/author>\n                        \u003Cdate>2025\u003C/date>\n                        \u003CcitedRange>48 fig.40\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/JI6JALFR\"/>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Boffa\u003C/author>\n                       \u003Cdate>2025\u003C/date>\n                        \u003CcitedRange>608-621, figs. 1-2.\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/LHNEVHEN\"/>\n                    \u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
