 reason=\"lost\" extent=\"unknown\" unit=\"character\"/>κοι ͱότ\u003Csupplied reason=\"lost\">ι\u003C/supplied> κα λε̄ΐε̄ι ἀτέλε\n                    \u003Clb n=\"2\" break=\"no\" style=\"text-direction:l-to-r\"/>στα καὶ \u003Cunclear>ἔ\u003C/unclear>ργα καὶ ἔπεα ἐ͂\u003Csupplied reason=\"lost\">μ\u003C/supplied>\n                    \u003Clb n=\"3\" break=\"no\" style=\"text-direction:r-to-l\"/>\u003Csupplied reason=\"lost\">ε\u003C/supplied>\u003Cunclear>ν\u003C/unclear> καὶ \u003CpersName type=\"attested\">\u003Cname>Σικανᾶι\u003C/name>\u003C/persName> ἀτέλε\n                    \u003Clb n=\"4\" break=\"no\" style=\"text-direction:l-to-r\"/>στα \u003Cspace unit=\"character\" extent=\"unknown\"/> καὶ ἔργα καὶ ἔπε\u003Csupplied reason=\"lost\">α\u003C/supplied> \u003Csupplied reason=\"lost\">ͱό\u003C/supplied>\n                    \u003Clb n=\"5\" break=\"no\" style=\"text-direction:r-to-l\"/>\u003Csupplied reason=\"lost\">τ\u003C/supplied>ι κα λε̄ΐε̄ι\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Bettarini 2005\u003C/note>\n                    \u003C/app>\n                    \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\"> \u003C!-- add other editions -->\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1976-1977\u003C/date>\n                        \u003CcitedRange>26.1112\u003C/citedRange>\n                        \u003Cptr target=\"http