03Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.funerary\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Funerary\">funerary\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n                \u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n                \u003Cchange when=\"2020-12-22\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n                \u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2021-06-04\" who=\"#AR\">edited text division\u003C/change>\n                \u003Cchange when=\"2025-11-05\" who=\"#VF\">Victoria Fendel's lemmatizations were added from source CoNLL-U files using PyEpiDoc and associated scripts\u003C/change>\n                \u003Cchange when=\"2025-11-05\" who=\"#RC\">Robert Crellin integrated lemmatizations into EpiDoc\u003C/change>\n                \u003Cchange when=\"2025-12-23\" who=\"#ZL\">tagged names and persons\u003C/change>\n                \u003Cchange when=\"2026-08-03\" who=\"#martaf\">Marta Fogagnolo revised the text encoding, added the translation and the commentary\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001281_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001281.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#AR\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cw n=\"5\">\u003Csupplied reason=\"lost\">Θε\u003C/supplied>οις\u003C/w> \u003Cw n=\"10\">χθο\u003Csupplied reason=\"lost\">νίοις\u003C/supplied>\u003C/w>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cw n=\"15\">Ἀγαθη\u003C/w>\u003C/name>\u003C/persName> \u003Cw n=\"20\">χ\u003Csupplied reason=\"lost\">αῖρε\u003C/supplied>\u003C/w>\n                    \u003Clb n=\"3\"/>\u003Cw n=\"25\">\u003Csupplied reason=\"lost\">ἔ\u003C/supplied>ζησεν\u003C/w> \u003Cw n=\"30\">\u003Csupplied reason=\"lost\">ἔτη\u003C/supplied>\u003C/w> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"35\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#VF #RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"Θεός\">Θεοις\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"χθόνιος\">χθονίοις\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"Ἀγαθή\">Ἀγαθη\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"χαίρω\">χαῖρε\u003C/w>\n                    \u003Cw n=\"25\" lemma=\"ζάω\">ἔζησεν\u003C/w>\n                    \u003Cw n=\"30\" lemma=\"ἔτος\">ἔτη\u003C/w>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"35\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                \u003C/ab>\n            \u003C/div>\n           \u003Cdiv type=\"apparatus\" resp=\"#martaf\">\n                \u003Capp loc=\"line 1\">\u003Cnote>[Θε]οῖς Χθο[νίοις] Franz (ap. CIG III 5732c); Kaibel (ap. IG XIV 457)\u003C/note>\u003C/app>\n                \u003Capp loc=\"line 2\">\u003Cnote>Ἀγάθη χ[αῖρε] Kaibel (ap. IG XIV 457); ἡ δεῖνα ἀ]γάθη Franz (ap. CIG III 5732c)\u003C/note>\u003C/app>\n                \u003Capp loc=\"line 3\">\u003Cnote>[ἔ]ζησεν [ἔτη ---]  Franz (ap. CIG III 5732c); Kaibel (ap. IG XIV 457)\u003C/note>\u003C/app>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#martaf\">\n                \u003Cp>To the Gods of the Underworld. Agathe, farewell! She lived for … years.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#martaf\">\n                \u003Cp>This epitaph is dedicated to a deceased female, Agathe, and preceeded by an invocation to the Gods of the Underworld, in a less usual form than the more typical \u003Cforeign xml:lang=\"grc\">Θεοῖς Καταχθονίοις\u003C/foreign> (cf. IG XIV 30 = \u003Cref target=\"https://sicily.classics.ox.ac.uk/inscription/ISic000847\">ISic000847\u003C/ref>, IG XIV 49 = \u003Cref target=\"https://sicily.classics.ox.ac.uk/inscription/ISic000866\">ISic000866\u003C/ref>, both from Siracusa). The unabbreviated form is found before the Augustan age, but occasionally also after: this seems to be the case, if at l. 2 we read the name Agathe (and not an adjective referred to the deceased, with the name in the lacuna, as Franz ap. CIG III 5732c).  \u003Cforeign xml:lang=\"grc\">Ἀγάθη\u003C/foreign> is a name which recurs in Catania in several palaeochristian epitaphs: IG XIV 523 (= \u003Cref target=\"https://sicily.classics.ox.ac.uk/inscription/ISic001343\">ISic001343\u003C/ref>), IG XIV 524 (= \u003Cref target=\"https://sicily.classics.ox.ac.uk/inscription/ISic001334\">ISic001344\u003C/ref>), IG XIV 525 (= \u003Cref target=\"https://sicily.classics.ox.ac.uk/inscription/ISic000964\">ISic000964\u003C/ref>), IG XIV 552 (\u003Cref target=\"https://sicily.classics.ox.ac.uk/inscription/ISic001371\">ISic001371\u003C/ref>). The age, expressed in numerals, is lost in the final lacuna. \u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IG\">\n                        \u003Cauthor>Kaibel\u003C/author>\n                        \u003Cdate>1890\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"https://clio.columbia.edu/catalog/6873760\">457\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Q2SBPG9F\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001072\">https://biblio.inscriptiones.org/epig10001072\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"CIG\">\n                        \u003Cauthor>Franz\u003C/author>\n                        \u003Cdate>1853\u003C/date>\n                        \u003CcitedRange>5732c\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/TQMVHEVL\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001250\">https://biblio.inscriptiones.org/epig10001250\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
