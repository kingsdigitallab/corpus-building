eason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"5\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Cw n=\"10\" lemma=\"Aulus\">Auli\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"filius\">filio\u003C/w>\n                    \u003Cw n=\"30\" lemma=\"Quirina\">Quirina\u003C/w>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"35\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"40\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Cw n=\"45\" lemma=\"Eucarpia\">Eucarpia\u003C/w>\n                    \u003Cw n=\"55\" lemma=\"uxor\">uxor\u003C/w>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"60\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of Manganaro 1989 controlled against the stone.\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"1\">\n                        \u003Cnote>Manganaro did not record the interpuncts. The space for QV[IR] is extremely limited, and can only have been present if combined in ligature\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"2\">\n                        \u003Cnote>Manganaro did not record the interpunct. Again, the space to complete VX[OR] is limited, although not impossible, and so perhaps abbreviated.\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003Cli