upplied reason=\"lost\">ir\u003C/supplied>\u003C/abbr>\u003Cex>ina\u003C/ex>\u003C/expan>\u003C/w>\u003C/orgName> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"35\"/>\n                    \u003Clb n=\"2\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"40\"/> \u003Cname>\u003Cw n=\"45\">\u003Csupplied reason=\"lost\" cert=\"low\">Euc\u003C/supplied>arpia\u003C/w>\u003C/name> \u003Cg ref=\"#interpunct\" n=\"50\">·\u003C/g> \u003Cw n=\"55\">ux\u003Csupplied reason=\"lost\">or\u003C/supplied>\u003C/w> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"60\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#RC\">\n                \u003Cab>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"5\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Cw n=\"10\" lemma=\"Aulus\">Auli\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"filius\">filio\u003C/w>\n                    \u003Cw n=\"30\" lemma=\"Quirina\">Quirina\u003C/w>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"35\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"40\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Cw n=\"45\" lemma=\"Eucarpia\">Eucarpia\u003C/w>\n                    \u003Cw n=\"55\" lemma=\"uxor\">uxor\u003C/w>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" n=\"60\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of Manganaro 1989 controlled against the stone.\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"1\">\n                        \u003Cnote>Manganaro did not record the interpuncts. The space for QV[IR] is extremely limited, and can only have been present if combined in ligature\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"2\">\n                        \u003Cnote>Manganaro did not record the interpunct. Again, the space to complete VX[OR] is limited, although not impossible, and so perhaps abbreviated.\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003CcitedRange>1989.0338k\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R46KDTZX\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001283\">https://biblio.inscriptiones.org/epig10001283\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Manganaro\u003C/author>\n                        \u003Cdate>1989\u003C/date>\n                        \u003CcitedRange>165 no.19 fig.19\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/EZMBJ6GN\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001831\">https://biblio.inscriptiones.org/epig10001831\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Fasolo\u003C/author>\n                        \u003Cdate>2013\u003C/date>\n                        \u003CcitedRange>83 no.30 fig.56\u003C/citedRange>\n             