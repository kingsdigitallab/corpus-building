layout":49},{"p":50,"rs":51,"damage":59},"Four lines of text, filling the upper part of the plaque, and tending to slant upwards across each line. A Staurogram is inserted between the first two lines of text.",[52,56],{"_":53,"ana":54,"ref":55},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"_":57,"ana":58},"Rubrication, red","#execution.rubrication.red",{"ana":60},"#text_condition.incomplete",{"lettering":62,"dimensions":63},"Letters of somewhat irregular size and form. Alpha of cursive form, lunate epsilon and sigma, uncial omega, omicron of varying form.",[64,71,77,83,89,93,96],{"type":65,"l":66,"from":67,"to":67,"h":68,"unit":69,"atLeast":70,"atMost":43},"letterHeight","Line 1-1","line1","16-26","mm","16",{"type":65,"l":72,"from":73,"to":73,"h":74,"unit":69,"atLeast":75,"atMost":76},"Line 3","line3","14-27","14","27",{"type":65,"l":78,"from":79,"to":79,"h":80,"unit":69,"atLeast":81,"atMost":82},"Line 4","line4","13-25","13","25",{"type":65,"l":84,"from":85,"to":85,"h":86,"unit":69,"atLeast":87,"atMost":88},"Line 5","line5","11-29","11","29",{"type":90,"l":91,"from":67,"to":73,"h":92,"unit":69},"interlinear","Interlineation line 1 to 3","11-24",{"type":90,"l":94,"from":73,"to":79,"h":95,"unit":69},"Interlineation line 3 to 4","6-20",{"type":90,"l":97,"from":79,"to":85,"h":98,"unit":69},"Interlineation line 4 to 5","5-6",{"_":100,"notBefore":101,"notAfter":102},"Late Roman",275,500,[104,109],{"_":105,"type":106,"ref":107,"region":108},"Syracusae","ancient","http://pleiades.stoa.org/places/462503","Sicilia",{"_":110,"type":111,"ref":112,"region":108},"Siracusa","modern","http://sws.geonames.org/2523083",[114],[115,116],37.08415,15.27628,{"_":118,"type":119,"subtype":120,"geo":121,"geoCert":124},"According to Ferrua, extracted from beyond the end of the principal decumanus in the catacomb of S. Giovanni, and subsequently autopsied by him in Sept. 1970. Now in cassette 55, magazzino B, Mus. arch. reg. Siracusa","found","discovered",[122,123],37.0766385,15.2851219,"high",[122,123],{"_":127,"type":128,"subtype":129,"xml:id":130,"geo":17},"Flavio Santini, 2018-09-24","observed","autopsied","autopsy",[132,139],{"n":133,"url":134,"height":135,"width":136,"desc":137,"surfaceType":138},"screen","ISic002137_tiled.tif","3680px","5520px","I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2019-10-03","front",{"n":133,"url":140,"height":135,"width":136,"desc":137,"surfaceType":141},"ISic002137_rear_tiled.tif","rear","Sicily",{"_":144,"role":145,"ref":146,"museum":147},"Museo Archeologico Regionale Paolo Orsi","museum","http://sicily.classics.ox.ac.uk/museum/097",{"slug":148,"type":145,"name":144,"uri":146,"description":149,"location":150},"097","An outstanding collection of archaeological material. The collection ranges from Siracusa and the surrounding territory (Megara Hyblaia, Akrai, Kasmenai etc) to encompass all of eastern Sicily, reaching as far as Gela and Agrigento. The ground floor covers prehistory through to the end of the Classical period. Upstairs includes Hellenistic and Roman Syracuse and a display of material from the catacombs. A gallery displaying material from Hellenistic eastern Sicily is in preparation.",{"settlement":110,"region":110,"country":151,"address":152,"geo":153},"Italy","Viale Teocrito 66, 96100 - Siracusa",{"lat":154,"lon":155},37.07636989,15.2866213,{"_":157,"type":158},"107648","inventory",{"_":160,"mainLang":161,"languages":162},"Ancient Greek","grc",[160],{"type":164,"bibl":165},"edition",[166,175],{"author":167,"date":168,"citedRange":169,"ptr":170,"ref":171,"inscriptionDate":168,"title":172,"citation":173,"uri":174,"year":168},"Ferrua","1989","no. 207",{"target":171},"https://www.zotero.org/groups/382445/items/759ZXHKQ","Note e giunte alle iscrizioni cristiane antiche della Sicilia","\u003Cspan>Antonio Ferrua, \u003Ci>Note e giunte alle is