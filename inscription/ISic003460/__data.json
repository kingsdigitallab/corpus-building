twork.eu/voc/objtyp/lod/259\">plaque\u003C/objectType>\n                                    \u003Cdimensions>\u003C!--From silvestrini 2020-->\n                                        \u003Cheight unit=\"cm\">98\u003C/height>\n                                        \u003Cwidth unit=\"cm\">65\u003C/width>\n                                        \u003Cdepth unit=\"cm\">21\u003C/depth>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition/>\n\t\t    \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\u003Cp>The Latin text fills the preserved face in the upper half at least  to both margins, but is extremely worn in the lower parts\u003C/p>\n                                    \u003Crs ana=\"#execution.chiselled\" ref=\"http://www.eagle-network.eu/voc/writing/lod/1\">chiselled\u003C/rs>\n                                \t\u003Cdamage/>\n\t\t\t\u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\u003Cp>Tall narrow letters, implying a C2-3 AD date\u003C/p>\n                                \u003Clocus from=\"line1\" to=\"line7\">Lines 1-7\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"60\" atMost=\"75\">60-75\u003C/height>\u003C!-- measurement of Silvestrini 2020 -->\n                                \u003C/dimensions>\n                                \u003Clocus from=\"line1\" to=\"line2\">Interlineation\u003C/locus>\n                                \u003Cdimensions type=\"interlinear\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                  