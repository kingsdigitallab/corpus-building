003Cauthority>I.Sicily\u003C/authority>\n                \u003Cidno type=\"filename\">ISic003460\u003C/idno>\n                \u003Cidno type=\"TM\">644937\u003C/idno>\n                \u003Cidno type=\"EDR\"/>\n                \u003Cidno type=\"EDH\"/>\n                \u003Cidno type=\"EDCS\"/>\n                \u003Cidno type=\"PHI\"/>\n                \u003Cidno type=\"URI\">http://sicily.classics.ox.ac.uk/inscription/ISic003460\u003C/idno>\n                \u003Cidno type=\"DOI\" when=\"2020-12-18\">10.5281/zenodo.4358556\u003C/idno>\n                \u003Cavailability>\n                    \u003Clicence target=\"http://creativecommons.org/licenses/by/4.0/\">Licensed under a Creative\n                        Commons-Attribution 4.0 licence.\n                    \u003C/licence>\n                \u003C/availability>\n            \u003C/publicationStmt>\n            \u003CsourceDesc>\n                \u003CmsDesc>\n                    \u003CmsIdentifier>\n                        \u003Ccountry>Italy\u003C/country>\n                        \u003Cregion>Sicily\u003C/region>\n                        \u003Csettlement>Marsala\u003C/settlement>\n                        \u003Crepository role=\"museum\" ref=\"http://sicily.classics.ox.ac.uk/museum/108\">Museo archeologico regionale Lilibeo Marsala - Baglio Anselmi\u003C/repository>\n                        \u003C!--No inventory number found-->\n                        \u003C!--Adding location for old id numbers if available-->\n                        \u003CaltIdentifier>\n                            \u003Csettlement/>\n                            \u003Crepository/>\n                            \u003Cidno type=\"old\"/>\n                        \u003C/altIdentifier>\n                    \u003C/msIdentifier>\n                    \u003CmsContents>\n                        \u003CtextLang mainLang=\"la\">Latin\u003C/textLang>\n                    \u003C/msContents>\n                    \u003CphysDesc>\n                        \u003CobjectDesc>\n                            \u003CsupportDesc>\n                                \u003Csupport>\u003Cp>A thick slab of local, pinkish, limestone; the upper part has a rounded form, consequent upon re-use in antiquiry for the covering of a large drain. The surface is extremely worn, especially on the lower and right side of the face.\u003C/p>\n                                    \u003Cmaterial ana=\"#material.inorganic.stone.sedimentary_rock.limestone.calcilutite.white.calcare-lucidabile_bianco_tipo-scaglia #material.inorganic.stone.sedimentary_rock.limestone.calcilutite.white.calcare-lucidabile_bianco_lattimusa\" type=\"stone.limestone.polishable.white\" subtype=\"calcare_bianco_tipo-scaglia|calcare_bianco_scaglia\" resp=\"#Coccato\" ref=\"http://www.eagle-network.eu/voc/material/lod/66.html\">compact whitish limestone with chonchoidal fracture, veins and stylolites, likely tipo scaglia (SCA, AMM) (wackestone with planktonic foraminifera: globigerinoids, globotruncanids and fine calcite veins) (identification based on pXRF, digital microscopy, XRD, optical microscopy)\u003Cnote> Petrographic imagery at \u003Cref target=\"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic003460\">https://iiif.csad.ox.ac.uk/viewer/isicily/ISic003460\u003C/ref>\u003C/note>\u003C/material>\n                                    \u003CobjectType ana=\"#object.plaque\" ref=\"http://www.eagle-network.eu/voc/objtyp/lod/259\">plaque\u003C/objectType>\n                                    \u003Cdimensions>\u003C!--From silvestrini 2020-->\n                                        \u003Cheight unit=\"cm\">98\u003C/height>\n                                        \u003Cwidth unit=\"cm\">65\u003C/width>\n                                        \u003Cdepth unit=\"cm\">21\u003C/depth>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition/>\n\t\t    \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\u003Cp>The Latin text fills the preserved face in the upper half at least  to both margins, but is extremely worn in the lower parts\u003C/p>\n                                    \u003Crs ana=\"#execution.chiselled\" ref=\"http://www.eagle-network.eu/voc/writing/lod/1\">chiselled\u003C/rs>\n                                \t\u003Cdamage/>\n\t\t\t\u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\u003Cp>Tall narrow letters, implying a C2-3 AD date\u003C/p>\n                                \u003Clocus from=\"line1\" to=\"line7\">Lines 1-7\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"60\" atMost=\"75\">60-75\u003C/height>\u003C!-- measurement of Silvestrini 2020 -->\n                                \u003C/dimensions>\n                                \u003Clocus from=\"line1\" to=\"line2\">Interlineation\u003C/locus>\n                                \u003Cdimensions type=\"interlinear\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462281\">Lilybaeum\u003C/placeName>\t\t\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/6542148\">Marsala\u003C/placeName>\n                            \t\u003Cgeo>37.80355, 12.4379\u003C/geo>\n\t\t\u003C/origPlace>\n          