C/desc>\n                  \u003C/graphic>\n                  \u003Cgraphic n=\"print\" url=\"ISic010019_profile_tiled.jpg\" height=\"2267px\" width=\"3024px\">\n                      \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n                  \u003C/graphic>\n              \u003C/surface>\n      \u003C/facsimile>\n      \u003Ctext>\n          \u003Cbody>\n              \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\" resp=\"#IG\" source=\"#autopsy\">\n                      \u003Cdiv type=\"textpart\" subtype=\"lamina\"> \u003C!-- remove corresp attribute from textparts -->\n                             \u003Cab>\n                                 \u003Clb n=\"1\" style=\"text-direction:r-to-l\"/>\u003Cexpan>\u003Cabbr>Caecilior\u003C/abbr>\u003Cex>um\u003C/ex>\u003C/expan> Serv   \n                                 \u003Clb n=\"2\" style=\"text-direction:r-to-l\" break=\"no\"/>iliani et Potiti \n                                 \u003Clb n=\"3\" style=\"text-direction:r-to-l\"/>Herenniani \u003Cexpan>\u003Cabbr>iun\u003C/abbr>\u003Cex>ioris\u003C/ex>\u003C/expan>\n                             \u003C/ab>\n                      \u003C/div>\n                  \u003C/div>\n              \u003Cdiv type=\"apparatus\">\n                  \u003ClistApp>\n                      \u003Capp>\u003Cnote>Text from autopsy.\u003C/note>\u003C/app>\n                  \u003C/listApp>\n              \u003C/div>\n              \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#IG\">\n                  \u003Cp>of Caecilii Servilianus and Potitus (and?) Herennianus the younger.\u003C/p>\n              \u003C/div>\n              \u003Cdiv type=\"translation\" xml:lang=\"it\" resp=\"#IG\">\n                  \u003Cp>dei Caecilii Servilianus e Potitus (e?) Herennianus il giovane.\u003C/p>\n              \u003C/div>\n              \u003Cdiv type=\"commentary\">\n                  \u003Cp xml:lang=\"en\">Family company, composed of two or three members, depending on whether one wants to recognise one - Potiti Herenniani iun(oris) - or two - Potiti (et) Herenniani iun(ioris) - distinct persons in the second part of the text.\u003C/p>\n              \u003C/div>\n              \u003Cdiv type=\"bibliography\">\n                  \u003ClistBibl type=\"edition\"> \u003C!-- change to \"discussion\" where applicable; , can have two listBibl, one with each type -->\n                      \u003Cbibl type=\"corpus\" n=\"CIL\">\n                          \u003CcitedRange>10.8059.91\u003C/citedRange>\n                           \u003Cptr target=\"http://zotero.org/groups/382445/items/GQN8UZSI\"/>\n                      \u003C/bibl>\n                      \u003Cbibl>\n                          \u003Cauthor>Libertini\u003C/author>\n                          \u003Cdate>1930\u003C/date>\n                          \u003CcitedRange>143\u003C/citedRange>\n                          \u003Cptr target=\"http://zotero.org/groups/382445/items/SKUU2R8X\"/>\n                      \u003C/bibl>\n                      \u003Cbibl>\n                          \u003Cauthor>Manganaro Perrone\u003C/author>\n                          \u003Cdate>2006\u003C/date>\n                          \u003CcitedRange>18, no. 3\u003C/citedRange>\n                          \u003Cptr target=\"http://zotero.org/groups/382445/items/GP8C6MAM\"/>\n                      \u003C/bibl>\n                      \u003Cbibl>\n                          \u003Cauthor>Gradante\u003C/author>\n                          \u003Cdate>2026\u003C/date>\n                          \u003CcitedRange>no. 11\u003C/citedRange>\n                      \u003C/bibl>                  \n                  \u003C/listBibl>\n              \u003C/div>\n          \u003C/body>\n      \u003C/text>\n\u003C/TEI>             \n"],"uses":{"params":["slug"]}}]}
