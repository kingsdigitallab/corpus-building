interpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Corig>ΦΕ\u003C/orig>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"2\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003Corig>ΜΕΘΕΞ\u003C/orig> \u003Cexpan>\u003Cabbr>ἔξελθ\u003C/abbr>\u003Cex>ε\u003C/ex>\u003C/expan> διάβο\u003Chi rend=\"subscript\">\u003Cunclear>λ\u003C/unclear>ε\u003C/hi>\n                    \u003Clb n=\"3\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/> \u003CpersName type=\"divine\">\u003Cname>\u003Chi rend=\"supraline\">Ἀδωνα\u003C/hi>\u003Csupplied reason=\"omitted\">ι\u003C/supplied>\u003C/name>\u003C/persName> \u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\n                    \u003Clb n=\"4\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/> \u003Corig>Ε\u003C/orig>\u003Cgap reason=\"lost\" unit=\"character\" quantity=\"1\"/>\u003Corig>Ι\u003C/orig> \u003CpersName type=\"divine\">\u003Cname>Σα\n                    \u003Clb n=\"5\" break=\"no\"/>βαὼθ\u003C/name>\u003C/persName> \u003Corig>Α\u003Cunclear>Ρ\u003C/unclear>ΑΚΙΑ\u003C/orig>\n                    \u003Clb n=\"6\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cg ref=\"#sign_uninterpreted\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text of Pugliese Carratelli\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C/p>\n            \u003C/div>\n            \u003Cdiv typ