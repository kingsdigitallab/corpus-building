e=\"edition\" subtype=\"simple-lemmatized\" resp=\"#VF #RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"ἀπό\">ἀπὸ\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"ὁ\">τοῦ\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"praetorium\">πρετωρίου\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"κατάθεσις\">κατάθεσις\u003C/w>\n                    \u003Cspace extent=\"unknown\" unit=\"character\" n=\"25\"/>\n                    \u003Cw n=\"30\" lemma=\"Aprilis\">Ἀπριλίων\u003C/w>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"line\" n=\"35\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Corig n=\"40\">ΝΙΛΑ\u003C/orig>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"line\" n=\"45\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"line\" n=\"50\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                    \u003Corig n=\"55\">ΛΑΣ\u003C/orig>\n                    \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"line\" n=\"60\">\u003Cdesc>[-?-]\u003C/desc>\u003C/gap>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Agnello 1956\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--frag; The text in l.1 after the vacat is actually 10.5 cm distant from the former text. The letters in this second part are 6 cm high, while those in the first segment are smaller. Everything would suggest that this second part belongs to another inscription, but the lacunosity of the text does not allow us to be certain (see Agnello 1956, p. 20, who nevertheless tries to integrate as if it were a single text).-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1962\u003C/date>\n                        \u003CcitedRange>18.0405\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"BE\">\n                        \u003Cdate>1960\u003C/date>\n                        \u003CcitedRange>461\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/77P5MNIR\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001282\">https://biblio.inscriptiones.org/epig10001282\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Agnello\u003C/author>\n                        \u003Cdate>1956\u003C/date>\n                        \u003CcitedRange>20-21e ph\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/NW5FES25\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002207\">https://biblio.inscriptiones.org/epig10002207\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n