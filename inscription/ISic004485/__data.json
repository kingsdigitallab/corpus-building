//relaxng.org/ns/structure/1.0\"?>\n\u003C?xml-model href=\"../schematron/ircyr-checking.sch\" schematypens=\"http://purl.oclc.org/dsdl/schematron\"?>\n\u003CTEI xmlns=\"http://www.tei-c.org/ns/1.0\"\n    xml:lang=\"en\"\n    xmlns:xi=\"http://www.w3.org/2001/XInclude\">\n    \u003CteiHeader>\n        \u003CfileDesc>\n            \u003CtitleStmt>\n                \u003Ctitle>Dedication by an Akragantine at Delphi\u003C/title>\n                \u003Ceditor ref=\"#JP\">Jonathan Prag\u003C/editor>\n                \u003Cprincipal ref=\"#VM\">Valentina Mignosa\u003C/principal>\n                \u003Cfunder>John Fell OUP Research Fund\u003C/funder>\n                \u003Cfunder>\n                    \u003Cref target=\"https://cordis.europa.eu/project/id/885040\">ERC Advanced Grant no.885040\u003C/ref>\n                \u003C/funder>\n                \u003CrespStmt>\n                    \u003Cname xml:id=\"JP\" ref=\"https://orcid.org/0000-0003-3819-8537\">Jonathan Prag\u003C/name>\n                    \u003Cresp>Project direction, template development, general editing\u003C/resp>\n                \u003C/respStmt>\n                \u003CrespStmt>\n                    \u003Cname xml:id=\"SS\" ref=\"https://orcid.org/0000-0003-3914-9569\">Simona Stoyanova\u003C/name>\n                    \u003Cresp>Standardisation of template and tidying up encoding\u003C/resp>\n                \u003C/respStmt>\n                \u003CrespStmt>\n                    \u003Cname xml:id=\"VM\" ref=\"https://orcid.org/0000-0002-7122-2511\">Valentina Mignosa\u003C/name>\n                    \u003Cresp>Bibliographic research, metadata, editing and EpiDoc encoding\u003C/resp>\n                \u003C/respStmt>\n            \u003C/titleStmt>\n            \u003CpublicationStmt>\n                \u003Cauthority>I.Sicily\u003C/authority>\n                \u003Cidno type=\"filename\">ISic004485\u003C/idno>\n                \u003Cidno type=\"TM\">931327\u003C/idno>\n                \u003Cidno type=\"EDR\"/>\n                \u003Cidno type=\"EDH\"/>\n                \u003Cidno type=\"EDCS\"/>\n                \u003Cidno type=\"PHI\">329475\u003C/idno>\n                \u003Cidno type=\"URI\">http://sicily.classics.ox.ac.uk/inscription/ISic004485\u003C/idno>\n                \u003Cidno type=\"DOI\"/>\n                \u003Cavailability>\n                    \u003Clicence target=\"http://creativecommons.org/licenses/by/4.0/\">Licensed under a Creative Commons-Attribution 4.0 licence.\u003C/licence>\n                \u003C/availability>\n            \u003C/publicationStmt>\n            \u003CsourceDesc>\n                \u003CmsDesc>\n                    \u003CmsIdentifier>\n                        \u003Ccountry>Greece\u003C/country>\n                        \u003Cregion>Phocis\u003C/region>\n                        \u003Csettlement>Delphi\u003C/settlement>\n                        \u003Crepository role=\"museum\">Archaeological Museum of Delphi\u003C/repository>\n                        \u003Cidno type=\"inventory\">5098\u003C/idno>\n                        \u003CaltIdentifier>\n                            \u003Csettlement/>\n                            \u003Crepository/>\n                            \u003Cidno type=\"old\"/>\n                        \u003C/altIdentifier>\n                    \u003C/msIdentifier>\n                    \u003CmsContents>\n                        \u003CtextLang mainLang=\"grc\">Ancient Greek\u003C/textLang>\n                    \u003C/msContents>\n                    \u003CphysDesc>\n                        \u003CobjectDesc>\n                            \u003CsupportDesc>\n                                \u003Csupport>\n                                    \u003Cp>Fragment of an elongated dedicatory base in Saint-Elijah limestone, broken on the left, right and back. The upper bed has setting holes for at least two bronze statues and at least two stelae.\u003C/p>\n                                    \u003Cmaterial ana=\"#material.stone.limestone\" subtype=\"unverified\" ref=\"http://www.eagle-network.eu/voc/material/lod/66.html\">limestone\u003C/material>\n                                    \u003CobjectType ana=\"#object.base\" ref=\"http://www.eagle-network.eu/voc/objtyp/lod/57.html\">base\u003C/objectType>\n                                    \u003Cdimensions>\n                                        \u003Cheight unit=\"cm\">28\u003C/height>\n                                        \u003Cwidth unit=\"cm\">83\u003C/width>\n                                        \u003Cdepth unit=\"cm\">62\u003C/depth>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition ana=\"#condition.fragment\"/>\n                            \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\n                                    \u003Cp>Two lines are inscribed on the front face. Line 1 is cut immediately below the upper edge.\u003C/p>\n                                    \u003Crs ana=\"#execution.chiselled\"\n                                        ref=\"http://www.eagle-network.eu/voc/writing/lod/1\">chiselled\u003C/rs>\n                                    \u003Cdamage ana=\"#text_condition.incomplete #text_condition.partly_illegible\"/>\n                                \u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\n                                \u003Cp>Daux attributed the lettering to an Akragantine stonecutter on the basis of the form of gamma.\u003C/p>\n                                \u003Clocus from=\"line1\" to=\"line2\">Lines 1–2\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"25\" atMost=\"35\">25–35\u003C/height>\n                                \u003C/dimensions>\n                                \u003Clocus from=\"line1\" to=\"line2\">Interlineation\u003C/locus>\n                                \u003Cdimensions type=\"interlinear\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"7\" atMost=\"8\">7–8\u003C/height>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\n                                \u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462086\">Agrigentum\u003C/placeName>\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/6541860\">Agrigento\u003C/placeName>\n                                \u003Cgeo>37.32084, 13.58876\u003C/geo>\n                            \u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" notBefore-custom=\"-0500\" notAfter-custom=\"-0475\" evidence=\"lettering\">500–475 BCE\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\">Found at \u003CplaceName ref=\"https://pleiades.stoa.org/places/540726\">Delphi\u003C/placeName>, Greece; the precise findspot and date of discovery are not recorded.\u003Cgeo>38.482289, 22.501169\u003C/geo>. Daux examined the stone in 1922 and saw it in the same depot until 1926, but could not locate it in 1933 or 1936. It was subsequently rediscovered and was kept in the epigraphic depot of the West Stoa by 1959. Jeffery 1990 records it as Delphi Museum inv. 5098.\u003C/provenance>\n\u003Cprovenance type=\"observed\" subtype=\"autopsied\">None\u003C/provenance>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n            \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n            \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                \u003Cxi:fallback>\n                    \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                \u003C/xi:fallback>\n            \u003C/xi:include>\n            \u003Cxi:include href=\"../alists/charDecl.xml\">\n                \u003Cxi:fallback>\n                    \u003Cp>ISicily glyphs authority list\u003C/p>\n                \u003C/xi:fallback>\n            \u003C/xi:include>\n        \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language>\n                \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.dedication\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Dedication\">dedication\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2026-07-30\" who=\"#VM\">Creation of file and EpiDoc encoding from published sources\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#VM\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003Corig>\u003Cunclear>Ι\u003C/unclear>ΟΣ\u003C/orig> \u003Cspace extent=\"unknown\" unit=\"character\"/> \u003Corig>\u003Cunclear>Ι\u003C/unclear>Α\u003Cunclear>Ι\u003C/unclear>\u003C/orig> \u003Cspace extent=\"unknown\" unit=\"character\"/> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003Corig>\u003Cunclear>ΛΣΙΛ\u003C/unclear>\u003C/orig>\n                    \u003Clb n=\"2\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003CplaceName type=\"ethnic\" ref=\"http://pleiades.stoa.org/places/462086\">\u003Csupplied reason=\"lost\">Ἀκρ\u003C/supplied>\u003Cunclear>α\u003C/unclear>γαντῖνος\u003C/placeName>.\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Arena 2002 (IGASMG II² 93).\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"line 1\">\n                        \u003Cnote>Daux 1937 tentatively interpreted the surviving traces as the end of a personal name in \u003Cforeign xml:lang=\"grc\">-ιος\u003C/foreign> or \u003Cforeign xml:lang=\"grc\">-ος\u003C/foreign>, followed perhaps by the patronymic \u003Cforeign xml:lang=\"grc\">Μνασία\u003C/foreign>.\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#VM\">\n                \u003Cp>[— — —], an Akragantine.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>The ethnic Ἀκραγαντῖνος is the only securely interpretable element. Daux regarded the text as a dedication rather than an artist's signature and attributed the form of gamma to an Akragantine stonecutter. \n                    Bousquet interpreted the holes on the upper bed as settings for at least two bronze statues and at least two stelae, suggesting an elongated base carrying a multi-figure dedication.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1962\u003C/date>\n                        \u003CcitedRange>18.0210\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003C/bibl>\n                        \u003Cbibl>\n                            \u003Cauthor>Daux\u003C/author>\n                            \u003Cdate>1937\u003C/date>\n                            \u003CcitedRange>60–61, pl. VII\u003C/citedRange>\n                            \u003Cptr target=\"http://zotero.org/groups/382445/items/BWAWZMS3\"/>\n                        \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Bousquet\u003C/author>\n                        \u003Cdate>1959\u003C/date>\n                        \u003CcitedRange>150, n. 2\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/VB5QSXQK\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001375\">https://biblio.inscriptiones.org/epig10001375\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>De Waele\u003C/author>\n                        \u003Cdate>1971\u003C/date>\n                        \u003CcitedRange>40 no. 9\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/CXHAXNBQ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002040\">https://biblio.inscriptiones.org/epig10002040\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"LSAG\">\n                        \u003Cauthor>Jeffery and Johnston\u003C/author>\n                        \u003Cdate>1990\u003C/date>\n                        \u003CcitedRange>278 no. 64\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/QUWGZA84\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000678\">https://biblio.inscriptiones.org/epig10000678\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IGDS\">\n                        \u003Cauthor>Dubois\u003C/author>\n                        \u003Cdate>1989\u003C/date>\n                        \u003CcitedRange>\n                        \u003Cref target=\"http://www.persee.fr/doc/efr_0000-0000_1989_cat_119_1\">182b\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/RWXNUFEX\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000187\">https://biblio.inscriptiones.org/epig10000187\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IGASMG II²\">\n                        \u003Cauthor>Arena\u003C/author>\n                        \u003Cdate>2002\u003C/date>\n                        \u003CcitedRange>93\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/65P7AM6N\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001373\">https://biblio.inscriptiones.org/epig10001373\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>"],"uses":{"params":["slug"]}}]}
