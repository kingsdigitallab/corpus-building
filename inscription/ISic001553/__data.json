   \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cw n=\"5\">Ἰθι\u003Csupplied reason=\"undefined\" evidence=\"previouseditor\">ο\u003C/supplied>κασία\u003C/w>\u003C/name>\u003C/persName> \u003Cw n=\"10\">ἥρ\u003Cunclear>υ\u003C/unclear>σα\u003C/w> \u003Cw n=\"15\">ἀγαθά\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#DD #RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"Ἰθιοκασία\">Ἰθιοκασία\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"ἥρυς\">ἥρυσα\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"ἀγαθός\">ἀγαθά\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text checked against photograph in Vento\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"line 1\">\n                        \u003Cnote>Gabrici: ΙΘΙΟΚΑΣΙΑ ΗΡΥΣΑ ΑΓΑΘΑ; Manni Piraino: Ἰθι[. .]ασία ἥρ[υ]σα ἀγαθά\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>Photograph in Vento is excellent and it is possible to see traces of almost the entire text, as originally read by Gabrici.\n                    \u003C!--painted inscr., with banqueting scene. Has another variant on the feminine form of heros, apparently, while the name is incomplete, but is, Bisi suggests, of Semitic, theophoric origin.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl