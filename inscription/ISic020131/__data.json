istChange>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2020-12-07\" who=\"#VM\">Valentina Mignosa added metadata, text\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic020131_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic020131.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"xly-Grek\"> \n                    \u003Cab>\n                        \u003Clb n=\"1\"/>\u003Cmeasure type=\"currency\" unit=\"obolos\">\u003Cnum value=\"1\">\u003Cg type=\"val03\"/>\u003C/num>\u003C/measure> \u003Cnote>uncertain interpretation\u003C/note>\n                        \u003Clb n=\"2\"/>\u003Cexpan>\u003Cabbr>λε̄́\u003C/abbr>\u003Cex>κυθος\u003C/ex>\u003C/expan>\n                    \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" xml:space=\"preserve\" subtype=\"transliteration\" xml:lang=\"xly-Latn\">\n                \u003Cab/>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Agostiniani 1977 (IAS I)\u003C/note>\n                    \u003C/app>\n                    \u003Capp>\n                        \u003Cnote>Λεω, Alessio 1970\u003C/note>\n                    \u003C/app>\n                    \u003Capp>\n                        \u003Cnote>Λεω or Λεο-, Lejeune 1970\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp>\u003C!-- One lekythos (corresponding to the value of) one obol. -->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp>\u003C!-- Una lekythos (corrispondente al valore di) un obolo. -->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\">\n                \u003Cp>Abbreviation ΛΕ frequently used on Attic vases with the value of λήκυθος. However, there are no examples of this abbreviation associated with a value notation. Agostianiani suggests interpreting the alphabetical sign as a value notation (one obol), thus proposing to translate how: \"One lekythos (corresponding to the value of) one obol\". See also Hackl 1909, p.98.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IAS1\">\n                        \u003Cauthor>Agostiniani\u003C/author>\n                        \u003Cdate>1977\u003C/date>\n                        \u003CcitedRange>131\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/QR2S9AJ9\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002201\">https://biblio.inscriptiones.org/epig10002201\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Alessio\u003C/author>\n                        \u003Cdate>1970\u003C/date>\n                        \u003CcitedRange>60\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/5X3JK8SE\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002566\">https://biblio.inscriptiones.org/epig10002566\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Lejeune\u003C/author>\n                        \u003Cdate>1970\u003C/date>\n                        \u003CcitedRange>148, 161, 163\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/2H7NP37F\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001880\">https://biblio.inscriptiones.org/epig10001880\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Schmoll\u003C/author>\n                        \u003Cdate>1961\u003C/date>\n                        \u003CcitedRange>68\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/EBTAVEAP\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001602\">https://biblio.inscriptiones.org/epig10001602\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Tusa\u003C/author>\n                        \u003Cdate>1960\u003C/date>\n                        \u003CcitedRange>no.12\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/W57IFXNR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001542\">https://biblio.inscriptiones.org/epig10001542\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl>\n                        \u003Cauthor>Hackl\u003C/author>\n                        \u003Cdate>1909\u003C/date>\n                        \u003CcitedRange>98\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/4SCEIH8D\"/>\u003Cref target=\"https://biblio.inscriptiones.org/epig10002565\">https://biblio.inscriptiones.org/epig10002565\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
