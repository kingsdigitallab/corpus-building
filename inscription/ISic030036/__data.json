u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language> \n                \u003Clanguage ident=\"it\">Italian\u003C/language> \n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language> \n                \u003Clanguage ident=\"la\">Latin\u003C/language> \n                \u003Clanguage ident=\"he\">Hebrew\u003C/language> \n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language> \n                \u003Clanguage ident=\"xly\">Elymian\u003C/language> \n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>  \n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>  \n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.defixio\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Defixio\">defixio\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2021-06-09\" who=\"#VM\">Valentina Mignosa added basic metadata\u003C/change>\n                \u003Cchange when=\"2021-08-12\" who=\"#SN\">Savannah Neibart encoded inscription using data from ISicDef, supplemented by Orsi and other editions\u003C/change>\n                \u003Cchange when=\"2021-10-18\" who=\"#JP\">Jonathan Prag checked file and amended bibliography\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic030036_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic030036.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#SN\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname type=\"idionym\">Ἀριστο̄́ι\u003C/name>\u003C/persName>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname type=\"idionym\">Ἐπιείκης\u003C/name>\n                    \u003Clb n=\"3\"/>\u003CpersName type=\"attested\">\u003Cname type=\"patronym\">Φαΰλλο̄\u003C/name>\u003C/persName>\u003C/persName>\n                    \u003Clb n=\"4\"/>\u003CpersName type=\"attested\">\u003Cname type=\"idionym\">\u003Csupplied reason=\"lost\">Ἀ\u003C/supplied>ριστο̄́\u003Csupplied reason=\"omitted\">ι\u003C/supplied>\u003C/name> \n                    \u003Clb n=\"5\"/>\u003CpersName type=\"attested\">\u003Cname type=\"patronym\">\u003Cseg type=\"I\">Ματρ\u003C/seg>\u003Cgap reason=\"lost\" quantity=\"3\" unit=\"character\"/>\u003C/name>\u003C/persName>\u003C/persName>\n                    \u003Clb n=\"6\"/>\u003CpersName type=\"attested\">\u003Cname type=\"idionym\">\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003Cseg part=\"F\">ιας\u003C/seg>\u003C/name>\u003C/persName>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Arena.\u003C/note>\u003C!-- ISicDef no. 1 -->\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\">\n                \u003Cp>4-5. Incised upside down and probably added later; ΡΙΣΤΟ, tablet; Ἀριστο̄́ι (not identical to A. of L. 1, whose descent is not specified) plus patronymic (either Μάτρ[ο̄] from Μᾶτρος or Μάτρ[ιος] from Μᾶτρις) or matronymic (Ματρ[οῦς] from Ματρο̄́ι). (SEG)\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1988\u003C/date>\n                        \u003CcitedRange>38.0935\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Cordano\u003C/author>\n                        \u003Cdate>1988\u003C/date>\n                        \u003CcitedRange>14 no. 2\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F8BUYFFR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002411\">https://biblio.inscriptiones.org/epig10002411\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Curbera\u003C/author>\n                        \u003Cdate>1999\u003C/date>\n                        \u003CcitedRange>176 no. 7\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/9DL74VZN\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002060\">https://biblio.inscriptiones.org/epig10002060\u003C/ref>\u003C/bibl>\n                        \u003Cbibl type=\"corpus\" n=\"IGASM2[2]\">\n                            \u003Cauthor>Arena\u003C/author>\n                            \u003Cdate>2002\u003C/date>\n                            \u003CcitedRange>132\u003C/citedRange>\n                            \u003Cptr target=\"https://www.zotero.org/groups/382445/items/65P7AM6N\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001373\">https://biblio.inscriptiones.org/epig10001373\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Jordan\u003C/author>\n                        \u003Cdate>2000\u003C/date>\n                        \u003CcitedRange>18 no. 58\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GP888GFE\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001902\">https://biblio.inscriptiones.org/epig10001902\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IGDS2\">\n                        \u003Cauthor>Dubois\u003C/author>\n                        \u003Cdate>2008\u003C/date> \n                        \u003CcitedRange>61b\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/SM2KDHZC\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000160\">https://biblio.inscriptiones.org/epig10000160\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
