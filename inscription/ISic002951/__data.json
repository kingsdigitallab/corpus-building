lised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n                \u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n                \u003Cchange when=\"2020-12-23\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n                \u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2022-03-05\" who=\"#JP\">Jonathan Prag revised file from photographs and added images\u003C/change>\n                \u003Cchange when=\"2026-01-05\" who=\"#ZL\">tagged names and persons\u003C/change>\n                \u003Cchange when=\"2026-01-19\" who=\"#DD\">Dmitry Dundua's lemmatizations were added from source CoNLL-U files\u003C/change>\n                \u003Cchange when=\"2026-01-19\" who=\"#RC\">Robert Crellin integrated lemmatizations into EpiDoc using PyEpiDoc and associated scripts\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic02951_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>Photo J. Prag, courtesy Museo Mandralisca\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic002951.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>Photo J. Prag, courtesy Museo Mandralisca\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"screen\" url=\"ISic02951_copy1_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>Photo J. Prag, courtesy Museo Mandralisca\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic002951_copy1.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>Photo J. Prag, courtesy Museo Mandralisca\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"screen\" url=\"ISic002951_l3q_tiled.tif\" height=\"3178px\" width=\"3480px\">\n                \u003Cdesc>Photo J. Prag, courtesy Museo Mandralisca\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic002951_l3q.jpg\" height=\"3178px\" width=\"3480px\">\n                \u003Cdesc>Photo J. Prag, courtesy Museo Mandralisca\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname type=\"nomen\">\u003Cw n=\"5\">Πομπήϊα\u003C/w>\u003C/name>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname type=\"patronym\">\u003Cw n=\"10\">Ῥοῦφου\u003C/w>\u003C/name>\u003C/persName> \u003Cname type=\"cognomen\">\u003Cw n=\"15\">Μέγα\u003C/w>\u003C/name>\n                    \u003Clb n=\"3\"/>\u003Cname type=\"cognomen\">\u003Cw n=\"20\">Μεγάλαι\u003C/w>\u003C/name>\u003C/persName> \u003Cw n=\"25\">χαῖρε\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#DD #RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"Πομπήϊα\">Πομπήϊα\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"Ῥοῦφος\">Ῥοῦφου\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"Μέγας\">Μέγα\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"Μεγάλη\">Μεγάλαι\u003C/w>\n                    \u003Cw n=\"25\" lemma=\"χαίρω\">χαῖρε\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\" resp=\"#JP\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of Tullio\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"2\">\n                        \u003Cnote>Brugnone: Ρούφου Μέγα χαῖρε (typographic mistake?)\u003C/note>\n                    \u003C/app>\n                    \u003Capp loc=\"3\">\n                        \u003Cnote>Brugnone: Μέγα χαῖρε; letters between Μέγα and χαῖρε are difficult to discern without further autopsy\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--(Epitymbion) Pompeia Roufou Mega Magalai chaire. T asserts that there is an aniconic reflief of punic type on the upper surface, which, combined with the mixed graeco-latin onomastic makes this particularly good. T (1988-89) suggests 'si tratta della tomba di una grecofona (una liberta affrancata, come lasciano supporre i patronimici latini?), il carattere aniconico del rilievo sulla faccia superiore denuncia innegabili rapporti con la cultura punica'. See also Tullio, Incontri e iniziative. Memorie del Centro di Cultura di Cefalu, IV (1987 [1989]) 7.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003Cdate>2009\u003C/date>\n                        \u003CcitedRange>442\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R46KDTZX\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001283\">https://biblio.inscriptiones.org/epig10001283\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>2007\u003C/date>\n                        \u003CcitedRange>57.0877\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1992\u003C/date>\n                        \u003CcitedRange>42.0849b\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Tullio\u003C/author>\n                        \u003Cdate>1988-1989\u003C/date>\n                        \u003CcitedRange>680 tav. 114.1\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/82IWAJBA\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001551\">https://biblio.inscriptiones.org/epig10001551\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Wilson\u003C/author>\n                        \u003Cdate>1995-1996\u003C/date>\n                        \u003CcitedRange>105\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/SPPJMW9F\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001508\">https://biblio.inscriptiones.org/epig10001508\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Tullio\u003C/author>\n                        \u003Cdate>1993\u003C/date>\n                        \u003CcitedRange>241\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/RQWVBFIV\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001549\">https://biblio.inscriptiones.org/epig10001549\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Brugnone\u003C/author>\n                        \u003Cdate>2005\u003C/date>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/ZDDSRBHN\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002116\">https://biblio.inscriptiones.org/epig10002116\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Tullio\u003C/author>\n                        \u003Cdate>2005\u003C/date>\n                        \u003CcitedRange>845-847 fig. 12-14\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/ASI7X2QE\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001546\">https://biblio.inscriptiones.org/epig10001546\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
