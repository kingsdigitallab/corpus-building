40,"unit":37,"dimension":41},"3.8","width",{"_":43,"unit":37,"dimension":44},"1.8","depth",{"layout":46},{"rs":47,"damage":33},{"_":48,"ana":49,"ref":50},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"lettering":33,"dimensions":52},[53,60],{"type":54,"l":55,"from":56,"to":56,"h":57,"unit":58,"atLeast":59,"atMost":36},"letterHeight","Line 1","line1","12-13","mm","12",{"type":61,"l":62,"from":56,"to":63,"h":64,"unit":58},"interlinear","Interlineation line 1 to 2","line2","not measured",{"_":66,"notBefore":67,"notAfter":68,"evidence":69},"Late sixth or early fifth century BCE",-525,-475,"lettering",[71,76],{"_":72,"type":73,"ref":74,"region":75},"Syracusae","ancient","http://pleiades.stoa.org/places/462503","Sicilia",{"_":77,"type":78,"ref":79,"region":75},"Siracusa","modern","http://sws.geonames.org/2523083",[81],[82,83],37.08415,15.27628,{"_":85,"type":86,"subtype":87,"geo":16},"Area of Fusco, Siracusa","found","discovered",[],{"_":90,"type":91,"subtype":92,"xml:id":93,"geo":16},"Mignosa","observed","autopsied","autopsy",[],"Sicily",{"_":97,"role":98,"ref":99,"museum":100},"Museo Archeologico Regionale Paolo Orsi","museum","http://sicily.classics.ox.ac.uk/museum/097",{"slug":101,"type":98,"name":97,"uri":99,"description":102,"location":103},"097","An outstanding collection of archaeological material. The collection ranges from Siracusa and the surrounding territory (Megara Hyblaia, Akrai, Kasmenai etc) to encompass all of eastern Sicily, reaching as far as Gela and Agrigento. The ground floor covers prehistory through to the end of the Classical period. Upstairs includes Hellenistic and Roman Syracuse and a display of material from the catacombs. A gallery displaying material from Hellenistic eastern Sicily is in preparation.",{"settlement":77,"region":77,"country":104,"address":105,"geo":106},"Italy","Viale Teocrito 66, 96100 - Siracusa",{"lat":107,"lon":108},37.07636989,15.2866213,{"_":110,"type":111},"5926","inventory",{"_":113,"mainLang":114,"languages":115},"Ancient Greek","grc",[113],{"type":117,"bibl":118},"edition",[119],{"author":120,"date":121,"citedRange":122,"ptr":123,"inscriptionDate":121,"year":33},"Manenti and Mignosa","2024","113-115 no.1 figs.1-2",{"target":124},"https://www.zotero.org/groups/382445/items/XJUBNCHS",{"type":126,"bibl":127},"discussion",[16],{"editor":129,"principal":132,"contributors":135,"change":150},{"_":130,"ref":131},"Jonathan Prag","#JP",{"_":133,"ref":134},"Valentina Mignosa","#VM",[136,139,142,146],{"_":130,"xml:id":137,"ref":138},"JP","https://orcid.org/0000-0003-3819-8537",{"_":133,"xml:id":140,"ref":141},"VM","https://orcid.org/0000-0002-7122-2511",{"_":143,"xml:id":144,"ref":145},"Simona Stoyanova","SS","https://orcid.org/0000-0003-3914-9569",{"_":147,"xml:id":148,"ref":149},"Alessia Coccato","Coccato","https://orcid.org/0000-0002-6641-2820",{"_":151,"when":152,"who":134},"Valentina Mignosa added metadata","2026-07-30",[154],{"atLeast":155,"atMost":156},12,13,[158],"Manenti and Mignosa, 2024",[160],"XJUBNCHS",[162,162,163,18,23,27,164,165,166,167,165,168,169,114],"isic004488",{"_":4},"syracusae","siracusa","sicilia","sicily","museo archeologico regionale paolo orsi","ancient greek",[],{"title":172,"body":173,"divs":174,"editions":199,"images":209,"handnote":210},"ISic004488. ISic004488","\u003Cdiv id=\"editions\">\u003Cdiv class=\"attribution\">Text encoding: Valentina Mignosa; edition source: autopsy Mignosa\u003C/div>\u003Cdiv id=\"edition-interpretive\" lang=\"grc\">  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἐνγυμάχο \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003Cdiv class=\"attribution\">Text encoding: Valentina Mignosa; edition source: autopsy Mignosa\u003C/div>\u003Cdiv id=\"edition-diplomatic\" lang=\"grc\">\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-diplomatic\">\u003Ca id=\"al1-diplomatic\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>ΕΝΓΥΜΑΧΟ\u003C/span>\u003C/div>\u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003C/div>  \u003Cdiv id=\"facsimile-images\">\u003Ch2>Facsimile Images\u003C/h2>\u003C/div>  \u003Cdiv id=\"apparatus\">\u003Ch4>Apparatus criticus\u003C/h4>\u003Cul>\u003Cli>\u003Cspan>  \u003Cspan>Text from autopsy\u003C/span>  \u003C/span>\u003C/li>\u003C/ul>\u003C/div>  \u003Cdiv id=\"translation\">\u003Ch2> translation\u003C/h2>\u003Cp class=\"translation-author\">  \u003C/p>\u003Cp>  \u003C/p>\u003C/div>  \u003Cdiv id=\"commentary\">\u003Ch2>commentary\u003C/h2>  \u003Cp>The inscription can be dated on palaeographical grounds to the late sixth or early fifth century BCE . The trident-shaped chi, dotted alpha and curved gamma point to a Geloan-Akragantine alphabetic context. The text is read as Ἐνγυμάχο (= Ἐγγυμάχο), an otherwise unattested personal name in the genitive, and is therefore best interpreted as an ownership inscription. Its formation from ἐγγύς and μάχη may be compared with the name Ἐγγύδιχος. The function of the object remains uncertain. The square recess and its three shallow holes may have accommodated a square-section handle secured by three projections or nails. Some Roman stone weights provide morphological parallels, but its weight of 187.392 g does not correspond to any known weight standard attested by comparable objects in Archaic or Classical Sicily. Alternatively, it may have been a small hafted tool, perhaps a hammer intended for a specific purpose. The absence of wear might be explained by a votive use, but the generic provenance from the Fusco area does not permit a more precise interpretation because of the lack of archaeological context.\u003C/p>  \u003C/div>  \u003Cdiv id=\"bibliography\">\u003Ch2>bibliography\u003C/h2>  \u003Cul>\u003Cli> Manenti and Mignosa 2024 113-115 no.1 figs.1-2 \u003C/li>\u003C/ul>  \u003Cul>\u003Cli>\u003C/li>\u003C/ul>  \u003C/div>  \u003Cdiv id=\"handnote\"> \u003Cp> Line 1  12-13  Interlineation line 1 to 2  not measured  \u003C/p>\u003C/div>\u003Cdiv id=\"license\"> Licensed under a Creative Commons-Attribution 4.0 licence \u003C/div>",[175,178,181,184,187,190,193,196],{"id":176,"html":177},"editions","\u003Cdiv class=\"attribution\">Text encoding: Valentina Mignosa; edition source: autopsy Mignosa\u003C/div>\u003Cdiv id=\"edition-interpretive\" lang=\"grc\">  \u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἐνγυμάχο \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003Cdiv class=\"attribution\">Text encoding: Valentina Mignosa; edition source: autopsy Mignosa\u003C/div>\u003Cdiv id=\"edition-diplomatic\" lang=\"grc\">\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-diplomatic\">\u003Ca id=\"al1-diplomatic\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>ΕΝΓΥΜΑΧΟ\u003C/span>\u003C/div>\u003Cp class=\"miniapp\">\u003C/p>\u003C/div>",{"id":179,"html":180},"facsimile-images","\u003Ch2>Facsimile Images\u003C/h2>",{"id":182,"html":183},"apparatus","\u003Ch4>Apparatus criticus\u003C/h4>\u003Cul>\u003Cli>\u003Cspan>  \u003Cspan>Text from autopsy\u003C/span>  \u003C/span>\u003C/li>\u003C/ul>",{"id":185,"html":186},"translation","\u003Ch2> translation\u003C/h2>\u003Cp class=\"translation-author\">  \u003C/p>\u003Cp>  \u003C/p>",{"id":188,"html":189},"commentary","\u003Ch2>commentary\u003C/h2>  \u003Cp>The inscription can be dated on palaeographical grounds to the late sixth or early fifth century BCE . The trident-shaped chi, dotted alpha and curved gamma point to a Geloan-Akragantine alphabetic context. The text is read as Ἐνγυμάχο (= Ἐγγυμάχο), an otherwise unattested personal name in the genitive, and is therefore best interpreted as an ownership inscription. Its formation from ἐγγύς and μάχη may be compared with the name Ἐγγύδιχος. The function of the object remains uncertain. The square recess and its three shallow holes may have accommodated a square-section handle secured by three projections or nails. Some Roman stone weights provide morphological parallels, but its weight of 187.392 g does not correspond to any known weight standard attested by comparable objects in Archaic or Classical Sicily. Alternatively, it may have been a small hafted tool, perhaps a hammer intended for a specific purpose. The absence of wear might be explained by a votive use, but the generic provenance from the Fusco area does not permit a more precise interpretation because of the lack of archaeological context.\u003C/p>  ",{"id":191,"html":192},"bibliography","\u003Ch2>bibliography\u003C/h2>  \u003Cul>\u003Cli> Manenti and Mignosa 2024 113-115 no.1 figs.1-2 \u003C/li>\u003C/ul>  \u003Cul>\u003Cli>\u003C/li>\u003C/ul>  ",{"id":194,"html":195},"handnote"," \u003Cp> Line 1  12-13  Interlineation line 1 to 2  not measured  \u003C/p>",{"id":197,"html":198},"license"," Licensed under a Creative Commons-Attribution 4.0 licence ",[200,202,205,206],{"html":201},"Text encoding: Valentina Mignosa; edition source: autopsy Mignosa",{"id":203,"lang":114,"html":204},"edition-interpretive","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἐνγυμάχο \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"html":201},{"id":207,"lang":114,"html":208},"edition-diplomatic","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-diplomatic\">\u003Ca id=\"al1-diplomatic\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>ΕΝΓΥΜΑΧΟ\u003C/span>\u003C/div>\u003Cp class=\"miniapp\">\u003C/p>",[],[211],{"html":212},"Line 1  12-13  Interlineation line 1 to 2  not measured","\u003C?xm