            \u003Clb n=\"2\"/>\u003CroleName type=\"civic.religious\" subtype=\"flaminica\">\u003Cw n=\"40\">flaminicae\u003C/w>\u003C/roleName> \u003Cg ref=\"#interpunct\" n=\"45\">·\u003C/g> \u003Cw n=\"50\">divae\u003C/w> \u003Cg ref=\"#interpunct\" n=\"55\">·\u003C/g> \u003Cname>\u003Cw n=\"60\">\u003Cexpan>\u003Cabbr>Aug\u003C/abbr>\u003Cex>ustae\u003C/ex>\u003C/expan>\u003C/w>\u003C/name>\n                    \u003Clb n=\"3\"/>\u003Cw n=\"65\">ex\u003C/w> \u003Cg ref=\"#interpunct\" n=\"70\">·\u003C/g> \u003Cw n=\"75\">testamento\u003C/w> \u003Cg ref=\"#interpunct\" n=\"80\">·\u003C/g> \u003Cname>\u003Cw n=\"85\">Messi\u003C/w>\u003C/name> \u003Cg ref=\"#interpunct\" n=\"90\">·\u003C/g> \u003Cname>\u003Cw n=\"95\">Modiani\u003C/w>\u003C/name> \u003Cg ref=\"#interpunct\" n=\"100\">·\u003C/g> \u003Cw n=\"105\">patris\u003C/w>\n                    \u003Clb n=\"4\"/>\u003Cname>\u003Cw n=\"110\">Modianus\u003C/w>\u003C/name> \u003Cg ref=\"#interpunct\" n=\"115\">·\u003C/g> \u003Cw n=\"120\">frater\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"Messia\">Messiae\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"Priscus\">Prisci\u003C/w>\n                    \u003Cw n=\"25\" lemma=\"filia\">filiae\u003C/w>\n                    \u003Cw n=\"35\" lemma=\"Crispinus\">Crispinae\u003C/w>\n                    \u003Cw n=\"40\" lemma=\"flaminica\">flaminicae\u003C/w>\n                    \u003Cw n=\"50\" lemma=\"divus\">divae\u003C/w>\n                    \u003Cw n=\"60\" lemma=\"Augustus\">Augustae\u003C/w>\n                    \u003Cw n=\"65\" lemma=\"ex\">ex\u003C/w>\n                    \u003Cw n=\"75\" lemma=\"testamentum\">testamento\u003C/w>\n                    \u003Cw n=\"85\" lemma=\"Messius\">Messi\u003C/w>\n                    \u003Cw n=\"95\" lemma=\"Modianus\">Modiani\u003C/w>\n                    \u003Cw n=\"105\" lemma=\"pater\">patris\u003C/w>\n                    \u003Cw n=\"110\" lemma=\"Modianus\">Modianus\u003C/w>\n                    \u003Cw n=\"120\" lemma=\"frater\">frater\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text based upon Bitto 2001 and CIL\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#AA\">\n                \u003Cp>To Messia Crispina, daughter of Priscus, flaminica of Diva Augusta. Her brother Modianus set it up by the will of his father Messius Modianus.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--to Messia Crispina (Priscus' daughter), flaminica div.aug.; her brother Modianus set it up by the will of his father Messius Modianus (precise relationship therefore unclear).-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"CIL\">\n                        \u003Cauthor>Mommsen\u003C/author>\n                        \u003Cdate>1883\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"http://arachne.uni-koeln.de/item/buchseite/650751\">6978\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GQN8UZSI\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000589\">https://biblio.inscriptiones.org/epig10000589\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IMusMessina\">\n       