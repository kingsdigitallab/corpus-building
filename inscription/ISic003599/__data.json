\n                \u003Cab>\n                    \u003Clb n=\"1\"/>In nomine \u003Cexpan>\u003Cabbr>D\u003C/abbr>\u003Cex>omi\u003C/ex>\u003Cabbr>ni\u003C/abbr>\u003C/expan> \u003Cexpan>\u003Cabbr>n\u003C/abbr>\u003Cex>ostri\u003C/ex>\u003C/expan>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"divine\">\u003Cname>\u003Cexpan>\u003Cabbr>\u003Chi rend=\"supraline\">Ih\u003C/hi>\u003C/abbr>\u003Cex>es\u003C/ex>\u003Cabbr>\u003Chi rend=\"supraline\">u\u003C/hi>\u003C/abbr>\u003C/expan>\u003C/name>\u003C/persName> \u003CpersName type=\"attested\">\u003Cname>Cresconius\u003C/name>\u003C/persName> \u003Cexpan>\u003Cabbr>s\u003C/abbr>\u003Cex>anctum\u003C/ex>\u003C/expan>\n                    \u003Clb n=\"3\"/>opus \u003CpersName type=\"divine\">\u003Cname>\u003Cexpan>\u003Cabbr>\u003Cg ref=\"#christogram\">☧\u003C/g>\u003C/abbr>\u003Cex>rist\u003C/ex>\u003Cabbr>i\u003C/abbr>\u003C/expan>\u003C/name>\u003C/persName> edificabit\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text after Rizzone and Sammito 2004\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>In the name of our lord Jesus, Cresconius built the sacred work of Christ\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" resp=\"Rizzone-Sammito\">\n                \u003Cp>Nel nome del Signore nostro Gesù, Crosconius la santa opera di Cristo edificò\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003Cdate>2007\u003C/date>\n                        \u003CcitedRange>677\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R46KDTZX\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001283\">https://biblio.inscriptiones.org/epig10001283\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Rizzone\u003C/author>\n                        \u003Cauthor>Sammito\u003C/author>\n                        \u003Cdate>2004\u003C/date>\n                        \u003CcitedRange>104-105 fig.2\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/RHXWRC83\"/>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Sammito and Rizzone\u003C/author>\n                        \u003Cdate>2007\u003C/date>\n                        \u003CcitedRange>1623-1624 tav.9.6\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/A8P3577Q\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001606\">https://biblio.inscriptiones.org/epig10001606\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
