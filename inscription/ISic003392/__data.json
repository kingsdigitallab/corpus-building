 e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#MB\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>ονιε \u003CpersName type=\"attested\">\u003Cname>Ποπλίο\u003Csupplied reason=\"lost\" cert=\"low\">υ\u003C/supplied>\u003C/name>\u003C/persName>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"0\"/>\u003Cgap reason=\"lost\" quantity=\"1\" unit=\"line\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text of Giannobile 2003\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--[- - -]onie poplio[u -?- -]. Giannobile assumes type name of deceased in vocative, plus patronym, plus chreste chaire, dates to late C2 on basis of letter-forms (and a spurious association with the Thermae honorifics for Scipio Aemilianus. Giannobile suggests that this text might belong to the inscription ISic003393, the latter probably referring to a monumental structure.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003Cdate>2007\u003C/date>\n                        \u003CcitedRange>681\u003C/citedRange>\n                        \u003Cptr target=\"https://www.