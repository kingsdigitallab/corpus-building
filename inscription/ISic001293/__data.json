c>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462270\">Catina\u003C/placeName>\t\t\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2525068\">Catania\u003C/placeName>\n                            \t\u003Cgeo>37.49223, 15.07041\u003C/geo>\n\t\t\u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" notBefore-custom=\"0001\" notAfter-custom=\"0300\">Imperial\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\" notAfter=\"1833\">Found several years before 1833 near to the drinking trough/fountain between the Palazzo Rizzari and Palazzo di Mazza, to the north of the porta Stesicorea\u003Cgeo cert=\"medium\">37.509673, 15.084874\u003C/geo>\u003C/provenance>\u003C!-- generic geo north of porta stesicorea, nr via Rizzari -->\n                        \u003Cprovenance type=\"not-observed\" subtype=\"lost\">Not seen since the 19th century, presumed lost.\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n             \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n             \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                 \u003Cxi:fallback>\n                     \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                 \u003C/xi:fallback>\n             \u003C/xi:include>\n\t  \u003Cxi:include href=\"../alists/charDecl.xml\">\n\t     \u003Cxi:fallback>\n\t       \u003Cp>ISicily glyphs authority list\u003C/p>\n\t     \u003C/xi:fallback>\n\t   \u003C/xi:include>\n         \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language>\n                \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.funerary\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Funerary\">funerary\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n            \t   \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n            \t   \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n            \t\u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n\t\t\u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n\t    \u003Cchange when=\"2020-12-22\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n            \t\u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2021-02-17\" who=\"#JP\">Jonathan Prag edited file against IG and Alessi\u003C/change>\n                \u003Cchange when=\"2025-12-18\" who=\"#ZG\">Zoe Greblunas tagged names and persons\u003C/change> \u003Cchange when=\"2026-08-03\" who=\"#martaf\">Marta Fogagnolo revised the text encoding, added the translation and the commentary\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001293_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001293.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cw>\u003Cexpan>\u003Cabbr>Θ\u003C/abbr>\u003Cex>εοῖς\u003C/ex>\u003C/expan>\u003C/w> \u003Cw>\u003Cexpan>\u003Cabbr>Κ\u003C/abbr>\u003Cex>αταχθονίοις\u003C/ex>\u003C/expan>\u003C/w>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>Δάφνη\u003C/name>\u003C/persName> \u003Cw>γλυ\u003Csupplied reason=\"lost\">κυ\u003C/supplied>\n                    \u003Clb n=\"3\" break=\"no\"/>τάτη\u003C/w> \u003Cw>χαῖρ\u003Csupplied reason=\"lost\">ε\u003C/supplied>\u003C/w> \u003Cw>\u003Csupplied reason=\"lost\">ἔζη\u003C/supplied>\n                    \u003Clb n=\"4\" break=\"no\"/>σας\u003C/w> \u003Cw>ἔτη\u003C/w> \u003Cnum>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003C/num>\n                    \u003Clb n=\"5\"/>\u003Cw>τύχης\u003C/w> \u003Corig>Ν\u003C/orig>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"6\"/>\u003Corig>Ο\u003Cunclear>Σ\u003C/unclear>\u003C/orig> \u003Cw part=\"I\">πεπ\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\" resp=\"#martaf\">\n               \u003ClistApp>\n                   \u003Capp>\u003Cnote>Text after Alessi and Kaibel\u003C/note>\u003C/app>\n                    \u003Capp loc=\"line 2\">\u003Cnote>Alessi: ΓΛΥΚυ... and ΓΛΥκυ...\u003C/note>\u003C/app>\n                    \u003Capp loc=\"line 3\">\u003Cnote>[ἔζυ]|σας sic Alessi; ἔζη]|σας Franz; χαῖρ[ε ν’ ζή]|σασ’ ἔτη\u003C/note>\u003C/app>\n                   \u003Capp loc=\"line 4\">\u003Cnote>ἔτη [ὑπό Alessi\u003C/note>\u003C/app>\n                   \u003Capp loc=\"line 5\">\u003Cnote>N[εοκορύτ]|ος Alessi; Εὐ]|τύχης [πατὴρ ἴδι]|ος Franz\u003C/note>\u003C/app>\n                   \u003Capp loc=\"line 6\">\u003Cnote>πεπ[ρωμενυς sic Alessi; πεπ[οίηκεν Franz\u003C/note>\u003C/app>\n               \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#martaf\">\n                \u003Cp>To the Underworld Gods. Sweetest Daphne, farewell. You lived for … years. … of fortune …\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#martaf\">\n                \u003Cp>This is an epitaph for a woman named Daphne, preceded by an invocation to the chthonic gods. The deceased is described with an attribute (ll. 2–3 \u003Cforeign xml:lang=\"grc\">γλυ[κυ]|τάτη\u003C/foreign>) that is quite common, followed by a greeting and the verb ζάω in the second person singular, with a direct address to the deceased made even more effective by the greeting formula. The age has been lost in a lacuna. The final part of the epitaph is very fragmentary: Kaibel suggests lines 5-6 likely to be consolatory epithets (e.g. \u003Cforeign xml:lang=\"grc\">τύχης ... πεπρωμεν\u003C/foreign>), rather than e.g. name of a male relative responsible for the building of the monument (as Alessi and Franz believed, since the first supplied at ll. 5-6 \u003Cforeign xml:lang=\"grc\">Ν[εοκορύτ]|ος πεπ[ρωμένυς\u003C/foreign>, the second at ll. 4-6 \u003Cforeign xml:lang=\"grc\">Εὐ]|τύχης [πατὴρ ἴδι]|ος πεπ[οίηκεν\u003C/foreign>), and notes a suggestion of Willamowitz that the final part might have been in verse (iambic trimeter), and even the whole, if the age were a single syllable (e.g. \u003Cforeign xml:lang=\"grc\">Δάφνη γλυ[κυ]|τάτη χαῖρ[ε ν´ ζή]|σασ’ ἔτη\u003C/foreign>).\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IG\">\n                        \u003Cauthor>Kaibel\u003C/author>\n                        \u003Cdate>1890\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"https://clio.columbia.edu/catalog/6873760\">469\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Q2SBPG9F\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001072\">https://biblio.inscriptiones.org/epig10001072\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"CIG\">\n                        \u003Cauthor>Franz\u003C/author>\n                        \u003Cdate>1853\u003C/date>\n                        \u003CcitedRange>5703\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/TQMVHEVL\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001250\">https://biblio.inscriptiones.org/epig10001250\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Alessi\u003C/author>\n                        \u003Cdate>1833\u003C/date>\n                        \u003CcitedRange>226\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/SRZQ4DSI\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002538\">https://biblio.inscriptiones.org/epig10002538\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Alessi\u003C/author>\n                        \u003Cdate>1833\u003C/date>\n                        \u003CcitedRange>172\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F986DASI\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002540\">https://biblio.inscriptiones.org/epig10002540\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
