000796\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Orsi\u003C/author>\n                        \u003Cdate>1923\u003C/date>\n                        \u003CcitedRange>no.6\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GQ8HXJJE\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001699\">https://biblio.inscriptiones.org/epig10001699\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>"],"uses":{"params":["slug"]}}]}
