{"type":"data","nodes":[{"type":"data","data":[{"debug":1},true],"uses":{}},{"type":"data","data":[{"slug":1,"metadata":2,"images":102,"html":180,"xml":231},"ISic001788",{"file":1,"uri":1,"title":3,"status":4,"editions":6,"editionAuthor":17,"type":18,"support":23,"objectType":24,"material":28,"condition":35,"dimensions":37,"layoutDesc":48,"handNote":57,"date":72,"places":77,"geo":87,"country":82,"provenance":79,"provenanceFound":91,"provenanceGeo":96,"provenanceObserved":97,"provenanceLost":17,"graphics":102,"region":113,"repository":114,"idno":127,"textLang":129,"bibliographyEdition":133,"bibliographyDiscussion":145,"citation":148,"tmNumber":144,"facsimile":160,"letterHeights":161,"publications":165,"zotero":167,"keywords":169,"lettering_types":179},"Fragment of a Latin inscription",{"_":5},"edited",[7,9,11,13,15],{"type":8},"TM",{"type":10},"EDR",{"type":12},"EDH",{"type":14},"EDCS",{"type":16},"PHI",null,{"_":19,"ana":20,"ref":21,"cert":22},"honorific","#function.honorific","https://ontology.inscriptiones.org/type_of_inscription/Honorific","low","Two joining fragments of a fine pale grey marble plaque, previously glued together but now separated. The reverse is finished smooth, and shows marks around the edge which imply it was stuck to a wall at some previous point in this form (for display?). The right hand fragment preserves part of the upper margin, but otherwise the fragments are broken on all sides. (frag. a (left) is H. 17.6 x W 14.5 cm; frag. b (right) is H 20.3 x W 12.9 cm).",{"_":25,"ana":26,"ref":27},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259",{"_":29,"ana":30,"type":31,"subtype":32,"ref":34},"marble","#material.inorganic.stone.metamorphic_rock.marble","stone.marble",[33],"unverified","http://www.eagle-network.eu/voc/material/lod/48.html",{"ana":36},"#condition.fragments.contiguous",[38,42,45],{"_":39,"unit":40,"dimension":41},"20.3","cm","height",{"_":43,"unit":40,"dimension":44},"26.7","width",{"_":46,"unit":40,"dimension":47},"2.1 (left) to 1.9 (right)","depth",{"layout":49},{"p":50,"rs":51,"damage":55},"There is a large vacat (11.5 cm to the upper margin) above the single preserved line of letters, implying this is the first line of the text.",{"_":52,"ana":53,"ref":54},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"ana":56},"#text_condition.incomplete",{"lettering":58,"dimensions":59},"Large v-cut letters with standard serifs; P is slightly open, B has smaller upper loop (both closed). Deep triangular interpuncts.",[60,68],{"type":61,"l":62,"from":63,"to":63,"h":64,"unit":65,"atLeast":66,"atMost":67},"letterHeight","Line 1","line1","69-72","mm","69","72",{"type":69,"l":70,"from":63,"to":71,"unit":65},"interlinear","Interlineation line 1 to 2","line2",{"_":73,"notBefore":74,"notAfter":75,"evidence":76},"Augustan / first half of the first century CE",-21,50,"lettering",[78,83],{"_":79,"type":80,"ref":81,"region":82},"Syracusae","ancient","http://pleiades.stoa.org/places/462503","Sicilia",{"_":84,"type":85,"ref":86,"region":82},"Siracusa","modern","http://sws.geonames.org/2523083",[88],[89,90],37.08415,15.27628,{"_":92,"type":93,"subtype":94,"notAfter":95,"geo":17},"No record of discovery is preserved, but the right hand fragment is recorded in Orsi's first notebook (Sept. 1888) among fragments already in the museum.","found","discovered","1888",[],{"_":98,"type":99,"subtype":100,"xml:id":101,"geo":17},"Prag 2015-01-16, cassette 16, magazzino B, Museo Archeologico Regionale Paolo Orsi","observed","autopsied","autopsy",[103,110],{"n":104,"url":105,"height":106,"width":107,"desc":108,"surfaceType":109},"screen","ISic001788_tiled.tif","3680px","5520px","I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2015-01-16","front",{"n":104,"url":111,"height":106,"width":107,"desc":108,"surfaceType":112},"ISic001788_rear_tiled.tif","rear","Sicily",{"_":115,"role":116,"ref":117,"museum":118},"Museo Archeologico Regionale Paolo Orsi","museum","http://sicily.classics.ox.ac.uk/museum/097",{"slug":119,"type":116,"name":115,"uri":117,"description":120,"location":121},"097","An outstanding collection of archaeological material. The collection ranges from Siracusa and the surrounding territory (Megara Hyblaia, Akrai, Kasmenai etc) to encompass all of eastern Sicily, reaching as far as Gela and Agrigento. The ground floor covers prehistory through to the end of the Classical period. Upstairs includes Hellenistic and Roman Syracuse and a display of material from the catacombs. A gallery displaying material from Hellenistic eastern Sicily is in preparation.",{"settlement":84,"region":84,"country":122,"address":123,"geo":124},"Italy","Viale Teocrito 66, 96100 - Siracusa",{"lat":125,"lon":126},37.07636989,15.2866213,{"type":128},"inventory",{"_":130,"mainLang":131,"languages":132},"Latin","la",[130],{"type":134,"bibl":135},"edition",[136],{"author":137,"date":138,"citedRange":139,"ptr":140,"ref":142,"inscriptionDate":138,"year":144},"Orsi","2018","Tacc. 1, p.72 (no.88)",{"target":141},"https://www.zotero.org/groups/382445/items/RGRSRUHK",{"_":143,"target":143},"https://biblio.inscriptiones.org/epig10002617","",{"type":146,"bibl":147},"discussion",[17],{"editor":149,"principal":152,"contributors":153,"change":157},{"_":150,"ref":151},"Jonathan Prag","#JP",{"_":150,"ref":151},[154],{"_":150,"xml:id":155,"ref":156},"JP","http://orcid.org/0000-0003-3819-8537",{"_":158,"when":159,"who":151},"Jonathan Prag created file from autopsy","2026-05-13",{"n":104,"url":105,"height":106,"width":107,"desc":108,"surfaceType":109},[162],{"atLeast":163,"atMost":164},69,72,[166],"Orsi, 2018",[168],"RGRSRUHK",[170,171,172,19,25,29,173,174,175,176,177,178,131],"isic001788","fragment of a latin inscription",{"_":5},"syracusae","siracusa","sicilia","sicily","museo archeologico regionale paolo orsi","latin",[],{"title":181,"body":182,"divs":183,"editions":208,"images":218,"handnote":229},"ISic001788. Fragment of a Latin inscription","\u003Cdiv id=\"editions\">\u003Cdiv class=\"attribution\">Text encoding: Jonathan Prag; edition source: autopsy Prag 2015-01-16, cassette 16, magazzino B, Museo Archeologico Regionale Paolo Orsi\u003C/div>\u003Cdiv id=\"edition-interpretive\" lang=\"la\">  \u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"o · Cai · filio · Poblilia tribu\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"o\">\u003Cspan data-text=\"o\">ọ\u003C/span>\u003C/span> · \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Cai\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Cai\">C(ai)\u003C/span>\u003C/span> · f(ilio) · Pob(lilia) (\u003Cem>scil.\u003C/em> tribu)\u003C/span> [\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003Cdiv class=\"attribution\">Text encoding: Jonathan Prag; edition source: autopsy Prag 2015-01-16, cassette 16, magazzino B, Museo Archeologico Regionale Paolo Orsi\u003C/div>\u003Cdiv id=\"edition-diplomatic\" lang=\"la\">\u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-diplomatic\">\u003Ca id=\"al1-diplomatic\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"o · Cai · filio · Poblilia tribu\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"o\">\u003Cspan data-text=\"o\">.\u003C/span>\u003C/span>·\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Cai\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Cai\">C\u003C/span>\u003C/span>·F·POB(\u003Cem>scil.\u003C/em> TRIBU)\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]\u003C/span>\u003C/div>\u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003C/div>  \u003Cdiv id=\"facsimile-images\">\u003Ch2>Facsimile Images\u003C/h2>\u003Ca href=\"ISic001788_tiled.tif\">\u003Cimg title=\"I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2015-01-16\" src=\"ISic001788_tiled-thumb.tif\">\u003C/a>\u003Ca href=\"ISic001788.jpg\">\u003Cimg title=\"I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2015-01-16\" src=\"ISic001788-thumb.jpg\">\u003C/a>\u003Ca href=\"ISic001788_rear_tiled.tif\">\u003Cimg title=\"I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2015-01-16\" src=\"ISic001788_rear_tiled-thumb.tif\">\u003C/a>\u003Ca href=\"ISic001788_rear.jpg\">\u003Cimg title=\"I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2015-01-16\" src=\"ISic001788_rear-thumb.jpg\">\u003C/a>\u003C/div>  \u003Cdiv id=\"apparatus\">\u003Ch4>Apparatus criticus\u003C/h4>\u003Cul>\u003Cli>\u003Cspan>\u003Cspan>Text based on autopsy\u003C/span>\u003C/span>; \u003C/li>\u003Cli>\u003Cspan class=\"1\">1: \u003Cspan>Trace of curve on the break at the start of the line must be from an O\u003C/span>\u003C/span>\u003C/li>\u003C/ul>\u003C/div>  \u003Cdiv id=\"translation\">\u003Ch2>English translation\u003C/h2>\u003Cp class=\"translation-author\">\u003Ca href=\"http://orcid.org/0000-0003-3819-8537\">Jonathan Prag\u003C/a>\u003C/p>  \u003Cp>[---]o, son of Gaius, of the Poblilia tribe [---]\u003C/p>  \u003C/div>  \u003Cdiv id=\"commentary\">\u003Ch2>commentary\u003C/h2>  \u003Cp>This is presumably an honorific inscription for an individual, who was named in line 1 of the text and part of whose name is here preserved. The use of the dative (the partial trace of O at the start of the fragment) indicates the likely honorific form of the text, and the partial preservation of the upper edge and the vacat above the letters indicate that this is the first line of the text. The size of the letters speaks to a monumental public text. The Poblilia tribe is only attested once in Sicily, in a Severan period honorific from Lilybaeum (\u003Ca href=\"https://sicily.classics.ox.ac.uk/inscription/ISic000492\" target=\"_blank\">ISic000492\u003C/a>), and in Syracusae itself only the Maecia and the Quirina (the most commonly attested tribe in Sicily) are attested (see Prag, J. R. W., ‘Sicilia Romana Tributim Discripta’, in Le Tribù Romane. Atti Della XVIe Rencontre Sur l’épigraphie (Bari 8-10 Ottobre 2009), ed. by M. Silvestrini (Edipuglia, 2010), pp. 305–11). The form of the letters suggests this text likely belongs to the Augustan / Julio-Claudian period. The text is previously unpublished, and although the right-hand fragment is recorded in Orsi's first notebook, indicating that it was present in the museum's collection prior to his arrival in 1888, there is no record of the left-hand fragment, nor of the provenance of either.\u003C/p>  \u003C/div>  \u003Cdiv id=\"bibliography\">\u003Ch2>bibliography\u003C/h2>  \u003Cul>\u003Cli> Orsi 2018 Tacc. 1, p.72 (no.88) \u003Ca href=\"https://biblio.inscriptiones.org/epig10002617\" target=\"_blank\">https://biblio.inscriptiones.org/epig10002617\u003C/a>\u003C/li>\u003C/ul>  \u003Cul>\u003Cli>\u003C/li>\u003C/ul>  \u003C/div>  \u003Cdiv id=\"handnote\">\u003Cp>Large v-cut letters with standard serifs; P is slightly open, B has smaller upper loop (both closed). Deep triangular interpuncts.\u003C/p> Line 1  69-72  Interlineation line 1 to 2    \u003C/div>\u003Cdiv id=\"license\"> Licensed under a Creative Commons-Attribution 4.0 licence. \u003C/div>",[184,187,190,193,196,199,202,205],{"id":185,"html":186},"editions","\u003Cdiv class=\"attribution\">Text encoding: Jonathan Prag; edition source: autopsy Prag 2015-01-16, cassette 16, magazzino B, Museo Archeologico Regionale Paolo Orsi\u003C/div>\u003Cdiv id=\"edition-interpretive\" lang=\"la\">  \u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"o · Cai · filio · Poblilia tribu\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"o\">\u003Cspan data-text=\"o\">ọ\u003C/span>\u003C/span> · \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Cai\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Cai\">C(ai)\u003C/span>\u003C/span> · f(ilio) · Pob(lilia) (\u003Cem>scil.\u003C/em> tribu)\u003C/span> [\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003Cdiv class=\"attribution\">Text encoding: Jonathan Prag; edition source: autopsy Prag 2015-01-16, cassette 16, magazzino B, Museo Archeologico Regionale Paolo Orsi\u003C/div>\u003Cdiv id=\"edition-diplomatic\" lang=\"la\">\u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-diplomatic\">\u003Ca id=\"al1-diplomatic\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"o · Cai · filio · Poblilia tribu\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"o\">\u0