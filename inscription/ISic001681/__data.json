es.stoa.org/places/462487\">Segesta\u003C/placeName>\t\t\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2523171\">Segesta\u003C/placeName>\n                            \t\u003Cgeo>37.94171, 12.83649\u003C/geo>\n\t\t\u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" notBefore-custom=\"-0200\" notAfter-custom=\"-0101\" source=\"https://www.zotero.org/groups/382445/items/3PK3JKXR\" evidence=\"archaeological-context lettering\">2nd century BCE\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\" when=\"2006-05\">Found in May 2006 in a collapse layer (US 40500) relating to the mediaeval room U, on the west wing of the agora stoa\u003Cgeo>37.939781, 12.842462\u003C/geo>\u003C/provenance>\u003C!-- geo is based upon map in fig.138 of I.Segesta-->\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">None\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n             \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n             \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                 \u003Cxi:fallback>\n                     \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                 \u003C/xi:fallback>\n             \u003C/xi:include>\n\t  \u003Cxi:include href=\"../alists/charDecl.xml\">\n\t     \u003Cxi:fallback>\n\t       \u003Cp>ISicily glyphs authority list\u003C/p>\n\t     \u003C/xi:fallback>\n\t   \u003C/xi:include>\n         \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language>\n                \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.honorific\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Honorific\">honorific\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2021-05-21\" who=\"#JP\">Jonathan Prag created initial draft of text and metadata from the ed. pr. of Ampolo/Erdas\u003C/change>\n                \u003Cchange when=\"2025-12-24\" who=\"#ZL\">tagged names and persons\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001681_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001681.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Csupplied reason=\"lost\">ὁ\u003C/supplied> \u003Csupplied reason=\"lost\">δᾶμος\u003C/supplied> τῶν \u003CplaceName type=\"ethnic\">Ἐγεστα\u003Csupplied reason=\"lost\">ίων\u003C/supplied>\u003C/placeName>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\">\u003Cdesc>personal name\u003C/desc>\u003C/gap>\u003C/name> \u003CpersName type=\"attested\">\u003Cname type=\"patronym\">\u003Csupplied reason=\"lost\">Ἀ\u003C/supplied>ρτέμωνος\u003C/name>\u003C/persName> \u003Cname>\u003Cw part=\"I\">Ν\u003C/w>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\">\u003Cdesc>personal name\u003C/desc>\u003C/gap>\u003C/name>\u003C/persName>\n                    \u003Clb n=\"3\"/>\u003Csupplied reason=\"lost\">πρεσ\u003C/supplied>\u003Cunclear>β\u003C/unclear>ύτερον ἀρετᾶ\u003Csupplied reason=\"lost\">ς\u003C/supplied> \u003Csupplied reason=\"lost\">ἕνεκα\u003C/supplied> \n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\u003Cnote>Text of I.Segesta\u003C/note>\u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>The people of the Segestans (dedicate this statue of) [---] N[---] the elder, son of Artemon, on account of his excellence\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" source=\"https://www.zotero.org/groups/382445/items/3PK3JKXR\">\n                \u003Cp>Il popolo dei Segestani (ha onorato/ha eretto la statua di) [---] senior, figlio di Artemon, N[---], per il suo valore [transl. from I.Segesta]\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                   \u003Cbibl>\n                        \u003Cauthor>Ampolo and Erdas\u003C/author>\n                        \u003Cdate>2019\u003C/date>\n                        \u003CcitedRange>G5\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/3PK3JKXR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001036\">https://biblio.inscriptiones.org/epig10001036\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\n\t       \u003Cbibl/>\n\t   \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
