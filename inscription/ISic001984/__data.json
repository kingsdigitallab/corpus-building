984.jpg\" height=\"992px\" width=\"558px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"transliteration-primary\" xml:space=\"preserve\" xml:lang=\"xpu-Latn\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/EGNUE9CZ\">\n                \u003Cab>\n                    \u003Clb n=\"1\" style=\"text-direction:r-to-l\"/>lrbt lʿš\n                    \u003Clb n=\"2\" style=\"text-direction:r-to-l\"/>trt \u003Cgap reason=\"lost\" unit=\"character\" quantity=\"2\"/> b\n                    \u003Clb n=\"3\" style=\"text-direction:r-to-l\"/>\u003Cgap reason=\"lost\" unit=\"character\" extent=\"unknown\"/> b \u003Cgap reason=\"lost\" unit=\"character\" quantity=\"2\"/> d \u003Cgap reason=\"lost\" unit=\"character\" quantity=\"2\"/>\n                    \u003Clb n=\"4\" style=\"text-direction:r-to-l\"/>\u003Cgap reason=\"lost\" unit=\"character\" extent=\"unknown\"/> ʿ gm\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text of De Simone 2013\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#RDS\">\n                \u003Cp>To the Lady, to Ashtarte .. b....... b.d.……. ʿ gm\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" resp=\"#RDS\">\n                \u003Cp>Alla Signora, ad Astarte .. b...... b.d........ ʿ gm\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#RDS\">\n                \u003Cp>Only the first two lines of the inscription are interpretable; the rest is illegible due to the stone's poor state of preservation.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Coacci Polselli\u003C/author>\n                        \u003Cdate>1978\u003C/date>\n                        \u003CcitedRange>167-168, tav. LXXXV.1\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/D8YT5N6Y\"/>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>De Simone\u003C/author>\n                        \u003Cdate>2013\u003C/date>\n                        \u003CcitedRange>25 MO.1 fig.1\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/EGNUE9CZ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002545\">https://biblio.inscriptiones.org/epig10002545\u003C/ref>\n                    \u003C/bibl>\n                  \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
