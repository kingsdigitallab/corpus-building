ange>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!-- \n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic000203_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic000203.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface> -->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\" resp=\"#VM #JP\" source=\"https://www.zotero.org/groups/382445/items/ZP8DE8KS\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cw n=\"5\">\u003Cexpan>\u003Cabbr>D\u003C/abbr>\u003Cex>is\u003C/ex>\u003C/expan>\u003C/w> \u003Cw n=\"10\">\u003Cexpan>\u003Cabbr>m\u003C/abbr>\u003Cex>anibus\u003C/ex>\u003C/expan>\u003C/w>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cw n=\"15\">\u003Cexpan>\u003Cabbr>Cn\u003C/abbr>\u003Cex>aeus\u003C/ex>\u003C/expan>\u003C/w>\u003C/name> \u003Cg ref=\"#interpunct\" n=\"17\">·\u003C/g> \u003Cname>\u003Cw n=\"20\">Octavius\u003C/w>\u003C/name>\n                    \u003Clb n=\"3\"/>\u003Cname>\u003Cw n=\"25\">Martialis\u003C/w>\u003C/name>\u003C/persName>\n                    \u003Clb n=\"4\"/>\u003Cw n=\"30\">\u003Cexpan>\u003Cabbr>v\u003C/abbr>\u003Cex>ixit\u003C/ex>\u003C/expan>\u003C/w> \u003Cg ref=\"#interpunct\" n=\"32\">·\u003C/g> \u003Cw n=\"35\">\u003Cexpan>\u003Cabbr>a\u003C/abbr>\u003Cex>nnis\u003C/ex>\u003C/expan>\u003C/w> \u003Cg ref=\"#interpunct\" n=\"37\">·\u003C/g> \u003Cnum value=\"80\">\u003Cw n=\"40\">LXXX\u003C/w>\u003C/num>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#VF\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"dis\">Dis\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"manes\">manibus\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"Cnaeus\">Cnaeus\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"Octavius\">Octavius\u003C/w>\n                    \u003Cw n=\"25\" lemma=\"Martialis\">Martialis\u003C/w>\n                    \u003Cw n=\"30\" lemma=\"vivo\">vixit\u003C/w>\n                    \u003Cw n=\"35\" lemma=\"annus\">annis\u003C/w>\n                    \u003Cw n=\"40\" lemma=\"LXXX\">LXXX\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of Gualtherus\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>To the shades of the underworld. Cnaeus Octavius Martialis lived 80 years.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Gualtherus\u003C/author>\n                        \u003Cdate>1624\u003C/date>\n                        \u003CcitedRange>121\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GIN6NANU\"/>\n                        \u003Cref target=\"h