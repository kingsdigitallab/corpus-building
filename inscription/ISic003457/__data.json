n data-type=\"persname\" data-name-type=\"divine\" data-text=\"Veneri Eque\n                    stri\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Veneri\">Veneri\u003C/span>  \u003Cspan data-type=\"name\" data-name-type=\"epithet\" data-text=\"Eque\n                    stri\">Eque [stri\u003C/span>\u003C/span> don (um) ? ded (it) ?] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003Cdiv class=\"attribution\">Text encoding: Jonathan Prag\u003C/div>\u003Cdiv id=\"edition-diplomatic\" lang=\"la\">\u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-diplomatic\">\u003Ca id=\"al1-diplomatic\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"\n                        \n                            \n                                \n                                    L\n                                    ucius\n                                \n                            \n                        \n                        \n                            Plinius\n                            \n                        \n                                \n                                    L\n                                    uci\n                                \n                            \n                        \n                        \n                            \n                                f\n                                ilius\n                            \n                        \n                        Rufus\n                        \n                    \">[...........\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Rufus\n                        \">...]US\u003C/span>\u003C/span>LEGPROPRPRDESIG\u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Veneri Eque\n                    stri\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Veneri\">VENERI\u003C/span>\u003Cspan data-type=\"name\" data-name-type=\"epithet\" data-text=\"Eque\n                    stri\">EQUE[....\u003C/span>\u003C/span>........]\u003C/span>\u003C/div>\u003Cp class=\"miniapp\">\u003C/p>\u003C/div>\u003C/div>  \u003Cdiv id=\"facsimile-images\">\u003Ch2>Facsimile Images\u003C/h2>\u003Ca href=\"ISic003457_tiled.tif\">\u003Cimg title=\"I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; Photo R.J.A. Wilson\" src=\"ISic003457_tiled-thumb.tif\">\u003C/a>\u003Ca href=\"ISic003457.jpg\">\u003Cimg title=\"I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; Photo R.J.A. Wilson\" src=\"ISic003457-thumb.jpg\">\u003C/a>\u003C/div>  \u003Cdiv id=\"apparatus\">\u003Ch4>Apparatus criticus\u003C/h4>\u003Cul>\u003Cli>\u003Cspan>  \u003Cspan>Text of Silvestrini 2014\u003C/span>  \u003C/span>\u003C/li>\u003C/ul>\u003C/div>  \u003Cdiv id=\"translation\">\u003Ch2>English translation\u003C/h2>\u003Cp class=\"translation-author\">\u003Ca href=\"http://orcid.org/0000-0003-3819-8537\">Jonathan Prag\u003C/a>\u003C/p>  \u003Cp>[Lucius Plinius Rufus, son of Lucius] propraetorian legate, praetor designate, [gave this as a gift] to Venus Equestris\u003C/p>  \u003C/div>  \u003Cdiv id=\"commentary\">\u003Ch2>commentary\u003C/h2>  \u003Cp>Silvestrini 2014 plausibly suggests that this is a dedication set up by L. Plinius L.f. Rufus, legatus pro praetore of Sextus Pompeius and praetor designate for 33 BC, already attested at Lilybaeum in ILLRP 426 = \u003Ca href=\"http://sicily.classics.ox.ac.uk/inscription/ISic000007\" target=\"_blank\">ISic000007\u003C/a>. The inscription is referenced within AE 2007.678-679, although neither lemma there concerns this text.\u003C/p>  \u003C/div>  \u003Cdiv id=\"bibliography\">\u003Ch2>bibliography\u003C/h2>  \u003Cul>\u0