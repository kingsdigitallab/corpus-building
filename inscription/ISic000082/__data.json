Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.terminus\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Boundary_marker\">terminus\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n                \u003Cchange when=\"2017-11-24\" who=\"#JP\">Jonathan Prag made general revisions on basis of Giustolisi 1999 (added to bibl), including adding text div\u003C/change>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n                \u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n                \u003Cchange when=\"2020-12-17\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n                \u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2026-06-10\" who=\"#RC\">Robert Crellin provided lemmatizations\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic000082_tiled.tif\" height=\"2024px\" width=\"3312px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2024-12-03\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic000082.jpg\" height=\"2024px\" width=\"3312px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2024-12-03\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\" resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cw n=\"5\">\u003Cexpan>\u003Cabbr>M\u003C/abbr>\u003Cex cert=\"low\">assa\u003C/ex>\u003C/expan>\u003C/w> \u003CplaceName>\u003Cw n=\"10\">\u003Cexpan>\u003Cabbr>Pici\u003Chi rend=\"supraline\">an\u003C/hi>\u003C/abbr>\u003Cex>ensis\u003C/ex>\u003C/expan>\u003C/w>\u003C/placeName>\n                    \u003Clb n=\"2\"/>\u003Cname>\u003Cw n=\"15\">\u003Csupplied reason=\"lost\">P\u003C/supplied>etri\u003C/w>\u003C/name> \u003Cw n=\"20\">\u003Cexpan>\u003Cabbr>ba\u003Chi rend=\"supraline\">c\u003C/hi>\u003C/abbr>\u003Cex>u\u003C/ex>\u003Cabbr>\u003Chi rend=\"supraline\">l\u003C/hi>\u003C/abbr>\u003Cex>um\u003C/ex>\u003C/expan>\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"Massa\">Massa\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"Picianensis\">Picianensis\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"Petrus\">Petri\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"baculum\">baculum\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of Bivona 1995\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>Giustolisi speculates that the C in line 2 might be a lunate sigma and so 'basilica' instead, but this seems rather hard to sustain without stronger grounds for the suggestion. The suggestion of Bivona is that this marks the boundary of a property of a church of St Peter.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003CcitedRange>1996.0811\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R46KDTZX\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001283\">https://biblio.inscriptiones.org/epig10001283\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Bivona\u003C/author>\n                        \u003Cdate>1997-1998\u003C/date>\n                        \u003CcitedRange>614\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/CK5K5DDG\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002144\">https://biblio.inscriptiones.org/epig10002144\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Bivona\u003C/author>\n                        \u003Cdate>1995\u003C/date>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/RSMZKCDQ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002136\">https://biblio.inscriptiones.org/epig10002136\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Giustolisi\u003C/author>\n                        \u003Cdate>1999\u003C/date>\n                        \u003CcitedRange>17\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GGJ4H43M\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001944\">https://biblio.inscriptiones.org/epig10001944\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
