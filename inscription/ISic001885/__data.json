                 \u003Cterm ana=\"#function.funerary\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Funerary\">funerary\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2026-06-10\" who=\"#JP\">Jonathan Prag created draft edition from photo and observation in exhibition\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001885_tiled.tif\" height=\"3901px\" width=\"3241px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2024-09-28\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001885.jpg\" height=\"3901px\" width=\"3241px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2024-09-28\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\" resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Csupplied reason=\"lost\">\u003Cexpan>\u003Cabbr>d\u003C/abbr>\u003Cex>is\u003C/ex>\u003C/expan>\u003C/supplied> \u003Cexpan>\u003Cabbr>m\u003C/abbr>\u003Cex>anibus\u003C/ex>\u003C/expan> \u003Cg ref=\"#ivy-leaf\">❦\u003C/g> \u003Cexpan>\u003Cabbr>s\u003C/abbr>\u003Cex>acrum\u003C/ex>\u003C/expan>\n                    \u003Clb n=\"2\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cw part=\"F\">nta\u003C/w>\u003C/name> \u003Cg ref=\"#interpunct\">·\u003C/g> \u003Cname>\u003Cw part=\"I\">Fla\u003C/w>\u003C/name>\u003C/persName>\n                     \u003Clb n=\"3\" break=\"no\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/> \u003Cg ref=\"#interpunct\">·\u003C/g> vixit \u003Cg ref=\"#interpunct\">·\u003C/g> \n                     \u003Clb n=\"4\"/>\u003Csupplied reason=\"lost\">an\u003C/supplied>nis \u003Cg ref=\"#interpunct\">·\u003C/g> \u003Cnum value=\"18\">XVIII\u003C/num>\n                    \u003Clb n=\"5\"/>\u003Csupplied reason=\"lost\">p\u003C/supplied>\u003Cunclear>a\u003C/unclear>ter fecit\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\u003Cnote>Text from autopsy/photograph\u003C/note>\u003C/app>\n                    \u003Capp loc=\"5\">\u003Cnote>Alternatively: [m]ater; the serif of the foot of the initial A is just visible.\u003C/note>\u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" resp=\"#JP\">\n                \u003Cp>Sacro agli dei Mani. [---]nta Fla[---] visse 18 anni. Il padre (o la madre) fece.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>Sacred to the shades of the underworld. [---]nta Fla[---] lived 18 years. Her father (or mother) made it.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>The first, fourth and fifth lines indicate that only 2-3 letters are missing on the left side, suggesting a pair of names such as Quinta Flavia (but many other names such as Amynta, Inventa, Leonta, etc. are also possible).\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                \u003Cbibl/>    \n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
