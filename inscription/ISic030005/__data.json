nguage> \n                \u003Clanguage ident=\"xly\">Elymian\u003C/language> \n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>  \n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>  \n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.defixio\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Defixio\">defixio\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2021-03-24\" who=\"#VM\">Valentina Mignosa created new file and added metadata\u003C/change>\n                \u003Cchange when=\"2026-07-31\" who=\"#JP\">Jonathan Prag added bibliography\u003C/change>\n                \u003Cchange when=\"2026-08-11\" who=\"#JP\">Jonathan Prag added identifiers and draft text\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic030005_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic030005.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/SEW88NC7\">\n                \u003Cdiv type=\"textpart\" subtype=\"face\" n=\"a\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>Σελιν\u003Csupplied reason=\"omitted\">ό\u003C/supplied>ντιος \u003Csupplied reason=\"lost\">\n                    \u003Clb n=\"2\"/>κ\u003C/supplied>\u003Cunclear>α\u003C/unclear>ὶ ͱα Σελινο\n                    \u003Clb n=\"3\" break=\"no\"/>ντίο̄ γλο͂σα ἀπεσ\n                    \u003Clb n=\"4\" break=\"no\"/>τραμέν’ ἐπ’ ἀτ\u003Csupplied reason=\"omitted\">ε\u003C/supplied>λ\n                    \u003Clb n=\"5\" break=\"no\"/>είαι τᾶι τέ̄|ν|ο̄ν | ἐν|γράφο̄\n                    \u003Clb n=\"6\"/>καὶ το͂ν ξένο̄ν συν\n                    \u003Clb n=\"7\" break=\"no\"/>δίϙο̄ν τὰς γλό̄σας ἀπε\n                    \u003Clb n=\"8\" break=\"no\"/>στραμένας ἐπ’ ἀτε\n                    \u003Clb n=\"9\" break=\"no\"/>λείαι τᾶι τέ̄νο̄ν\n                    \u003Clb n=\"10\"/>ἐνγρ\u003Cunclear>ά\u003C/unclear>φο̄\n                \u003C/ab>\n                \u003C/div>\n                  \u003Cdiv type=\"textpart\" subtype=\"face\" n=\"b\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>Τιμασὸ̄ι καὶ ͱα Τιμασο͂ς γλο͂σσα \u003Csupplied reason=\"lost\">ἀ\u003C/supplied>πεστραμέ\n                    \u003Clb n=\"2\" break=\"no\"/>ναν ἐπ’ ἀτελείαι τᾶι τέ̄νο̄ν ἐ\u003Csupplied reason=\"omitted\">ν\u003C/supplied>γράφο̄\n                    \u003Clb n=\"3\"/>Τυρρανὰ καὶ ͱα \u003Csupplied reason=\"lost\">Τυρρ\u003C/supplied>ανᾶς γλο͂σα \u003Csupplied reason=\"lost\">ἀπε\u003C/supplied>στρ\n                    \u003Clb n=\"4\" break=\"no\"/>αμέναν ἐπ’ ἀτελείαι τ\u003Csupplied reason=\"lost\">ᾶι\u003C/supplied> \u003Csupplied reason=\"lost\">τ\u003C/supplied>έ̄νο̄ν ἐ\u003Csupplied reason=\"omitted\">ν\u003C/supplied>γ\u003Csupplied reason=\"lost\">ράφο̄\u003C/supplied> πάντο̄ν\n                \u003C/ab>\n                \u003C/div>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Bettarini 2005 (the line divisions follow Bettarini, but note that individual elements of some lines, such as a.5 and b.4 are severely disjointed and separated in their placing on the disc.\u003C/note>\n                    \u003C/app>\n                   \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\"> \u003C!-- add other editions -->\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Comparetti\u003C/author>\n                        \u003Cdate>1918\u003C/date>\n                        \u003CcitedRange>193-197\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/6F4NP6IC\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002434\">https://biblio.inscriptiones.org/epig10002434\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Arangio-Ruiz and Olivieri\u003C/author>\n                        \u003Cdate>1925\u003C/date>\n                        \u003CcitedRange>160-164 no. 23\u003C/citedRange>\n                        \u003Cptr target=\"