ho=\"#ZL\">tagged names and persons\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic002996_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic002996.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#VM\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"divine\">\u003Cname>Π\n                    \u003Clb n=\"2\" break=\"no\"/>αίδ\n                    \u003Clb n=\"3\" break=\"no\"/>εσσι\u003C/name>\u003C/persName> κ\n                    \u003Clb n=\"4\" break=\"no\"/>\u003Csupplied reason=\"lost\">αὶ\u003C/supplied> \u003CpersName type=\"divine\">\u003Cname>\u003Csupplied reason=\"lost\">Ἄννᾳ\u003C/supplied>\u003C/name>\u003C/persName>\n                    \u003Clb n=\"5\"/>ἐπὶ ἀμφι\n                    \u003Clb n=\"6\" break=\"no\"/>πόλου τᾶ\n                    \u003Clb n=\"7\" break=\"no\"/>ν \u003CpersName type=\"divine\">\u003Cname>Παίδων\u003C/name>\u003C/persName>\n                    \u003Clb n=\"8\"/>καὶ τᾶς \u003CpersName type=\"divine\">\u003Cname>Ἄ\n                    \u003Clb n=\"9\" break=\"no\"/>ννας\u003C/name>\u003C/persName>\n                    \u003Clb n=\"10\"/>\u003Corig>ΑΠ\u003C/orig>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Orsi 1899\u003C/note> \u003C!-- but check Guarducci 1936 -->\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--paidessi kai Annai epi amphipolou tan Paidown kai tas Annas. This and the others from a cave at Buscemi, nr. Acrae; cf. the others published best also in PdP 6 (1951), and also IG XIV.204 (Acrae) for related 'hagnai theai'; P-C discusses other relevant material also. In general, note the Roman names in most of these; also the persistence of the amphipolis at Syracuse (cf. DS XVI.70.6), and the  amphipolis of the Paides, probably the eponymous amphipolis for Acrae (presumably the local city concerned). P-C observes that the 'koreion' attested in IG XIV.217 could perhaps be associated with this cult also, although P-C thinks that the Demeter-Korai and Paides cults should be kept separate in this case, although considerable overlap generally likely / common. The material in the cave doesn't go back past the C3 BC, and the whole institution is presumaly Timoleontic or later. cf. ASNP 1981, p.1069ff for 2 oracle inscrs. from Akrai region with mentions of Nymphs and Paides.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1992\u003C/date>\n                        \u003CcitedRange>42.0825\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"BE\">\n                        \u003Cdate>1952\u003C/date>\n                        \u003CcitedRange>199\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/77P5MNIR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001282\">https://biblio.inscriptiones.org/epig10001282\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Pugliese Carratelli\u003C/author>\n                        \u003Cdate>1951\u003C/date>\n                        \u003CcitedRange>69 no.1\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/HRATE8IJ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001450\">https://biblio.inscriptiones.org/epig10001450\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"NSA\">\n                        \u003Cauthor>Orsi\u003C/author>\n                        \u003Ctitle>NSA\u003C/title>\n                        \u003Cdate>1899\u003C/date>\n                        \u003CcitedRange>456 no.2 ph\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/4MCP2PVV\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001392\">https://biblio.inscriptiones.org/epig10001392\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"SGDI\">\n                        \u003Cauthor>Hoffmann\u003C/author>\n                        \u003Cdate>1904\u003C/date>\n                        \u003CcitedRange>5256\u00