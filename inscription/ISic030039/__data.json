ange>51\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/KK5FQVHF\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000282\">https://biblio.inscriptiones.org/epig10000282\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Jordan\u003C/author>\n                        \u003Cdate>1985\u003C/date>\n                        \u003CcitedRange>177-178 (unnumbered)\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/7UQBFBPB\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001391\">https://biblio.inscriptiones.org/epig10001391\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Curbera\u003C/author>\n                        \u003Cdate>1999\u003C/date>\n                        \u003CcitedRange>181 no. 51\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/9DL74VZN\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002060\">https://biblio.inscriptiones.org/epig10002060\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
