riptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.letter\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Letter\" cert=\"low\">letter\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n              \u003Cchange when=\"2026-08-17\" who=\"#JP\">Jonathan Prag created draft file\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic030039_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic030039.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\">\n                \u003Cdiv type=\"textpart\" subtype=\"face\" n=\"a\">\n               \u003Cab>\n                    \u003Clb n=\"1\"/>Εὐο̄πίδας hιάλε̄\n                   \u003Clb n=\"2\"/>Διεύχε̄ς \u003Cg ref=\"#dipunct\">⁚\u003C/g> λοχαγὸς\n                   \u003Clb n=\"3\"/>Δαῖτις\n               \u003C/ab>\n                \u003C/div>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n      