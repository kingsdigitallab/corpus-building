3C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic003641.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#VM\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Csupplied reason=\"lost\">Τειχῶν\u003C/supplied> \u003CroleName type=\"civic\" subtype=\"epistates\">\u003Csupplied reason=\"lost\">ἐπιστάτ\u003C/supplied>\n                    \u003Clb n=\"2\" break=\"no\"/>αι\u003C/roleName> καὶ \u003CroleName type=\"civic\" subtype=\"agoranomos\">ἀγορα\n                    \u003Clb n=\"3\" break=\"no\"/>\u003Csupplied reason=\"lost\">νόμοι\u003C/supplied>\u003C/roleName> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/> \u003Csupplied reason=\"lost\">τοῦ\u003C/supplied>\n                    \u003Clb n=\"4\"/>\u003CpersName type=\"divine\">\u003Cname>Δαματρίου\u003C/name>\u003C/persName>\n                    \u003Clb n=\"4a\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"line\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Manganaro 1965\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\