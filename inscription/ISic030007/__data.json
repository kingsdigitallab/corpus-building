                 \u003CtextLang mainLang=\"grc\">Ancient Greek\u003C/textLang>    \n                    \u003C/msContents>\n                    \u003CphysDesc>\n                        \u003CobjectDesc>\n                            \u003CsupportDesc>\n                                \u003Csupport>\n                                    \u003Cp>Lamina\u003C/p>\n                                    \u003Cmaterial ana=\"#material.inorganic.metal.lead\" type=\"metal.lead\" subtype=\"unverified\" ref=\"https://www.eagle-network.eu/voc/material/lod/108.html\">lead\u003C/material>\n                                    \u003CobjectType ana=\"#object.lamina\" ref=\"https://www.eagle-network.eu/voc/objtyp/lod/145.html\">lamina\u003C/objectType>\n                                    \u003Cdimensions>\n                                        \u003Cheight unit=\"cm\"/> \u003C!-- add value -->\n                                        \u003Cwidth unit=\"cm\"/>\n                                        \u003Cdepth unit=\"cm\"/>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition/>\n                            \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\n                                    \u003Crs ana=\"#execution.engraved\" ref=\"https://www.eagle-network.eu/voc/writing/lod/3.html\">engraved\u003C/rs>\n                                    \u003Cp/>\n                                    \u003Cdamage/>\n                                \u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\n                                \u003C!-- Based on Glyph table: -->\n                                \u003Clocus from=\"line1\" to=\"line1\">Line 1\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462489\">Selinus\u003C/placeName>\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2523164/\">Selinunte\u003C/placeName>\n                                \u003Cgeo>37.58337, 12.82522\u003C/geo>\n                            \u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" evidence=\"lettering archaeological-context\" notBefore-custom=\"-0500\" notAfter-custom=\"-0451\">First half of 5th century BCE (Bettarini)\u003C/origDate> \n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\">Found in the sanctuary of Malophoros, loc. Gaggera, archaeological area of Selinunte.\u003C/provenance>\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">No Autopsy\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n            \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n            \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                \u003Cxi:fallback>\n                    \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                \u003C/xi:fallback>\n            \u003C/xi:include>             \n            \u003Cxi:include href=\"../alists/charDecl.xml\">                 \n                \u003Cxi:fallback>                     \n                    \u003Cp>ISicily glyphs authority list\u003C/p>                 \n                \u003C/xi:fallback>             \n            \u003C/xi:include>         \n        \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language> \n                \u003Clanguage ident=\"it\">Italian\u003C/language> \n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language> \n                \u003Clanguage ident=\"la\">Latin\u003C/language> \n                \u003Clanguage ident=\"he\">Hebrew\u003C/language> \n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language> \n                \u003Clanguage ident=\"xly\">Elymian\u003C/language> \n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>  \n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>  \n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.defixio\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Defixio\">defixio\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2021-03-24\" who=\"#VM\">Valentina Mignosa created new file and added metadata\u003C/change>\n                \u003Cchange when=\"2026-07-31\" who=\"#JP\">Jonathan Prag added bibliography\u003C/change>\n                \u003Cchange when=\"2026-08-11\" who=\"#JP\">Jonathan Prag added draft text\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!-- \n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic030007_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic030007.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/SEW88NC7\"> \n                \u003Cab>\n                    \u003Clb n=\"1\"/>\t\u003Csupplied reason=\"lost\">Ἀ\u003C/supplied>πελον τὸν Λυκίνο̄ κα\u003Csurplus>κα\u003C/surplus>ταγράφο̄ πὰρ τὰν ͱαγνὰν\n                    \u003Clb n=\"2\"/>\u003Csupplied reason=\"lost\">θ\u003C/supplied>εὸν τὰν ψυχὰν αὐτο͂ καὶ τὰν δύνασιν καὶ Λυκῖνον\n                    \u003Clb n=\"3\"/>τὸν ͱάλο̄ ͱυιὸν καὶ τὸν ἀδελφεὸν αὐτο͂· καὶ αὐτὸν\n                    \u003Clb n=\"4\"/>πὰρ τὰν ͱαγνὰν θεὸν τὸν Ναύερο\u003Csupplied reason=\"omitted\">ν\u003C/supplied> τὸν ͱάλο̄ ͱυιὸν\n                    \u003Clb n=\"5\"/>καὶ Βοτυλον τὸν Ταμίραντος καὶ τὸ̄ς ͱυιὸ̄ς καὶ Σαριν\n                    \u003Clb n=\"6\"/>καὶ Ἀπελον καὶ Ῥο͂μιν τὸν Καιλίο̄\u003Csurplus>ν\u003C/surplus> πὰρ τὰν ͱαγνὰ\u003Csupplied reason=\"omitted\">ν\u003C/supplied> θε\n                    \u003Clb n=\"7\" break=\"no\"/>ὸν καὶ τὸ̄ς ͱυιὸ̄ς καὶ Σαριν τὸν Πυρίνο̄ καὶ Πύρον\n                    \u003Clb n=\"8\"/>τὸν Πύρο̄\u003Csurplus>ν\u003C/surplus> πὰρ τὰν ͱαγνὰν θεόν· καὶ τὸ̄ς Ῥοτύ\n                    \u003Clb n=\"9\" break=\"no\"/>λο̄ ͱυιὸ̄ς το͂ Πύρο̄ πὰρ τὰν ͱαγνὰν θεὸν καὶ\n                    \u003Clb n=\"10\"/>δύνασιν καὶ γλό̄σας· Πλακίταν τὸν Ναννελαίο̄\n                    \u003Clb n=\"11\"/>καὶ ͱάλον τὸν Πυκελεί\u003Csupplied reason=\"omitted\">ο̄\u003C/supplied> ἐγὸ̄ τὰν ψυχὰν καταγρά\n                    \u003Clb n=\"12\" break=\"no\"/>φο̄ πὰρ τὰν ͱαγνὰν θεὸν καὶ δύνασιν αὐτο͂\u003Csupplied reason=\"lost\">ν\u003C/supplied>·\n                    \u003Clb n=\"13\"/>Καδοσιν τὸν Ματυλαίο̄ καὶ Ἐκοτιν τὸν Μάγο̄\u003Cunclear>ν\u003C/unclear>\u003Csupplied reason=\"omitted\">ος\u003C/supplied>\n                    \u003Clb n=\"14\"/>\u003Cunclear>ἐ\u003C/unclear>νκαταγρά\u003Csurplus>ο\u003C/surplus>φο̄ πὰρ τὰν ͱαγνὰν θεὸν τὰ\u003Csupplied reason=\"omitted\">ν\u003C/supplied> ψυχὰν\n                    \u003Clb n=\"15\"/>αὐτο͂ν· τὸν Φο\u003Csupplied reason=\"omitted\">ί\u003C/supplied>νικος ͱυιὸν το͂ Καιλίο̄ καταγράφο̄\n                    \u003Clb n=\"16\"/>πὰρ τὰν ͱαγνὰν θεόν. Ἀπελος Λυκίνο̄, Λυκῖνος Πύρο̄,\n                    \u003Clb n=\"17\"/>Νανελαιος, Ἐϙοτις Μάγο̄νος, ͱαλος Πυκελείο̄\u003Csurplus>ν\u003C/surplus>, Ῥο͂μις Καιλ\n                    \u003Clb n=\"18\" break=\"no\"/>ίο̄\u003Csurplus>ν\u003C/surplus>, Ἀπελος ͱο Φοίνιϙος, Τιτελος Φοίνιϙος, Ἀτος Ναυεριάδα,\n                    \u003Clb n=\"19\"/>Τιτελος Νανελαίο̄\u003Csurplus>ν\u003C/surplus>, Σαρις Ῥόμιος.\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Bettarini no.23\u003C/note>\n                    \u003C/app>\n                    \u003Capp>\n                        \u003Cnote/>\n                    \u003C/app>\n                    \u003Capp>\n                        \u003Cnote/>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\"> \u003C!-- add other editions -->\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IGASM1\">\n                        \u003Cauthor>Arena\u003C/author>\n                        \u003Cdate>1989\u003C/date>\n                        \u003CcitedRange>63\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/VC9IHZAR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000638\">https://biblio.inscriptiones.org/epig10000638\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1959\u003C/date>\n                        \u003CcitedRange>16.0573\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IGDS1\">\n                        \u003Cauthor>Dubois\u003C/author>               \n                      