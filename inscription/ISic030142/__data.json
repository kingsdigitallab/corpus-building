002762\u003C/a>  \u003C/li>\u003Cli> Cordano 2020 263-266 fig.2 \u003Ca href=\"https://biblio.inscriptiones.org/epig10002276\" target=\"_blank\">https://biblio.inscriptiones.org/epig10002276\u003C/a>  \u003C/li>\u003C/ul>  \u003Cul>\u003Cli> 2002 52.0920 \u003Ca href=\"https://biblio.inscriptiones.org/epig10000796\" target=\"_blank\">https://biblio.inscriptiones.org/epig10000796\u003C/a>\u003C/li>\u003Cli> 2004 54.0892 \u003Ca href=\"https://biblio.inscriptiones.org/epig10000796\" target=\"_blank\">https://biblio.inscriptiones.org/epig10000796\u003C/a>\u003C/li>\u003C/ul>  ",{"id":233,"html":234},"license"," Licensed under a Creative Commons-Attribution 4.0 licence. ",[236,238,241,242],{"html":237},"Text encoding: Valentina Mignosa",{"id":239,"lang":113,"html":240},"edition-interpretive","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΤΑΙΝ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">⁦ - - - - - - - - - - ⁩\u003C/span>] \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">⁦ - - - - - - - - - - ⁩\u003C/span>]-\u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>κ̣ας \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Θράσυς Ἐμ\n                    μενίδας Δορι\n                    στόνφο̄ν\">\u003Cspan data-type=\"name\" data-name-type=\"idionym\" data-text=\"Θράσυς\">Θράσυς\u003C/span>  \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Ἐμ\n                    μενίδας Δορι\n                    στόνφο̄ν\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Ἐμ\n                    μενίδας\">Ἐμ-\u003Cbr 