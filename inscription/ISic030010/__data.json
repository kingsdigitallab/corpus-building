sc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462489\">Selinus\u003C/placeName>\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2523164\">Selinunte\u003C/placeName> \n                                \u003Cgeo>37.58337, 12.82522\u003C/geo>\n                            \u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" evidence=\"lettering archaeological-context\" notBefore-custom=\"-0500\" notAfter-custom=\"-0451\">500-451 BCE\u003C/origDate> \n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\">Found in the necropolis in Contrada Buffa\u003Cgeo>37.59873, 12.83127\u003C/geo>.\u003C/provenance> \n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">No Autopsy\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n            \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n            \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                \u003Cxi:fallback>\n                    \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                \u003C/xi:fallback>\n            \u003C/xi:include>             \n            \u003Cxi:include href=\"../alists/charDecl.xml\">                 \n                \u003Cxi:fallback>                     \n                    \u003Cp>ISicily glyphs authority list\u003C/p>                 \n                \u003C/xi:fallback>             \n            \u003C/xi:include>         \n        \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language> \n                \u003Clanguage ident=\"it\">Italian\u003C/language> \n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language> \n                \u003Clanguage ident=\"la\">Latin\u003C/language> \n                \u003Clanguage ident=\"he\">Hebrew\u003C/language> \n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language> \n                \u003Clanguage ident=\"xly\">Elymian\u003C/language> \n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>  \n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>  \n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.defixio\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Defixio\">defixio\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2021-03-24\" who=\"#VM\">Valentina Mignosa created new file and added metadata\u003C/change>\n                \u003Cchange when=\"2021-06-15\" who=\"#SN\">Savannah Neibart encoded inscription using data from ISicDef, supplemented by Bettarini\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic030010_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic030010.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#SN\"> \n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname type=\"idionym\">Χάμις\u003C/name>\u003C/persName> ἐπέ\u003Cunclear>χ\u003C/unclear>ο̄\n                    \u003Clb n=\"2\"/>κα\u003Csupplied reason=\"omitted\">ὶ\u003C/supplied> νόσο̄ ῥοπᾶι\n                    \u003Clb n=\"3\"/>ἐπ’ ἀτελείαι ℎο\n                    \u003Clb n=\"4\" break=\"no\"/>\u003Cunclear>τ\u003C/unclear>\u003Csupplied reason=\"lost\">ι\u003C/supplied> \u003Corig>ΚΑ\u003C/orig>\u003Cgap reason=\"lost\" quantity=\"2\" unit=\"character\"/>\u003Corig>\u003Cunclear>Ε\u003C/unclear>\u003C/orig>\u003Cgap reason=\"lost\" quantity=\"2\" unit=\"character\"/>\u003Corig>\u003Cunclear>Ο\u003C/unclear>ΝΤΙ\u003C/orig>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Bettarini\u003C/note>\n                    \u003C/app>\n                  \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"fr\">\n                \u003Cp>Je te maintiens dans la crise fatale de la maladie afin que tu ne puisses atteindre tes objectifs.(Dubois)\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" resp=\"#VM\">\n                \u003Cp>Chamis ti conduco alla fase critica della malattia perché tu non possa portare a termine ...\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp xml:lang=\"fr\">Il doit s'agir d'une imprécation contre un grabataire dont l'impotence réjouit le rédacteur de la tablette. (Dubois)\u003C/p>\n                \u003Cp xml:lang=\"es\">A pesar de su brevedad, èste es uno de los documentos que demuestra un estilo màas refinado, con una figura insòlita como es la metáfora, y un verbo también inusual, ἐπέχω, que hacen de ella una de las defixiones de mayor originalidad. (Lopez-Jimeno)\u003C/p>\n                \u003Cp xml:lang=\"it\">Questa lamina ci offre l'occasione di rivedere l'abusato cliché che vuole le defixiones redatte unicamente secondo formule stereotipe. Il problema interpretativo riguarda le prime due linee, dove a una sequenza iniziale certamente di tipo onomastico segue il verbo επεχω - un unicum nelle maledizioni - e la singolare espressione νόσου ῥοπα. Pare evidente quindi che la volontà di chi ha inciso la lamina è di condurre (επεχω) il defisso alla \"fase critica della malattia\", evidentemente per procurarne la morte. (Bettarini)\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\"> \n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IGASM1\">\n                        \u003Cauthor>Arena\u003C/author>\n                        \u003Cdate>1989\u003C/date>\n                        \u003CcitedRange>no. 66\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/VC9IHZAR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000638\">https://biblio.inscriptiones.org/epig10000638\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Brugnone\u003C/author>\n                        \u003Cdate>1976\u003C/date>\n                        \u003CcitedRange>81-83, no. 4\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/isicily/items/IEFIMGIK\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002280\">https://biblio.inscriptiones.org/epig10002280\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Jordan\u003C/author>\n                        \u003Cdate>1985\u003C/date>\n                        \u003CcitedRange>175, no. 97\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/7UQBFBPB\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001391\">https://biblio.inscriptiones.org/epig10001391\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IGDS1\">\n                         \u003Cauthor>Dubois\u003C/author>      \n                        \u003Cdate>1989\u003C/date>\n                        \u003CcitedRange>\u003Cref target=\"http://www.persee.fr/doc/efr_0000-0000_1989_cat_119_1\">32\u003C/ref>\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/isicily/items/RWXNUFEX\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000187\">https://biblio.inscriptiones.org/epig10000187\u003C/ref>\u003C/bibl>\n                   \u003Cbibl>\n                       \u003Cauthor>López-Jimeno\u003C/author>\n                        \u003Cdate>1991\u003C/date>\n                        \u003CcitedRange>no. 7\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/N5IF2DZR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001858\">https://biblio.inscriptiones.org/epig10001858\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1976-1977\u003C/date>\n                        \u003CcitedRange>26.0111\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Curbera\u003C/author>\n                        \u003Cdate>1999\u003C/date>\n                        \u003CcitedRange>178, no. 20\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/9DL74VZN\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002060\">https://biblio.inscriptiones.org/epig10002060\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Bettarini\u003C/author>\n                        \u003Cdate>2005\u003C/date>\n                        \u003CcitedRange>17\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/isicily/items/SEW88NC7\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001388\">https://biblio.inscriptiones.org/epig10001388\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                  \u003Cbibl>\u003C/bibl>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
