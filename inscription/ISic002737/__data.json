to 2012 314 \u003Ca href=\"https://biblio.inscriptiones.org/epig10001557\" target=\"_blank\">https://biblio.inscriptiones.org/epig10001557\u003C/a>  \u003C/li>\u003Cli> Ampolo and Erdas 2019 L8 \u003Ca href=\"https://biblio.inscriptiones.org/epig10001036\" target=\"_blank\">https://biblio.inscriptiones.org/epig10001036\u003C/a>  \u003C/li>\u003C/ul>  \u003Cul>\u003Cli>\u003C/li>\u003C/ul>  ",{"id":306,"html":307},"handnote","\u003Cp>Slightly irregular letters iwth a broad square module, but narrower towards the end of each line. E has upward curling serifs; triangular interpuncts; final A of line 3 is small, at 29mm.\u003C/p> Line 1-4  52-61  Interlineation line 1 to 2    ",{"id":309,"html":310},"license"," Licensed under a Creative Commons-Attribution 4.0 licence. ",[312,314,317,318],{"html":313},"Text encoding: Jonathan Prag; edition source: \u003Ca href=\"https://www.zotero.org/groups/382445/items/3PK3JKXR\">https://www.zotero.org/groups/382445/items/3PK3JKXR\u003C/a>",{"id":315,"lang":138,"html":316},"edition-interpretive","\u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>L(ucio) · Iulio · C(aii) · f(ilio) · Agrippae \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>euergetae · \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>hic · plateam · a · Sosi\u003Cspan class=\"small\" title=\"small character: a\">a\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>usque · ad · fanum · \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"html":313},{"id":319,"lang":138,"html":320},"edition-diplomatic","\u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-diplomatic\">\u003Ca id=\"al1-diplomatic\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>L·IULIO·C·F·AGRIPPAE\u003Cbr id=\"al2-diplomatic\">\u003Cspan class=\"linenumber\">2\u003C/span>EUERGETAE·\u003Cbr id=\"al3-diplomatic\">\u003Cspan class=\"linenumber\">3\u003C/span>HIC·PLATEAM·A·SOSI\u003Cspan class=\"small\" title=\"small character: a\">A\u003C/span>\u003Cbr id=\"al4-diplomatic\">\u003Cspan class=\"linenumber\">4\u003C/span>USQUE·AD·FANUM·\u003C/span>\u003C/div>\u003Cp class=\"miniapp\">\u003C/p>",[],[323],{"html":64},"\u003C?xml version='1.0' encoding='UTF-8'?>\n\u003C?xml-model href=\"https://epidoc.stoa.org/schema/latest/tei-epidoc.rng\" type=\"application/xml\" schematypens=\"http://relaxng.org/ns/structure/1.0\"?>\n\u003C?xml-model href=\"../schematron/ircyr-checking.sch\" schematypens=\"http://purl.oclc.org/dsdl/schematron\"?>\n\u003CTEI xmlns=\"http://www.tei-c.org/ns/1.0\" xmlns:xi=\"http://www.w3.org/2001/XInclude\" xml:lang=\"en\">\n    \u003CteiHeader>\n        \u003CfileDesc>\n            \u003CtitleStmt>\n                \u003Ctitle>Honorific for Lucius Iulius Agrippa, euergetes\u003C/title>\n                \u003Ceditor ref=\"#JP\">Jonathan Prag\u003C/editor>\n                \u003Cprincipal ref=\"#JP\">Jonathan Prag\u003C/principal>\n                \u003Cfunder>John Fell OUP Research Fund\u003C/funder>\n\t   \u003Cfunder>\u003Cref target=\"https://cordis.europa.eu/project/id/885040\">ERC Advanced Grant no.885040\u003C/ref>\u003C/funder>\n                \u003CrespStmt>\n                    \u003Cname xml:id=\"JP\" ref=\"http://orcid.org/0000-0003-3819-8537\">Jonathan Prag\u003C/name>\n                    \u003Cresp>original data collection and editing\u003C/resp>\n                \u003C/respStmt>\n                \u003CrespStmt>\n                    \u003Cname xml:id=\"JCu\" ref=\"http://orcid.org/0000-0002-6686-3728\">James Cummings\u003C/name>\n                    \u003Cresp>conversion to EpiDoc\u003C/resp>\n                \u003C/respStmt>\n\t    \u003CrespStmt>\n     \t       \u003Cname xml:id=\"SS\" ref=\"https://orcid.org/0000-0003-3914-9569\">Simona Stoyanova\u003C/na