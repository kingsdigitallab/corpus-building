narrower towards the end of each line. E has upward curling serifs; triangular interpuncts; final A of line 3 is small, at 29mm.\u003C/p>\n                                \u003Clocus from=\"line1\" to=\"line4\">Line 1-4\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"52\" atMost=\"61\">52-61\u003C/height>\n                                \u003C/dimensions>\n                                \u003Clocus from=\"line1\" to=\"line2\">Interlineation line 1 to 2\u003C/locus>\n                                \u003Cdimensions type=\"interlinear\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"https://pleiades.stoa.org/places/462487\">Segesta\u003C/placeName>\t\t\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2523171\">Segesta\u003C/placeName>\n                            \t\u003Cgeo>37.94171, 12.83649\u003C/geo>\n\t\t\u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" notBefore-custom=\"0014\" notAfter-custom=\"0054\" evidence=\"lettering nomenclature\">Suggested to be Tiberian or Claudian on palaeographic and onomastic grounds\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\" when=\"1992-05\">Found in May 1992, in the fill of the base of the temple on the west side of the agora, in a mediaeval layer\u003Cgeo>37.9396551,12.8418013\u003C/geo>\u003C/provenance>\u003C!-- findspot as marked on fig.138 of I.Segesta, located on googlemaps -->\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">None\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n             \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n             \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                 \u003Cxi:fallback>\n                     \u003Cp>Taxonomies for ISicily controlled values\u003C/p>\n                 \u003C/xi:fallback>\n             \u003C/xi:include>\n\t  \u003Cxi:include href=\"../alists/charDecl.xml\">\n\t     \u003Cxi:fallback>\n\t       \u003Cp>ISicily glyphs authority list\u003C/p>\n\t     \u003C/xi:fallback>\n\t   \u003C/xi:include>\n         \u003C/encodingDesc>\n        \u003CprofileDesc>\n            \u003CcalendarDesc>\n                \u003Ccalendar xml:id=\"julian\">\n                    \u003Cp>Julian Calendar\u003C/p>\n                \u003C/calendar>\n            \u003C/calendarDesc>\n            \u003ClangUsage>\n                \u003Clanguage ident=\"en\">English\u003C/language>\n                \u003Clanguage ident=\"it\">Italian\u003C/language>\n                \u003Clanguage ident=\"grc\">Ancient Greek\u003C/language>\n                \u003Clanguage ident=\"la\">Latin\u003C/language>\n                \u003Clanguage ident=\"he\">Hebrew\u003C/language>\n                \u003Clanguage ident=\"phn\">Phoenician\u003C/language>\n                \u003Clanguage ident=\"xpu\">Punic\u003C/language>\n                \u003Clanguage ident=\"osc\">Oscan\u003C/language>\n                \u003Clanguage ident=\"xly\">Elymian\u003C/language>\n                \u003Clanguage ident=\"scx\">Sikel\u003C/language>\n                \u003Clanguage ident=\"sxc\">Sikan\u003C/language>\n            \u003C/langUsage>\n            \u003CtextClass>\n                \u003Ckeywords scheme=\"https://ontology.inscriptiones.org/type_of_inscription\">\n                    \u003Cterm ana=\"#function.honorific\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Honorific\">honorific\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n                \u003Cchange when=\"2019-09-23\" who=\"#JP\">Jonathan Prag added ISegesta ref\u003C/change>\n            \t   \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n            \t   \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n            \t\u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n\t\t\u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n\t    \u003Cchange when=\"2020-12-23\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n            \t\u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2025-07-04\" who=\"#JP\">Jonathan Prag revised from publication\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!-- \n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic002737_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic002737.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\" resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/3PK3JKXR\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cexpan>\u003Cabbr>L\u003C/abbr>\u003Cex>ucio\u003C/ex>\u003C/expan> \u003Cg ref=\"#interpunct\">·\u003C/g> Iulio \u003Cg ref=\"#interpunct\">·\u003C/g> \u003Cexpan>\u003Cabbr>C\u003C/abbr>\u003Cex>aii\u003C/ex>\u003C/expan> \u003Cg ref=\"#interpunct\">·\u003C/g> \u003Cexpan>\u003Cabbr>f\u003C/abbr>\u003Cex>ilio\u003C/ex>\u003C/expan> \u003Cg ref=\"#interpunct\">·\u003C/g> Agrippae\n                    \u003Clb n=\"2\"/>euergetae \u003Cg ref=\"#interpunct\">·\u003C/g>\n                    \u003Clb n=\"3\"/>hic \u003Cg ref=\"#interpunct\">·\u003C/g> plateam \u003Cg ref=\"#interpunct\">·\u003C/g> a \u003Cg ref=\"#interpunct\">·\u003C/g> Sosi\u003Chi rend=\"small\">a\u003C/hi>\n                    \u003Clb n=\"4\"/>usque \u003Cg ref=\"#interpunct\">·\u003C/g> ad \u003Cg ref=\"#interpunct\">·\u003C/g> fanum \u003Cg ref=\"#interpunct\">·\u003C/g>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\" resp=\"#JP\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text of I.Segesta, with the addition of interpunctuation on the basis of photograph\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>To Lucius Iulius Agrippa, son of Gaius, euergetes. This man (was responsible for) the street from Sosia all the way to the temple\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#JP\">\n                \u003Cp>The stone is presumably a plaque to be affixed to a statue base, with the word 'hic' referring to the statue of the honorand. Euergetes is the first instance of this Greek word as a calque in Latin. 'a Sosia' presumably refers to a location within the city, and has been suggested to refer to a statue (Dubois), or perhaps a platea or via.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003Cdate>1997\u003C/date>\n                        \u003CcitedRange>740\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R46KDTZX\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001283\">https://biblio.inscriptiones.org/epig10001283\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003Cdate>2000\u003C/date>\n                        \u003CcitedRange>640\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R46KDTZX\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001283\">https://biblio.inscriptiones.org/epig10001283\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"BE\">\n                        \u003Cdate>1998\u003C/date>\n                        \u003CcitedRange>608\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/77P5MNIR\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001282\">https://biblio.inscriptiones.org/epig10001282\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Nenci\u003C/author>\n                        \u003Cdate>1995\u003C/date>\n                        \u003CcitedRange>1184 no.11\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/WHBJDH75\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001415\">https://biblio.inscriptiones.org/epig10001415\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Michelini\u003C/author>\n                        \u003Cdate>1997\u003C/date>\n                        \u003CcitedRange>n.12\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/U7GGTWQM\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001746\">https://biblio.inscriptiones.org/epig10001746\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Nenci\u003C/author>\n                        \u003Cdate>1997\u003C/date>\n                        \u003CcitedRange>1193 tav.CCXXXV.2\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/4FSSHE62\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001729\">https://biblio.inscriptiones.org/epig10001729\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Paci\u003C/author>\n                        \u003Cdate>2008\u003C/date>\n                        \u003CcitedRange>333-334\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Z54HF9PD\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001687\">https://biblio.inscriptiones.org/epig10001687\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Tribulato\u003C/author>\n                        \u003Cdate>2012\u003C/date>\n                        \u003CcitedRange>314\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/X5ZZ4GPT\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001557\">https://biblio.inscriptiones.org/epig10001557\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Ampolo and Erdas\u003C/author>\n                        \u003Cdate>2019\u003C/date>\n                        \u003CcitedRange>L8\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/3PK3JKXR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001036\">https://biblio.inscriptiones.org/epig10001036\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
