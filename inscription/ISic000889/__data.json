03CphysDesc>\n                        \u003CobjectDesc>\n                            \u003CsupportDesc>\n                                \u003Csupport>\n                                    \u003Cp>Plastered front of a trisome arcosolium.\u003C/p>\n                                    \u003Cp>For the four impressions on the tabula see: \u003Cref target=\"http://sicily.classics.ox.ac.uk/inscription/ISic010005.xml\">ISic010005\u003C/ref>.\u003C/p>\n                                    \u003Cp>A fifth impression of the same signaculum can be found on another tomb, see \u003Cref target=\"http://sicily.classics.ox.ac.uk/inscription/ISic010006.xml\">ISic010006\u003C/ref>.\u003C/p>\n                                    \u003CobjectType ana=\"#object.funerary_monument.tomb\" ref=\"https://www.eagle-network.eu/voc/objtyp/lod/447.html\">arcosolium\u003C/objectType>\n                                    \u003Cmaterial type=\"inorganic.stone\" subtype=\"unverified\">plaster\u003C/material>\n                                    \u003Cdimensions>\n                                        \u003Cheight unit=\"cm\">23\u003C/height>\n                                        \u003Cwidth unit=\"cm\">67\u003C/width>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition ana=\"#condition.damaged\"/>\n                            \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\n                                    \u003Cp>Scratched inscription in the middle, surrounded by four impressions of the same circular \u003Crs ana=\"#signaculum.circular\">signaculum\u003C/rs> impressed on the four corners of a rectangular tabula etched in fresco \n                                        on the plaster. Epigraphic field divided into two concentric registers delimited by a linear frame.\u003C/p>\n                                    \u003Crs ana=\"#execution.scratched\" ref=\"http://www.eagle-network.eu/voc/writing/lod/9 \">scratched\u003C/rs>\n                                    \u003Crs ana=\"#execution.rubrication.red\">Rubrication, red coloured\u003C/rs>\n                                \t\u003Cdamage ana=\"#text_condition.incomplete\"/>\n\t\t\t\u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\n                                \u003Cp>Letters are painted in red.\u003C/p>\n                                \u003Cp>Omicron and sigma small and stacked one on top of the other.\u003C/p>\n                                \u003Clocus from=\"line1\" to=\"line1\">Line 1\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"50\" atMost=\"50\">50\u003C/height>\n                                \u003C/dimensions>\n                                \u003Clocus from=\"line1\" to=\"line2\">Interlineation line 1 to 2\u003C/locus>\n                                \u003Cdimensions type=\"interlinear\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462503\">Syracusae\u003C/placeName>\t\t\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/2523083\">Siracusa\u003C/placeName>\n                                \u003Cgeo>37.08415, 15.27628\u003C/geo>\n                            \u003C/origPlace>         