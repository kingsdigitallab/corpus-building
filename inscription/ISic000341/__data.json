ll’Identità Siciliana; photo Liceo Lazzaro 2017-04-27\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic000341_rear.jpg\" height=\"3168px\" width=\"4752px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo Liceo Lazzaro 2017-04-27\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\" resp=\"#TG\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cexpan>\u003Cabbr>d\u003C/abbr>\u003Cex>is\u003C/ex>\u003C/expan> \u003Cg ref=\"#interpunct\">·\u003C/g> \u003Cexpan>\u003Cabbr>m\u003C/abbr>\u003Cex>anibus\u003C/ex>\u003C/expan> \u003Cg ref=\"#interpunct\">·\u003C/g> \u003Cexpan>\u003Cabbr>s\u003C/abbr>\u003Cex>acrum\u003C/ex>\u003C/expan>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>Ce\u003Cg ref=\"#interpunct\">·\u003C/g>pa\u003Cg ref=\"#interpunct\">·\u003C/g>ri\u003Cg ref=\"#interpunct\">·\u003C/g>us\u003C/name>\n                    \u003Clb n=\"3\"/>\u003Cname>Nym\u003Cg ref=\"#interpunct\">·\u003C/g>phi\u003Cg ref=\"#interpunct\">·\u003C/g>di\u003Cg ref=\"#interpunct\">·\u003C/g>a \u003Cg ref=\"#interpunct\">·\u003C/g>\n                    \u003Clb n=\"4\" break=\"no\"/>nus\u003C/name>\u003C/persName> \u003Cg ref=\"#interpunct\">·\u003C/g> vi\u003Cg ref=\"#interpunct\">·\u003C/g>xit\n                    \u003Clb n=\"5\"/>an\u003Cg ref=\"#interpunct\">·\u003C/g>nis \u003Cnum value=\"33\">XXXIII\u003C/num> \u003Cg ref=\"#interpunct\">·\u003C/g>\n                    \u003Clb n=\"6\"/>mater \u003Cg ref=\"#interpunct\">·\u003C/g> \u003Cchoice>\u003Corig>phe\u003Cg ref=\"#interpunct\">·\u003C/g>cit\u003C/orig>\u003Creg>fecit\u003C/reg>\u003C/choice> \u003Cg ref=\"#interpunct\">·\u003C/g>  \n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text from Korhonen 2004\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#TG\">\n                \u003Cp>Sacred to the spirits of the netherworld. Ceparius Nymphidianus lived for thirty three years. His mother made this.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--D.M.S. / Ceparius Nymphidianus vixit annis XXXIIII. mater phecit. Interpuncts between syllables. Note the very unusual use of ph for f in fecit (some parallels the other way, i.e. f for ph, but not this way round). (Ceparius = Caeparius, cf. 10.7054).-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Castelli\u003C/author>\n                        \u003Cdate>1769\u003C/date>\n                        \u003CcitedRange>cl.12, no.11\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/SPTB56H3\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002084\">https://biblio.inscriptiones.org/epig10002084\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Castelli\u003C/author>\n                        \u003Cdate>1784\u003C/date>\n                        \u003CcitedRange>cl.12, no.14\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/7PSFHSUH\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002083\">https://biblio.inscriptiones.org/epig10002083\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"CIL\">\n                        \u003Cauthor>Mommsen\u003C/author>\n                        \u003Cdate>1883\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"http://arachne.uni-koeln.de/books/CILv10pII1883\">7057\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GQN8UZSI\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000589\">https://biblio.inscriptiones.org/epig10000589\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IMusCatania\">\n                         \u003Cauthor>Korhonen\u003C/author>\n                         \u003Cdate>2004\u003C/date> \n                        \u003CcitedRange>69\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/2EUC82DH\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000028\">https://biblio.inscriptiones.org/epig10000028\u003C/ref>\u003C/bibl>\n                    \u003Cbibl/>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
