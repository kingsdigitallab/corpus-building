CsupportDesc>\n                                \u003Csupport>\u003Cp>Stele, the surfaces of which are carefully smoothed. The whole upper margin, including the right corner part, is intentionally chiselled\u003C/p>\n                                    \u003Cmaterial ana=\"#material.inorganic.stone.magmatic_rock.basalt\" type=\"stone.basalt\" subtype=\"unverified\" ref=\"http://www.eagle-network.eu/voc/material/lod/28.html\">volcanic (pietra di Fuardo)\u003C/material>\n                                    \u003CobjectType ana=\"#object.stele\" ref=\"http://www.eagle-network.eu/voc/objtyp/lod/250\">stele\u003C/objectType>\n                                    \u003Cdimensions>\u003C!--ILipara-->\n                                        \u003Cheight unit=\"cm\">56\u003C/height>\n                                        \u003Cwidth unit=\"cm\">31.5\u003C/width>\n                                        \u003Cdepth unit=\"cm\">8\u003C/depth>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition ana=\"#condition.damaged\"/>\n                            \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\n                                    \u003Crs ana=\"#execution.chiselled\" ref=\"http://www.eagle-network.eu/voc/writing/lod/1\">chiselled\u003C/rs>\n                                    \u003Cdamage ana=\"#text_condition.incomplete\"/>\n\t\t\t\u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\u003C!--ILipara-->\n                                \u003Clocus from=\"line1\" to=\"line1\">Line 1\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\" atLeast=\"34\" atMost=\"43\">34-43\u003C/hei