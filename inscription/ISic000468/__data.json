ali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface> -->\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"la\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cw n=\"5\">\u003Cexpan>\u003Cabbr>Caesarib\u003C/abbr>\u003Cex>us\u003C/ex>\u003C/expan>\u003C/w>\n                    \u003Clb n=\"2\"/>\u003Cw n=\"10\">sacrum\u003C/w>\n                    \u003Clb n=\"3\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cw n=\"15\">\u003Cexpan>\u003Cabbr>L\u003C/abbr>\u003Cex>ucius\u003C/ex>\u003C/expan>\u003C/w>\u003C/name> \u003Cname>\u003Cw n=\"20\">Caelius\u003C/w>\u003C/name> \u003CpersName type=\"attested\">\u003Cname>\u003Cw n=\"25\">\u003Cexpan>\u003Cabbr>M\u003C/abbr>\u003Cex>arci\u003C/ex>\u003C/expan>\u003C/w>\u003C/name> \u003Cw n=\"30\">\u003Cexpan>\u003Cabbr>f\u003C/abbr>\u003Cex>ilius\u003C/ex>\u003C/expan>\u003C/w>\u003C/persName>\n                    \u003Clb n=\"4\"/>\u003Cname>\u003Cw n=\"35\">Quadratus\u003C/w>\u003C/name>\u003C/persName>\n                    \u003Clb n=\"5\"/>\u003Cw n=\"40\">\u003Cexpan>\u003Cabbr>d\u003C/abbr>\u003Cex>e\u003C/ex>\u003C/expan>\u003C/w> \u003Cw n=\"45\">\u003Cexpan>\u003Cabbr>s\u003C/abbr>\u003Cex>ua\u003C/ex>\u003C/expan>\u003C/w> \u003Cw n=\"50\">\u003Cexpan>\u003Cabbr>p\u003C/abbr>\u003Cex>ecunia\u003C/ex>\u003C/expan>\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"Caesar\">Caesaribus\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"sacer\">sacrum\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"Lucius\">Lucius\u003C/w>\n                    \u003Cw n=\"20\" lemma=\"Caelius\">Caelius\u003C/w>\n                    \u003Cw n=\"25\" lemma=\"Marcus\">Marci\u003C/w>\n                    \u003Cw n=\"30\" lemma=\"filius\">filius\u003C/w>\n                    \u003Cw n=\"35\" lemma=\"Quadratus\">Quadratus\u003C/w>\n                    \u003Cw n=\"40\" lemma=\"de\">de\u003C/w>\n                    \u003Cw n=\"45\" lemma=\"suus\">sua\u003C/w>\n                    \u003Cw n=\"50\" lemma=\"pecunia\">pecunia\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text of CIL\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>Sacred to the Caesars. Lucius Caelius Quadratus, son of Marcus (dedicated this) at his own expense\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>The inscription appears to be lost, recorded first in Fazello 1558\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Fazello\u003C/author>\n                        \u003Cdate>1558\u003C/date>\n                        \u003CcitedRange>Dec. 1, book 5, p.23\u003C/citedRange>\u003C!-- vol.2 p.34 (dec.1, book 5) in the C18 Italian edition -->\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/UKMEHMF4\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002606\">https://biblio.inscriptiones.org/epig10002606\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Gualtherus\u003C/author>\n                        \u003Cdate>1624\u003C/date>\n                        \u003CcitedRange>71\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GIN6NANU\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002388\">https://biblio.inscriptiones.org/epig10002388\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Gualtherus\u003C/author>\n                        \u003Cdate>1624 [1625]\u003C/date>\n                        \u003CcitedRange>231\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/ZP8DE8KS\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001931\">https://biblio.inscriptiones.org/epig10001931\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"CIL\">\n                        \u003Cauthor>Mommsen\u003C/author>\n                        \u003Cdate>1883\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"http://arachne.uni-koeln.de/books/CILv10pII1883\">7191\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GQN8UZSI\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000589\">https://biblio.inscriptiones.org/epig10000589\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Schubring\u003C/author>\n                        \u003Cdate>1873\u003C/date>\n                        \u003CcitedRange>75\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/5NHGE6V5\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002684\">https://biblio.inscriptiones.org/epig10002684\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Manganaro\u003C/author>\n                        \