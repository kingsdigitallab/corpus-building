{"type":"data","nodes":[{"type":"data","data":[{"debug":1},true],"uses":{}},{"type":"data","data":[{"slug":1,"metadata":2,"images":112,"html":252,"xml":298},"ISic001904",{"file":1,"uri":1,"title":3,"status":4,"editions":6,"editionAuthor":20,"type":21,"support":25,"objectType":26,"material":30,"condition":37,"dimensions":39,"layoutDesc":49,"handNote":57,"date":79,"places":84,"geo":94,"country":89,"provenance":86,"provenanceFound":98,"provenanceGeo":105,"provenanceObserved":106,"provenanceLost":20,"graphics":112,"region":120,"settlement":91,"repository":121,"textLang":139,"bibliographyEdition":146,"bibliographyDiscussion":197,"citation":200,"tmNumber":8,"facsimile":220,"letterHeights":221,"publications":228,"zotero":234,"keywords":240,"lettering_types":251},"Mosaic depicting wrestlers, with artist's signature",{"_":5},"edited",[7,10,13,15,18],{"_":8,"type":9},"698370","TM",{"_":11,"type":12},"150007","EDR",{"type":14},"EDH",{"_":16,"type":17},"70901006","EDCS",{"type":19},"PHI",null,{"_":22,"ana":23,"ref":24},"Artist's signature (and labels)","#function.attribution.production.artist","https://ontology.inscriptiones.org/type_of_inscription/Artist","A mosaic 'doormat' at the entrance to the frigidarium of the insula IV baths at Tindari. A Greek inscription runs along the lower edge, above which is a rectangular black border surrounding a white field, on which are depicted in black tesserae two naked figures facing one another in a fighting stance, and behind each is depicted a large krater, a palm branch, and a victor's wreath, with a Latin label behind each figure's head. The lower left corner is lost and some of the tesserae of the Greek text are missing. The section containing the Greek text is 119 cm wide (originally 127.5) and 12-13 cm high.",{"_":27,"ana":28,"ref":29},"pavement","#object.pavement","http://www.eagle-network.eu/voc/objtyp/lod/190.html",{"_":31,"ana":32,"type":33,"subtype":34,"resp":36},"mosaic","#material.inorganic.stone.mosaic","stone.mosaic",[35],"unspecified","#Coccato",{"ana":38},"#condition.damaged",[40,44,47],{"_":41,"unit":42,"dimension":43},"81","cm","height",{"_":45,"unit":42,"dimension":46},"143","width",{"unit":42,"dimension":48},"depth",{"layout":50},{"p":51,"rs":52,"damage":55},"A single line of Greek along the lower edge, and two Latin labels in the main pictorial field.",{"_":31,"ana":53,"ref":54},"#execution.mosaic","http://www.eagle-network.eu/voc/writing/lod/16",{"ana":56},"#text_condition.deteriorated",{"lettering":58,"dimensions":59},"Tall narrow letters with ovid form to the omicron and theta, with lunate epsilon and sigma and uncial omega. The Latin letters are also relatively tall and narrow, with the top of the A extended.",[60,68,74],{"type":61,"l":62,"from":63,"to":63,"h":64,"unit":65,"atLeast":66,"atMost":67},"letterHeight","Line a.1","linea.1","62-75","mm","62","75",{"type":61,"l":69,"from":70,"to":70,"h":71,"unit":65,"atLeast":72,"atMost":73},"Line b.1","lineb.1","92-108","92","108",{"type":75,"l":76,"from":77,"to":78,"unit":65},"interlinear","Interlineation line 1 to 2","line1","line2",{"_":80,"notBefore":81,"notAfter":82,"evidence":83},"later second or earlier third century CE",151,250,"lettering, archaeological-context",[85,90],{"_":86,"type":87,"ref":88,"region":89},"Tyndaris","ancient","http://pleiades.stoa.org/places/462527","Sicilia",{"_":91,"type":92,"ref":93,"region":89},"Tindari","modern","http://sws.geonames.org/10282151",[95],[96,97],38.14227,15.04385,{"_":99,"type":100,"subtype":101,"geo":102},"In situ at the entrance to the frigidarium on the north side of the peristyle of the house at the northern end of insula IV, Tindari","found","discovered",[103,104],38.1432591,15.0430593,[103,104],{"_":107,"type":108,"subtype":109,"resp":110,"xml:id":111,"geo":20},"2022-07-14 Prag and Antoniou, on site","observed","autopsied","#JP #AA","autopsy",[113],{"n":114,"url":115,"height":116,"width":117,"desc":118,"surfaceType":119},"screen","ISic001904_tiled.tif","3680px","5520px","I.Si