resp=\"#JP\" source=\"https://www.zotero.org/groups/382445/items/YHFC9RB5\">\n                \u003Cab>\n                    \u003Clb n=\"1\" style=\"text-direction:r-to-l\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>bn \u003CpersName type=\"attested\">\u003Cname>ʾd\u003Cunclear>r\u003C/unclear>\u003Csupplied reason=\"lost\">bʿl\u003C/supplied>\u003C/name>\u003C/persName> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\u003Cnote>Text after Coacci Polselli 1986.\u003C/note>\u003C/app>\n                    \u003Capp loc=\"1\">\u003Cnote>alternatively: ʾdn[---]\u003C/note>\u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#RDS\">\n                \u003Cp>[---] son of  ʾdr/n[---]\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\" resp=\"#RDS\">\n                \u003Cp>[---] figlio di  ʾdr/n[---]\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#RDS\">\n                \u003Cp>The text contains part of a votive inscription of which only the genealogy remains with the initial part of a Phoenician anthroponym to be completed as \u003Cforeign xml:lang=\"xpu-Latn\">ʾdr[bʿl]\u003C/foreign> or \u003Cforeign xml:lang=\"xpu-Latn\">ʾdn[bʿl]\u003C/foreign>.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl>\n                        \u003Cauthor>Coacci Polselli\u003C/author>\n                        \u003Cdate>1986\u003C/date>\n                        \u003CcitedRange>93-94\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/YHFC9RB5\"/>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>De Simone\u003C/author>\n                        \u003Cdate>2013\u003C/date>\n                        \u003CcitedRange>26 MO.4 fig.4\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/EGNUE9CZ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002545\">https://biblio.inscriptiones.org/epig10002545\u003C/ref>\n                    \u003C/bibl>\n                  \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
