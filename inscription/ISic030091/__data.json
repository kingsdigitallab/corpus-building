u003C/change>\n                \u003Cchange when=\"2021-08-29\" who=\"#SN\">Savannah Neibart encoded inscription using data from ISicDef, supplemented by Bettarini\u003C/change>\n                \u003Cchange when=\"2021-10-18\" who=\"#JP\">Jonathan Prag checked file, revised text div\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic030091_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic030091.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#SN\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cchoice>\u003Corig>Πύρ\u003Cunclear>ο\u003C/unclear>ν\u003C/orig>\u003Creg>Πύρρον\u003C/reg>\u003C/choice>\u003C/name>\u003C/persName> \u003Cw>καἴ\u003C/w> \u003Cw>τι\u003C/w>\n                    \u003Clb n=\"2\"/>\u003Corig>Δ\u003C/orig> \u003Cw>ὑπὲρ\u003C/w> \u003CpersName type=\"attested\">\u003Cname type=\"idionym\">\u003Cexpan>\u003Cabbr>Ἀρτάμων\u003C/abbr>\u003Cex>ος\u003C/ex>\u003C/expan>\u003C/name>\u003C/persName>\n                    \u003Cg ref=\"#dash\">‒\u003C/g> \u003Cg ref=\"#diple\">&lt;\u003C/g> \u003Cspace extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"3\"/>\u003Cw>μηδὲ\u003C/w> \u003Cw>ὑπὲρ\u003C/w> \u003CpersName type=\"attested\">\u003Cname>\u003Cexpan>\u003Cabbr>Εὕρ\u003C/abbr>\u003Cex cert=\"low\">ιος\u003C/ex>\u003C/expan>\u003C/name>\u003C/persName> \u003Cunclear>\u003Cg ref=\"#dash\">‒\u003C/g>\u003C/unclear> \u003Cspace extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"4\"/>\u003Cspace extent=\"unknown\" unit=\"character\"/> \u003Corig>\u003Cunclear>ΛΕ\u003C/unclear>\u003C/orig>\n                    \u003Clb n=\"5\"/>\u003Cspace extent=\"unknown\" unit=\"character\"/>\u003Cw>κατ\u003C/w> \u003CpersName type=\"attested\">\u003Cname type=\"idionym\">Ἀρτ\u003Cunclear>ά\u003C/unclear>\u003Cg ref=\"#sign_uninterpreted\"/>                \n                    \u003Clb n=\"6\" break=\"no\"/>\u003Cspace extent=\"unknown\" unit=\"character\"/>μωνα\u003C/name>\u003C/persName>                \n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp>\n                        \u003Cnote>Text after Bettarini.\u003C/note>\u003C!-- ISicDef no. 47 -->\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"it\">\n                \u003Cp/>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp xml:lang=\"en\">The horizontal strokes (LL. 2 and 3) probably denote the abbreviation of the preceding names. The other signs occur in the lines in which the defictus Ἀρτάμων is mentioned: magical signs? (SEG)\u003C/p>\n                \u003Cp xml:lang=\"it\">La peculiarità di questa lamina è la menzione della persona a favore della quale la maledizione viene redatta: Heuris a r.3 è il 'beneficiario' della maledizione. Siamo dunque nell'abituale contesto agonistico delle defixiones greche, contesto di cui è però impossibile in questo caso precisare la natura. (Bettarini)\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"ISelinunteDef\">\n                        \u003Cauthor>Bettarini\u003C/author>\n                        \u003Cdate>2005\u003C/date>\n                        \u003CcitedRange>5\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/SEW88NC7\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001388\">https://biblio.inscriptiones.org/epig10001388\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>2005\u003C/date>\n                        \u003CcitedRange>55.1025\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n                \u003ClistBibl type=\"discussion\">\n                    \u003Cbibl/>\n                \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
