03CmsDesc>\n                    \u003CmsIdentifier>\n                        \u003Ccountry>Italy\u003C/country>\n                        \u003Cregion>Sicily\u003C/region>\n                        \u003Csettlement>Marsala\u003C/settlement>\n                        \u003Crepository role=\"museum\" ref=\"http://sicily.classics.ox.ac.uk/museum/108\">Museo archeologico regionale Lilibeo Marsala - Baglio Anselmi\u003C/repository>\n                        \u003Cidno type=\"inventory\"/>\n                        \u003CaltIdentifier type=\"former\">\n                            \u003Csettlement>Palermo\u003C/settlement>\n                            \u003Crepository role=\"museum\" ref=\"http://sicily.classics.ox.ac.uk/museum/064\">Museo Archeologico Regionale Antonino Salinas\u003C/repository>\n                            \u003Cidno type=\"old\">24369\u003C/idno>\n                        \u003C/altIdentifier>\n                    \u003C/msIdentifier>\n                    \u003CmsContents>\n                        \u003CtextLang mainLang=\"grc\">Ancient Greek\u003C/textLang>\n                    \u003C/msContents>\n                    \u003CphysDesc>\n                        \u003CobjectDesc>\n                            \u003CsupportDesc>\n                                \u003Csupport>\n                                    \u003Cmaterial ana=\"#material.inorganic.mortars\" type=\"mortars\" subtype=\"plaster\" resp=\"#Coccato\">plaster on unspecified sedimentary rock (yellowish calcarenite) (identification based on pXRF, digital microscopy)\u003Cnote> Petrographic imagery at \u003Cref target=\"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic003070\">https://iiif.csad.ox.ac.uk/viewer/isicily/ISic003070\u003C/ref>\u003C/note>\u003C/material>\n                                    \u003CobjectType ana=\"#object.funerary_monument.column\" ref=\"http://www.eagle-network.eu/voc/objtyp/lod/100\">column\u003C/objectType>\n                                    \u003Cdimensions>\u003C!--Lilibeo 1984-->\n                                        \u003Cheight unit=\"cm\">87\u003C/height>\n                                        \u003Cwidth unit=\"cm\">34\u003C/width>\n                                        \u003Cdepth unit=\"cm\">34\u003C/depth>\n                                    \u003C/dimensions>\n                                \u003C/support>\n                                \u003Ccondition ana=\"#condition.damaged\"/>\n                            \u003C/supportDesc>\n                            \u003ClayoutDesc>\n                                \u003Clayout>\n                                    \u003Crs ana=\"#execution.painted\" ref=\"http://www.eagle-network.eu/voc/writing/lod/10\">painted\u003C/rs>\n                                    \u003Cdamage/>\n                                \u003C/layout>\n                            \u003C/layoutDesc>\n                        \u003C/objectDesc>\n                        \u003ChandDesc>\n                            \u003ChandNote>\n                                \u003Cp>Neatly painted square letters with short serifs, painted in the style of stone cut letters. Alpha is broad with straight bar; Epsilon has equal length horizontal strokes; theta is ovoid with a full horizontal bar; kappa has arms that are not quite ful length; mu has vertical first and last, with middle strokes nearly reaching down to the line; pi has equal length verticals; sigma is four-bar, of equal length, top and bottom strokes horizontal.\u003C/p>\n                                \u003Clocus from=\"line1\" to=\"line1\">Line 1\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                                \u003Clocus from=\"line1\" to=\"line2\">Interlineation line 1 to 2\u003C/locus>\n                                \u003Cdimensions type=\"interlinear\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>\n                        \u003C/handDesc>\n                        \u003CdecoDesc>\n                            \u003CdecoNote>A togate male figure stands in the middle of the field, his head rising in the middle of line 2 and to the left of line 3 of the text; a pair of raised arms/hands bracket the text.\u003C/decoNote>\n                        \u003C/decoDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462281\">Lilybaeum\u003C/placeName>\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/6542148\">Marsala\u003C/placeName>\n                                \u003Cgeo>37.80355, 12.4379\u003C/geo>\n                            \u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" notBefore-custom=\"-0200\" notAfter-custom=\"-0101\" evidence=\"archaeological-context\">2nd century BCE (Manni Piraino)\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\" when=\"1984\">Excavated in the via del Fante necropolis in 1984.\u003C/provenance>\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">Photographed, Metcalfe, 2018-08-31\u003C/provenance>\n                        \u003Cacquisition/>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n            \u003Cp>Encoded following the latest EpiDoc guidelines\u003C/p>\n            \u003Cxi:include href=\"../alists/ISicily-taxonomies.xml\">\n                \u003Cx