003ChandNote xml:id=\"h2\">\n                                \u003Clocus from=\"line1\" to=\"line1\">Line 1\u003C/locus>\n                                \u003Cdimensions type=\"letterHeight\">\n                                    \u003Cheight unit=\"mm\"/>\n                                \u003C/dimensions>\n                            \u003C/handNote>                       \n                        \u003C/handDesc>\n                    \u003C/physDesc>\n                    \u003Chistory>\n                        \u003Corigin>\n                            \u003CorigPlace>\u003Cregion>Sicilia\u003C/region>\n                                \u003CplaceName type=\"ancient\" ref=\"http://pleiades.stoa.org/places/462126\">Kamarina\u003C/placeName>\n                                \u003CplaceName type=\"modern\" ref=\"http://sws.geonames.org/6540853\">Santa Croce Camerina\u003C/placeName>\n                                \u003Cgeo>36.8736, 14.4507\u003C/geo>\n                            \u003C/origPlace>\n                            \u003CorigDate datingMethod=\"#julian\" evidence=\"lettering archaeological-context\" notBefore-custom=\"-0480\" notAfter-custom=\"-0451\">480—450 BCE\u003C/origDate>\n                        \u003C/origin>\n                        \u003Cprovenance type=\"found\" subtype=\"discovered\">Found in the archaeological area of Kamarina, inside a storeroom in the sanctuary of Athena, in contrada Cammarana\u003Cgeo>36.87316, 14.4415\u003C/geo>.\u003C/provenance> \u003C!-- double check coordinates -->\n                        \u003Cprovenance type=\"observed\" subtype=\"autopsied\">No Autopsy\u003C/provenance>\n                        \u003Cacquisition>Santa Croce Camerina, Museo Archeologico Regionale di Kamarina\u003C/acquisition>\n                    \u003C/history>\n                \u003C/msDesc>\n            \u003C/sourceDesc>\n        \u003C/fileDesc>\n        \u003CencodingDesc>\n            \u003Cp>Encoded following the latest EpiDoc guidelines