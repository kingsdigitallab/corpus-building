03Capp>\n                        \u003Cnote>Text of Silvestrini 2024\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--Caius Mevius Donatus Iunianus, already known from stone of Lanuvium, CIL 14.2107. On the gens Mevia, cf. Manganaro, Epigraphica 51 (1989), 190.80. One othe inscr. which provides evidence for the 12 tribes of Lilybaeum: C. Mevio Q.f. Donato Iuniano quaestori pro praetore provinciae Siciliae optimo et humanissimo XII tribus patrono. On these, see Sartori, Kokalos 3 (1957), 38-60 (where S argues that it is maintenance by the Romans of the pre-Republican civic constitution, e.g. esp. p.45). Cf. CIL X.7206 and 7233, and 7237.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"AE\">\n                        \u003CcitedRange>1964.0183\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/R46KDTZX\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001283\">https://biblio.inscriptiones.org/epig10001283\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Barbieri\u003C/author>\n                        \u003Cdate>1961\u003C/date>\n                        \u003CcitedRange>45-51 no.3 tav.III\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/KHCM59WG\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002169\">https://biblio.inscriptiones.org/epig10002169\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Wilson\u003C/author>\n                        \u003Cdate>1990\u003C/date>\n                        \u003CcitedRange>174 n.94 fig.147\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/VF9MMBI9\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001509\">https://biblio.inscriptiones.org/epig10001509\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Calderone\u003C/author>\n                        \u003Cdate>1959\u003C/date>\n                        \u003CcitedRange>1071-1072\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/PACIVUJ6\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002099\">https://biblio.inscriptiones.org/epig10002099\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Manganaro\u003C/author>\n                        \u003Cdate>1988\u003C/date>\n                        \u003CcitedRange>42 n.206\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/RZSFKACR\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001427\">https://biblio.inscriptiones.org/epig10001427\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Silvestrini\u003C/author>\n                        \u003Cdate>2024\u003C/date>\n                        \u003CcitedRange>436\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/H5GJ8WQW\"/>\n                    \u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug