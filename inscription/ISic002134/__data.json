organic.stone.sedimentary_rock.limestone","stone.limestone",[38],"unverified","http://www.eagle-network.eu/voc/material/lod/66.html",{"ana":41},"#condition.complete.broken",[43,47,50],{"_":44,"unit":45,"dimension":46},"69","cm","height",{"_":48,"unit":45,"dimension":49},"33","width",{"unit":45,"dimension":51},"depth",{"layout":53},{"p":54,"rs":55,"damage":59},"Text crudely incised in two lines across the face",{"_":56,"ana":57,"ref":58},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"ana":60},"#text_condition.complete",{"lettering":62,"dimensions":63},"The text is crudely incised with a sharp implement, more in the style of a graffito than a formally carved text.  The lettering is somewhat irregular in size. The sigma in line 2 is seemingly crudely inserted below the eta, but the form is unclear. Quadrate epsilon, small omicron, episilon with bars of equal length.",[64,69],{"type":65,"l":66,"from":67,"to":67,"unit":68},"letterHeight","Line 1","line1","mm",{"type":70,"l":71,"from":67,"to":72,"unit":68},"interlinear","Interlineation line 1 to 2","line2",{"_":74,"notBefore":75,"notAfter":76,"evidence":77},"Hellenistic",-300,1,"lettering",[79,84],{"_":80,"type":81,"ref":82,"region":83},"Syracusae","ancient","http://pleiades.stoa.org/places/462503","Sicilia",{"_":85,"type":86,"ref":87,"region":83},"Siracusa","modern","http://sws.geonames.org/2523083",[89],[90,91],37.08415,15.27628,{"_":93,"type":94,"subtype":95,"when":96,"geo":97,"geoCert":100},"Found in the autumn of 1911, 'nel fondo denominato Merica, al bivio delle rotabili Belvedere-Floridia' (assumed to be the junction where the road splits for these two locales, in the area therefore of the Fusco necropolis)","found","discovered","1911",[98,99],37.07617,15.25279,"medium",[98,99],{"_":103,"type":104,"subtype":105,"geo":106},"Observed by Prag in storage in the archaeological park of Neapolis, 2026-09-17, but not yet fully studied.","observed","autopsied",null,[108],{"n":109,"url":110,"height":111,"width":112,"desc":113,"surfaceType":114},"screen","ISic002134_tiled.tif","4032px","2268px","I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2026-09-17","front","Sicily",{"_":117,"role":118,"ref":119,"museum":120},"Museo Archeologico Regionale Paolo Orsi","museum","http://sicily.classics.ox.ac.uk/museum/097",{"slug":121,"type":118,"name":117,"uri":119,"description":122,"location":123},"097","An outstanding collection of archaeological material. The collection ranges from Siracusa and the surrounding territory (Megara Hyblaia, Akrai, Kasmenai etc) to encompass all of eastern Sicily, reaching as far as Gela and Agrigento. The ground floor covers prehistory through to the end of the Classical period. Upstairs includes Hellenistic and Roman Syracuse and a display of material from the catacombs. A gallery displaying material from Hellenistic eastern Sicily is in preparation.",{"settlement":85,"region":85,"country":124,"address":125,"geo":126},"Italy","Viale Teocrito 66, 96100 - Siracusa",{"lat":127,"lon":128},37.07636989,15.2866213,{"_":130,"type":131},"32643","inventory",{"_":133,"mainLang":134,"languages":135},"Ancient Greek","grc",[133],{"type":137,"bibl":138},"edition",[139,146],{"type":140,"n":141,"author":19,"title":18,"date":20,"citedRange":142,"ptr":143,"ref":23,"inscriptionDate":144,"citation":21,"uri":22,"year":145},"bulletin","NSA","299",{"target":23},"1912","1876",{"type":140,"n":141,"author":19,"title":18,"date":20,"citedRange":147,"ptr":148,"ref":23,"inscriptionDate":149,"citation":21,"uri":22,"year":145},"203",{"target":23},"1915",{"type":151,"bibl":152},"discussion",[106],{"editor":154,"principal":157,"contributors":158,"change":162},{"_":155,"ref":156},"Jonathan Prag","#JP",{"_":155,"ref":156},[159],{"_":155,"xml:id":160,"ref":161},"JP","http://orcid.org/0000-0003-3819-8537",{"_":163,"when":164,"who":156},"Jon