e/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001550_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001550.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#VM\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003CpersName type=\"attested\">\u003Cname>\u003Cw n=\"5\">Μαρία\u003C/w>\u003C/name>\u003C/persName> \u003Cw n=\"10\">ἥρυς\u003C/w>\n                    \u003Clb n=\"2\"/>\u003Cw n=\"15\">ἀγαθά\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"edition\" subtype=\"simple-lemmatized\" resp=\"#DD #RC\">\n                \u003Cab>\n                    \u003Cw n=\"5\" lemma=\"Μαρία\">Μαρία\u003C/w>\n                    \u003Cw n=\"10\" lemma=\"ἥρυς\">ἥρυς\u003C/w>\n                    \u003Cw n=\"15\" lemma=\"ἀγαθός\">ἀγαθά\u003C/w>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003Cp>Text of IGPalermo\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--painted inscr., with banqueting scene; Maria herys agatha; NB, that the form of heros here is 'forma \"scorrettissima e con un inesplicabile tardo dorismo\". Del cattivo greco che si parlava a Lilibeo abbiamo un'altra testimonianza in una tessera ospitale a Lilibeo (=IG 14.0279) e nella critica che di esso fa Cicerone a Cecilio (Div.in Caec. 39).'; note also tanit symbols, caduceus and cresc.moon with disc.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1984\u003C/date>\n                        \u003CcitedRange>34.0950\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1926-1927\u003C/date>\n                        \u003CcitedRange>04.0042\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"IGMusPalermo\">\n                        \u003Cauthor>Manni Piraino\u003C/author>\n                        \u003Cdate>1973\u003C/date>\n                        \u003CcitedRange>20\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F66S4X3M\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10000531\">https://biblio.inscriptiones.org/epig10000531\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Kretschmer\u003C/author>\n                        \u003Cdate>1927\u003C/date>\n                        \u003CcitedRange>306 no.3\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/NT9TNH4M\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002533\">https://biblio.inscriptiones.org/epig10002533\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Gabrici\u003C/author>\n                        \u003Cdate>1929\u003C/date>\n                        \u003CcitedRange>50-53\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/W9I8NZBC\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001976\">https://biblio.inscriptiones.org/epig10001976\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Bisi\u003C/author>\n                        \u003Cdate>1970\u003C/date>\n                        \u003CcitedRange>98 no.2\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/2DZ9TJFH\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002148\">https://biblio.inscriptiones.org/epig10002148\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Di Stefano\u003C/author>\n                        \u003Cdate>1984\u003C/date>\n                        \u003CcitedRange>166-169 no.186 fig.90\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Q5PB252W\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002035\">https://biblio.inscrip