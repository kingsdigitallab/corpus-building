ion\" ref=\"https://ontology.inscriptiones.org/type_of_inscription/Dedication\">dedication\u003C/term>\n                \u003C/keywords>\n            \u003C/textClass>\n        \u003C/profileDesc>\n        \u003CrevisionDesc status=\"draft\">\n            \u003ClistChange>\n                \u003Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n                \u003Cchange when=\"2018-08-07\" who=\"#JP\">Jonathan Prag revised file based upon photographs\u003C/change>\n                \u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n                \u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n                \u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n                \u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n                \u003Cchange when=\"2020-12-18\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n                \u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2025-10-15\" who=\"#RC\">Robert Crellin added local IDs to edition elements\u003C/change>\n            \u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001122_tiled.tif\" height=\"1856px\" width=\"4232px\">\n                \u003Cdesc>Photo R. Henzel, courtesy Palermo Museo Archeologico Regionale \"A.Salinas\"\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001122.jpg\" height=\"1856px\" width=\"4232px\">\n                \u003Cdesc>Photo R. Henzel, courtesy Palermo Museo Archeologico Regionale \"A.Salinas\"\u003C/desc>\n            \u003C/graphic>\n        \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\">\n                \u003Cab>\n                    \u003Clb n=\"1\" xml:id=\"BMUAK\"/>\u003Cw xml:id=\"BMUAU\" n=\"5\">Ὁμονοίας\u003C/w>\n                    \u003Clb n=\"2\" xml:id=\"BMUAe\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" xml:id=\"BMUAo\" n=\"10\"/>\n                \u003C/ab>\n             \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\n                    \u003Capp loc=\"line 2\">\n                        \u003Cnote>Traces of a second line, as read by Manni Piraino, are not obvious in the available photograph\u003C/note>\n                    \u003C/app>\n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\">\n                \u003Cp>Of concord\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>\u003C!--commented out pending revision-->\n                    \u003C!--Prob. a public dedication (statue base?) to Concorde? (text remaining reads: 'homonoias'. I have a slide of what must be this, but it doesn't look much like a C2 AD dedication on basalt.! Manganaro 1998: 137 n.28 cites this as an inscr. 'forse ellenistica di Centuripe', as relevant for his discussion of the HOMONOIA coin issue of the Kimissaioi.-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IG\">\n                        \u003Cauthor>Kaibel\u003C/author>\n                        \u003Cdate>1890\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"https://clio.columbia.edu/catalog/6873760\">302\u003C/ref>\n                        \u003C/citedRange>\n                        \u003