om":62,"to":62,"h":63,"unit":64,"atLeast":63,"atMost":63},"letterHeight","Line 1","line1","30","mm",{"type":60,"l":66,"from":67,"to":67,"h":68,"unit":64,"atLeast":68,"atMost":68},"Line 2","line2","25",{"type":70,"l":71,"from":62,"to":67,"h":72,"unit":64,"atLeast":72,"atMost":72},"interlinear","Interlineation line 1 to 2","20",{"_":74,"notBefore":75,"notAfter":76},"1st — 3rd century CE",1,300,[78,83],{"_":79,"type":80,"ref":81,"region":82},"Messana","ancient","http://pleiades.stoa.org/places/462538","Sicilia",{"_":84,"type":85,"ref":86,"region":82},"Messina","modern","http://sws.geonames.org/2524170",[88],[89,90],38.19394,15.55256,{"_":92,"type":93,"subtype":94,"geo":21},"Necropolis of San Placido, recinto F","found","discovered",[],{"_":97,"type":98,"subtype":99,"geo":21},"None","observed","autopsied",[],"Sicily",{"_":103,"role":104,"ref":105,"museum":106},"Museo regionale interdisciplinare di Messina","museum","http://sicily.classics.ox.ac.uk/museum/147",{"slug":107,"type":104,"name":103,"uri":105,"description":108,"location":109},"147","The collection is focused on finds made within the city of Messina itself (the warship ram from Acqualadroni being one of the only notable exceptions). Beginning with the prehistoric periods (a single case) it progresses through the different areas and periods of the city, focusing at the end on the sculpture and inscriptions. The accompanying boards set the objects into a clear historical context. One of the highlights of the collection is the aforementioned warship ram. Two other objects given prominence are two of the four Oscan inscriptions in the collection, from the time of Mamertine domination. The principle display cases focus on the cemeteries and religious areas of the city. The grounds of the museum contain a number of monuments and architectural pieces (many from the post-medieval city that was destroyed in the 1908 earthquake) but some earlier as well, principally Roman in date",{"settlement":84,"region":84,"country":1