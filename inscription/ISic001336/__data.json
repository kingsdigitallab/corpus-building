Cchange when=\"2016-12-03\" who=\"#JCu\">James Cummings autogenerated EpiDoc output from database\u003C/change>\n            \t\u003Cchange when=\"2020-10-05\" who=\"#SS\">Simona Stoyanova normalised Unicode\u003C/change>\n            \t\u003Cchange when=\"2020-10-08\" who=\"#SS\">Simona Stoyanova updated list of languages\u003C/change>\n            \t\u003Cchange when=\"2020-11-20\" who=\"#SS\">Simona Stoyanova added EDCS numbers\u003C/change>\n        \t\t\u003Cchange when=\"2020-11-26\" who=\"#SS\">Simona Stoyanova restructured bibliography\u003C/change>\n        \t    \u003Cchange when=\"2020-12-22\" who=\"#JP\">Updated Zenodo DOI\u003C/change>\n            \t\u003Cchange when=\"2021-01-19\" who=\"#SS\">renumbered files, uris and references\u003C/change>\n                \u003Cchange when=\"2021-06-04\" who=\"#AA\">Epidoc editing\u003C/change>\n                \u003Cchange when=\"2026-08-03\" who=\"#martaf\">Marta Fogagnolo revised the text encoding, added the translation and the commentary\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\u003Csurface/>\u003C!--\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001336_tiled.tif\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001336.jpg\" height=\"3680px\" width=\"5520px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#AA\">\n                \u003Cab>\n                    \u003Clb n=\"0\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"1\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" cert=\"low\"/>\u003Corig>ΕΝΕ\u003C/orig>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                    \u003Clb n=\"2\"/>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\" cert=\"low\"/>\u003Corig>ΙΝΕΣ\u003C/orig>\u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\u003Cw>\u003Csupplied reason=\"lost\">ἐκ\u003C/supplied>\u003C/w> \u003Cw>\u003Csupplied reason=\"lost\">τ\u003C/supplied>\n                    \u003Clb n=\"3\" break=\"no\"/>\u003Csupplied reason=\"lost\">ῶν\u003C/supplied>\u003C/w> \u003Cw>ἰδίων\u003C/w> \u003Cw>\u003Csupplied reason=\"lost\">ἐποίησεν\u003C/supplied>\u003C/w>\n                    \u003Clb n=\"4\"/>\u003Cw>\u003Csupplied reason=\"lost\">τό\u003C/supplied>\u003Cunclear>π\u003C/unclear>ον\u003C/w> \u003Cw>\u003Csupplied reason=\"lost\">ἑ\u003C/supplied>α\u003Csupplied reason=\"lost\">υτῷ\u003C/supplied>\u003C/w>      \n                    \u003Clb n=\"5\"/>\u003Csupplied reason=\"lost\">\u003Cw>καί\u003C/w> \u003Cw>τοῖς\u003C/w> \u003Cw>ἰδίος\u003C/w>\u003C/supplied>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\" resp=\"#martaf\">\n                \u003ClistApp>\n                    \u003Capp loc=\"lines 2-3\">\u003Cnote>ἐκ τ|ῶν] ἰδίων [ἐποίησεν Ferrua\u003C/note>\u003C/app>\n                    \u003Capp loc=\"line 4\">\u003Cnote>ΙΟΝ .. Α Amico, Kaibel; [τό]\u003Cunclear>π\u003C/unclear>ον [ἑ]α[υτῷ Ferrua\u003C/note>\u003C/app>\n                    \u003Capp loc=\"line 5\">\u003Cnote>[καὶ τοῖς ἰδίοις Ferrua\u003C/note>\u003C/app>     \n                \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#martaf\">\n                \u003Cp>… built it at his own expense for himself and his children.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#martaf\">\n                \u003Cp>According to Ferrua’s restorations (1941, 243), the epitaph includes a reference to the construction of the funerary monument at the deceased's own expense, for himself and his descendants. A less likely, though still possible, restoration is \u003Cforeign xml:lang=\"grc\">ἐκ τ|ῶν] ἰδίων [ἐγόρασεν\u003C/foreign> (cf. IG XIV 529, ll. 4–5). On the formula fecit sibis et suis, which at Catania is attested exclusively in Christian funerary inscriptions, see Ferrua 1941, 242–243.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IG\">\n                        \u003Cauthor>Kaibel\u003C/author>\n                        \u003Cdate>1890\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"https://clio.columbia.edu/catalog/6873760\">516\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Q2SBPG9F\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001072\">https://biblio.inscriptiones.org/epig10001072\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Amico\u003C/author>\n                        \u003Cdate>1741\u003C/date>\n                        \u003CcitedRange>277\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F5INCW3T\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10002186\">https://biblio.inscriptiones.org/epig10002186\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Ferrua\u003C/author>\n                        \u003Cdate>1941\u003C/date>\n                        \u003CcitedRange>243 n.2\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/4HR4GXBX\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001456\">https://biblio.inscriptiones.org/epig10001456\u003C/ref>\u003C/bibl>\n                    \u003Cbibl/>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
