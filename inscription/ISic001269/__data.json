encoded text\u003C/change>\n                \u003Cchange when=\"2024-07-29\" who=\"#JP\">Jonathan Prag revised metadata\u003C/change>\n\t\u003C/listChange>\n        \u003C/revisionDesc>\n    \u003C/teiHeader>\n    \u003Cfacsimile>\n        \u003Csurface type=\"front\">\n            \u003Cgraphic n=\"screen\" url=\"ISic001269_tiled.tif\" height=\"1944px\" width=\"2592px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo L. Campagna 2005-03-31\u003C/desc>\n            \u003C/graphic>\n            \u003Cgraphic n=\"print\" url=\"ISic001269.jpg\" height=\"1944px\" width=\"2592px\">\n                \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo L. Campagna 2005-03-31\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n    \u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#MB\">\n                    \u003Cab>\n                        \u003Clb n=\"1\"/>ἐνθάδε κῖτε \u003Cg ref=\"#staurogram\">𐆠\u003C/g>\n                        \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>Ἀγάθων\u003C/name>\u003C/persName> πιστὸς\n                        \u003Clb n=\"3\"/>ζήσας ἔτη \u003Cnum value=\"7\">ζ\u003C/num> \u003Cexpan>\u003Cabbr>μ\u003C/abbr>\u003Cex>ῆ\u003C/ex>\u003Chi rend=\"ligature\">\u003Cabbr>νας\u003C/abbr>\u003C/hi>\u003C/expan>\n                        \u003Clb n=\"4\"/>\u003Cnum value=\"7\">ζ\u003C/num> ἀνεπαύσατο\n                    \u003Clb n=\"5\"/>\u003CroleName type=\"supracivic\" subtype=\"consul\">\u003Cexpan>\u003Cabbr>ὑ\u003Chi rend=\"ligature\">πατ\u003C/hi>\u003C/abbr>\u003Cex>ίᾳ\u003C/ex>\u003C/expan>\u003C/roleName> \u003CpersName type=\"attested\">\u003Cname>Ὀνωρίου\u003C/name>\u003C/persName> τὸ \u003Cnum value=\"8\">η\u003C/num>\n                        \u003Clb n=\"6\"/>\u003Cchoice>\u003Corig>κὲ\u003C/orig>\u003Creg>καὶ\u003C/reg>\u003C/choice> \u003CpersName type=\"attested\">\u003Cname>Θεοδοσίου\u003C/name>\u003C/persName> τὸ \u003Cnum value=\"3\">γ\u003C/num> \u003Cexpan>\u003Cabbr>Σε\n                    \u003Clb n=\"7\" break=\"no\"/>β\u003C/abbr>\u003Cex>αστῶν\u003C/ex>\u003C/expan>  \u003Cexpan>\u003Cabbr>Α\u003Cam>α\u003C/am>υ\u003Cam>ὐ\u003C/am>γ\u003Cam>γ\u003C/am>\u003C/abbr>\u003Cex>ούστων δυοῖν\u003C/ex>\u003C/expan> τῇ πρὸ \u003Cnum value=\"5\">\u003Cchoice>\u003Csic>γ\u003C/sic>\u003Ccorr>ε\u003C/corr>\u003C/choice>\u003C/num> \u003Cg ref=\"#interpunct\">·\u003C/g>\n                        \u003Clb n=\"8\"/>εἰδῶν Ὀκτωβρίων\n                        \u003Clb n=\"9\"/>ἡμέρᾳ Σελήνης \u003Cg ref=\"#staurogram\">𐆠\u003C/g>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text of IG 14.0444\u003C/note>\u003C/app>\u003C/listApp>\n                \u003Capp loc=\"7\">\u003Cnote>Ferrua 1982 and 1989: corrects Γ to Ε\u003C/note>\u003C/app>\n            \u003C/div>\n            \u003Cdiv type=\"translation\">\n                \u003Cp>\u003C!--translation(s) - add @xml:lang for 'en' or 'it' to div-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>Ferrua notes that the date must be corrected, if it is to align with the consulship year of 409. Note the day recorded as day of the moon; and note the combined use of Greek and Latin abbreviations for Augustus, the latter in Greek letters.\n                    \u003C!--enthade keitai; chi-rho symbol; Agathon; Age in years and months; cos. date of death, together with day and month; Note that the day is specified as that of Selene. F corrects the date from 409 to 411. Photograph from Lorenzo Campagna-->\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IG\">\n                        \u003Cauthor>Kaibel\u003C/author>\n                        \u003Cdate>1890\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"https://clio.columbia.edu/catalog/6873760\">444\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Q2SBPG9F\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001072\">https://biblio.inscriptiones.org/epig10001072\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Rizzo\u003C/author>\n                        \u003Cdate>1904\u003C/date>\n                        \u003CcitedRange>114\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/D82CQMFK\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10003144\">https://biblio.inscriptiones.org/epig10003144\u003C/ref>\n                    \u003C/bibl>\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>1986\u003C/date>\n                        \u003CcitedRange>36.0887\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Ferrua\u003C/author>\n                        \u003Cdate>1982-1983\u003C/date>\n                        \u003CcitedRange>12 no.35\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Q7DDNWD6\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001996\">https://biblio.inscriptiones.org/epig10001996\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Ferrua\u003C/author>\n                        \u003Cdate>1989\u003C/date>\n                        \u003CcitedRange>no.483\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/759ZXHKQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001995\">https://biblio.inscriptiones.org/epig10001995\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Muscolino\u003C/author>\n                        \u003Cdate>2011-2012\u003C/date>\n                        \u003CcitedRange>222 G6 fig.7\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/GJKY97S8\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002215\">https://biblio.inscriptiones.org/epig10002215\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
