        \u003Cdesc>I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana\u003C/desc>\n            \u003C/graphic>\n         \u003C/surface>\n     -->\u003C/facsimile>\n    \u003Ctext>\n        \u003Cbody>\n            \u003Cdiv type=\"edition\" subtype=\"primary\" xml:space=\"preserve\" xml:lang=\"grc\" resp=\"#AA\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cw>ἐτελεύτησεν\u003C/w>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>Ἰουλιανὸς\u003C/name>\u003C/persName>\n                    \u003Clb n=\"3\"/>\u003Cw>τῇ\u003C/w> \u003Cw>πρὸ\u003C/w> \u003Cnum value=\"15\">\u003Chi rend=\"supraline\">ιε\u003C/hi>\u003C/num> \u003Cw>\u003Cexpan>\u003Cabbr>κ\u003Chi rend=\"supraline\">αλ\u003C/hi>\u003C/abbr>\u003Cex>ανδῶν\u003C/ex>\u003C/expan>\u003C/w>\n                    \u003Clb n=\"4\"/>\u003Cw>Ἀπριλίων\u003C/w> \u003Cw>ζή\n                    \u003Clb n=\"5\" break=\"no\"/>σας\u003C/w> \u003Cw>ἔτη\u003C/w> \u003Cnum value=\"50\">ν\u003C/num>\n                    \u003Clb n=\"6\"/>\u003Cg ref=\"#alpha\">Α\u003C/g> \u003Cg ref=\"#staurogram\">⳨\u003C/g> \u003Cg ref=\"#omega\">Ω\u003C/g>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n                \u003ClistApp>\u003Capp>\u003Cnote>Text: IG\u003C/note>\u003C/app>\u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#AA\">\n                \u003Cp>Ioulianos died 15 days before the Kalends of April, having lived for 50 years\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\">\n                \u003Cp>The funerary inscription is Christian, as suggested by the particular attention devoted to recording the day of the deceased's death and by the final Christogram. For the name \u003Cforeign xml:lang=\"grc\">Ἰουλιανός\u003C/foreign> in Sicily, see IG XIV 126 (= \u003Cref target=\"https://sicily.classics.ox.ac.uk/inscription/ISic000943\">ISic000943\u003C/ref>), from Syracuse.\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"corpus\" n=\"IG\">\n                        \u003Cauthor>Kaibel\u003C/author>\n                        \u003Cdate>1890\u003C/date>\n                        \u003CcitedRange>\n                            \u003Cref target=\"https://clio.columbia.edu/catalog/6873760\">539\u003C/ref>\n                        \u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/Q2SBPG9F\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001072\">https://biblio.inscriptiones.org/epig10001072\u003C/ref>\u003C/bibl>\n                    \u003Cbibl type=\"corpus\" n=\"CIG\">\n                        \u003Cauthor>Kirchhoff\u003C/author>\n                        \u003Cdate>1877\u003C/date>\n                        \u003CcitedRange>9489\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/533T8HNS\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10001249\">https://biblio.inscriptiones.org/epig10001249\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Amico\u003C/author>\n                        \u003Cdate>1741\u003C/date>\n                        \u003CcitedRange>267 no. IX\u003C/citedRange>\n                        \u003Cptr target=\"http://zotero.org/groups/382445/items/F5INCW3T\"/>\n                        \u003Cref target=\"https://biblio.inscriptiones.org/epig10002186\">https://biblio.inscriptiones.org/epig10002186\u003C/ref>\n                    \u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\u003Cbibl/>\u003C/listBibl>\n