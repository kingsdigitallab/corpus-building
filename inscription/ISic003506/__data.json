 resp=\"#JP\">\n                \u003Cab>\n                    \u003Clb n=\"1\"/>\u003Cg ref=\"#ivy-leaf\">❦\u003C/g> \u003Chi rend=\"stacked\">\u003Cg ref=\"#sinusoid\">&#65932;\u003C/g>\u003C/hi> \u003Cw>\u003Cexpan>\u003Cabbr>\u003Chi rend=\"ligature\">μνημ\u003C/hi>\u003C/abbr>\u003Cex>ίον\u003C/ex>\u003C/expan>\u003C/w>  \u003Cw>ἐνθά\u003Csupplied reason=\"lost\">δε\u003C/supplied>\u003C/w> \u003Cw>\u003Csupplied reason=\"lost\">κῖτε\u003C/supplied>\u003C/w>\n                    \u003Clb n=\"2\"/>\u003CpersName type=\"attested\">\u003Cname>Γεώργιος\u003C/name>\u003C/persName> \u003Cw>παῖ\u003Csupplied reason=\"lost\">ς\u003C/supplied>\u003C/w> \u003Cw>\u003Cexpan>\u003Cabbr>\u003Csupplied reason=\"lost\" cert=\"low\">ἀναπαυ\u003C/supplied>\n                    \u003Clb n=\"3\" break=\"no\"/>\u003Csupplied reason=\"lost\">σ\u003C/supplied>\u003Cunclear>ά\u003C/unclear>μ\u003C/abbr>\u003Cex>ενος\u003C/ex>\u003C/expan>\u003C/w> \u003Cw>\u003Cexpan>\u003Cabbr>μ\u003Cam>\u003Cg ref=\"#sinusoid\">&#65932;\u003C/g>\u003C/am>\u003C/abbr>\u003Cex>ηνῶν\u003C/ex>\u003C/expan>\u003C/w> \u003Cnum value=\"9\">θ\u003C/num> \u003Cw>\u003Cexpan>\u003Cabbr>μ\u003C/abbr>\u003Cex>ηνὶ\u003C/ex>\u003C/expan>\u003C/w> \u003Cw>Μαΐῳ\u003C/w> \u003Cgap reason=\"lost\" extent=\"unknown\" unit=\"character\"/>\n                \u003C/ab>\n            \u003C/div>\n            \u003Cdiv type=\"apparatus\">\n               \u003ClistApp>\n                   \u003Capp>\u003Cnote>Text of Manganaro\u003C/note>\u003C/app>\n                   \u003Capp loc=\"line 3\">\u003Cnote>A small S above Μ represents the abbreviation\u003C/note>\u003C/app>\n               \u003C/listApp>\n            \u003C/div>\n            \u003Cdiv type=\"translation\" xml:lang=\"en\" resp=\"#JP\">\n                \u003Cp>Memorial. Here lies infant Georgios, passed away at 9 months in the month of May...\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"commentary\" resp=\"#martaf\">\u003Cp>The inscription is dated to the Byzantine period on the basis of the presence of abbreviation marks. The structure of the epitaph is the same as that of IMusCatania 198 (5th–6th century CE), which features the heading \u003Cforeign xml:lang=\"grc\">μνημεῖον\u003C/foreign> and the expression \u003Cforeign xml:lang=\"grc\">ἐνθάδε κεῖται\u003C/foreign>, followed by the name of the deceased in the nominative (cf. Korhonen 2004, 265).\u003C/p>\n            \u003C/div>\n            \u003Cdiv type=\"bibliography\">\n                \u003ClistBibl type=\"edition\">\n                    \u003Cbibl type=\"bulletin\" n=\"SEG\">\n                        \u003Cdate>2001\u003C/date>\n                        \u003CcitedRange>51.1201\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/F2GG87EQ\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10000796\">https://biblio.inscriptiones.org/epig10000796\u003C/ref>\u003C/bibl>\n                    \u003Cbibl>\n                        \u003Cauthor>Manganaro\u003C/author>\n                        \u003Cdate>2001\u003C/date>\n                        \u003CcitedRange>138 fig.3\u003C/citedRange>\n                        \u003Cptr target=\"https://www.zotero.org/groups/382445/items/JVCEV98D\"/>\n                    \u003Cref target=\"https://biblio.inscriptiones.org/epig10001807\">https://biblio.inscriptiones.org/epig10001807\u003C/ref>\u003C/bibl>\n                \u003C/listBibl>\n\t   \u003ClistBibl type=\"discussion\">\n\t       \u003Cbibl>\n\t           \u003Cauthor>Korhonen\u003C/author>\n\t           \u003Cdate>2004\u003C/date>\n\t           \u003CcitedRange>265\u003C/citedRange>\n\t           \u003Cptr target=\"http://zotero.org/groups/382445/items/2EUC82DH\"/>\n\t           \u003Cref target=\"https://biblio.inscriptiones.org/epig10000028\">https://biblio.inscriptiones.org/epig10000028\u003C/ref>\n\t       \u003C/bibl>\n\t   \u003C/listBibl>\n            \u003C/div>\n        \u003C/body>\n    \u003C/text>\n\u003C/TEI>\n"],"uses":{"params":["slug"]}}]}
