u003C/span>\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Λούκιος ς Λουκίου υἱὸς ο\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Λούκιος\">Λούκιος\u003C/span>  \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"ς\">[\u003Cspan dir=\"ltr\" class=\"gap\">. 5.\u003C/span>]ς\u003C/span>  \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Λουκίου\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Λουκίου\">Λουκίου\u003C/span>\u003C/span> υἱὸ[ς \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"ο\">\u003Cspan dir=\"ltr\" class=\"gap\">..\u003C/span>]ο[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>\u003C/span>\u003C/span> γυμνασίαρχος τῶν τε ἐφήβων καὶ νε]ωτέρων τοὺς ἀν[κ]λίτας ἐκ τῶν ἰδίων \u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἑρμᾶι\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἑρμᾶι\">Ἑρμᾶι\u003C/span>\u003C/span> καὶ \u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἡρακλεῖ\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἡρακλεῖ\">Ἡρακλε[ῖ]\u003C/span>\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":140,"ptr":141,"ref":143,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"77-78",{"target":142},"https://www.zotero.org/groups/382445/items/SWSRB88X",{"_":144,"target":144},"https://biblio.inscriptiones.org/epig10002048",2010,false],"uses":{"params":["slug"]}}]}
