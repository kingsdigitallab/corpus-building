7,"notAfter":168,"evidence":169},"Dated to the end of the 4th century BCE by the burial goods",-325,-301,"archaeological-context",[171,172],{"_":72,"type":73,"ref":74,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[174],[83,84],[176,177],38.06519,15.11438,{"_":179,"role":180,"ref":181},"Museo Archeologico Santi Furnari di Tripi","museum","http://sicily.classics.ox.ac.uk/museum/177",{"_":183,"type":184},"ME23435","inventory",{"_":186,"mainLang":187,"languages":188},"Ancient Greek","grc",[186],[190],{"atLeast":191,"atMost":191},30,[105,193,106,194],"Bacci, Coppolino, Sofia, Arizia, 2015, Tripi. Il museo archeologico \"Santi Furnari\". Guida all'esposizione","Sofia, 2018, Nuove iscrizioni funerarie dalla necropoli di Abakainon",[111,196,112,197],"ILQ4RQGU","JQQKI6JP",[199,200,201,142,146,150,117,118,119,120,118,202,203,187],"isic004411","epitaph for kratisstos",{"_":134},"museo archeologico santi furnari di tripi","ancient greek","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κρατίσστω \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":206,"ptr":207,"ref":208,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"27 fig.14",{"target":126},{"_":128,"target":128},{"file":210,"uri":210,"title":211,"status":212,"editions":213,"editionAuthor":27,"type":219,"objectType":220,"material":224,"condition":53,"layoutDesc":226,"handNote":230,"date":235,"places":239,"geo":243,"country":75,"provenance":72,"provenanceGeo":245,"region":88,"settlement":77,"repository":246,"idno":250,"textLang":251,"tmNumber":53,"letterHeights":253,"publications":255,"zotero":256,"keywords":257,"html":262,"bibl":263,"bulletinDateSort":129,"citedRangeSort":264,"languageSort":186,"materialSort":150,"typeSort":142},"ISic004415","Epitaph for Krimma, child of Aunakos",{"_":134},[214,215,216,217,218],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":221,"ana":222,"ref":223},"plinth","#object.arch_element.plinth","https://www.eagle-network.eu/voc/objtyp/lod/1910.html",{"_":150,"ana":39,"type":40,"subtype":225,"ref":152},[42],{"layout":227},{"p":228,"rs":229,"damage":53},"Single line of greek letters approximately centred on the face of the plinth",{"_":50,"ana":51,"ref":52},{"lettering":231,"dimensions":232},"Small simple letters. Kappa has short equal arms, attached to the vertical; rho has small closed eye; mu has slanting first and final strokes, with the mid-strokes joining as a curve and only descending half-way; alpha is broad with straight bar, in one case slightly curved with the apex extending at the top; nu has shorter right vertical joining the diagonal above the line; omicron is small and mid-line.",[233,234],{"type":58,"l":161,"from":60,"to":60,"h":162,"unit":62,"atLeast":162,"atMost":162},{"type":64,"l":65,"from":60,"to":61,"h":164,"unit":62},{"_":236,"notBefore":237,"notAfter":238,"evidence":169},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",-350,-201,[240,242],{"_":72,"type":73,"ref":74,"corresp":241,"region":75},"#findspot",{"_":77,"type":78,"ref":79,"offset":80,"region":75},[244],[83,84],[176,177],{"_":247,"role":248,"ref":249},"Necropoli di Abakainon","site","http://sicily.classics.ox.ac.uk/museum/186",{"type":184},{"_":186,"mainLang":187,"languages":252},[186],[254],{"atLeast":191,"atMost":191},[105,194],[111,197],[258,259,260,142,221,150,117,118,119,120,118,261,203,187],"isic004415","epitaph for krimma, child of aunakos",{"_":134},"necropoli di abakainon","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κριμμα Αυνακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":264,"ptr":265,"ref":266,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"28 fig.15 (and ref on p.113)",{"target":126},{"_":128,"target":128},{"file":268,"uri":268,"title":269,"status":270,"editions":271,"editionAuthor":27,"type":277,"objectType":278,"material":279,"condition":53,"layoutDesc":281,"handNote":285,"date":291,"places":292,"geo":295,"country":75,"provenance":72,"provenanceGeo":297,"region":88,"settlement":77,"repository":298,"idno":299,"textLang":300,"tmNumber":53,"letterHeights":302,"publications":305,"zotero":306,"keywords":307,"html":311,"bibl":312,"bulletinDateSort":129,"citedRangeSort":264,"languageSort":186,"materialSort":150,"typeSort":142},"ISic004416","Epitaph for Philon, son Aunakos",{"_":134},[272,273,274,275,276],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":221,"ana":222,"ref":223},{"_":150,"ana":39,"type":40,"subtype":280,"ref":152},[42],{"layout":282},{"p":283,"rs":284,"damage":53},"Single line of greek letters approximately centred on the face of the plinth, descending to right",{"_":50,"ana":51,"ref":52},{"lettering":286,"dimensions":287},"Crude and irregularly carved large letters. Phi has a small eye, seemingly formed of two small loops; omega is small, mid-line, open, with outward/downward sloping tails; nu is large and uneven; alpha is broad, but the form of the bar is illegible; kappa has short equal arms joined to the vertical; omicron appears small and midline.",[288,290],{"type":58,"l":161,"from":60,"to":60,"h":289,"unit":62,"atLeast":289,"atMost":289},"59",{"type":64,"l":65,"from":60,"to":61,"h":164,"unit":62},{"_":236,"notBefore":237,"notAfter":238,"evidence":169},[293,294],{"_":72,"type":73,"ref":74,"corresp":241,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[296],[83,84],[176,177],{"_":247,"role":248,"ref":249},{"type":184},{"_":186,"mainLang":187,"languages":301},[186],[303],{"atLeast":304,"atMost":304},59,[105,194],[111,197],[308,309,310,142,221,150,117,118,119,120,118,261,203,187],"isic004416","epitaph for philon, son aunakos",{"_":134},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Φίλων Αυ̣νακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":264,"ptr":313,"ref":314,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":126},{"_":128,"target":128},{"file":316,"uri":316,"title":317,"status":318,"editions":319,"editionAuthor":27,"type":325,"objectType":326,"material":327,"condition":53,"layoutDesc":329,"handNote":332,"date":337,"places":340,"geo":343,"country":75,"provenance":72,"provenanceGeo":345,"region":88,"settlement":77,"repository":346,"idno":347,"textLang":349,"tmNumber":53,"letterHeights":351,"publications":353,"zotero":354,"keywords":355,"html":359,"bibl":360,"bulletinDateSort":129,"citedRangeSort":361,"languageSort":186,"materialSort":150,"typeSort":142},"ISic004414","Epitaph for Eupolemos",{"_":134},[320,321,322,323,324],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":146,"ana":147,"ref":148},{"_":150,"ana":39,"type":40,"subtype":328,"ref":152},[42],{"layout":330},{"p":155,"rs":331,"damage":53},{"_":50,"ana":51,"ref":52},{"lettering":333,"dimensions":334},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[335,336],{"type":58,"l":161,"from":60,"to":60,"h":162,"unit":62,"atLeast":162,"atMost":162},{"type":64,"l":65,"from":60,"to":61,"h":164,"unit":62},{"_":338,"notBefore":339,"notAfter":238,"evidence":169},"The goods recovered from the tomb suggest a date in the 3rd century BCE",-300,[341,342],{"_":72,"type":73,"ref":74,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[344],[83,84],[176,177],{"_":179,"role":180,"ref":181},{"_":348,"type":184},"ME23438",{"_":186,"mainLang":187,"languages":350},[186],[352],{"atLeast":191,"atMost":191},[105,193,106,194],[111,196,112,197],[356,357,358,142,146,150,117,118,119,120,118,202,203,187],"isic004414","epitaph for eupolemos",{"_":134},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":361,"ptr":362,"ref":363,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"41 fig.23",{"target":126},{"_":128,"target":128},{"file":365,"uri":365,"title":366,"status":367,"editions":368,"editionAuthor":27,"type":374,"objectType":375,"material":376,"condition":53,"layoutDesc":378,"handNote":382,"date":388,"places":390,"geo":393,"country":75,"provenance":72,"provenanceGeo":395,"region":88,"settlement":77,"repository":396,"idno":397,"textLang":398,"tmNumber":53,"letterHeights":400,"publications":402,"zotero":403,"keywords":404,"html":408,"bibl":409,"bulletinDateSort":129,"citedRangeSort":410,"languageSort":186,"materialSort":150,"typeSort":142},"ISic004418","Epitaph for [-?-], child of Gerontios",{"_":134},[369,370,371,372,373],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":221,"ana":222,"ref":223},{"_":150,"ana":39,"type":40,"subtype":377,"ref":152},[42],{"layout":379},{"p":380,"rs":381,"damage":53},"Most of the lower line of Greek text is preserved, centred on the front face of the plinth; traces of a preceding line are visible.",{"_":50,"ana":51,"ref":52},{"lettering":383,"dimensions":384},"Neat, regular, simply cut, widely spaced letters. Epsilon has shorter middle bar; rho has closed, regular eye; omicron is small and mid-line; nu is broad with verticals of equal length.",[385,387],{"type":58,"l":386,"from":60,"to":61,"h":289,"unit":62,"atLeast":289,"atMost":289},"Line 1-2",{"type":64,"l":65,"from":60,"to":61,"unit":62},{"_":389,"notBefore":237,"notAfter":238,"evidence":169},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[391,392],{"_":72,"type":73,"ref":74,"corresp":241,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[394],[83,84],[176,177],{"_":247,"role":248,"ref":249},{"type":184},{"_":186,"mainLang":187,"languages":399},[186],[401],{"atLeast":304,"atMost":304},[105,106,194],[111,112,197],[405,406,407,142,221,150,117,118,119,120,118,261,203,187],"isic004418","epitaph for [-?-], child of gerontios",{"_":134},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ς̣ \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>Γ̣ερόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":410,"ptr":411,"ref":412,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"113 and 166 tav.XXXIVa",{"target":126},{"_":128,"target":128},{"file":414,"uri":414,"title":366,"status":415,"editions":416,"editionAuthor":27,"type":422,"objectType":423,"material":424,"condition":53,"layoutDesc":426,"handNote":430,"date":435,"places":436,"geo":439,"country":75,"provenance":72,"provenanceGeo":441,"region":88,"settlement":77,"repository":442,"idno":443,"textLang":444,"tmNumber":53,"letterHeights":446,"publications":448,"zotero":449,"keywords":450,"html":453,"bibl":454,"bulletinDateSort":129,"citedRangeSort":455,"languageSort":186,"materialSort":150,"