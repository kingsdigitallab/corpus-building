rt":142},"ISic004415","Epitaph for Krimma, child of Aunakos",{"_":134},[216,217,218,219,220],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":223,"ana":224,"ref":225},"plinth","#object.arch_element.plinth","https://www.eagle-network.eu/voc/objtyp/lod/1910.html",{"_":150,"ana":151,"type":152,"subtype":227,"ref":154},[42],{"layout":229},{"p":230,"rs":231,"damage":53},"Single line of greek letters approximately centred on the face of the plinth",{"_":50,"ana":51,"ref":52},{"lettering":233,"dimensions":234},"Small simple letters. Kappa has short equal arms, attached to the vertical; rho has small closed eye; mu has slanting first and final strokes, with the mid-strokes joining as a curve and only descending half-way; alpha is broad with straight bar, in one case slightly curved with the apex extending at the top; nu has shorter right vertical joining the diagonal above the line; omicron is small and mid-line.",[235,236],{"type":58,"l":163,"from":60,"to":60,"h":164,"unit":62,"atLeast":164,"atMost":164},{"type":64,"l":65,"from":60,"to":61,"h":166,"unit":62},{"_":238,"notBefore":239,"notAfter":240,"evidence":171},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",-350,-201,[242,244],{"_":72,"type":73,"ref":74,"corresp":243,"region":75},"#findspot",{"_":77,"type":78,"ref":79,"offset":80,"region":75},[246],[83,84],[178,179],{"_":249,"role":250,"ref":251},"Necropoli di Abakainon","site","http://sicily.classics.ox.ac.uk/museum/186",{"type":186},{"_":188,"mainLang":189,"languages":254},[188],[256],{"atLeast":193,"atMost":193},[105,196],[111,199],[260,261,262,142,223,150,117,118,119,120,118,263,205,189],"isic004415","epitaph for krimma, child of aunakos",{"_":134},"necropoli di abakainon","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κριμμα Αυνακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":266,"ptr":267,"ref":268,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"28 fig.15 (and ref on p.113)",{"target":126},{"_":128,"target":128},{"file":270,"uri":270,"title":271,"status":272,"editions":273,"editionAuthor":27,"type":279,"objectType":280,"material":281,"condition":53,"layoutDesc":283,"handNote":287,"date":293,"places":294,"geo":297,"country":75,"provenance":72,"provenanceGeo":299,"region":88,"settlement":77,"repository":300,"idno":301,"textLang":302,"tmNumber":53,"letterHeights":304,"publications":307,"zotero":308,"keywords":309,"html":313,"bibl":314,"bulletinDateSort":129,"citedRangeSort":266,"languageSort":188,"materialSort":150,"typeSort":142},"ISic004416","Epitaph for Philon, son Aunakos",{"_":134},[274,275,276,277,278],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":223,"ana":224,"ref":225},{"_":150,"ana":151,"type":152,"subtype":282,"ref":154},[42],{"layout":284},{"p":285,"rs":286,"damage":53},"Single line of greek letters approximately centred on the face of the plinth, descending to right",{"_":50,"ana":51,"ref":52},{"lettering":288,"dimensions":289},"Crude and irregularly carved large letters. Phi has a small eye, seemingly formed of two small loops; omega is small, mid-line, open, with outward/downward sloping tails; nu is large and uneven; alpha is broad, but the form of the bar is illegible; kappa has short equal arms joined to the vertical; omicron appears small and midline.",[290,292],{"type":58,"l":163,"from":60,"to":60,"h":291,"unit":62,"atLeast":291,"atMost":291},"59",{"type":64,"l":65,"from":60,"to":61,"h":166,"unit":62},{"_":238,"notBefore":239,"notAfter":240,"evidence":171},[295,296],{"_":72,"type":73,"ref":74,"corresp":243,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[298],[83,84],[178,179],{"_":249,"role":250,"ref":251},{"type":186},{"_":188,"mainLang":189,"languages":303},[188],[305],{"atLeast":306,"atMost":306},59,[105,196],[111,199],[310,311,312,142,223,150,117,118,119,120,118,263,205,189],"isic004416","epitaph for philon, son aunakos",{"_":134},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Φίλων Αυ̣νακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":266,"ptr":315,"ref":316,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":126},{"_":128,"target":128},{"file":318,"uri":318,"title":319,"status":320,"editions":321,"editionAuthor":27,"type":327,"objectType":328,"material":329,"condition":53,"layoutDesc":331,"handNote":334,"date":339,"places":342,"geo":345,"country":75,"provenance":72,"provenanceGeo":347,"region":88,"settlement":77,"repository":348,"idno":349,"textLang":351,"tmNumber":53,"letterHeights":353,"publications":355,"zotero":356,"keywords":357,"html":361,"bibl":362,"bulletinDateSort":129,"citedRangeSort":363,"languageSort":188,"materialSort":150,"typeSort":142},"ISic004414","Epitaph for Eupolemos",{"_":134},[322,323,324,325,326],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":146,"ana":147,"ref":148},{"_":150,"ana":151,"type":152,"subtype":330,"ref":154},[42],{"layout":332},{"p":157,"rs":333,"damage":53},{"_":50,"ana":51,"ref":52},{"lettering":335,"dimensions":336},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[337,338],{"type":58,"l":163,"from":60,"to":60,"h":164,"unit":62,"atLeast":164,"atMost":164},{"type":64,"l"