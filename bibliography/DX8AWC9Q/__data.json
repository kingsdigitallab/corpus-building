ana":51,"ref":52},{"lettering":385,"dimensions":386},"Neat, regular, simply cut, widely spaced letters. Epsilon has shorter middle bar; rho has closed, regular eye; omicron is small and mid-line; nu is broad with verticals of equal length.",[387,389],{"type":58,"l":388,"from":60,"to":61,"h":291,"unit":62,"atLeast":291,"atMost":291},"Line 1-2",{"type":64,"l":65,"from":60,"to":61,"unit":62},{"_":391,"notBefore":239,"notAfter":240,"evidence":171},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[393,394],{"_":72,"type":73,"ref":74,"corresp":243,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[396],[83,84],[178,179],{"_":249,"role":250,"ref":251},{"type":186},{"_":188,"mainLang":189,"languages":401},[188],[403],{"atLeast":306,"atMost":306},[105,106,196],[111,112,199],[407,408,409,142,223,150,117,118,119,120,118,263,205,189],"isic004418","epitaph for [-?-], child of gerontios",{"_":134},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ς̣ \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>Γ̣ερόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":412,"ptr":413,"ref":414,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"113 and 166 tav.XXXIVa",{"target":126},{"_":128,"target":128},{"file":416,"uri":416,"title":368,"status":417,"editions":418,"editionAuthor":27,"type":424,"objectType":425,"material":426,"condition":53,"layoutDesc":428,"handNote":432,"date":437,"places":438,"geo":441,"country":75,"provenance":72,"provenanceGeo":443,"region":88,"settlement":77,"repository":444,"idno":445,"textLang":446,"tmNumber":53,"letterHeights":448,"publications":450,"zotero":451,"keywords":452,"html"