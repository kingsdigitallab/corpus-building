6,"notBefore":167,"notAfter":168,"evidence":169},"Dated to the end of the 4th century BCE by the burial goods",-325,-301,"archaeological-context",[171,172],{"_":72,"type":73,"ref":74,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[174],[83,84],[176,177],38.06519,15.11438,{"_":179,"role":180,"ref":181},"Museo Archeologico Santi Furnari di Tripi","museum","http://sicily.classics.ox.ac.uk/museum/177",{"_":183,"type":184},"ME23435","inventory",{"_":186,"mainLang":187,"languages":188},"Ancient Greek","grc",[186],{"n":94,"url":190,"height":191,"width":192,"desc":193,"surfaceType":99},"ISic004411_tiled.tif","3680px","5520px","I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana",[195],{"atLeast":196,"atMost":196},30,[105,198,106,199],"Bacci, Coppolino, Sofia, Arizia, 2015, Tripi. Il museo archeologico \"Santi Furnari\". Guida all'esposizione","Sofia, 2018, Nuove iscrizioni funerarie dalla necropoli di Abakainon",[111,201,112,202],"ILQ4RQGU","JQQKI6JP",[204,205,206,142,146,150,117,118,119,120,118,207,208,187],"isic004411","epitaph for kratisstos",{"_":134},"museo archeologico santi furnari di tripi","ancient greek","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κρατίσστω \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":211,"ptr":212,"ref":213,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"27 fig.14",{"target":126},{"_":128,"target":128},{"file":215,"uri":215,"title":216,"status":217,"editions":218,"editionAuthor":27,"type":224,"objectType":225,"material":229,"condition":53,"layoutDesc":231,"handNote":235,"date":240,"places":244,"geo":248,"country":75,"provenance":72,"provenanceGeo":250,"region":88,"settlement":77,"repository":251,"idno":255,"textLang":256,"tmNumber":53,"facsimile":258,"letterHeights":260,"publications":262,"zotero":263,"keywords":264,"html":269,"bibl":270,"bulletinDateSort":129,"citedRangeSort":271,"languageSort":186,"materialSort":150,"typeSort":142},"ISic004415","Epitaph for Krimma, child of Aunakos",{"_":134},[219,220,221,222,223],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":226,"ana":227,"ref":228},"plinth","#object.arch_element.plinth","https://www.eagle-network.eu/voc/objtyp/lod/1910.html",{"_":150,"ana":39,"type":40,"subtype":230,"ref":152},[42],{"layout":232},{"p":233,"rs":234,"damage":53},"Single line of greek letters approximately centred on the face of the plinth",{"_":50,"ana":51,"ref":52},{"lettering":236,"dimensions":237},"Small simple letters. Kappa has short equal arms, attached to the vertical; rho has small closed eye; mu has slanting first and final strokes, with the mid-strokes joining as a curve and only descending half-way; alpha is broad with straight bar, in one case slightly curved with the apex extending at the top; nu has shorter right vertical joining the diagonal above the line; omicron is small and mid-line.",[238,239],{"type":58,"l":161,"from":60,"to":60,"h":162,"unit":62,"atLeast":162,"atMost":162},{"type":64,"l":65,"from":60,"to":61,"h":164,"unit":62},{"_":241,"notBefore":242,"notAfter":243,"evidence":169},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",-350,-201,[245,247],{"_":72,"type":73,"ref":74,"corresp":246,"region":75},"#findspot",{"_":77,"type":78,"ref":79,"offset":80,"region":75},[249],[83,84],[176,177],{"_":252,"role":253,"ref":254},"Necropoli di Abakainon","site","http://sicily.classics.ox.ac.uk/museum/186",{"type":184},{"_":186,"mainLang":187,"languages":257},[186],{"n":94,"url":259,"height":191,"width":192,"desc":193,"surfaceType":99},"ISic004415_tiled.tif",[261],{"atLeast":196,"atMost":196},[105,199],[111,202],[265,266,267,142,226,150,117,118,119,120,118,268,208,187],"isic004415","epitaph for krimma, child of aunakos",{"_":134},"necropoli di abakainon","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κριμμα Αυνακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":271,"ptr":272,"ref":273,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"28 fig.15 (and ref on p.113)",{"target":126},{"_":128,"target":128},{"file":275,"uri":275,"title":276,"status":277,"editions":278,"editionAuthor":27,"type":284,"objectType":285,"material":286,"condition":53,"layoutDesc":288,"handNote":292,"date":298,"places":299,"geo":302,"country":75,"provenance":72,"provenanceGeo":304,"region":88,"settlement":77,"repository":305,"idno":306,"textLang":307,"tmNumber":53,"facsimile":309,"letterHeights":311,"publications":314,"zotero":315,"keywords":316,"html":320,"bibl":321,"bulletinDateSort":129,"citedRangeSort":271,"languageSort":186,"materialSort":150,"typeSort":142},"ISic004416","Epitaph for Philon, son Aunakos",{"_":134},[279,280,281,282,283],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":226,"ana":227,"ref":228},{"_":150,"ana":39,"type":40,"subtype":287,"ref":152},[42],{"layout":289},{"p":290,"rs":291,"damage":53},"Single line of greek letters approximately centred on the face of the plinth, descending to right",{"_":50,"ana":51,"ref":52},{"lettering":293,"dimensions":294},"Crude and irregularly carved large letters. Phi has a small eye, seemingly formed of two small loops; omega is small, mid-line, open, with outward/downward sloping tails; nu is large and uneven; alpha is broad, but the form of the bar is illegible; kappa has short equal arms joined to the vertical; omicron appears small and midline.",[295,297],{"type":58,"l":161,"from":60,"to":60,"h":296,"unit":62,"atLeast":296,"atMost":296},"59",{"type":64,"l":65,"from":60,"to":61,"h":164,"unit":62},{"_":241,"notBefore":242,"notAfter":243,"evidence":169},[300,301],{"_":72,"type":73,"ref":74,"corresp":246,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[303],[83,84],[176,177],{"_":252,"role":253,"ref":254},{"type":184},{"_":186,"mainLang":187,"languages":308},[186],{"n":94,"url":310,"height":191,"width":192,"desc":193,"surfaceType":99},"ISic004416_tiled.tif",[312],{"atLeast":313,"atMost":313},59,[105,199],[111,202],[317,318,319,142,226,150,117,118,119,120,118,268,208,187],"isic004416","epitaph for philon, son aunakos",{"_":134},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Φίλων Αυ̣νακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":271,"ptr":322,"ref":323,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":126},{"_":128,"target":128},{"file":325,"uri":325,"title":326,"status":327,"editions":328,"editionAuthor":27,"type":334,"objectType":335,"material":336,"condition":53,"layoutDesc":338,"handNote":341,"date":346,"places":349,"geo":352,"country":75,"provenance":72,"provenanceGeo":354,"region":88,"settlement":77,"repository":355,"idno":356,"textLang":358,"tmNumber":53,"facsimile":360,"letterHeights":362,"publications":364,"zotero":365,"keywords":366,"html":370,"bibl":371,"bulletinDateSort":129,"citedRangeSort":372,"languageSort":186,"materialSort":150,"typeSort":142},"ISic004414","Epitaph for Eupolemos",{"_":134},[329,330,331,332,333],{"type":16},{"type":19},{"type":21},{"type":24},{"type":26},{"_":142,"ana":143,"ref":144},{"_":146,"ana":147,"ref":148},{"_":150,"ana":39,"type":40,"subtype":337,"ref":152},[42],{"layout":339},{"p":155,"rs":340,"damage":53},{"_":50,"ana":51,"ref":52},{"lettering":342,"dimensions":343},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[344,345],{"type":58,"l":161,"from":60,"to":60,"h":162,"unit":62,"atLeast":162,"atMost":162},{"type":64,"l":65,"from":60,"to":61,"h":164,"unit":62},{"_":347,"notBefore":348,"notAfter":243,"evidence":169},"The goods recovered from the tomb suggest a date in the 3rd century BCE",-300,[350,351],{"_":72,"type":73,"ref":74,"region":75},{"_":77,"type":78,"ref":79,"offset":80,"region":75},[353],[83,84],[176,177],{"_":179,"role":180,"ref":181},{"_":357,"type":184},"ME23438",{"_":186,"mainLang":187,"languages":359},[186],{"n":94,"url":361,"height":191,"width":192,"desc":193,"surfaceType":99},"ISic004414_tiled.tif",[363],{"atLeast":196,"atMost":196},[105,198,106,199],[111,201,112,202],[367,368,369,142,146,150,117,118,119,120,118,207,208,187],"isic004414","epitaph for eupolemos",{"_":134},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":372,"ptr":373,"ref":374,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"41 fig.23",{"target":126},{"_":128,"target":128},{"file":376,"uri":376,"title":377,"status":378,"editions":379,"editionAuthor":27,"type":385,"objectType":386,"material":387,"condition":53,"layoutDesc":389,"handNote":393,"date":399,"places":401,"geo":404,"country":75,"provenance":72,"provenanceGeo":406,"region":88,"settlement":77,"repository":407,"idno":408,"textLang":409,"tmNumber":53,"facsimile":411,"letterHeights":413,"publications":415,"zotero":416,"keywords":417,"html":421,"bibl":422,"bulle