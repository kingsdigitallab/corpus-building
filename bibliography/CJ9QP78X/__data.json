{"type":"data","nodes":[{"type":"data","data":[{"debug":1},true],"uses":{}},{"type":"data","data":[{"zotero":1,"inscriptions":7,"isBulletin":227},{"title":2,"author":3,"date":4,"citation":5,"uri":6},"Olumpis Olumpios ed IG, XIV, 434","Gentile","2002","\u003Cspan>L. Gentile, «Olumpis Olumpios ed IG, XIV, 434», \u003Ci>Epigraphica\u003C/i> 64 (2002): 224–29\u003C/span>","https://www.zotero.org/groups/isicily/items/CJ9QP78X",[8],{"file":9,"uri":9,"title":10,"status":11,"editions":13,"editionAuthor":29,"type":30,"objectType":34,"material":38,"condition":44,"layoutDesc":45,"handNote":52,"date":144,"places":149,"geo":159,"country":154,"provenance":151,"provenanceGeo":163,"region":166,"settlement":156,"repository":167,"idno":171,"textLang":174,"tmNumber":15,"facsimile":178,"letterHeights":185,"publications":189,"zotero":199,"keywords":209,"html":219,"bibl":220,"bulletinDateSort":225,"citedRangeSort":226,"languageSort":175,"materialSort":39,"typeSort":31},"ISic001259","Statue base in honour of Olympis Mestos",{"_":12},"draft",[14,17,19,21,24,27],{"_":15,"type":16},"492865","TM",{"type":18},"EDR",{"type":20},"EDH",{"_":22,"type":23},"39101627","EDCS",{"_":25,"type":26},"140747","PHI",{"_":28,"type":26},"337259",null,{"_":31,"ana":32,"ref":33},"honorific","#function.honorific","https://ontology.inscriptiones.org/type_of_inscription/Honorific",{"_":35,"ana":36,"ref":37},"base","#object.base","http://www.eagle-network.eu/voc/objtyp/lod/57.html",{"_":39,"type":40,"resp":41,"ref":42,"subtype":43},"breccia","stone.breccia","#Coccato","http://www.eagle-network.eu/voc/material/lod/73.html",[],"",{"layout":46},{"p":47,"rs":48,"damage":44},"The inscription is set out over four lines on the front face of the block on its upper half. The text is roughly centred, lines 1-3 filling the face, line 4 a single word approximately centered. Spacing between words is apparent and increases significantly in line 3.",{"_":49,"ana":50,"ref":51},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"lettering":53,"dimensions":130},[54,55],"The letters are regular and with terminal points rather than serfis, and are inscribed in parts in what is almost a punch style, rather than a chiselled groove. Alpha has broken bar; epsilon has mostly equal legnth cross-bars; theta has a full-width cross bar; kappa has full length bars; mu has vertical first and last, three-quarter length mid-strokes; omicron is full-size; pi has eual length verticals; rho has fair-sized closed eye; sigma has horizontal top and bottom strokes; omega is rhomboid and closed.",{"_":56,"ref":57},"\n                                    Types list:\n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                ",[58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127],{"_":59,"target":60},"Α type2","https://kingsdigitallab.github.io/crossreads/data/allographs/types/greek-Α-type2.html",{"_":62,"target":63},"Ε type2","https://kingsdigitallab.github.io/crossreads/data/allographs/types/greek-Ε-type2.html",{"_":65,"target":66},"Ε type2.3","https://kingsdigitallab.github.io/crossrea