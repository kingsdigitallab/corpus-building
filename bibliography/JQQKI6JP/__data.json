,"atLeast":55,"atMost":55},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":202,"notBefore":203,"notAfter":204,"evidence":66},[253,254],{"_":69,"type":70,"ref":71,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[256],[80,81],[83,84],{"_":87,"role":88,"ref":89},{"_":260,"type":92},"ME23438",{"_":94,"mainLang":95,"languages":262},[94],[264],{"atLeast":99,"atMost":99},[101,102,103,104],[106,107,108,109],[268,269,270,26,30,34,114,115,116,117,115,118,119,95],"isic004414","epitaph for eupolemos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":273,"ptr":274,"ref":275,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.4 and fig.5",{"target":124},{"_":126,"target":126},{"file":277,"uri":277,"title":278,"status":279,"editions":280,"editionAuthor":24,"type":286,"objectType":287,"material":291,"condition":40,"layoutDesc":293,"handNote":297,"date":302,"places":304,"geo":308,"country":72,"provenance":69,"provenanceGeo":310,"region":85,"settlement":74,"repository":311,"idno":315,"textLang":316,"tmNumber":40,"letterHeights":318,"publications":320,"zotero":321,"keywords":322,"html":327,"bibl":328,"bulletinDateSort":127,"citedRangeSort":329,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004415","Epitaph for Krimma, child of Aunakos",{"_":12},[281,282,283,284,285],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},"plinth","#object.arch_element.plinth","https://www.eagle-network.eu/voc/objtyp/lod/1910.html",{"_":34,"ana":35,"type":36,"subtype":292,"ref":39},[38],{"layout":294},{"p":295,"rs":296,"damage":40},"Single line of greek letters approximately centred on the face of the plinth",{"_":45,"ana":46,"ref":47},{"lettering":298,"dimensions":299},"Small simple letters. Kappa has short equal arms, attached to the vertical; rho has small closed eye; mu has slanting first and final strokes, with the mid-strokes joining as a curve and only descending half-way; alpha is broad with straight bar, in one case slightly curved with the apex extending at the top; nu has shorter right vertical joining the diagonal above the line; omicron is small and mid-line.",[300,301],{"type":52,"l":53,"from":54,"to":54,"h":55,"unit":56,"atLeast":55,"atMost":55},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":303,"notBefore":152,"notAfter":204,"evidence":66},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[305,307],{"_":69,"type":70,"ref":71,"corresp":306,"region":72},"#findspot",{"_":74,"type":75,"ref":76,"offset":77,"region":72},[309],[80,81],[83,84],{"_":312,"role":313,"ref":314},"Necropoli di Abakainon","site","http://sicily.classics.ox.ac.uk/museum/186",{"type":92},{"_":94,"mainLang":95,"languages":317},[94],[319],{"atLeast":99,"atMost":99},[101,104],[106,109],[323,324,325,26,288,34,114,115,116,117,115,326,119,95],"isic004415","epitaph for krimma, child of aunakos",{"_":12},"necropoli di abakainon","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κριμμα Αυνακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":329,"ptr":330,"ref":331,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.5 and fig.6",{"target":124},{"_":126,"target":126},{"file":333,"uri":333,"title":334,"status":335,"editions":336,"editionAuthor":24,"type":342,"objectType":343,"material":344,"condition":40,"layoutDesc":346,"handNote":350,"date":356,"places":357,"geo":360,"country":72,"provenance":69,"provenanceGeo":362,"region":85,"settlement":74,"repository":363,"idno":364,"textLang":365,"tmNumber":40,"letterHeights":367,"publications":370,"zotero":371,"keywords":372,"html":376,"bibl":377,"bulletinDateSort":127,"citedRangeSort":378,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004416","Epitaph for Philon, son Aunakos",{"_":12},[337,338,339,340,341],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},{"_":34,"ana":35,"type":36,"subtype":345,"ref":39},[38],{"layout":347},{"p":348,"rs":349,"damage":40},"Single line of greek letters approximately centred on the face of the plinth, descending to right",{"_":45,"ana":46,"ref":47},{"lettering":351,"dimensions":352},"Crude and irregularly carved large letters. Phi has a small eye, seemingly formed of two small loops; omega is small, mid-line, open, with outward/downward sloping tails; nu is large and uneven; alpha is broad, but the form of the bar is illegible; kappa has short equal arms joined to the vertical; omicron appears small and midline.",[353,355],{"type":52,"l":53,"from":54,"to":54,"h":354,"unit":56,"atLeast":354,"atMost":354},"59",{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":303,"notBefore":152,"notAfter":204,"evidence":66},[358,359],{"_":69,"type":70,"ref":71,"corresp":306,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[361],[80,81],[83,84],{"_":312,"role":313,"ref":314},{"type":92},{"_":94,"mainLang":95,"languages":366},[94],[368],{"atLeast":369,"atMost":369},59,[101,104],[106,109],[373,374,375,26,288,34,114,115,116,117,115,326,119,95],"isic004416","epitaph for philon, son aunakos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Φίλων Αυ̣νακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":378,"ptr":379,"ref":380,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.6 and fig.7",{"target":124},{"_":126,"target":126},{"file":382,"uri":382,"title":383,"status":384,"editions":385,"editionAuthor":24,"type":391,"objectType":392,"material":393,"condition":40,"layoutDesc":395,"handNote":399,"date":405,"places":406,"geo":409,"country":72,"provenance":69,"provenanceGeo":411,"region":85,"settlement":74,"repository":412,"idno":413,"textLang":414,"tmNumber":40,"letterHeights":416,"publications":418,"zotero":419,"keywords":420,"html":424,"bibl":425,"bulletinDateSort":127,"citedRangeSort":426,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004417","Epitaph for [-?-], child of Gerontios",{"_":12},[386,387,388,389,390],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},{"_":34,"ana":35,"type":36,"subtype":394,"ref":39},[38],{"layout":396},{"p":397,"rs":398,"damage":40},"Remains of two lines of Greek letters, apparently centred on the face of the plinth; the second line sits directly above the lower moulding",{"_":45,"ana":46,"ref":47},{"lettering":400,"dimensions":401},"Simple, widely spaced letters. Omega is wide and open, with horizontal tails; rho has a large, closed eye; omicron is small and mid-line; nu is regular and with both verticals full length",[402,404],{"type":52,"l":403,"from":54,"to":60,"h":55,"unit":56,"atLeast":55,"atMost":55},"Line 1-2",{"type":58,"l":59,"from":54,"to":60,"unit":56},{"_":303,"notBefore":152,"notAfter":204,"evidence":66},[407,408],{"_":69,"type":70,"ref":71,"corresp":306,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[410],[80,81],[83,84],{"_":312,"role":313,"ref":314},{"type":92},{"_":94,"mainLang":95,"languages":415},[94],[417],{"atLeast":99,"atMost":99},[101,103,104],[106,108,109],[421,422,423,26,288,34,114,115,116,117,115,326,119,95],"isic004417","epitaph for [-?-], child of gerontios",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ω\u003Cspan dir=\"ltr\" class=\"gap\">.\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[Γ]ε̣ρόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":426,"ptr":427,"ref":428,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.7 and fig.8",{"target":124},{"_":126,"target":126},{"file":430,"uri":430,"title":383,"status":431,"editions":432,"editionAuthor":24,"type":438,"objectType":439,"material":440,"condition":40,"layoutDesc":442,"handNote":446,"date":451,"places":453,"geo":456,"country":72,"provenance":69,"provenanceGeo":458,"region":85,"settlement":74,"repository":459,"idno":460,"textLang":461,"tmNumber":40,"letterHeights":463,"publications":465,"zotero":466,"keywords":467,"html":470,"bibl":471,"bulletinDateSort":127,"citedRangeSort":472,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004418",{"_":12},[433,434,435,436,437],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},{"_":34,"ana":35,"type":36,"subtype":441,"ref":39},[38],{"layout":443},{"p":444,"rs":445,"damage":40},"Most of the lower line of Greek text is preserved, centred on the front face of the plinth; traces of a preceding line are visible.",{"_":45,"ana":46,"ref":47},{"lettering":447,"dimensions":448},"Neat, regular, simply cut, widely spaced letters. Epsilon has shorter middle bar; rho has closed, regular eye; omicron is small and mid-line; nu is broad with verticals of equal length.",[449,450],{"type":52,"l":403,"from":54,"to":60,"h":354,"unit":56,"atLeast":354,"atMost":354},{"type":58,"l":59,"from":54,"to":60,"unit":56},{"_":452,"notBefore":152,"notAfter":204,"evidence":66},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[454,455],{"_":69,"type":70,"ref":71,"corresp":306,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[457],[80,81],[83,84],{"_":312,"role":313,"ref":314},{"type":92},{"_":94,"mainLang":95,"languages":462},[94],[464],{"atLeast":369,"atMost":369},[101,103,104],[106,108,109],[468,422,469,26,288,34,114,115,116,117,115,326,119,95],"isic004418",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ς̣ \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>Γ̣ερόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":472,"ptr":473,"ref":474,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.8 and fig.9",{"target":124},{"_":126,"target":126},{"file":476,"uri":476,"title":477,"status":478,"editions":479,"editionAuthor":24,"type":485,"objectType":486,"material":487,"condition":40,"layoutDesc":489,"handNote":493,"date":498,"places":499,"geo":502,"country":72,"provenance":69,"provenanceGeo":504,"region":85,"settlement":74,"repository":505,"idno":506,"textLang":507,"tmNumber":40,"letterHeights":509,"publications":511,"zotero":512,"keywords":513,"html":517,"bibl":518,"bulletinDateSort":127,"citedRangeSort":519,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004419","Epitaph for Aristarchos",{"_":12},[480,481,482,483,484],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},{"_":34,"ana":35,"type":36,"subtype":488,"ref":39},[38],{"layout":490},{"p":491,"rs":492,"damage":40},"Remains of a single line of Greek letters, somewhat irregularly laid out and not following the horizontal",{"_":45,"ana":46,"ref":47},{"lettering":494,"dimensions":495},"Somewhat irregular plainly cut, widely spaced letters. Rho has closed and regular eye; sigma has horizontal upper and lower strokes, the intermediate strokes joined by a curve; alpha is broad with straight bar; omicron is small and mid-line.",[496,497],{"type":52,"l":53,"from":54,"to":54,"h":55,"unit":56,"atLeast":55,"atMost":55},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":452,"notBefore":152,"notAfter":204,"evidence":66},[500,501],{"_":69,"type":70,"ref":71,"corresp":306,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[503],[80,81],[83,84],{"_":312,"role":313,"ref":314},{"type":92},{"_":94,"mainLang":95,"languages":508},[94],[510],{"atLeast":99,"atMost":99},[104],[109],[514,515,516,26,288,34,114,115,116,117,115,326,119,95],"isic004419","epitaph for aristarchos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[Ἀ]ρισταρχου̣ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":519,"ptr":520,"ref":521,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.9 and fig.10",{"target":124},{"_":126,"target":126},{"file":523,"uri":523,"title":524,"status":525,"editions":526,"editionAuthor":24,"type":532,"objectType":533,"material":534,"condition":40,"layoutDesc":536,"handNote":540,"date":546,"places":547,"geo":550,"country":72,"provenance":69,"provenanceGeo":552,"region":85,"settlement":74,"repository":553,"idno":554,"textLang":555,"tmNumber":40,"letterHeights":557,"publications":560,"zotero":561,"keywords":562,"html":566,"bibl":567,"bulletinDateSort":127,"citedRangeSort":568,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004420","Epitaph for Aristokrates",{"_":12},[527,528,529,530,531],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},{"_":34,"ana":35,"type":36,"subtype":535,"ref":39},[38],{"layout":537},{"p":538,"rs":539,"damage":40},"Two lines of Greek letters rather irregularly laid out (not strictly observing the horizontal) and not strictly centred; the single word is split across two lines",{"_":45,"ana":46,"ref":47},{"lettering":541,"dimensions":542},"Somewhat irregular plainly cut, widely spaced letters, poorly laid out. Alpha is broad with straight bar; rho has closed eye, somewhat angular in the first instance, more curved in the second; sigma has horizontal top and bottom strokes, angular mid-strokes, very crudely done in the first instance; omicron is very small and mid-line; kappa has short equal bars joined to the vertical; epsilon has shorter middle bar.",[543,545],{"type":52,"l":403,"from":54,"to":60,"h":544,"unit":56,"atLeast":544,"atMost":544},"49",{"type":58,"l":59,"from":54,"to":60,"unit":56},{"_":452,"notBefore":152,"notAfter":204,"evidence":66},[548,549],{"_":69,"type":70,"ref":71,"corresp":306,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[551],[80,81],[83,84],{"_":312,"role":313,"ref":314},{"type":92},{"_":94,"mainLang":95,"languages":556},[94],[558],{"atLeast":559,"atMost":559},49,[104],[109],[563,564,565,26,288,34,114,115,116,117,115,326,119,95],"isic004420","epitaph for aristokrates",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">\u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοκρά \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>τεος \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":568,"ptr":569,"ref":570,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.10 and fig.11",{"target":124},{"_":126,"target":126},{"file":572,"uri":572,"title":573,"status":574,"editions":575,"editionAuthor":24,"type":581,"objectType":582,"material":583,"condition":40,"layoutDesc":585,"handNote":589,"date":595,"places":597,"geo":600,"country":72,"provenance":69,"provenanceGeo":602,"region":85,"settlement":74,"repository":603,"idno":604,"textLang":605,"tmNumber":40,"letterHeights":607,"publications":610,"zotero":611,"keywords":612,"html":616,"bibl":617,"bulletinDateSort":127,"citedRangeSort":618,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004421","Epitaph for Athanippos",{"_":12},[576,577,578,579,580],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},{"_":34,"ana":35,"type":36,"subtype":584,"ref":39},[38],{"layout":586},{"p":587,"rs":588,"damage":40},"A single line of Greek letters filling the width of the stele, approximately 20 cm from the top of the stele.",{"_":45,"ana":46,"ref":47},{"lettering":590,"dimensions":591},"Plainly cut and fairly regular squarish letters. Alpha has broken bar (and in the first instance, shows a slight apex at the top); theta is smaller than other letters and mid-line, with a single central dot; nu has equal length vertical strokes (the right slightly off vertical); pi is quadrate in form with nearly equal length vertical strokes and slightly overlapping horizontal; omicron is slightly smaller than other letters and mid-line.",[592,594],{"type":52,"l":53,"from":54,"to":54,"h":593,"unit":56,"atLeast":593,"atMost":593},"29",{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":596,"notBefore":152,"notAfter":204,"evidence":66},"The tomb has not been excavated, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[598,599],{"_":69,"type":70,"ref":71,"corresp":306,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[601],[80,81],[83,84],{"_":312,"role":313,"ref":314},{"type":92},{"_":94,"mainLang":95,"languages":606},[94],[608],{"atLeast":609,"atMost":609},29,[104],[109],[613,614,615,26,288,34,114,115,116,117,115,326,119,95],"isic004421","epitaph for athanippos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀθανίππου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":618,"ptr":619,"ref":620,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.11 and fig.12",{"target":124},{"_":126,"target":126},{"file":622,"uri":622,"title":623,"status":624,"editions":625,"editionAuthor":24,"type":631,"objectType":632,"material":633,"condition":40,"layoutDesc":635,"handNote":639,"date":644,"places":646,"geo":649,"country":72,"provenance":69,"provenanceGeo":651,"region":85,"settlement":74,"repository":652,"idno":653,"textLang":655,"tmNumber":40,"letterHeights":657,"publications":659,"zotero":660,"keywords":661,"html":665,"bibl":666,"bulletinDateSort":127,"citedRangeSort":667,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004422","Epitaph for Artemidoros (?)",{"_":12},[626,627,628,629,630],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":288,"ana":289,"ref":290},{"_":34,"ana":35,"type":36,"subtype":634,"ref":39},[38],{"layout":636},{"p":637,"rs":638,"damage":40},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":45,"ana":46,"ref":47},{"lettering":640,"dimensions":641},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[642,643],{"type":52,"l":53,"from":54,"to":54,"h":593,"unit":56,"atLeast":593,"atMost":593},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":645,"notBefore":152,"notAfter":204,"evidence":66},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[647,648],{"_":69,"type":70,"ref":71,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[650],[80,81],[83,84],{"_":87,"role":88,"ref":89},{"_":654,"type":92},"ME23440",{"_":94,"mainLang":95,"languages":656},[94],[658],{"atLeast":609,"atMost":609},[103,104],[108,109],[662,663,664,26,288,34,114,115,116,117,115,118,119,95],"isic004422","epitaph for artemidoros (?)",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":667,"ptr":668,"ref":669,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.12 and fig.13",{"target":124},{"_":126,"target":126},false],"uses":{"params":["slug"]}}]}
