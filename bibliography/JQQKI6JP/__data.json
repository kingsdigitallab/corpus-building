broken bar; omicron is small and mid-line; sigma has horizontal top and bottom strokes.",[208,209],{"type":52,"l":53,"from":54,"to":54,"h":55,"unit":56,"atLeast":55,"atMost":55},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":211,"notBefore":212,"notAfter":213,"evidence":66},"The goods recovered from the tomb suggest a date in the 3rd century BCE",-300,-201,[215,216],{"_":69,"type":70,"ref":71,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[218],[80,81],[83,84],{"_":87,"role":88,"ref":89},{"_":222,"type":92},"ME23436",{"_":94,"mainLang":95,"languages":224},[94],{"n":98,"url":226,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004413_tiled.tif",[228],{"atLeast":106,"atMost":106},[109,110,111],[114,115,116],[232,233,234,26,30,34,121,122,123,124,122,125,126,95],"isic004413","epitaph for kallo",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Καλλοῦς \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":237,"ptr":238,"ref":239,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.3 and fig.4",{"target":131},{"_":133,"target":133},{"file":241,"uri":241,"title":242,"status":243,"editions":244,"editionAuthor":24,"type":250,"objectType":251,"material":252,"condition":40,"layoutDesc":254,"handNote":257,"date":262,"places":263,"geo":266,"country":72,"provenance":69,"provenanceGeo":268,"region":85,"settlement":74,"repository":269,"idno":270,"textLang":272,"tmNumber":40,"facsimile":274,"letterHeights":276,"publications":278,"zotero":279,"keywords":280,"html":284,"bibl":285,"bulletinDateSort":134,"citedRangeSort":286,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004414","Epitaph for Eupolemos",{"_":12},[245,246,247,248,249],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":30,"ana":31,"ref":32},{"_":34,"ana":35,"type":36,"subtype":253,"ref":39},[38],{"layout":255},{"p":43,"rs":256,"damage":40},{"_":45,"ana":46,"ref":47},{"lettering":258,"dimensions":259},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[260,261],{"type":52,"l":53,"from":54,"to":54,"h":55,"unit":56,"atLeast":55,"atMost":55},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":211,"notBefore":212,"notAfter":213,"evidence":66},[264,265],{"_":69,"type":70,"ref":71,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[267],[80,81],[83,84],{"_":87,"role":88,"ref":89},{"_":271,"type":92},"ME23438",{"_":94,"mainLang":95,"languages":273},[94],{"n":98,"url":275,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004414_tiled.tif",[277],{"atLeast":106,"atMost":106},[108,109,110,111],[113,114,115,116],[281,282,283,26,30,34,121,122,123,124,122,125,126,95],"isic004414","epitaph for eupolemos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":286,"ptr":287,"ref":288,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.4 and fig.5",{"target":131},{"_":133,"target":133},{"file":290,"uri":290,"title":291,"status":292,"editions":293,"editionAuthor":24,"type":299,"objectType":300,"material":304,"condition":40,"layoutDesc":306,"handNote":310,"date":315,"places":317,"geo":321,"country":72,"provenance":69,"provenanceGeo":323,"region":85,"settlement":74,"repository":324,"idno":328,"textLang":329,"tmNumber":40,"facsimile":331,"letterHeights":333,"publications":335,"zotero":336,"keywords":337,"html":342,"bibl":343,"bulletinDateSort":134,"citedRangeSort":344,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004415","Epitaph for Krimma, child of Aunakos",{"_":12},[294,295,296,297,298],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},"plinth","#object.arch_element.plinth","https://www.eagle-network.eu/voc/objtyp/lod/1910.html",{"_":34,"ana":35,"type":36,"subtype":305,"ref":39},[38],{"layout":307},{"p":308,"rs":309,"damage":40},"Single line of greek letters approximately centred on the face of the plinth",{"_":45,"ana":46,"ref":47},{"lettering":311,"dimensions":312},"Small simple letters. Kappa has short equal arms, attached to the vertical; rho has small closed eye; mu has slanting first and final strokes, with the mid-strokes joining as a curve and only descending half-way; alpha is broad with straight bar, in one case slightly curved with the apex extending at the top; nu has shorter right vertical joining the diagonal above the line; omicron is small and mid-line.",[313,314],{"type":52,"l":53,"from":54,"to":54,"h":55,"unit":56,"atLeast":55,"atMost":55},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":316,"notBefore":159,"notAfter":213,"evidence":66},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[318,320],{"_":69,"type":70,"ref":71,"corresp":319,"region":72},"#findspot",{"_":74,"type":75,"ref":76,"offset":77,"region":72},[322],[80,81],[83,84],{"_":325,"role":326,"ref":327},"Necropoli di Abakainon","site","http://sicily.classics.ox.ac.uk/museum/186",{"type":92},{"_":94,"mainLang":95,"languages":330},[94],{"n":98,"url":332,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004415_tiled.tif",[334],{"atLeast":106,"atMost":106},[108,111],[113,116],[338,339,340,26,301,34,121,122,123,124,122,341,126,95],"isic004415","epitaph for krimma, child of aunakos",{"_":12},"necropoli di abakainon","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κριμμα Αυνακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":344,"ptr":345,"ref":346,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.5 and fig.6",{"target":131},{"_":133,"target":133},{"file":348,"uri":348,"title":349,"status":350,"editions":351,"editionAuthor":24,"type":357,"objectType":358,"material":359,"condition":40,"layoutDesc":361,"handNote":365,"date":371,"places":372,"geo":375,"country":72,"provenance":69,"provenanceGeo":377,"region":85,"settlement":74,"repository":378,"idno":379,"textLang":380,"tmNumber":40,"facsimile":382,"letterHeights":384,"publications":387,"zotero":388,"keywords":389,"html":393,"bibl":394,"bulletinDateSort":134,"citedRangeSort":395,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004416","Epitaph for Philon, son Aunakos",{"_":12},[352,353,354,355,356],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},{"_":34,"ana":35,"type":36,"subtype":360,"ref":39},[38],{"layout":362},{"p":363,"rs":364,"damage":40},"Single line of greek letters approximately centred on the face of the plinth, descending to right",{"_":45,"ana":46,"ref":47},{"lettering":366,"dimensions":367},"Crude and irregularly carved large letters. Phi has a small eye, seemingly formed of two small loops; omega is small, mid-line, open, with outward/downward sloping tails; nu is large and uneven; alpha is broad, but the form of the bar is illegible; kappa has short equal arms joined to the vertical; omicron appears small and midline.",[368,370],{"type":52,"l":53,"from":54,"to":54,"h":369,"unit":56,"atLeast":369,"atMost":369},"59",{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":316,"notBefore":159,"notAfter":213,"evidence":66},[373,374],{"_":69,"type":70,"ref":71,"corresp":319,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[376],[80,81],[83,84],{"_":325,"role":326,"ref":327},{"type":92},{"_":94,"mainLang":95,"languages":381},[94],{"n":98,"url":383,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004416_tiled.tif",[385],{"atLeast":386,"atMost":386},59,[108,111],[113,116],[390,391,392,26,301,34,121,122,123,124,122,341,126,95],"isic004416","epitaph for philon, son aunakos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Φίλων Αυ̣νακου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":395,"ptr":396,"ref":397,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.6 and fig.7",{"target":131},{"_":133,"target":133},{"file":399,"uri":399,"title":400,"status":401,"editions":402,"editionAuthor":24,"type":408,"objectType":409,"material":410,"condition":40,"layoutDesc":412,"handNote":416,"date":422,"places":423,"geo":426,"country":72,"provenance":69,"provenanceGeo":428,"region":85,"settlement":74,"repository":429,"idno":430,"textLang":431,"tmNumber":40,"facsimile":433,"letterHeights":435,"publications":437,"zotero":438,"keywords":439,"html":443,"bibl":444,"bulletinDateSort":134,"citedRangeSort":445,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004417","Epitaph for [-?-], child of Gerontios",{"_":12},[403,404,405,406,407],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},{"_":34,"ana":35,"type":36,"subtype":411,"ref":39},[38],{"layout":413},{"p":414,"rs":415,"damage":40},"Remains of two lines of Greek letters, apparently centred on the face of the plinth; the second line sits directly above the lower moulding",{"_":45,"ana":46,"ref":47},{"lettering":417,"dimensions":418},"Simple, widely spaced letters. Omega is wide and open, with horizontal tails; rho has a large, closed eye; omicron is small and mid-line; nu is regular and with both verticals full length",[419,421],{"type":52,"l":420,"from":54,"to":60,"h":55,"unit":56,"atLeast":55,"atMost":55},"Line 1-2",{"type":58,"l":59,"from":54,"to":60,"unit":56},{"_":316,"notBefore":159,"notAfter":213,"evidence":66},[424,425],{"_":69,"type":70,"ref":71,"corresp":319,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[427],[80,81],[83,84],{"_":325,"role":326,"ref":327},{"type":92},{"_":94,"mainLang":95,"languages":432},[94],{"n":98,"url":434,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004417_tiled.tif",[436],{"atLeast":106,"atMost":106},[108,110,111],[113,115,116],[440,441,442,26,301,34,121,122,123,124,122,341,126,95],"isic004417","epitaph for [-?-], child of gerontios",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ω\u003Cspan dir=\"ltr\" class=\"gap\">.\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>[Γ]ε̣ρόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":445,"ptr":446,"ref":447,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.7 and fig.8",{"target":131},{"_":133,"target":133},{"file":449,"uri":449,"title":400,"status":450,"editions":451,"editionAuthor":24,"type":457,"objectType":458,"material":459,"condition":40,"layoutDesc":461,"handNote":465,"date":470,"places":472,"geo":475,"country":72,"provenance":69,"provenanceGeo":477,"region":85,"settlement":74,"repository":478,"idno":479,"textLang":480,"tmNumber":40,"facsimile":482,"letterHeights":484,"publications":486,"zotero":487,"keywords":488,"html":491,"bibl":492,"bulletinDateSort":134,"citedRangeSort":493,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004418",{"_":12},[452,453,454,455,456],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},{"_":34,"ana":35,"type":36,"subtype":460,"ref":39},[38],{"layout":462},{"p":463,"rs":464,"damage":40},"Most of the lower line of Greek text is preserved, centred on the front face of the plinth; traces of a preceding line are visible.",{"_":45,"ana":46,"ref":47},{"lettering":466,"dimensions":467},"Neat, regular, simply cut, widely spaced letters. Epsilon has shorter middle bar; rho has closed, regular eye; omicron is small and mid-line; nu is broad with verticals of equal length.",[468,469],{"type":52,"l":420,"from":54,"to":60,"h":369,"unit":56,"atLeast":369,"atMost":369},{"type":58,"l":59,"from":54,"to":60,"unit":56},{"_":471,"notBefore":159,"notAfter":213,"evidence":66},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[473,474],{"_":69,"type":70,"ref":71,"corresp":319,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[476],[80,81],[83,84],{"_":325,"role":326,"ref":327},{"type":92},{"_":94,"mainLang":95,"languages":481},[94],{"n":98,"url":483,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004418_tiled.tif",[485],{"atLeast":386,"atMost":386},[108,110,111],[113,115,116],[489,441,490,26,301,34,121,122,123,124,122,341,126,95],"isic004418",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ς̣ \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>Γ̣ερόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":493,"ptr":494,"ref":495,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"107 no.8 and fig.9",{"target":131},{"_":133,"target":133},{"file":497,"uri":497,"title":498,"status":499,"editions":500,"editionAuthor":24,"type":506,"objectType":507,"material":508,"condition":40,"layoutDesc":510,"handNote":514,"date":519,"places":520,"geo":523,"country":72,"provenance":69,"provenanceGeo":525,"region":85,"settlement":74,"repository":526,"idno":527,"textLang":528,"tmNumber":40,"facsimile":530,"letterHeights":532,"publications":534,"zotero":535,"keywords":536,"html":540,"bibl":541,"bulletinDateSort":134,"citedRangeSort":542,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004419","Epitaph for Aristarchos",{"_":12},[501,502,503,504,505],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},{"_":34,"ana":35,"type":36,"subtype":509,"ref":39},[38],{"layout":511},{"p":512,"rs":513,"damage":40},"Remains of a single line of Greek letters, somewhat irregularly laid out and not following the horizontal",{"_":45,"ana":46,"ref":47},{"lettering":515,"dimensions":516},"Somewhat irregular plainly cut, widely spaced letters. Rho has closed and regular eye; sigma has horizontal upper and lower strokes, the intermediate strokes joined by a curve; alpha is broad with straight bar; omicron is small and mid-line.",[517,518],{"type":52,"l":53,"from":54,"to":54,"h":55,"unit":56,"atLeast":55,"atMost":55},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":471,"notBefore":159,"notAfter":213,"evidence":66},[521,522],{"_":69,"type":70,"ref":71,"corresp":319,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[524],[80,81],[83,84],{"_":325,"role":326,"ref":327},{"type":92},{"_":94,"mainLang":95,"languages":529},[94],{"n":98,"url":531,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004419_tiled.tif",[533],{"atLeast":106,"atMost":106},[111],[116],[537,538,539,26,301,34,121,122,123,124,122,341,126,95],"isic004419","epitaph for aristarchos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[Ἀ]ρισταρχου̣ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":542,"ptr":543,"ref":544,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.9 and fig.10",{"target":131},{"_":133,"target":133},{"file":546,"uri":546,"title":547,"status":548,"editions":549,"editionAuthor":24,"type":555,"objectType":556,"material":557,"condition":40,"layoutDesc":559,"handNote":563,"date":569,"places":570,"geo":573,"country":72,"provenance":69,"provenanceGeo":575,"region":85,"settlement":74,"repository":576,"idno":577,"textLang":578,"tmNumber":40,"facsimile":580,"letterHeights":582,"publications":585,"zotero":586,"keywords":587,"html":591,"bibl":592,"bulletinDateSort":134,"citedRangeSort":593,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004420","Epitaph for Aristokrates",{"_":12},[550,551,552,553,554],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},{"_":34,"ana":35,"type":36,"subtype":558,"ref":39},[38],{"layout":560},{"p":561,"rs":562,"damage":40},"Two lines of Greek letters rather irregularly laid out (not strictly observing the horizontal) and not strictly centred; the single word is split across two lines",{"_":45,"ana":46,"ref":47},{"lettering":564,"dimensions":565},"Somewhat irregular plainly cut, widely spaced letters, poorly laid out. Alpha is broad with straight bar; rho has closed eye, somewhat angular in the first instance, more curved in the second; sigma has horizontal top and bottom strokes, angular mid-strokes, very crudely done in the first instance; omicron is very small and mid-line; kappa has short equal bars joined to the vertical; epsilon has shorter middle bar.",[566,568],{"type":52,"l":420,"from":54,"to":60,"h":567,"unit":56,"atLeast":567,"atMost":567},"49",{"type":58,"l":59,"from":54,"to":60,"unit":56},{"_":471,"notBefore":159,"notAfter":213,"evidence":66},[571,572],{"_":69,"type":70,"ref":71,"corresp":319,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[574],[80,81],[83,84],{"_":325,"role":326,"ref":327},{"type":92},{"_":94,"mainLang":95,"languages":579},[94],{"n":98,"url":581,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004420_tiled.tif",[583],{"atLeast":584,"atMost":584},49,[111],[116],[588,589,590,26,301,34,121,122,123,124,122,341,126,95],"isic004420","epitaph for aristokrates",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">\u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοκρά \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>τεος \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":593,"ptr":594,"ref":595,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.10 and fig.11",{"target":131},{"_":133,"target":133},{"file":597,"uri":597,"title":598,"status":599,"editions":600,"editionAuthor":24,"type":606,"objectType":607,"material":608,"condition":40,"layoutDesc":610,"handNote":614,"date":620,"places":622,"geo":625,"country":72,"provenance":69,"provenanceGeo":627,"region":85,"settlement":74,"repository":628,"idno":629,"textLang":630,"tmNumber":40,"facsimile":632,"letterHeights":634,"publications":637,"zotero":638,"keywords":639,"html":643,"bibl":644,"bulletinDateSort":134,"citedRangeSort":645,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004421","Epitaph for Athanippos",{"_":12},[601,602,603,604,605],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},{"_":34,"ana":35,"type":36,"subtype":609,"ref":39},[38],{"layout":611},{"p":612,"rs":613,"damage":40},"A single line of Greek letters filling the width of the stele, approximately 20 cm from the top of the stele.",{"_":45,"ana":46,"ref":47},{"lettering":615,"dimensions":616},"Plainly cut and fairly regular squarish letters. Alpha has broken bar (and in the first instance, shows a slight apex at the top); theta is smaller than other letters and mid-line, with a single central dot; nu has equal length vertical strokes (the right slightly off vertical); pi is quadrate in form with nearly equal length vertical strokes and slightly overlapping horizontal; omicron is slightly smaller than other letters and mid-line.",[617,619],{"type":52,"l":53,"from":54,"to":54,"h":618,"unit":56,"atLeast":618,"atMost":618},"29",{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":621,"notBefore":159,"notAfter":213,"evidence":66},"The tomb has not been excavated, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[623,624],{"_":69,"type":70,"ref":71,"corresp":319,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[626],[80,81],[83,84],{"_":325,"role":326,"ref":327},{"type":92},{"_":94,"mainLang":95,"languages":631},[94],{"n":98,"url":633,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004421_tiled.tif",[635],{"atLeast":636,"atMost":636},29,[111],[116],[640,641,642,26,301,34,121,122,123,124,122,341,126,95],"isic004421","epitaph for athanippos",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀθανίππου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":645,"ptr":646,"ref":647,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.11 and fig.12",{"target":131},{"_":133,"target":133},{"file":649,"uri":649,"title":650,"status":651,"editions":652,"editionAuthor":24,"type":658,"objectType":659,"material":660,"condition":40,"layoutDesc":662,"handNote":666,"date":671,"places":673,"geo":676,"country":72,"provenance":69,"provenanceGeo":678,"region":85,"settlement":74,"repository":679,"idno":680,"textLang":682,"tmNumber":40,"facsimile":684,"letterHeights":686,"publications":688,"zotero":689,"keywords":690,"html":694,"bibl":695,"bulletinDateSort":134,"citedRangeSort":696,"languageSort":94,"materialSort":34,"typeSort":26},"ISic004422","Epitaph for Artemidoros (?)",{"_":12},[653,654,655,656,657],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":301,"ana":302,"ref":303},{"_":34,"ana":35,"type":36,"subtype":661,"ref":39},[38],{"layout":663},{"p":664,"rs":665,"damage":40},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":45,"ana":46,"ref":47},{"lettering":667,"dimensions":668},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[669,670],{"type":52,"l":53,"from":54,"to":54,"h":618,"unit":56,"atLeast":618,"atMost":618},{"type":58,"l":59,"from":54,"to":60,"h":61,"unit":56},{"_":672,"notBefore":159,"notAfter":213,"evidence":66},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[674,675],{"_":69,"type":70,"ref":71,"region":72},{"_":74,"type":75,"ref":76,"offset":77,"region":72},[677],[80,81],[83,84],{"_":87,"role":88,"ref":89},{"_":681,"type":92},"ME23440",{"_":94,"mainLang":95,"languages":683},[94],{"n":98,"url":685,"height":100,"width":101,"desc":102,"surfaceType":103},"ISic004422_tiled.tif",[687],{"atLeast":636,"atMost":636},[110,111],[115,116],[691,692,693,26,301,34,121,122,123,124,122,125,126,95],"isic004422","epitaph for artemidoros (?)",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":696,"ptr":697,"ref":698,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 no.12 and fig.13",{"target":131},{"_":133,"target":133},false],"uses":{"params":["slug"]}}]}
