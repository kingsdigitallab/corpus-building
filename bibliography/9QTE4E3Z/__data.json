tero":649,"keywords":650,"html":654,"bibl":655,"bulletinDateSort":146,"citedRangeSort":656,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004413","Epitaph for Kallo",{"_":213},[614,615,616,617,618],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":451},{"_":40,"ana":41,"type":42,"subtype":622,"ref":45},[44],{"layout":624},{"p":456,"rs":625,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":627,"dimensions":628},"Broad simple letters: kappa has short, approximately equal arms; alpha is broad with broken bar; omicron is small and mid-line; sigma has horizontal top and bottom strokes.",[629,630],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":632,"notBefore":72,"notAfter":530,"evidence":467},"The goods recovered from the tomb suggest a date in the 3rd century BCE",[634,635],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[637],[87,88],[90,91],{"_":475,"role":96,"ref":476},{"_":641,"type":100},"ME23436",{"_":102,"mainLang":103,"languages":643},[102],{"n":106,"url":645,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004413_tiled.tif",[647],{"atLeast":114,"atMost":114},[486,121,487],[489,127,490],[651,652,653,32,36,40,132,133,134,135,133,495,138,103],"isic004413","epitaph for kallo",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Καλλοῦς \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":656,"ptr":657,"ref":658,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.118",{"target":143},{"_":145,"target":145},{"file":660,"uri":660,"title":661,"status":662,"editions":663,"editionAuthor":30,"type":669,"objectType":670,"material":671,"condition":46,"layoutDesc":673,"handNote":676,"date":681,"places":682,"geo":685,"country":79,"provenance":76,"provenanceGeo":687,"region":92,"settlement":81,"repository":688,"idno":689,"textLang":691,"tmNumber":46,"facsimile":693,"letterHeights":695,"publications":697,"zotero":698,"keywords":699,"html":703,"bibl":704,"bulletinDateSort":146,"citedRangeSort":705,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004414","Epitaph for Eupolemos",{"_":213},[664,665,666,667,668],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":451},{"_":40,"ana":41,"type":42,"subtype":672,"ref":45},[44],{"layout":674},{"p":456,"rs":675,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":677,"dimensions":678},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[679,680],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":632,"notBefore":72,"notAfter":530,"evidence":467},[683,684],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[686],[87,88],[90,91],{"_":475,"role":96,"ref":476},{"_":690,"type":100},"ME23438",{"_":102,"mainLang":103,"languages":692},[102],{"n":106,"url":694,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004414_tiled.tif",[696],{"atLeast":114,"atMost":114},[424,486,121,487],[428,489,127,490],[700,701,702,32,36,40,132,133,134,135,133,495,138,103],"isic004414","epitaph for eupolemos",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":705,"ptr":706,"ref":707,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.119",{"target":143},{"_":145,"target":145},{"file":709,"uri":709,"title":710,"status":711,"editions":712,"editionAuthor":30,"type":718,"objectType":719,"material":720,"condition":46,"layoutDesc":722,"handNote":726,"date":732,"places":734,"geo":737,"country":79,"provenance":76,"provenanceGeo":739,"region":92,"settlement":81,"repository":740,"idno":741,"textLang":743,"tmNumber":46,"facsimile":745,"letterHeights":747,"publications":750,"zotero":751,"keywords":752,"html":756,"bibl":757,"bulletinDateSort":146,"citedRangeSort":758,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004422","Epitaph for Artemidoros (?)",{"_":213},[713,714,715,716,717],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":513,"ana":514,"ref":515},{"_":40,"ana":41,"type":42,"subtype":721,"ref":45},[44],{"layout":723},{"p":724,"rs":725,"damage":46},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":51,"ana":52,"ref":53},{"lettering":727,"dimensions":728},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[729,731],{"type":58,"l":59,"from":60,"to":60,"h":730,"unit":62,"atLeast":730,"atMost":730},"29",{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":733,"notBefore":529,"notAfter":530,"evidence":467},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[735,736],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[738],[87,88],[90,91],{"_":475,"role":96,"ref":476},{"_":742,"type":100},"ME23440",{"_":102,"mainLang":103,"languages":744},[102],{"n":106,"url":746,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004422_tiled.tif",[748],{"atLeast":749,"atMost":749},29,[121,487],[127,490],[753,754,755,32,513,40,132,133,134,135,133,495,138,103],"isic004422","epitaph for artemidoros (?)",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":758,"ptr":759,"ref":760,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.120",{"target":143},{"_":145,"target":145},{"file":762,"uri":762,"title":763,"status":764,"editions":765,"editionAuthor":30,"type":771,"objectType":772,"material":773,"condition":46,"layoutDesc":775,"handNote":778,"date":783,"places":786,"geo":789,"country":79,"provenance":76,"provenanceGeo":791,"region":92,"settlement":81,"repository":792,"idno":793,"textLang":795,"tmNumber":46,"facsimile":797,"letterHeights":799,"publications":801,"zotero":802,"keywords":803,"html":807,"bibl":808,"bulletinDateSort":146,"citedRangeSort":809,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004412","Epitaph for Aristoboula",{"_":213},[766,767,768,769,770],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":451},{"_":40,"ana":41,"type":42,"subtype":774,"ref":45},[44],{"layout":776},{"p":456,"rs":777,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":779,"dimensions":780},"Slightly irregular letters, becoming slightly more compressed to the right hand end: Alpha broad with broken bar; rho has small closed eye; sigma is four equal bars, angled apart; omicron is small and mid-line; beta has equal closed eyes, with slight gap between them; upsilon asymmetrical.",[781,782],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":784,"notBefore":529,"notAfter":785,"evidence":246},"Letter forms suggest a date in the 4th or earlier 3rd century BCE",-251,[787,788],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[790],[87,88],[90,91],{"_":475,"role":96,"ref":476},{"_":794,"type":100},"ME23439",{"_":102,"mainLang":103,"languages":796},[102],{"n":106,"url":798,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004412_tiled.tif",[800],{"atLeast":114,"atMost":114},[486,121,487],[489,127,490],[804,805,806,32,36,40,132,133,134,135,133,495,138,103],"isic004412","epitaph for aristoboula",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοβούλας \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":809,"ptr":810,"ref":811,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.121",{"target":143},{"_":145,"target":145},false],"uses":{"params":["slug"]}}]}
