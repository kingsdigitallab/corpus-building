"to":68,"h":69,"unit":62},{"_":617,"notBefore":72,"notAfter":519,"evidence":458},"The goods recovered from the tomb suggest a date in the 3rd century BCE",[619,620],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[622],[87,88],[90,91],{"_":466,"role":96,"ref":467},{"_":626,"type":100},"ME23436",{"_":102,"mainLang":103,"languages":628},[102],[630],{"atLeast":107,"atMost":107},[475,114,476],[478,120,479],[634,635,636,32,36,40,125,126,127,128,126,484,131,103],"isic004413","epitaph for kallo",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Καλλοῦς \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":639,"ptr":640,"ref":641,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.118",{"target":136},{"_":138,"target":138},{"file":643,"uri":643,"title":644,"status":645,"editions":646,"editionAuthor":30,"type":652,"objectType":653,"material":654,"condition":46,"layoutDesc":656,"handNote":659,"date":664,"places":665,"geo":668,"country":79,"provenance":76,"provenanceGeo":670,"region":92,"settlement":81,"repository":671,"idno":672,"textLang":674,"tmNumber":46,"letterHeights":676,"publications":678,"zotero":679,"keywords":680,"html":684,"bibl":685,"bulletinDateSort":139,"citedRangeSort":686,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004414","Epitaph for Eupolemos",{"_":209},[647,648,649,650,651],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":442},{"_":40,"ana":41,"type":42,"subtype":655,"ref":45},[44],{"layout":657},{"p":447,"rs":658,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":660,"dimensions":661},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[662,663],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":617,"notBefore":72,"notAfter":519,"evidence":458},[666,667],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[669],[87,88],[90,91],{"_":466,"role":96,"ref":467},{"_":673,"type":100},"ME23438",{"_":102,"mainLang":103,"languages":675},[102],[677],{"atLeast":107,"atMost":107},[415,475,114,476],[419,478,120,479],[681,682,683,32,36,40,125,126,127,128,126,484,131,103],"isic004414","epitaph for eupolemos",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":686,"ptr":687,"ref":688,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.119",{"target":136},{"_":138,"target":138},{"file":690,"uri":690,"title":691,"status":692,"editions":693,"editionAuthor":30,"type":699,"objectType":700,"material":701,"condition":46,"layoutDesc":703,"handNote":707,"date":713,"places":715,"geo":718,"country":79,"provenance":76,"provenanceGeo":720,"region":92,"settlement":81,"repository":721,"idno":722,"textLang":724,"tmNumber":46,"letterHeights":726,"publications":729,"zotero":730,"keywords":731,"html":735,"bibl":736,"bulletinDateSort":139,"citedRangeSort":737,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004422","Epitaph for Artemidoros (?)",{"_":209},[694,695,696,697,698],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":502,"ana":503,"ref":504},{"_":40,"ana":41,"type":42,"subtype":702,"ref":45},[44],{"layout":704},{"p":705,"rs":706,"damage":46},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":51,"ana":52,"ref":53},{"lettering":708,"dimensions":709},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[710,712],{"type":58,"l":59,"from":60,"to":60,"h":711,"unit":62,"atLeast":711,"atMost":711},"29",{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":714,"notBefore":518,"notAfter":519,"evidence":458},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[716,717],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[719],[87,88],[90,91],{"_":466,"role":96,"ref":467},{"_":723,"type":100},"ME23440",{"_":102,"mainLang":103,"languages":725},[102],[727],{"atLeast":728,"atMost":728},29,[114,476],[120,479],[732,733,734,32,502,40,125,126,127,128,126,484,131,103],"isic004422","epitaph for artemidoros (?)",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":737,"ptr":738,"ref":739,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.120",{"target":136},{"_":138,"target":138},{"file":741,"uri":741,"title":742,"status":743,"editions":744,"editionAuthor":30,"type":750,"objectType":751,"material":752,"condition":46,"layoutDesc":754,"handNote":757,"date":762,"places":765,"geo":768,"country":79,"provenance":76,"provenanceGeo":770,"region":92,"settlement":81,"repository":771,"idno":772,"textLang":774,"tmNumber":46,"letterHeights":776,"publications":778,"zotero":779,"keywords":780,"html":784,"bibl":785,"bulletinDateSort":139,"citedRangeSort":786,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004412","Epitaph for Aristoboula",{"_":209},[745,746,747,748,749],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":442},{"_":40,"ana":41,"type":42,"subtype":753,"ref":45},[44],{"layout":755},{"p":447,"rs":756,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":758,"dimensions":759},"Slightly irregular letters, becoming slightly more compressed to the right hand end: Alpha broad with broken bar; rho has small closed eye; sigma is four equal bars, angled apart; omicron is small and mid-line; beta has equal closed eyes, with slight gap between them; upsilon asymmetrical.",[760,761],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":763,"notBefore":518,"notAfter":764,"evidence":242},"Letter forms suggest a date in the 4th or earlier 3rd century BCE",-251,[766,767],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[769],[87,88],[90,91],{"_":466,"role":96,"ref":467},{"_":773,"type":100},"ME23439",{"_":102,"mainLang":103,"languages":775},[102],[777],{"atLeast":107,"atMost":107},[475,114,476],[478,120,479],[781,782,783,32,36,40,125,126,127,128,126,484,131,103],"isic004412","epitaph for aristoboula",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοβούλας \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":786,"ptr":787,"ref":788,"inscriptionDate":4,"tit