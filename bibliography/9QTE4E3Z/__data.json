h the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana",[264],{"atLeast":114,"atMost":265},75,[117,118,119,120,121],[123,124,125,126,127],[269,270,271,32,36,40,132,133,134,135,136,137,138,103],"isic001206","epitaph for diokles",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Δίοκλε\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Δίοκλε\">\u003Cspan data-text=\"Δίοκλε\" data-n=\"5\" data-lemma=\"Διοκλῆς\">Δίοκλε\u003C/span>\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"χαῖρε\" data-n=\"10\" data-lemma=\"χαίρω\">χαῖρε\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":274,"ptr":275,"ref":276,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"108 and fig.112",{"target":143},{"_":145,"target":145},{"file":278,"uri":278,"title":279,"status":280,"editions":281,"editionAuthor":30,"type":293,"objectType":294,"material":295,"condition":46,"layoutDesc":300,"handNote":304,"date":313,"places":316,"geo":319,"country":79,"provenance":76,"provenanceGeo":321,"region":92,"settlement":93,"repository":322,"idno":323,"textLang":325,"tmNumber":283,"facsimile":327,"letterHeights":332,"publications":335,"zotero":338,"keywords":341,"html":345,"bibl":346,"bulletinDateSort":146,"citedRangeSort":347,"languageSort":102,"materialSort":40,"typeSort":32},"ISic001207","Epitaph for Nemeris, a goldsmith",{"_":12},[282,284,286,287,289,291],{"_":283,"type":16},"492811",{"_":285,"type":19},"147872",{"type":21},{"_":288,"type":24},"39101571",{"_":290,"type":27},"140691",{"_":292,"type":27},"175729",{"_":32,"ana":33,"ref":34