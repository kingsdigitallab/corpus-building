b has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE, offering a terminus ante quem",[574,575],{"_":76,"type":77,"ref":78,"corresp":523,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[577],[87,88],[90,91],{"_":529,"role":530,"ref":531},{"type":100},{"_":102,"mainLang":103,"languages":582},[102],[584],{"atLeast":585,"atMost":585},59,[416,114,477],[420,120,480],[589,541,590,32,503,40,125,126,127,128,126,543,131,103],"isic004418",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ς̣ \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>Γ̣ερόντιου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":488,"ptr":593,"ref":594,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":136},{"_":138,"target":138},{"file":596,"uri":596,"title":597,"status":598,"editions":599,"editionAuthor":30,"type":605,"objectType":606,"material":607,"condition":46,"layoutDesc":609,"handNote":612,"date":617,"places":619,"geo":622,"country":79,"provenance":76,"provenanceGeo":624,"region":92,"settlement":81,"repository":625,"idno":626,"textLang":628,"tmNumber":46,"letterHeights":630,"publications":632,"zotero":633,"keywords":634,"html":638,"bibl":639,"bulletinDateSort":139,"citedRangeSort":640,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004413","Epitaph for Kallo",{"_":209},[600,601,602,603,604],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":443},{"_":40,"ana":41,"type":42,"subtype":608,"ref":45},[44],{"layout":610},{"p":448,"rs":611,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":613,"dimensions":614},"Broad simple letters: kappa has short, approximately equal arms; alpha is broad with broken bar; omicron is small and mid-line; sigma has horizontal top and bottom strokes.",[615,616],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":618,"notBefore":72,"notAfter":520,"evidence":459},"The goods recovered from the tomb suggest a date in the 3rd century BCE",[620,621],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[623],[87,88],[90,91],{"_":467,"role":96,"ref":468},{"_":627,"type":100},"ME23436",{"_":102,"mainLang":103,"languages":629},[102],[631],{"atLeast":107,"atMost":107},[476,114,477],[479,120,480],[635,636,637,32,36,40,125,126,127,128,126,485,131,103],"isic004413","epitaph for kallo",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Καλλοῦς \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":640,"ptr":641,"ref":642,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.118",{"target":136},{"_":138,"target":138},{"file":644,"uri":644,"title":645,"status":646,"editions":647,"editionAuthor":30,"type":653,"objectType":654,"material":655,"condition":46,"layoutDesc":657,"handNote":660,"date":665,"places":666,"geo":669,"country":79,"provenance":76,"provenanceGeo":671,"region":92,"settlement":81,"repository":672,"idno":673,"textLang":675,"tmNumber":46,"letterHeights":677,"publications":679,"zotero":680,"keywords":681,"html":685,"bibl":686,"bulletinDateSort":139,"citedRangeSort":687,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004414","Epitaph for Eupolemos",{"_":209},[648,649,650,651,652],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":443},{"_":40,"ana":41,"type":42,"subtype":656,"ref":45},[44],{"layout":658},{"p":448,"rs":659,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":661,"dimensions":662},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[663,664],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":618,"notBefore":72,"notAfter":520,"evidence":459},[667,668],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[670],[87,88],[90,91],{"_":467,"role":96,"ref":468},{"_":674,"type":100},"ME23438",{"_":102,"mainLang":103,"languages":676},[102],[678],{"atLeast":107,"atMost":107},[416,476,114,477],[420,479,120,480],[682,683,684,32,36,40,125,126,127,128,126,485,131,103],"isic004414","epitaph for eupolemos",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":687,"ptr":688,"ref":689,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.119",{"target":136},{"_":138,"target":138},{"file":691,"uri":691,"title":692,"status":693,"editions":694,"editionAuthor":30,"type":700,"objectType":701,"material":702,"condition":46,"layoutDesc":704,"handNote":708,"date":714,"places":716,"geo":719,"country":79,"provenance":76,"provenanceGeo":721,"region":92,"settlement":81,"repository":722,"idno":723,"textLang":725,"tmNumber":46,"letterHeights":727,"publications":730,"zotero":731,"keywords":732,"html":736,"bibl":737,"bulletinDateSort":139,"citedRangeSort":738,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004422","Epitaph for Artemidoros (?)",{"_":209},[695,696,697,698,699],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":503,"ana":504,"ref":505},{"_":40,"ana":41,"type":42,"subtype":703,"ref":45},[44],{"layout":705},{"p":706,"rs":707,"damage":46},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":51,"ana":52,"ref":53},{"lettering":709,"dimensions":710},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[711,713],{"type":58,"l":59,"from":60,"to":60,"h":712,"unit":62,"atLeast":712,"atMost":712},"29",{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":715,"notBefore":519,"notAfter":520,"evidence":459},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[717,718],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[720],[87,88],[90,91],{"_":467,"role":96,"ref":468},{"_":724,"type":100},"ME23440",{"_":102,"mainLang":103,"languages":726},[102],[728],{"atLeast":729,"atMost":729},29,[114,477],[120,480],[733,734,735,32,503,40,125,126,127,128,126,485,131,103],"isic004422","epitaph for artemidoros (?)",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":738,"ptr":739,"ref":740,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.120",{"target":136},{"_":138,"target":138},{"file":742,"uri":742,"title":743,"status":744,"editions":745,"editionAuthor":30,"type":751,"objectType":752,"material":753,"condition":46,"layoutDesc":755,"handNote":758,"date":763,"places":766,"geo":769,"country":79,"provenance":76,"provenanceGeo":771,"region":92,"settlement":81,"repository":772,"idno":773,"textLang":775,"tmNumber":46,"letterHeights":777,"publications":779,"zotero":780,"keywords":781,"html":785,"bibl":786,"bulletinDateSort":139,"citedRangeSort":787,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004412","Epitaph for Aristoboula",{"_":209},[746,747,748,749,750],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":443},{"_":40,"ana":41,"type":42,"subtype":754,"ref":45},[44],{"layout":756},{"p":448,"rs":757,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":759,"dimensions":760},"Slightly irregular letters, becoming slightly more compressed to the right hand end: Alpha broad with broken bar; rho has small closed eye; sigma is four equal bars, angled apart; omicron is small and mid-line; beta has equal closed eyes, with slight gap between them; upsilon asymmetrical.",[761,762],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":764,"notBefore":519,"notAfter":765,"evidence":242},"Letter forms suggest a date in the 4th or earlier 3rd century BCE",-251,[767,768],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[770],[87,88],[90,91],{"_":467,"role":96,"ref":468},{"_":774,"type":100},"ME23439",{"_":102,"mainLang":103,"languages":776},[102],[778],{"atLeast":107,"atMost":107},[476,114,477],[479,120,480],[782,783,784,32,36,40,125,126,127,128,126,485,131,103],"isic004412","epitaph for aristoboula",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοβούλας \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":787,"ptr":788,"ref":789,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.121",{"target":136},{"_":138,"target":138},false],"uses":{"params":["slug"]}}]}
