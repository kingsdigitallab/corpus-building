:46},"Single line of Greek letters filling the width of the stone",{"_":51,"ana":52,"ref":53},{"lettering":456,"dimensions":457},"Plain wide letters: kappa has arms of almost full length, not quite joining the vertical; rho is closed; alpha broad with straight bar; sigma has horizontal top and bottom bars, joined by a curving stroke rather than two distinct diagonals; omega sits very slightly above the line, is circular and open with short arms",[458,459],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":461,"notBefore":462,"notAfter":463,"evidence":464},"Dated to the end of the 4th century BCE by the burial goods",-325,-301,"archaeological-context",[466,467],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[469],[87,88],[90,91],{"_":472,"role":96,"ref":473},"Museo Archeologico Santi Furnari di Tripi","http://sicily.classics.ox.ac.uk/museum/177",{"_":475,"type":100},"ME23435",{"_":102,"mainLang":103,"languages":477},[102],[479],{"atLeast":107,"atMost":107},[421,481,114,482],"Bacci, Coppolino, Sofia, Arizia, 2015, Tripi. Il museo archeologico \"Santi Furnari\". Guida all'esposizione","Sofia, 2018, Nuove iscrizioni funerarie dalla necropoli di Abakainon",[425,484,120,485],"ILQ4RQGU","JQQKI6JP",[487,488,489,32,36,40,125,126,127,128,126,490,131,103],"isic004411","epitaph for kratisstos",{"_":209},"museo archeologico santi furnari di tripi","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κρατίσστω \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":493,"ptr":494,"ref":495,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"113 fig.115",{"target":136},{"_":138,"target":138},{"file":497,"uri":497,"title":498,"status":499,"editions":500,"editionAuthor":30,"type":506,"objectType":507,"material":511,"condition":46,"layoutDesc":513,"handNote":517,"date":522,"places":526,"geo":530,"country":79,"provenance":76,"provenanceGeo":532,"region":92,"settlement":81,"repository":533,"idno":537,"textLang":538,"tmNumber":46,"letterHeights":540,"publications":542,"zotero":543,"keywords":544,"html":549,"bibl":550,"bulletinDateSort":139,"citedRangeSort":493,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004417","Epitaph for [-?-], child of Gerontios",{"_":209},[501,502,503,504,505],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":508,"ana":509,"ref":510},"plinth","#object.arch_element.plinth","https://www.eagle-network.eu/voc/objtyp/lod/1910.html",{"_":40,"ana":41,"type":42,"subtype":512,"ref":45},[44],{"layout":514},{"p":515,"rs":516,"damage":46},"Remains of two lines of Greek letters, apparently centred on the face of the plinth; the second line sits directly above the lower moulding",{"_":51,"ana":52,"ref":53},{"lettering":518,"dimensions":519},"Simple, widely spaced letters. Omega is wide and open, with horizontal tails; rho has a large, closed eye; omicron is small and mid-line; nu is regular and with both verticals full length",[520,521],{"type":58,"l":168,"from":60,"to":68,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"unit":62},{"_":523,"notBefore":524,"notAfter":525,"evidence":464},"The tomb has not been excavated fully, but the cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",-350,-201,[527,529],{"_":76,"type":77,"ref":78,"corresp":528,"region":79},"#findspot",{"_":81,"type":82,"ref":83,"offset":84,"region":79},[531],[87,88],[90,91],{"_":534,"role":535,"ref":536},"Necropoli di Abakainon","site","http://sicily.classics.ox.ac.uk/museum/186",{"type":100},{"_":102,"mainLang":103,"languages":539},[102],[541],{"atLeast":107,"atMost":107},[421,114,482],[425,120,485],[545,546,54