291],"arenaria_grigia_flysch_di_Capo_d-Orlando","#Coccato",{"type":294,"ref":295,"location":298},"provenance",{"_":296,"target":297},"Capo d'Orlando","https://www.geonames.org/2525384/capo-d-orlando.html",{"geo":299,"precision":300},"38.02466,15.01268",{"match":301,"n":302},"preceding-sibling::geo","20000",{"_":304,"ref":305}," Petrographic imagery at ",{"_":306,"target":306},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic001207",{"layout":308},{"p":309,"rs":310,"damage":46},"Five lines of Greek letters, centred on the stone",{"_":51,"ana":52,"ref":53},{"lettering":312,"dimensions":313},"Slightly crudely incised simple broad letters without serifs. Nu i sregular; epsilon has slightly shorter middle bar; mu has slightly inward leaning first and last strokes, the mid-strokes reach down to the base-line; rho has a small eye, not always fully closed; alpha has broken bar; omega varies between open circle closed by horizontal bar and closed ovoid form with horizontal bar; phi has a small circular eye; sigma has standard form with horizontal top and bottom storkes; omicron is approximately the same size as other letters.",[314,319],{"type":58,"l":315,"from":60,"to":316,"h":317,"unit":62,"atLeast":63,"atMost":318},"Lines 1-5","line5","30-45","45",{"type":66,"l":67,"from":60,"to":68,"unit":62},{"_":321,"notBefore":322,"notAfter":73},"2nd century BCE(?)",-200,[324,325],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[327],[87,88],[90,91],{"_":95,"role":96,"ref":97},{"_":331,"type":100},"8706",{"_":102,"mainLang":103,"languages":333},[102],{"n":185,"url":335,"height":336,"width":337,"desc":338,"surfaceType":190},"ISic001207_tiled.tif","3212px","2498px","Photo J. Prag, courtesy Museo Archeologico Regionale Antonino Salinas",[340],{"atLeast":107,"atMost":341},45,[110,111,112,113,343,344,114],"Manni Piraino, 1976, Contribution Épigraphique à l'Étude de l'esclavage en Sicile","Manganaro, 1988, La Sicilia da Sesto Pompeo a Diocleziano",[