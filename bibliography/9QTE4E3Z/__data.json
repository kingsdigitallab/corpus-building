ppa has short, approximately equal arms; alpha is broad with broken bar; omicron is small and mid-line; sigma has horizontal top and bottom strokes.",[617,618],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":620,"notBefore":72,"notAfter":518,"evidence":455},"The goods recovered from the tomb suggest a date in the 3rd century BCE",[622,623],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[625],[87,88],[90,91],{"_":463,"role":96,"ref":464},{"_":629,"type":100},"ME23436",{"_":102,"mainLang":103,"languages":631},[102],{"n":106,"url":633,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004413_tiled.tif",[635],{"atLeast":114,"atMost":114},[474,121,475],[477,127,478],[639,640,641,32,36,40,132,133,134,135,133,483,138,103],"isic004413","epitaph for kallo",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Καλλοῦς \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":644,"ptr":645,"ref":646,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.118",{"target":143},{"_":145,"target":145},{"file":648,"uri":648,"title":649,"status":650,"editions":651,"editionAuthor":30,"type":657,"objectType":658,"material":659,"condition":46,"layoutDesc":661,"handNote":664,"date":669,"places":670,"geo":673,"country":79,"provenance":76,"provenanceGeo":675,"region":92,"settlement":81,"repository":676,"idno":677,"textLang":679,"tmNumber":46,"facsimile":681,"letterHeights":683,"publications":685,"zotero":686,"keywords":687,"html":691,"bibl":692,"bulletinDateSort":146,"citedRangeSort":693,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004414","Epitaph for Eupolemos",{"_":213},[652,653,654,655,656],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":439},{"_":40,"ana":41,"type":42,"subtype":660,"ref":45},[44],{"layout":662},{"p":444,"rs":663,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":665,"dimensions":666},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[667,668],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":620,"notBefore":72,"notAfter":518,"evidence":455},[671,672],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[674],[87,88],[90,91],{"_":463,"role":96,"ref":464},{"_":678,"type":100},"ME23438",{"_":102,"mainLang":103,"languages":680},[102],{"n":106,"url":682,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004414_tiled.tif",[684],{"atLeast":114,"atMost":114},[412,474,121,475],[416,477,127,478],[688,689,690,32,36,40,132,133,134,135,133,483,138,103],"isic004414","epitaph for eupolemos",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":693,"ptr":694,"ref":695,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.119",{"target":143},{"_":145,"target":145},{"file":697,"uri":697,"title":698,"status":699,"editions":700,"editionAuthor":30,"type":706,"objectType":707,"material":708,"condition":46,"layoutDesc":710,"handNote":714,"date":720,"places":722,"geo":725,"country":79,"provenance":76,"provenanceGeo":727,"region":92,"settlement":81,"repository":728,"idno":729,"textLang":731,"tmNumber":46,"facsimile":733,"letterHeights":735,"publications":738,"zotero":739,"keywords":740,"html":744,"bibl":745,"bulletinDateSort":146,"citedRangeSort":746,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004422","Epitaph for Artemidoros (?)",{"_":213},[701,702,703,704,705],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":501,"ana":502,"ref":503},{"_":40,"ana":41,"type":42,"subtype":709,"ref":45},[44],{"layout":711},{"p":712,"rs":713,"damage":46},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":51,"ana":52,"ref":53},{"lettering":715,"dimensions":716},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[717,719],{"type":58,"l":59,"from":60,"to":60,"h":718,"unit":62,"atLeast":718,"atMost":718},"29",{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":721,"notBefore":517,"notAfter":518,"evidence":455},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[723,724],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[726],[87,88],[90,91],{"_":463,"role":96,"ref":464},{"_":730,"type":100},"ME23440",{"_":102,"mainLang":103,"languages":732},[102],{"n":106,"url":734,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004422_tiled.tif",[736],{"atLeast":737,"atMost":737},29,[121,475],[127,478],[741,742,743,32,501,40,132,133,134,135,133,483,138,103],"isic004422","epitaph for artemidoros (?)",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":746,"ptr":747,"ref":748,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.120",{"target":143},{"_":145,"target":145},{"file":750,"uri":750,"title":751,"status":752,"editions":753,"editionAuthor":30,"type":759,"objectType":760,"material":761,"condition":46,"layoutDesc":763,"handNote":766,"date":771,"places":774,"geo":777,"country":79,"provenance":76,"provenanceGeo":779,"region":92,"settlement":81,"repository":780,"idno":781,"textLang":783,"tmNumber":46,"facsimile":785,"letterHeights":787,"publications":789,"zotero":790,"keywords":791,"html":795,"bibl":796,"bulletinDateSort":146,"citedRangeSort":797,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004412","Epitaph for Aristoboula",{"_":213},[754,755,756,757,758],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":439},{"_":40,"ana":41,"type":42,"subtype":762,"ref":45},[44],{"layout":764},{"p":444,"rs":765,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":767,"dimensions":768},"Slightly irregular letters, becoming slightly more compressed to the right hand end: Alpha broad with broken bar; rho has small closed eye; sigma is four equal bars, angled apart; omicron is small and mid-line; beta has equal closed eyes, with slight gap between them; upsilon asymmetrical.",[769,770],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":772,"notBefore":517,"notAfter":773,"evidence":246},"Letter forms suggest a date in the 4th or earlier 3rd century BCE",-251,[775,776],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[778],[87,88],[90,91],{"_":463,"role":96,"ref":464},{"_":782,"type":100},"ME23439",{"_":102,"mainLang":103,"languages":784},[102],{"n":106,"url":786,"height":260,"width":261,"desc":262,"surfaceType":111},"ISic004412_tiled.tif",[788],{"atLeast":114,"atMost":114},[474,121,475],[477,127,478],[792,793,794,32,36,40,132,133,134,135,133,483,138,103],"isic004412","epitaph for aristoboula",{"_":213},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοβούλας \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":797,"ptr":798,"ref":799,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.121",{"target":143},{"_":145,"target":145},false],"uses":{"params":["slug"]}}]}
