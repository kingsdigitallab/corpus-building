],{"layout":615},{"p":453,"rs":616,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":618,"dimensions":619},"Broad simple letters: kappa has short, approximately equal arms; alpha is broad with broken bar; omicron is small and mid-line; sigma has horizontal top and bottom strokes.",[620,621],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":623,"notBefore":72,"notAfter":525,"evidence":464},"The goods recovered from the tomb suggest a date in the 3rd century BCE",[625,626],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[628],[87,88],[90,91],{"_":472,"role":96,"ref":473},{"_":632,"type":100},"ME23436",{"_":102,"mainLang":103,"languages":634},[102],[636],{"atLeast":107,"atMost":107},[481,114,482],[484,120,485],[640,641,642,32,36,40,125,126,127,128,126,490,131,103],"isic004413","epitaph for kallo",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Καλλοῦς \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":645,"ptr":646,"ref":647,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.118",{"target":136},{"_":138,"target":138},{"file":649,"uri":649,"title":650,"status":651,"editions":652,"editionAuthor":30,"type":658,"objectType":659,"material":660,"condition":46,"layoutDesc":662,"handNote":665,"date":670,"places":671,"geo":674,"country":79,"provenance":76,"provenanceGeo":676,"region":92,"settlement":81,"repository":677,"idno":678,"textLang":680,"tmNumber":46,"letterHeights":682,"publications":684,"zotero":685,"keywords":686,"html":690,"bibl":691,"bulletinDateSort":139,"citedRangeSort":692,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004414","Epitaph for Eupolemos",{"_":209},[653,654,655,656,657],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":448},{"_":40,"ana":41,"type":42,"subtype":661,"ref":45},[44],{"layout":663},{"p":453,"rs":664,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":666,"dimensions":667},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[668,669],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":623,"notBefore":72,"notAfter":525,"evidence":464},[672,673],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[675],[87,88],[90,91],{"_":472,"role":96,"ref":473},{"_":679,"type":100},"ME23438",{"_":102,"mainLang":103,"languages":681},[102],[683],{"atLeast":107,"atMost":107},[421,481,114,482],[425,484,120,485],[687,688,689,32,36,40,125,126,127,128,126,490,131,103],"isic004414","epitaph for eupolemos",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":692,"ptr":693,"ref":694,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.119",{"target":136},{"_":138,"target":138},{"file":696,"uri":696,"title":697,"status":698,"editions":699,"editionAuthor":30,"type":705,"objectType":706,"material":707,"condition":46,"layoutDesc":709,"handNote":713,"date":719,"places":721,"geo":724,"country":79,"provenance":76,"provenanceGeo":726,"region":92,"settlement":81,"repository":727,"idno":728,"textLang":730,"tmNumber":46,"letterHeights":732,"publications":735,"zotero":736,"keywords":737,"html":741,"bibl":742,"bulletinDateSort":139,"citedRangeSort":743,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004422","Epitaph for Artemidoros (?)",{"_":209},[700,701,702,703,704],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":508,"ana":509,"ref":510},{"_":40,"ana":41,"type":42,"subtype":708,"ref":45},[44],{"layout":710},{"p":711,"rs":712,"damage":46},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":51,"ana":52,"ref":53},{"lettering":714,"dimensions":715},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[716,718],{"type":58,"l":59,"from":60,"to":60,"h":717,"unit":62,"atLeast":717,"atMost":717},"29",{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":720,"notBefore":524,"notAfter":525,"evidence":464},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[722,723],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[725],[87,88],[90,91],{"_":472,"role":96,"ref":473},{"_":729,"type":100},"ME23440",{"_":102,"mainLang":103,"languages":731},[102],[733],{"atLeast":734,"atMost":734},29,[114,482],[120,485],[738,739,740,32,508,40,125,126,127,128,126,490,131,103],"isic004422","epitaph for artemidoros (?)",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":743,"ptr":744,"ref":745,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.120",{"target":136},{"_":138,"target":138},{"file":747,"uri":747,"title":748,"status":749,"editions":750,"editionAuthor":30,"type":756,"objectType":757,"material":758,"condition":46,"layoutDesc":760,"handNote":763,"date":768,"places":771,"geo":774,"country":79,"provenance":76,"provenanceGeo":776,"region":92,"settlement":81,"repository":777,"idno":778,"textLang":780,"tmNumber":46,"letterHeights":782,"publications":784,"zotero":785,"keywords":786,"html":790,"bibl":791,"bulletinDateSort":139,"citedRangeSort":792,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004412","Epitaph for Aristoboula",{"_":209},[751,752,753,754,755],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":448},{"_":40,"ana":41,"type":42,"subtype":759,"ref":45},[44],{"layout":761},{"p":453,"rs":762,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":764,"dimensions":765},"Slightly irregular letters, becoming slightly more compressed to the right hand end: Alpha broad with broken bar; rho has small closed eye; sigma is four equal bars, angled apart; omicron is small and mid-line; beta has equal closed eyes, with slight gap between them; upsilon asymmetrical.",[766,767],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":769,"notBefore":524,"notAfter":770,"evidence":241},"Letter forms suggest a date in the 4th or earlier 3rd century BCE",-251,[772,773],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[775],[87,88],[90,91],{"_":472,"role":96,"ref":473},{"_":779,"type":100},"ME23439",{"_":102,"mainLang":103,"languages":781},[102],[783],{"atLeast":107,"atMost":107},[481,114,482],[484,120,485],[787,788,789,32,36,40,125,126,127,128,126,490,131,103],"isic004412","epitaph for aristoboula",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοβούλας \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":792,"ptr":793,"ref":794,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.121",{"target":136},{"_":138,"target":138},false],"uses":{"params":["slug"]}}]}
