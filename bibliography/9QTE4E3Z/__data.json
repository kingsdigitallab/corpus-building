la",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀριστοβούλας \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":791,"ptr":792,"ref":793,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"116 fig.121",{"target":136},{"_":138,"target":138},false],"uses":{"params":["slug"]}}]}
