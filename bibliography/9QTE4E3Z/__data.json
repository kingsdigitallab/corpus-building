age":46},{"_":51,"ana":52,"ref":53},{"lettering":617,"dimensions":618},"Broad simple letters: kappa has short, approximately equal arms; alpha is broad with broken bar; omicron is small and mid-line; sigma has horizontal top and bottom strokes.",[619,620],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":622,"notBefore":72,"notAfter":524,"evidence":463},"The goods recovered from the tomb suggest a date in the 3rd century BCE",[624,625],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[627],[87,88],[90,91],{"_":471,"role":96,"ref":472},{"_":631,"type":100},"ME23436",{"_":102,"mainLang":103,"languages":633},[102],[635],{"atLeast":107,"atMost":107},[480,114,481],[483,120,484],[639,640,641,32,36,40,125,126,127,128,126,489,131,103],"isic004413","epitaph for kallo",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Καλλοῦς \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":644,"ptr":645,"ref":646,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.118",{"target":136},{"_":138,"target":138},{"file":648,"uri":648,"title":649,"status":650,"editions":651,"editionAuthor":30,"type":657,"objectType":658,"material":659,"condition":46,"layoutDesc":661,"handNote":664,"date":669,"places":670,"geo":673,"country":79,"provenance":76,"provenanceGeo":675,"region":92,"settlement":81,"repository":676,"idno":677,"textLang":679,"tmNumber":46,"letterHeights":681,"publications":683,"zotero":684,"keywords":685,"html":689,"bibl":690,"bulletinDateSort":139,"citedRangeSort":691,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004414","Epitaph for Eupolemos",{"_":209},[652,653,654,655,656],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":36,"ana":37,"ref":447},{"_":40,"ana":41,"type":42,"subtype":660,"ref":45},[44],{"layout":662},{"p":452,"rs":663,"damage":46},{"_":51,"ana":52,"ref":53},{"lettering":665,"dimensions":666},"Plain letters carved in a deep square cut: E has shorter mid-bar; upsilon slightly exceeds the line; pi is wide and square in form, with fractionally shorter right hasta; omicron is only slightly smaller than the other letters; mu has vertical first and last strokes, while the mid-strokes descend less than half-way.",[667,668],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":622,"notBefore":72,"notAfter":524,"evidence":463},[671,672],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[674],[87,88],[90,91],{"_":471,"role":96,"ref":472},{"_":678,"type":100},"ME23438",{"_":102,"mainLang":103,"languages":680},[102],[682],{"atLeast":107,"atMost":107},[420,480,114,481],[424,483,120,484],[686,687,688,32,36,40,125,126,127,128,126,489,131,103],"isic004414","epitaph for eupolemos",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Εὐπολέμου \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":691,"ptr":692,"ref":693,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"115 fig.119",{"target":136},{"_":138,"target":138},{"file":695,"uri":695,"title":696,"status":697,"editions":698,"editionAuthor":30,"type":704,"objectType":705,"material":706,"condition":46,"layoutDesc":708,"handNote":712,"date":718,"places":720,"geo":723,"country":79,"provenance":76,"provenanceGeo":725,"region":92,"settlement":81,"repository":726,"idno":727,"textLang":729,"tmNumber":46,"letterHeights":731,"publications":734,"zotero":735,"keywords":736,"html":740,"bibl":741,"bulletinDateSort":139,"citedRangeSort":742,"languageSort":102,"materialSort":40,"typeSort":32},"ISic004422","Epitaph for Artemidoros (?)",{"_":209},[699,700,701,702,703],{"type":16},{"type":19},{"type":21},{"type":24},{"type":27},{"_":32,"ana":33,"ref":34},{"_":507,"ana":508,"ref":509},{"_":40,"ana":41,"type":42,"subtype":707,"ref":45},[44],{"layout":709},{"p":710,"rs":711,"damage":46},"A single line of rather irregular Greek letters, seemingly not precisely centred on the stone, with empty space below; the right hand end of the text is lost to damage.",{"_":51,"ana":52,"ref":53},{"lettering":713,"dimensions":714},"Somewhat crudely cut and rather irregular letters. Alpha has straight bar; rho has somewhat elongated closed eye; epsilon has shorter middle bar; mu has vertical first and last strokes, mid-strokes formed by diagonals which meet about half-way down; delta is rather small and off-vertical; omega appears to be small, above the line, open, and with outward and downward angled arms.",[715,717],{"type":58,"l":59,"from":60,"to":60,"h":716,"unit":62,"atLeast":716,"atMost":716},"29",{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":719,"notBefore":523,"notAfter":524,"evidence":463},"The cemetery went out of use around the end of the 3rd century BCE or early 2nd century, offering a terminus ante quem",[721,722],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[724],[87,88],[90,91],{"_":471,"role":96,"ref":472},{"_":728,"type":100},"ME23440",{"_":102,"mainLang":103,"languages":730},[102],[732],{"atLeast":733,"atMost":733},29,[114,481],[120,484],[737,738,739,32,507,40,125,126,127,128,126,489,131,103],"isic004422","epitaph for artemidoros (?)",{"_":209},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Ἀρτεμιδω̣[ρου] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C