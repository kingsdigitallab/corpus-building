the line, is circular and open with short arms",[452,453],{"type":58,"l":59,"from":60,"to":60,"h":63,"unit":62,"atLeast":63,"atMost":63},{"type":66,"l":67,"from":60,"to":68,"h":69,"unit":62},{"_":455,"notBefore":456,"notAfter":457,"evidence":458},"Dated to the end of the 4th century BCE by the burial goods",-325,-301,"archaeological-context",[460,461],{"_":76,"type":77,"ref":78,"region":79},{"_":81,"type":82,"ref":83,"offset":84,"region":79},[463],[87,88],[90,91],{"_":466,"role":96,"ref":467},"Museo Archeologico Santi Furnari di Tripi","http://sicily.classics.ox.ac.uk/museum/177",{"_":469,"type":100},"ME23435",{"_":102,"mainLang":103,"languages":471},[102],[473],{"atLeast":107,"atMost":107},[415,475,114,476],"Bacci, Coppolino, Sofia, Arizia, 2015, Tripi. Il museo archeologico \"Santi Furnari\". Guida all'esposizione","Sofia, 2018, Nuove iscrizioni funerarie dalla necropoli di Abakainon",[419,478,120,479],"ILQ4RQGU","JQQKI6JP",[481,482,483,32,36,40,125,126,127,128,126,484,131,103],"isic004411","epitaph for kratisstos",{"_":209},"museo archeologico santi furnari di tripi","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>Κρατίσστω \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":487,"ptr":488,"ref":489,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"113 fig.115",{"target":136},{"_":138,"target":138},{"file":491,"uri":491,"title":492,"status":493,"editions":494,"editionAuthor":30,"type":500,"objectType":501,"material":505,"condition":46,"layoutDesc":507,"handNote":511,"date":516,"places":520,"geo":524,"country":79,"provenance":76,"provenanceGeo":526,"region":92,"settlement":81,"repository":527,"idno":531,"textLang":532,"tmNumber":46,"letterHeights":534,"publications":536,"zotero":537,"keywords":538,"html":543,"bibl":544,"bulletinDateSort":139,"citedRangeSort":487,"langu