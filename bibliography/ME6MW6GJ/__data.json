ine is incised down the left side and along the bottom.",{"_":50,"ana":51,"ref":52},{"ana":259},"#text_condition.complete",{"lettering":261,"dimensions":262},"Letters of moderate quality, with simpe serfis, and a fairly wide module. T is consistently overheight.",[263,267,271,275,279,282,286,290,294,298,301],{"type":60,"l":61,"from":62,"to":62,"h":264,"unit":64,"atLeast":265,"atMost":266},"35-37","35","37",{"type":60,"l":68,"from":69,"to":69,"h":268,"unit":64,"atLeast":269,"atMost":270},"29-33","29","33",{"type":60,"l":74,"from":75,"to":75,"h":272,"unit":64,"atLeast":273,"atMost":274},"28-31 (T is 34)","28","31",{"type":60,"l":79,"from":80,"to":80,"h":276,"unit":64,"atLeast":277,"atMost":278},"23-27 (T is 29)","23","27",{"type":60,"l":85,"from":86,"to":86,"h":280,"unit":64,"atLeast":281,"atMost":278},"24-27","24",{"type":60,"l":90,"from":91,"to":91,"h":283,"unit":64,"atLeast":284,"atMost":285},"22-25","22","25",{"type":99,"l":100,"from":62,"to":69,"h":287,"unit":64,"atLeast":288,"atMost":289},"12-13","12","13",{"type":99,"l":105,"from":69,"to":75,"h":291,"unit":64,"atLeast":292,"atMost":293},"7-11","7","11",{"type":99,"l":110,"from":75,"to":80,"h":295,"unit":64,"atLeast":296,"atMost":297},"4-10","4","10",{"type":99,"l":112,"from":80,"to":86,"h":299,"unit":64,"atLeast":300,"atMost":297},"5-10","5",{"type":99,"l":116,"from":86,"to":91,"h":302,"unit":64,"atLeast":303,"atMost":304},"8-9","8","9",{"_":306,"notBefore":307,"notAfter":308,"evidence":309},"Very end of the first or first third of the 2nd century CE",96,133,"prosopography",[311,314],{"_":312,"type":130,"ref":313,"region":132},"Capitoniania","http://pleiades.stoa.org/places/462131",{"_":315,"type":135,"ref":316,"region":132},"Ramacca","http://sws.geonames.org/2523644",[318],[319,320],37.38616,14.69241,[322,323],37.41743,14.62974,{"_":325,"role":147,"ref":326},"Museo Civico Archeologico di Ramacca","http://sicily.classics.ox.ac.uk/museum/024",{"_":328,"type":151},"54",{"_":153,"mainLang":154,"languages":330},[15