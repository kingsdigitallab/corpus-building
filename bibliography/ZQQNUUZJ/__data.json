{"type":"data","nodes":[{"type":"data","data":[{"debug":1},true],"uses":{}},{"type":"data","data":[{"zotero":1,"inscriptions":7,"isBulletin":462},{"title":2,"author":3,"date":4,"citation":5,"uri":6},"Alesa Archonidea. Guide to the Antiquarium","Scibona, Tigano","2008","\u003Cspan>G. Scibona and G. Tigano, \u003Ci>Alesa Archonidea. Guide to the Antiquarium\u003C/i> (Palermo: Regione Siciliana, 2008)\u003C/span>","https://www.zotero.org/groups/isicily/items/ZQQNUUZJ",[8,148,341],{"file":9,"uri":9,"title":10,"status":11,"editions":13,"editionAuthor":25,"type":26,"objectType":30,"material":34,"condition":49,"layoutDesc":50,"handNote":61,"date":77,"places":82,"geo":93,"country":87,"provenance":84,"provenanceGeo":97,"region":100,"settlement":84,"repository":101,"idno":105,"textLang":108,"tmNumber":15,"facsimile":112,"letterHeights":119,"publications":123,"zotero":126,"keywords":129,"html":140,"bibl":141,"bulletinDateSort":147,"citedRangeSort":142,"languageSort":109,"materialSort":35,"typeSort":27},"ISic003579","Record of building expenses",{"_":12},"edited",[14,17,19,21,23],{"_":15,"type":16},"645650","TM",{"type":18},"EDR",{"type":20},"EDH",{"type":22},"EDCS",{"type":24},"PHI",null,{"_":27,"ana":28,"ref":29},"building","#function.building","https://ontology.inscriptiones.org/type_of_inscription/Building_inscription",{"_":31,"ana":32,"ref":33},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259",{"_":35,"ana":36,"type":37,"subtype":38,"resp":40,"ref":41,"placeName":42},"Very fine to fine-grained, veined, grey marble, likely Lunense. Digital microscopy: homeoblastic to heteroblastic fabric (identification based on pXRF, digital microscopy)\n","#material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Lunense","stone.marble",[39],"Lunense","#Coccato","http://www.eagle-network.eu/voc/material/lod/48.html",{"type":43,"ref":44,"location":47},"provenance",{"_":45,"target":46},"Carrara","https://www.geonames.org/6542087/carrara.html",{"geo":48},"44.06294,10.06069","",{"layout":51},{"p":52,"rs":53,"damage":49}," On the reverse, above the line of holes, is a Latin inscription running the width of the slab. One fragment is lost from the upper part of the text",[54,58],{"_":55,"ana":56,"ref":57},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"_":59,"ana":60},"Rubrication, red coloured","#execution.rubrication.red",{"lettering":62,"dimensions":63},"The letters preserve red paint within them. The letters are neatly V-cut and regular, with triangular serifs to the ends of the strokes. M has sloping hastae; C is tall and shallow; P is curved and open; S is tall and falls forward slightly. Simple triangular interpuncts stand between each word and after the last word.",[64,72],{"type":65,"l":66,"from":67,"to":67,"h":68,"unit":69,"atLeast":70,"atMost":71},"letterHeight","Line 1","line1","65-70","mm","65","70",{"type":73,"l":74,"from":67,"to":75,"h":76,"unit":69},"interlinear","Interlineation","line2","n/a",{"_":78,"notBefore":79,"notAfter":80,"evidence":81},"1st century CE",1,100,"context, lettering",[83,88],{"_":84,"type":85,"ref":86,"region":87},"Halaesa","ancient","http://pleiades.stoa.org/places/462225","Sicilia",{"_":89,"type":90,"ref":91,"offset":92,"region":87},"Castel di Tusa","modern","http://sws.geonames.org/2525099","near",[94],[95,96],37.99907,14.26197,[98,99],37.997856,14.262463,"Sicily",{"_":102,"role":103,"ref":104},"Antiquarium e sito archeologico di Halaesa ","museum","http://sicily.classics.ox.ac.uk/museum/053",{"_":106,"type":107},"ME 20199","inventory",{"_":109,"mainLang":110,"languages":111},"Latin","la",[109],{"n":113,"url":114,"height":115,"width":116,"desc":117,"surfaceType":118},"screen","ISic003579_tiled.tif","2320px","5520px","Photo J. Prag courtesy Soprintendenza BBCCAA di Messina","front",[120],{"atLeast":121,"atMost":122},65,70,[124,125],"Scibona, Tigano, 2008, Alesa Archonidea. Guide to the Antiquarium","Prag, Tigano, 2017, Alesa Archonidea: il lapidarium",[127,128],"ZQQNUUZJ","MI64NB9L",[130,131,132,27,31,133,134,135,136,137,134,138,139,110],"isic003579","record of building expenses",{"_":12},"very fine to fine-grained, veined, grey marble, likely lunense. digital microscopy: homeoblastic to heteroblastic fabric (identification based on pxrf, digital microscopy)","halaesa","castel di tusa","sicilia","sicily","antiquarium e sito archeologico di halaesa","latin","\u003Cdiv class=\"textpart\" lang=\"la\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>impensa · \u003Cspan class=\"intraline\" title=\"line through\">(sestertium) · CC|ϽϽ · fecit · \u003C/span>\u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":142,"ptr":143,"ref":145,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"27",{"target":144},"https://www.zotero.org/groups/382445/items/ZQQNUUZJ",{"_":146,"target":146},"https://biblio.inscriptiones.org/epig10001590",2008,{"file":149,"uri":149,"title":150,"status":151,"editions":152,"editionAuthor":25,"type":159,"objectType":163,"material":164,"condition":49,"layoutDesc":175,"handNote":179,"date":261,"places":266,"geo":269,"country":87,"provenance":84,"provenanceGeo":271,"region":100,"settlement":84,"repository":274,"idno":275,"textLang":277,"tmNumber":154,"facsimile":281,"letterHeights":285,"publications":322,"zotero":326,"keywords":330,"html":336,"bibl":337,"bulletinDateSort":147,"citedRangeSort":338,"languageSort":278,"materialSort":165,"typeSort":160},"ISic003337","Funerary inscription for Eirena",{"_":12},[153,155,156,157,158],{"_":154,"type":16},"645584",{"type":18},{"type":20},{"type":22},{"type":24},{"_":160,"ana":161,"ref":162},"funerary","#function.funerary","https://ontology.inscriptiones.org/type_of_inscription/Funerary",{"_":31,"ana":32,"ref":33},{"_":165,"ana":166,"type":37,"subtype":167,"resp":40,"ref":41,"placeName":169},"Very fine-grained, veined, white marble, likely Pavonazzetto. Digital microscopy: indistinguishable fabric. Scribbly veins, maybe a limestone (identification based on pXRF, digital microscopy)\n","#material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Pavonazzetto",[168],"Pavonazzetto",{"type":43,"ref":170,"location":173},{"_":171,"target":172},"Bakakale","https://www.geonames.org/12207392/iscehisar-bucagi.html",{"geo":174},"38.86194,30.75028",{"layout":176},{"p":177,"rs":178,"damage":49},"Ten lines of Greek filling the available space, decreasing notably in size in the second five lines",{"_":55,"ana":56,"ref":57},{"lettering":180,"dimensions":181},"The letters are engraved in a fairly plain, square fashion, with simple serifs. Alpha is mostly with broken bar, sometimes with an extended upper serif, although there is a straight bar example in line 7 and in lines 8 and 10 straight bar descending to left foot; beta is closed, with larger lower eye, generally horizontal along the base; delta varies between regular triangle and oblique lower bar with extended serif above; epsilon has straight bars of equal length, except for instances in lines 9 and 10 when it is lunate; theta is ovoid with connecting straight bar; kappa has short tails; lambda sometimes has an extended upper serif; mu varies between a form with vertical first and last hastae and short middle strokes meeting above the line and cursive form comparable to a lower-case mu in line 9; omicron is full size in the first few lines, but increasingly is smaller and mid-line; sigma is consistently lunate, but more often formed of three straight strokes; less often a single curved stroke; omega is consistently lunate, and sometimes smaller and mid-line. The eta and nu are in ligature in lines 5, 6 and 7. In line 5 the omicron in the final word is inscribed above the other letters (due to omission?). The last two/three words of the last line are enclosed between a pair of christograms. Small hedera occur in lines 1, 3, 5, and 10.",[182,186,191,196,201,204,210,215,220,225,231,235,239,242,246,250,252,256,259],{"type":65,"l":66,"from":67,"to":67,"h":183,"unit":69,"atLeast":184,"atMost":185},"12-18","12","18",{"type":65,"l":187,"from":75,"to":75,"h":188,"unit":69,"atLeast":189,"atMost":190},"Line 2","14-19","14","19",{"type":65,"l":192,"from":193,"to":193,"h":194,"unit":69,"atLeast":184,"atMost":195},"Line 3","line3","12-22","22",{"type":65,"l":197,"from":198,"to":198,"h":199,"unit":69,"atLeast":200,"atMost":195},"Line 4","line4","8-22","8",{"type":65,"l":202,"from":203,"to":203,"h":183,"unit":69,"atLeast":184,"atMost":185},"Line 5","line5",{"type":65,"l":205,"from":206,"to":206,"h":207,"unit":69,"atLeast":208,"atMost":209},"Line 6","line6","9-16","9","16",{"type":65,"l":211,"from":212,"to":212,"h":213,"unit":69,"atLeast":214,"atMost":189},"Line 7","line7","7-14","7",{"type":65,"l":216,"from":217,"to":217,"h":218,"unit":69,"atLeast":219,"atMost":184},"Line 8","line8","6-12","6",{"type":65,"l":221,"from":222,"to":222,"h":223,"unit":69,"atLeast":219,"atMost":224},"Line 9","line9","6-10","10",{"type":65,"l":226,"from":227,"to":227,"h":228,"unit":69,"atLeast":229,"atMost":230},"Line 10","line10","5-13","5","13",{"type":73,"l":232,"from":67,"to":75,"h":233,"unit":69,"atLeast":224,"atMost":234},"Interlineation line 1 to 2","10-15","15",{"type":73,"l":236,"from":75,"to":193,"h":237,"unit":69,"atLeast":238,"atMost":214},"Interlineation line 2 to 3","3-7","3",{"type":73,"l":240,"from":193,"to":198,"h":241,"unit":69,"atLeast":229,"atMost":234},"Interlineation line 3 to 4","5-15",{"type":73,"l":243,"from":198,"to":203,"h":244,"unit":69,"atLeast":245,"atMost":224},"Interlineation line 4 to 5","4-10","4",{"type":73,"l":247,"from":203,"to":206,"h":248,"unit":69,"atLeast":249,"atMost":214},"Interlineation line 5 to 6","2-7","2",{"type":73,"l":251,"from":206,"to":212,"h":248,"unit":69,"atLeast":249,"atMost":214},"Interlineation line 6 to 7",{"type":73,"l":253,"from":212,"to":217,"h":254,"unit":69,"atLeast":255,"atMost":219},"Interlineation line 7 to 8","1-6","1",{"type":73,"l":257,"from":217,"to":222,"h":258,"unit":69,"atLeast":255,"atMost":229},"Interlineation line 8 to 9","1-5",{"type":73,"l":260,"from":222,"to":227,"h":258,"unit":69,"atLeast":255,"atMost":229},"Interlineation line 9 to 10",{"_":262,"notBefore":263,"notAfter":264,"evidence":265},"5th century CE, with a likely terminus post quem of 403-408 CE, given that a coin of that date was found within the tomb (Tigano 2009: 164; more generally, the tombs of this part of the necropolis all date late 4th to 5th century CE)",403,500,"archaeological-context",[267,268],{"_":84,"type":85,"ref":86,"region":87},{"_":89,"type":90,"ref":91,"offset":92,"region":87},[270],[95,96],[272,273],38.0073241,14.2527381,{"_":102,"role":103,"ref":104},{"_":276,"type":107},"ME 20272",{"_":278,"mainLang":279,"languages":280},"Ancient Greek","grc",[278],{"n":113,"url":282,"height":283,"width":284,"desc":117,"surfaceType":118},"ISic003337_tiled.tif","3387px","5310px",[286,289,292,294,296,297,300,302,304,306,309,311,313,314,316,318,319,320,321],{"atLeast":287,"atMost":288},12,18,{"atLeast":290,"atMost":291},14,19,{"atLeast":287,"atMost":293},22,{"atLeast":295,"atMost":293},8,{"atLeast":287,"atMost":288},{"atLeast":298,"atMost":299},9,16,{"atLeast":301,"atMost":290},7,{"atLeast":303,"atMost":287},6,{"atLeast":303,"atMost":305},10,{"atLeast":307,"atMost":308},5,13,{"atLeast":305,"atMost":310},15,{"atLeast":312,"atMost":301},3,{"atLeast":307,"atMost":310},{"atLeast":315,"atMost":305},4,{"atLeast":317,"atMost":301},2,{"atLeast":317,"atMost":301},{"atLeast":79,"atMost":303},{"atLeast":79,"atMost":307},{"atLeast":79,"atMost":307},[323,324,325,124,125],"L'année épigraphique: revue des publications épigraphiques relatives a l'antiquité romaine., 1888-","Supplementum epigraphicum graecum, 1923-","Manganaro Perrone, 2006, Epigrafe in greco di IV sec. d.C. di Alesa (Sicilia) in versi e prosa, per la morte di Eirena Philandros, \"carissima a Botis boio-celtico\"",[327,328,329,127,128],"R46KDTZX","F2GG87EQ","6KPB9V5B",[331,332,333,160,31,334,134,135,136,137,134,138,335,279],"isic003337","funerary inscription for eirena",{"_":12},"very fine-grained, veined, white marble, likely pavonazzetto. digital microscopy: indistinguishable fabric. scribbly veins, maybe a limestone (identification based on pxrf, digital microscopy)","ancient greek","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-text=\"Ἡ\" data-n=\"5\" data-lemma=\"ὁ\">Ἡ\u003C/span>  \u003Cspan data-text=\"πᾶσι\" data-n=\"10\" data-lemma=\"πᾶς\">πᾶσι\u003C/span> ❦ \u003Cspan data-text=\"ἐν\" data-n=\"20\" data-lemma=\"ἐν\">ἐν\u003C/span>  \u003Cspan data-text=\"βροτοῖσειν\" data-n=\"25\" data-lemma=\"βροτός\">βροτοῖσειν\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"σεμνῶς\" data-n=\"30\" data-lemma=\"σεμνός\">σεμνῶς\u003C/span>  \u003Cspan data-text=\"τὸν\" data-n=\"35\" data-lemma=\"ὁ\">τὸν\u003C/span>  \u003Cspan data-text=\"βίον\" data-n=\"40\" data-lemma=\"βίος\">βίον\u003C/span>  \u003Cspan data-text=\"ἀνα\n                    διξαμένη\" data-n=\"45\" data-lemma=\"ἀναδείκνυμι\">ἀνα-\u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>διξαμένη\u003C/span> ❦ \u003Cspan data-text=\"φίλανδρος\" data-n=\"55\" data-lemma=\"φίλανδρος\">φίλανδρος\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"ὡς\" data-n=\"60\" data-lemma=\"ὡς\">ὡς\u003C/span>  \u003Cspan data-text=\"οὐτ\" data-n=\"65\" data-lemma=\"οὔτε\">οὐτ\u003C/span>' \u003Cspan data-text=\"ἄλλη\" data-n=\"70\" data-lemma=\"ἄλλος\">ἄλλη\u003C/span>  \u003Cspan data-text=\"γυναικῶν\" data-n=\"75\" data-lemma=\"γυνή\">γυναικῶν\u003C/span>. \u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Εἰρήνα\">\u003Cspan data-text=\"Εἰρήνα\" data-n=\"80\" data-lemma=\"Εἰρήνη\">Εἰρ\u003Cspan class=\"petraeligature\" title=\"Ligature: these characters are joined\">ή͡ν\u003C/span>α\u003C/span>\u003C/span>  \u003Cspan data-text=\"ἔνθαδε\" data-n=\"85\" data-lemma=\"ἔνθαδε\">ἔνθαδε\u003C/span>  \u003Cspan data-text=\"κεῖτε\" data-n=\"90\" data-lemma=\"κεῖμαι\">κεῖτε\u003C/span> ❦ \u003Cspan data-text=\"τέκνοι\n                    σι\" data-n=\"100\" data-lemma=\"τέκνον\">τέκν\u003Cspan class=\"error\" title=\"hi tag with rend=stacked is not supported!\">ο\u003C/span>ι-\u003Cbr id=\"al6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>σι\u003C/span>  \u003Cspan data-text=\"στοργὴν\" data-n=\"105\" data-lemma=\"στοργή\">στοργ\u003Cspan class=\"petraeligature\" title=\"Ligature: these characters are joined\">ὴ͡ν\u003C/span>\u003C/span>  \u003Cspan data-text=\"λαμπρῶς\" data-n=\"110\" data-lemma=\"λαμπρός\">λαμπρῶς\u003C/span>  \u003Cspan data-text=\"εὐνοησα\n                    μένη\" data-n=\"115\" data-lemma=\"εὐνοέω\">εὐνοησα-\u003Cbr id=\"al7-interpretive\">\u003Cspan class=\"linenumber\">7\u003C/span>μέ\u003Cspan class=\"petraeligature\" title=\"Ligature: these characters are joined\">ν͡η\u003C/span>\u003C/span> ❦ \u003Cspan data-text=\"τριακοστῷ\" data-n=\"125\" data-lemma=\"τριακοστός\">τριακοστῷ\u003C/span>  \u003Cspan data-text=\"καὶ\" data-n=\"130\" data-lemma=\"καί\">καὶ\u003C/span>  \u003Cspan data-text=\"δευτέρῳ\" data-n=\"135\" data-lemma=\"δεύτερος\">δευτέρῳ\u003C/span>  \u003Cspan data-text=\"περι\n                    πλεκομένῳ\" data-n=\"140\" data-lemma=\"περιπλέκω\">περι-\u003Cbr id=\"al8-interpretive\">\u003Cspan class=\"linenumber\">8\u003C/span>πλεκομένῳ\u003C/span>  \u003Cspan data-text=\"ἔτι\" data-n=\"145\" data-lemma=\"ἔτι\">ἔτι\u003C/span>  \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Μοίρες\">\u003Cspan data-text=\"Μοίρες\" data-n=\"150\" data-lemma=\"Μοῖρα\">Μοίρες\u003C/span>\u003C/span>  \u003Cspan data-text=\"βουλεύμα\n                    τι\" data-n=\"155\" data-lemma=\"βούλευμα\">βουλεύμα-\u003Cbr id=\"al9-interpretive\">\u003Cspan class=\"linenumber\">9\u003C/span>τι\u003C/span>, \u003Cspan data-text=\"μετὰ\" data-n=\"160\" data-lemma=\"μετά\">μετὰ\u003C/span>  \u003Cspan data-text=\"μεγίστου\" data-n=\"165\" data-lemma=\"μέγας\">μεγίστου\u003C/span>  \u003Cspan data-text=\"κλέους\" data-n=\"170\" data-lemma=\"κλέος\">κλέους\u003C/span>  \u003Cspan data-text=\"τέλος\" data-n=\"175\" data-lemma=\"τέλος\">τέλος\u003C/span>  \u003Cbr id=\"al10-interpretive\">\u003Cspan class=\"linenumber\">10\u003C/span>\u003Cspan data-text=\"ἔλαχεν\" data-n=\"180\" data-lemma=\"λαγχάνω\">ἔλαχεν\u003C/span> ❦ ☧ \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Βωτιβοῖο\">\u003Cspan data-text=\"Βωτιβοῖο\" data-n=\"195\" data-lemma=\"Βωτῖβος\">Βωτιβοῖο\u003C/span>\u003C/span>  \u003Cspan data-text=\"φιλτάλτη\" data-n=\"200\" data-lemma=\"φίλος\">φιλτ&lt;ά&gt;τη\u003C/span> ❦ ☧ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">l.10 ά\u003C/p>",{"author":3,"date":4,"citedRange":338,"ptr":339,"ref":340,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"46-49, 52 ph",{"target":144},{"_":146,"target":146},{"file":342,"uri":342,"title":343,"status":344,"editions":345,"editionAuthor":25,"type":353,"objectType":354,"material":355,"condition":363,"layoutDesc":365,"handNote":371,"date":396,"places":398,"geo":401,"country":87,"provenance":84,"provenanceGeo":403,"region":100,"settlement":84,"repository":406,"idno":407,"textLang":409,"tmNumber":347,"facsimile":411,"letterHeights":414,"publications":430,"zotero":441,"keywords":452,"html":457,"bibl":458,"bulletinDateSort":147,"citedRangeSort":459,"languageSort":109,"materialSort":356,"typeSort":160},"ISic000584","Funerary inscription for Marcus Limbricius and his wife Helvia Arura",{"_":12},[346,348,349,350,352],{"_":347,"type":16},"491841",{"type":18},{"type":20},{"_":351,"type":22},"22100579",{"type":24},{"_":160,"ana":161,"ref":162},{"_":31,"ana":32,"ref":33},{"_":356,"ana":357,"type":358,"subtype":359,"resp":40,"ref":362},"compact white limestone with conchoidal fracture, likely tipo scaglia (SCA, AMM) (wackestone with foraminifera (?) and thin calcite veins) (identification based on pXRF, digital microscopy)","#material.inorganic.stone.sedimentary_rock.limestone.calcilutite.white.calcare-lucidabile_bianco_tipo-scaglia #material.inorganic.stone.sedimentary_rock.limestone.calcilutite.white.calcare-lucidabile_bianco_lattimusa","stone.limestone.polishable.white",[360,361],"calcare_bianco_tipo-scaglia","calcare_bianco_scaglia","http://www.eagle-network.eu/voc/material/lod/66.html",{"ana":364},"#condition.damaged",{"layout":366},{"p":367,"rs":368,"damage":369},"Latin text preserved in full over four lines, vertically centred on the stone, with a vacat below. The first line is the largest, the third line smallest and most compressed.",{"_":55,"ana":56,"ref":57},{"ana":370},"#text_condition.complete",{"lettering":372,"dimensions":373},"The letters are large and simply cut, without serifs. M has hastae of equal length, all off-vertical; S is shallow; R is closed with a long tail extending from the eye; B has small upper eye, closed; V is wide; F has shorter lower bar; E has equal short bars; C is not perfectly curved/circular, but rather shallow. Interpuncts throughout, formed of light vertical strokes.",[374,378,381,384,388,392,394],{"type":65,"l":66,"from":67,"to":67,"h":375,"unit":69,"atLeast":376,"atMost":377},"42-45","42","45",{"type":65,"l":187,"from":75,"to":75,"h":379,"unit":69,"atLeast":380,"atMost":376},"38-42","38",{"type":65,"l":192,"from":193,"to":193,"h":382,"unit":69,"atLeast":383,"atMost":380},"33-38","33",{"type":65,"l":197,"from":198,"to":198,"h":385,"unit":69,"atLeast":386,"atMost":387},"36-40","36","40",{"type":73,"l":232,"from":67,"to":75,"h":389,"unit":69,"atLeast":390,"atMost":391},"17-20