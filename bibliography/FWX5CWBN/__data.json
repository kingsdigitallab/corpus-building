{"type":"data","nodes":[{"type":"data","data":[{"debug":1},true],"uses":{}},{"type":"data","data":[{"zotero":1,"inscriptions":7,"isBulletin":622},{"title":2,"author":3,"date":4,"citation":5,"uri":6},"Sicile","Orsi","1896","\u003Cspan>Paolo Orsi, « Sicile », \u003Ci>Bulletin de Correspondance Hellénique\u003C/i> 20 (1896): 399‑400\u003C/span>","https://www.zotero.org/groups/isicily/items/FWX5CWBN",[8,129,191,289,362,434],{"file":9,"uri":9,"title":10,"status":11,"editions":13,"editionAuthor":24,"type":25,"objectType":29,"material":33,"condition":39,"layoutDesc":40,"handNote":47,"date":63,"places":68,"geo":78,"country":73,"provenance":70,"provenanceGeo":82,"region":85,"settlement":86,"repository":87,"idno":91,"textLang":94,"tmNumber":39,"letterHeights":98,"publications":102,"zotero":106,"keywords":110,"html":121,"bibl":122,"bulletinDateSort":128,"citedRangeSort":123,"languageSort":95,"materialSort":34,"typeSort":26},"ISic001869","Funerary inscription for Artemo",{"_":12},"edited",[14,16,18,20,22],{"type":15},"TM",{"type":17},"EDR",{"type":19},"EDH",{"type":21},"EDCS",{"type":23},"PHI",null,{"_":26,"ana":27,"ref":28},"funerary","#function.funerary","https://ontology.inscriptiones.org/type_of_inscription/Funerary",{"_":30,"ana":31,"ref":32},"block","#object.block","http://www.eagle-network.eu/voc/objtyp/lod/189.html",{"_":34,"type":35,"subtype":36,"ref":38},"limestone","inorganic.stone",[37],"unverified","http://www.eagle-network.eu/voc/material/lod/66.html","",{"layout":41},{"p":42,"rs":43,"damage":39},"Three lines of Greek letters, seemingly not centered / regularly laid out.",{"_":44,"ana":45,"ref":46},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"lettering":48,"dimensions":49},"Described by Orsi (1896) as 'scritto a pessimi caratteri', and (1899) as 'lettere cattive, rustiche cosi che a tutta prima sembrano archaiche, e molto sconservate... L'iscrizione negligentemente redatta e scolpita è funebre di tarda età'. Pace states 'lettere del III sec. av. Cr.', but given the presence of lunate epsilon and Orsi's comments, a later date seems much more likely.",[50,59],{"type":51,"l":52,"from":53,"to":54,"h":55,"unit":56,"atLeast":57,"atMost":58},"letterHeight","Line 1-3","line1","line3","55-95","mm","55","95",{"type":60,"l":61,"from":53,"to":62,"unit":56},"interlinear","Interlineation line 1 to 2","line2",{"_":64,"notBefore":65,"notAfter":66,"evidence":67},"Suggested to be of later Roman date by Orsi on the basis of lettering etc.",101,400,"lettering",[69,74],{"_":70,"type":71,"ref":72,"region":73},"Kamarina","ancient","http://pleiades.stoa.org/places/462126","Sicilia",{"_":75,"type":76,"ref":77,"region":73},"Santa Croce Camerina","modern","http://sws.geonames.org/6540853",[79],[80,81],36.8736,14.4507,[83,84],36.8759983,14.4377781,"Sicily","Siracusa",{"_":88,"role":89,"ref":90},"Museo Archeologico Regionale Paolo Orsi","museum","http://sicily.classics.ox.ac.uk/museum/097",{"_":92,"type":93},"16474","inventory",{"_":95,"mainLang":96,"languages":97},"Ancient Greek","grc",[95],[99],{"atLeast":100,"atMost":101},55,95,[103,104,105],"Orsi, 1896, Sicile","Orsi, 1899, Camarina (Campagna archeologica del 1896)","Pace, 1927, Camarina: topografia, storia, archeologia",[107,108,109],"FWX5CWBN","ICW2M9P2","ZJ6KUFMM",[111,112,113,26,30,34,114,115,116,117,118,119,120,96],"isic001869","funerary inscription for artemo",{"_":12},"kamarina","santa croce camerina","sicilia","sicily","siracusa","museo archeologico regionale paolo orsi","ancient greek","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Ἀρτεμοι\n                    Ἀρτεμιδό\n                    του\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἀρτεμοι\">Ἀρτεμοι̣\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class