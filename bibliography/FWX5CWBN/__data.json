rget":125},{"_":127,"target":127},{"file":287,"uri":287,"title":288,"status":289,"editions":290,"editionAuthor":24,"type":296,"objectType":297,"material":298,"condition":39,"layoutDesc":300,"handNote":304,"date":325,"places":326,"geo":329,"country":73,"provenance":241,"provenanceGeo":331,"region":85,"settlement":86,"repository":332,"idno":333,"textLang":334,"tmNumber":39,"facsimile":336,"letterHeights":338,"publications":349,"zotero":350,"keywords":351,"html":355,"bibl":356,"bulletinDateSort":128,"citedRangeSort":283,"languageSort":95,"materialSort":34,"typeSort":26},"ISic001872","Funerary inscription for Mousa",{"_":12},[291,292,293,294,295],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},{"_":34,"type":207,"resp":208,"ref":38,"subtype":299},[],{"layout":301},{"p":302,"rs":303,"damage":39},"Text over six lines, set in a recessed panel in the style of a temple facade, but without guidelines. Some use of interpuncts and vacats in the text.",{"_":44,"ana":45,"ref":46},{"lettering":305,"dimensions":306},"Text is deeply incised in letters of slightly varying size. Extensive use of serifs, with several letters tending to the cursive. Alpha has straight bar, curving ends; epsilon is lunate with equal length mid-bar; zeta is large and curved; kappa has near full-length arms; mu has slanting strokes that reach the lower line, but often join before the top and have extended upper strokes; pi has overlapping cross bar; rho has closed eye; sigma is lunate. Elegant hedera in line 2; use of vacats in age at death.",[307,310,314,317,318,320,324],{"type":51,"l":161,"from":53,"to":53,"h":308,"unit":56,"atLeast":224,"atMost":309},"25-31","31",{"type":51,"l":222,"from":62,"to":62,"h":311,"unit":56,"atLeast":312,"atMost":313},"20-22","20","22",{"type":51,"l":226,"from":54,"to":54,"h":315,"unit":56,"atLeast":316,"atMost":224},"19-25","19",{"type":51,"l":228,"from":229,"to":229,"h":315,"unit":56,"atLeast":316,"atMost":224},{"type":51,"l":233,"from":234,"to":234,"h":319,"unit":56,"atLeast":316,"atMost":231},"19-21",{"type":51,"l":321,"from":322,"to":322,"h":323,"unit":56,"atLeast":312,"atMost":231},"Line 6","line6","20-21",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":237,"notBefore":65,"notAfter":238,"evidence":67},[327,328],{"_":241,"type":71,"ref":242,"region":73},{"_":86,"type":76,"ref":244,"region":73},[330],[247,248],[250,251],{"_":88,"role":89,"ref":90},{"_":254,"type":93},{"_":95,"mainLang":96,"languages":335},[95],{"n":258,"url":337,"height":260,"width":261,"desc":262,"surfaceType":263},"ISic001872_tiled.tif",[339,341,344,346,347,348],{"atLeast":269,"atMost":340},31,{"atLeast":342,"atMost":343},20,22,{"atLeast":345,"atMost":269},19,{"atLeast":345,"atMost":269},{"atLeast":345,"atMost":272},{"atLeast":342,"atMost":272},[103],[107],[352,353,354,26,203,34,280,118,116,117,118,119,120,96],"isic001872","funerary inscription for mousa",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Μοῦσα\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Μοῦσα\">Μοῦσα\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"χρηστὰ\">χρηστὰ\u003C/span> ❦ \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-text=\"ἄμεμπτε\">ἄμεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"μῆνες\">μῆνες\u003C/span>  \u003Cbr id=\"al6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>ι´ ·\u003Cspan dir=\"ltr\">(vac.1)\u003C/span> ἡμέρας \u003Cspan dir=\"ltr\">(vac.1)\u003C/span> κε´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":283,"ptr":357,"ref":358,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":125},{"_":127,"target":127},{"file":360,"uri":360,"title":361,"status":362,"editions":363,"editionAuthor":24,"type":369,"objectType":370,"material":371,"condition":39,"layoutDesc":373,"handNote":381,"date":398,"places":399,"geo":402,"country":73,"provenance":241,"provenanceGeo":404,"region":85,"settlement":86,"repository":405,"idno":406,"textLang":407,"tmNumber":39,"facsimile":409,"letterHeights":411,"publications":421,"zotero":422,"keywords":423,"html":427,"bibl":428,"bulletinDateSort":128,"citedRangeSort":283,"languageSort":95,"materialSort":34,"typeSort":26},"ISic001873","Funerary inscription for Kopria",{"_":12},[364,365,366,367,368],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},{"_":34,"type":207,"resp":208,"ref":38,"subtype":372},[],{"layout":374},{"p":375,"rs":376,"damage":39},"Text over five lines, neatly respecting gridlines to the base of each line and with marginal lines to left and right - that on the left is approximately followed, that on the right is ignored; an additional gridline below is unused. Some use of interpuncts and vacats in the text. The first line shows clear traces of red paint in the letters.",[377,378],{"_":44,"ana":45,"ref":46},{"_":379,"ana":380},"rubrication, red colour","#execution.rubrication.red",{"lettering":382,"dimensions":383},"Text is incised in fairly tall, thin, neat and plain letters mostly without serifs. Alpha has downward left sloping cross-bar; epsilon is lunate, with shorter and sometimes detached middle bar; zeta is straight; eta sometimes has detached cross-bar (line 4); kapa has short arms; mu has angled strokes, the mid-strokes only descending half-way, and no upward extension of the apexes; omicron is slightly smaller than other letters; pi does not overlap; rho i slcosed; sigma is lunate. Use of a simple/stylised hedera in lines 2 and 4, and letters are somewhat irregularly spaced especially in the final line.",[384,387,391,392,395,397],{"type":51,"l":161,"from":53,"to":53,"h":385,"unit":56,"atLeast":386,"atMost":220},"29-30 (omicron = 20)","29",{"type":51,"l":222,"from":62,"to":62,"h":388,"unit":56,"atLeast":389,"atMost":390},"26-32","26","32",{"type":51,"l":226,"from":54,"to":54,"h":223,"unit":56,"atLeast":224,"atMost":220},{"type":51,"l":228,"from":229,"to":229,"h":393,"unit":56,"atLeast":394,"atMost":220},"24-30","24",{"type":51,"l":233,"from":234,"to":234,"h":396,"unit":56,"atLeast":313,"atMost":390},"22-32",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":237,"notBefore":65,"notAfter":238,"evidence":67},[400,401],{"_":241,"type":71,"ref":242,"region":73},{"_":86,"type":76,"ref":244,"region":73},[403],[247,248],[250,251],{"_":88,"role":89,"ref":90},{"_":254,"type":93},{"_":95,"mainLang":96,"languages":408},[95],{"n":258,"url":410,"height":260,"width":261,"desc":262,"surfaceType":263},"ISic001873_tiled.tif",[412,414,417,418,420],{"atLeast":413,"atMost":267},29,{"atLeast":415,"atMost":416},26,32,{"atLeast":269,"atMost":267},{"atLeast":419,"atMost":267},24,{"atLeast":343,"atMost":416},[103],[107],[424,425,426,26,203,34,280,118,116,117,118,119,120,96],"isic001873","funerary inscription for kopria",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Κοπρία\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Κοπρία\">Κοπρία\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"χρηστὰ\">χρηστὰ\u003C/span> ❦ \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-text=\"ἄμεμπτε\">ἄμεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span> ❦ \u003Cspan data-text=\"ἔζη\n                    σεν\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σεν\u003C/span>  \u003Cspan data-text=\"ἔτη\">ἔτη\u003C/span> λ´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":283,"ptr":429,"ref":430,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":125},{"_":127,"target":127},{"file":432,"uri":432,"title":433,"status":434,"editions":435,"editionAuthor":24,"type":444,"objectType":448,"material":452,"condition":39,"layoutDesc":455,"handNote":459,"date":562,"places":567,"geo":570,"country":73,"provenance":241,"provenanceGeo":572,"region":85,"settlement":86,"repository":575,"idno":576,"textLang":578,"tmNumber":437,"facsimile":580,"letterHeights":583,"publications":591,"zotero":599,"keywords":607,"html":611,"bibl":612,"bulletinDateSort":128,"citedRangeSort":283,"languageSort":95,"materialSort":34,"typeSort":445},"ISic003331","The Syracusans honour King Gelon, son of Hieron II",{"_":12},[436,438,440,441,443],{"_":437,"type":15},"285063",{"_":439,"type":17},"114426",{"type":19},{"_":442,"type":21},"64900709",{"type":23},{"_":445,"ana":446,"ref":447},"honorific","#function.honorific","https://ontology.inscriptiones.org/type_of_inscription/Honorific",{"_":449,"ana":450,"ref":451},"base","#object.base","http://www.eagle-network.eu/voc/objtyp/lod/57.html",{"_":34,"type":453,"resp":208,"ref":38,"subtype":454},"stone.calcite_limestone",[],{"layout":456},{"p":457,"rs":458,"damage":39},"Three lines