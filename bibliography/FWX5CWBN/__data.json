ions":159},"Presented as clearly incised archaic letters",[160,162],{"type":51,"l":161,"from":53,"to":53,"unit":56},"Line 1",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":164,"notBefore":165,"notAfter":166,"evidence":67},"Archaic, on the basis of the lettering.",-600,-501,[168,169],{"_":70,"type":71,"ref":72,"region":73},{"_":75,"type":76,"ref":77,"region":73},[171],[80,81],[173,174],36.8729563,14.4421611,{"_":88,"role":89,"ref":90},{"_":177,"type":93},"16484",{"_":95,"mainLang":96,"languages":179},[95],[],[103,104,105],[107,108,109],[184,185,186,140,144,148,114,115,116,117,118,119,120,96],"isic001870","inscribed fragment of a marble basin",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΘΟΝΙ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":123,"ptr":189,"ref":190,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":125},{"_":127,"target":127},{"file":192,"uri":192,"title":193,"status":194,"editions":195,"editionAuthor":24,"type":201,"objectType":202,"material":206,"condition":39,"layoutDesc":213,"handNote":217,"date":239,"places":242,"geo":248,"country":73,"provenance":244,"provenanceGeo":252,"region":85,"settlement":86,"repository":255,"idno":256,"textLang":258,"tmNumber":39,"facsimile":260,"letterHeights":267,"publications":277,"zotero":278,"keywords":279,"html":284,"bibl":285,"bulletinDateSort":128,"citedRangeSort":286,"languageSort":95,"materialSort":34,"typeSort":26},"ISic001871","Funerary inscription for Gamike",{"_":12},[196,197,198,199,200],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259",{"_":34,"ana":207,"type":208,"subtype":209,"resp":212,"ref":38},"#material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-orientali #material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-occidentali","stone.limestone.non-polishable.whitish",[210,211],"calcarenite_ibleiOR","calcarenite_ibleiOCC","#Coccato",{"layout":214},{"p":215,"rs":216,"damage":39},"Text over five lines, carefully following guidelines to the base of each line, with a marginal guideline to the left and right, with the left margin consistently observed. An additional guideline below is unused; the guidelines carefully align with the text to the right of this one. Use of a vacat prior to the age at death.",{"_":44,"ana":45,"ref":46},{"lettering":218,"dimensions":219},"Deep and wide slightly crude v-cut, producing consistent fairly square letters without serifs. Alpha has mostly downward left sloping cross-bar; epsilon is lunate with mostly shorter middle bar; zeta has slight curvature to the strokes; kappa has short arms; mu has four full-length diagonal strokes; lunate sigma, but note final square lunate for digamma / stigma for numeral 6.",[220,224,228,230,235,238],{"type":51,"l":161,"from":53,"to":53,"h":221,"unit":56,"atLeast":222,"atMost":223},"27-30","27","30",{"type":51,"l":225,"from":62,"to":62,"h":226,"unit":56,"atLeast":227,"atMost":223},"Line 2","25-30","25",{"type":51,"l":229,"from":54,"to":54,"h":226,"unit":56,"atLeast":227,"atMost":223},"Line 3",{"type":51,"l":231,"from":232,"to":232,"h":233,"unit":56,"atLeast":234,"atMost":223},"Line 4","line4","21-30","21",{"type":51,"l":236,"from":237,"to":237,"h":226,"unit":56,"atLeast":227,"atMost":223},"Line 5","line5",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":240,"notBefore":65,"notAfter":241,"evidence":67},"Roman imperial in date",300,[243,246],{"_":244,"type":71,"ref":245,"region":73},"Syracusae","http://pleiades.stoa.org/places/462503",{"_":86,"type":76,"ref":247,"region":73},"http://sws.geonames.org/2523083",[249],[250,251],37.08415,15.27628,[253,254],37.0784545,15.2786827,{"_":88,"role":89,"ref":90},{"_":257,"type":93},"15083",{"_":95,"mainLang":96,"languages":259},[95],{"n":261,"url":262,"height":263,"width":264,"desc":265,"surfaceType":266},"screen","ISic001871_tiled.tif","3680px","5520px","I.Sicily with the permission of the Parco archeologico e paesaggistico di Siracusa, Eloro, Villa del Tellaro e Akrai, and the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2022-04-29.","front",[268,271,273,274,276],{"atLeast":269,"atMost":270},27,30,{"atLeast":272,"atMost":270},25,{"atLeast":272,"atMost":270},{"atLeast":275,"atMost":270},21,{"atLeast":272,"atMost":270},[103],[107],[280,281,282,26,203,34,283,118,116,117,118,119,120,96],"isic001871","funerary inscription for gamike",{"_":12},"syracusae","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Γαμική\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Γαμική\">Γαμική\u003C/span>\u003C/span>  \u003Cspan data-text=\"χρη\n                    στὰ\">χρη-\u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>στὰ\u003C/span>  \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cspan data-text=\"ἄ\n                    μεμπτε\">ἄ-\u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>μεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔτη\">ἔτη\u003C/span> κς´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":286,"ptr":287,"ref":288,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"400",{"target":125},{"_":127,"target":127},{"file":290,"uri":290,"title":291,"status":292,"editions":293,"editionAuthor":24,"type":299,"objectType":300,"material":301,"condition":39,"layoutDesc":303,"handNote":307,"date":328,"places":329,"geo":332,"country":73,"provenance":244,"provenanceGeo":334,"region":85,"settlement":86,"repository":335,"idno":336,"textLang":337,"tmNumber":39,"facsimile":339,"letterHeights":341,"publications":352,"zotero":353,"keywords":354,"html":358,"bibl":359,"bulletinDateSort":128,"citedRangeSort":286,"languageSort":95,"materialSort":34,"typeSort":26},"ISic001872","Funerary inscription for Mousa",{"_":12},[294,295,296,297,298],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},{"_":34,"ana":207,"type":208,"subtype":302,"resp":212,"ref":38},[210,211],{"layout":304},{"p":305,"rs":306,"damage":39},"Text over six lines, set in a recessed panel in the style of a temple facade, but without guidelines. Some use of interpuncts and vacats in the text.",{"_":44,"ana":45,"ref":46},{"lettering":308,"dimensions":309},"Text is deeply incised in letters of slightly varying size. Extensive use of serifs, with several letters tending to the cursive. Alpha has straight bar, curving ends; epsilon is lunate with equal length mid-bar; zeta is large and curved; kappa has near full-length arms; mu has slanting strokes that reach the lower line, but often join before the top and have extended upper strokes; pi has overlapping cross bar; rho has closed eye; sigma is lunate. Elegant hedera in line 2; use of vacats in age at death.",[310,313,317,320,321,323,327],{"type":51,"l":161,"from":53,"to":53,"h":311,"unit":56,"atLeast":227,"atMost":312},"25-31","31",{"type":51,"l":225,"from":62,"to":62,"h":314,"unit":56,"atLeast":315,"atMost":316},"20-22","20","22",{"type":51,"l":229,"from":54,"to":54,"h":318,"unit":56,"atLeast":319,"atMost":227},"19-25","19",{"type":51,"l":231,"from":232,"to":232,"h":318,"unit":56,"atLeast":319,"atMost":227},{"type":51,"l":236,"from":237,"to":237,"h":322,"unit":56,"atLeast":319,"atMost":234},"19-21",{"type":51,"l":324,"from":325,"to":325,"h":326,"unit":56,"atLeast":315,"atMost":234},"Line 6","line6","20-21",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":240,"notBefore":65,"notAfter":241,"evidence":67},[330,331],{"_":244,"type":71,"ref":245,"region":73},{"_":86,"type":76,"ref":247,"region":73},[333],[250,251],[253,254],{"_":88,"role":89,"ref":90},{"_":257,"type":93},{"_":95,"mainLang":96,"languages":338},[95],{"n":261,"url":340,"height":263,"width":264,"desc":265,"surfaceType":266},"ISic001872_tiled.tif",[342,344,347,349,350,351],{"atLeast":272,"atMost":343},31,{"atLeast":345,"atMost":346},20,22,{"atLeast":348,"atMost":272},19,{"atLeast":348,"atMost":272},{"atLeast":348,"atMost":275},{"atLeast":345,"atMost":275},[103],[107],[355,356,357,26,203,34,283,118,116,117,118,119,120,96],"isic001872","funerary inscription for mousa",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Μοῦσα\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Μοῦσα\">Μοῦσα\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"χρηστὰ\">χρηστὰ\u003C/span> ❦ \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-text=\"ἄμεμπτε\">ἄμεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"μῆνες\">μῆνες\u003C/span>  \u003Cbr id=\"al6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>ι´ ·\u003Cspan dir=\"ltr\">(vac.1)\u003C/span> ἡμέρας \u003Cspan dir=\"ltr\">(vac.1)\u003C/span> κε´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":286,"ptr":360,"ref":361,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":125},{"_":127,"target":127},{"file":363,"uri":363,"title":364,"status":365,"editions":366,"editionAuthor":24,"type":372,"objectType":373,"material":374,"condition":39,"layoutDesc":376,"handNote":384,"date":401,"places":402,"geo":405,"country":73,"provenance":244,"provenanceGeo":407,"region":85,"settlement":86,"repository":408,"idno":409,"textLang":410,"tmNumber":39,"facsimile":412,"letterHeights":414,"publications":424,"zotero":425,"keywords":426,"html":430,"bibl":431,"bulletinDateSort":128,"citedRangeSort":286,"languageSort":95,"materialSort":34,"typeSort":26},"ISic001873","Funerary inscription for Kopria",{"_":12},[367,368,369,370,371],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},{"_":34,"ana":207,"type":208,"subtype":375,"resp":212,"ref":38},[210,211],{"layout":377},{"p":378,"rs":379,"damage":39},"Text over five lines, neatly respecting gridlines to the base of each line and with marginal lines to left and right - that on the left is approximately followed, that on the right is ignored; an additional gridline below is unused. Some use of interpuncts and vacats in the text. The first line shows clear traces of red paint in the letters.",[380,381],{"_":44,"ana":45,"ref":46},{"_":382,"ana":383},"rubrication, red colour","#execution.rubrication.red",{"lettering":385,"dimensions":386},"Text is incised in fairly tall, thin, neat and plain letters mostly without serifs. Alpha has downward left sloping cross-bar; epsilon is lunate, with shorter and sometimes detached middle bar; zeta is straight; eta sometimes has detached cross-bar (line 4); kapa has short arms; mu has angled strokes, the mid-strokes only descending half-way, and no upward extension of the apexes; omicron is slightly smaller than other letters; pi does not overlap; rho i slcosed; sigma is lunate. Use of a simple/stylised hedera in lines 2 and 4, and letters are somewhat irregularly spaced especially in the final line.",[387,390,394,395,398,400],{"type":51,"l":161,"from":53,"to":53,"h":388,"unit":56,"atLeast":389,"atMost":223},"29-30 (omicron = 20)","29",{"type":51,"l":225,"from":62,"to":62,"h":391,"unit":56,"atLeast":392,"atMost":393},"26-32","26","32",{"type":51,"l":229,"from":54,"to":54,"h":226,"unit":56,"atLeast":227,"atMost":223},{"type":51,"l":231,"from":232,"to":232,"h":396,"unit":56,"atLeast":397,"atMost":223},"24-30","24",{"type":51,"l":236,"from":237,"to":237,"h":399,"unit":56,"atLeast":316,"atMost":393},"22-32",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":240,"notBefore":65,"notAfter":241,"evidence":67},[403,404],{"_":244,"type":71,"ref":245,"region":73},{"_":86,"type":76,"ref":247,"region":73},[406],[250,251],[253,254],{"_":88,"role":89,"ref":90},{"_":257,"type":93},{"_":95,"mainLang":96,"languages":411},[95],{"n":261,"url":413,"height":263,"width":264,"desc":265,"surfaceType":266},"ISic001873_tiled.tif",[415,417,420,421,423],{"atLeast":416,"atMost":270},29,{"atLeast":418,"atMost":419},26,32,{"atLeast":272,"atMost":270},{"atLeast":422,"atMost":270},24,{"atLeast":346,"atMost":419},[103],[107],[427,428,429,26,203,34,283,118,116,117,118,119,120,96],"isic001873","funerary inscription for kopria",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-in