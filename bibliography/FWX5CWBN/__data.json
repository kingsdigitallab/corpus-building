ions":159},"Presented as clearly incised archaic letters",[160,162],{"type":51,"l":161,"from":53,"to":53,"unit":56},"Line 1",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":164,"notBefore":165,"notAfter":166,"evidence":67},"Archaic, on the basis of the lettering.",-600,-501,[168,169],{"_":70,"type":71,"ref":72,"region":73},{"_":75,"type":76,"ref":77,"region":73},[171],[80,81],[173,174],36.8729563,14.4421611,{"_":88,"role":89,"ref":90},{"_":177,"type":93},"16484",{"_":95,"mainLang":96,"languages":179},[95],[],[103,104,105],[107,108,109],[184,185,186,140,144,148,114,115,116,117,118,119,120,96],"isic001870","inscribed fragment of a marble basin",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΘΟΝΙ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":123,"ptr":189,"ref":190,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":125},{"_":127,"target":127},{"file":192,"uri":192,"title":193,"status":194,"editions":195,"editionAuthor":24,"type":201,"objectType":202,"material":206,"condition":39,"layoutDesc":214,"handNote":218,"date":240,"places":243,"geo":249,"country":73,"provenance":245,"provenanceGeo":253,"region":85,"settlement":86,"repository":256,"idno":257,"textLang":259,"tmNumber":39,"facsimile":261,"letterHeights":268,"publications":278,"zotero":279,"keywords":280,"html":286,"bibl":287,"bulletinDateSort":128,"citedRangeSort":288,"languageSort":95,"materialSort":207,"typeSort":26},"ISic001871","Funerary inscription for Gamike",{"_":12},[196,197,198,199,200],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259",{"_":207,"ana":208,"type":209,"subtype":210,"resp":213,"ref":38},"whitish soft calcarenite, likely calcarenite degli Iblei (sand-grade limestone) (identification based on pXRF, digital microscopy)","#material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-orientali #material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-occidentali","stone.limestone.non-polishable.whitish",[211,212],"calcarenite_ibleiOR","calcarenite_ibleiOCC","#Coccato",{"layout":215},{"p":216,"rs":217,"damage":39},"Text over five lines, carefully following guidelines to the base of each line, with a marginal guideline to the left and right, with the left margin consistently observed. An additional guideline below is unused; the guidelines carefully align with the text to the right of this one. Use of a vacat prior to the age at death.",{"_":44,"ana":45,"ref":46},{"lettering":219,"dimensions":220},"Deep and wide slightly crude v-cut, producing consistent fairly square letters without serifs. Alpha has mostly downward left sloping cross-bar; epsilon is lunate with mostly shorter middle bar; zeta has slight curvature to the strokes; kappa has short arms; mu has four full-length diagonal strokes; lunate sigma, but note final square lunate for digamma / stigma for numeral 6.",[221,225,229,231,236,239],{"type":51,"l":161,"from":53,"to":53,"h":222,"unit":56,"atLeast":223,"atMost":224},"27-30","27","30",{"type":51,"l":226,"from":62,"to":62,"h":227,"unit":56,"atLeast":228,"atMost":224},"Line 2","25-30","25",{"type":51,"l":230,"from":54,"to":54,"h":227,"unit":56,"atLeast":228,"atMost":224},"Line 3",{"type":51,"l":232,"from":233,"to":233,"h":234,"unit":56,"atLeast":235,"atMost":224},"Line 4","line4","21-30","21",{"type":51,"l":237,"from":238,"to":238,"h":227,"unit":56,"atLeast":228,"atMost":224},"Line 5","line5",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":241,"notBefore":65,"notAfter":242,"evidence":67},"Roman imperial in date",300,[244,247],{"_":245,"type":71,"ref":246,"region":73},"Syracusae","http://pleiades.stoa.org/places/462503",{"_":86,"type":76,"ref":248,"region":73},"http://sws.geonames.org/2523083",[250],[251,252],37.08415,15.27628,[254,255],37.0784545,15.2786827,{"_":88,"role":89,"ref":90},{"_":258,"type":93},"15083",{"_":95,"mainLang":96,"languages":260},[95],{"n":262,"url":263,"height":264,"width":265,"desc":266,"surfaceType":267},"screen","ISic001871_tiled.tif","3680px","5520px","I.Sicily with the permission of the Parco archeologico e paesaggistico di Siracusa, Eloro, Villa del Tellaro e Akrai, and the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2022-04-29.","front",[269,272,274,275,277],{"atLeast":270,"atMost":271},27,30,{"atLeast":273,"atMost":271},25,{"atLeast":273,"atMost":271},{"atLeast":276,"atMost":271},21,{"atLeast":273,"atMost":271},[103],[107],[281,282,283,26,203,284,285,118,116,117,118,119,120,96],"isic001871","funerary inscription for gamike",{"_":12},"whitish soft calcarenite, likely calcarenite degli iblei (sand-grade limestone) (identification based on pxrf, digital microscopy)","syracusae","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Γαμική\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Γαμική\">Γαμική\u003C/span>\u003C/span>  \u003Cspan data-text=\"χρη\n                    στὰ\">χρη-\u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>στὰ\u003C/span>  \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cspan data-text=\"ἄ\n                    μεμπτε\">ἄ-\u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>μεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔτη\">ἔτη\u003C/span> κς´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":288,"ptr":289,"ref":290,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"400",{"target":125},{"_":127,"target":127},{"file":292,"uri":292,"title":293,"status":294,"editions":295,"editionAuthor":24,"type":301,"objectType":302,"material":303,"condition":39,"layoutDesc":305,"handNote":309,"date":330,"places":331,"geo":334,"country":73,"provenance":245,"provenanceGeo":336,"region":85,"settlement":86,"repository":337,"idno":338,"textLang":339,"tmNumber":39,"facsimile":341,"letterHeights":343,"publications":354,"zotero":355,"keywords":356,"html":360,"bibl":361,"bulletinDateSort":128,"citedRangeSort":288,"languageSort":95,"materialSort":207,"typeSort":26},"ISic001872","Funerary inscription for Mousa",{"_":12},[296,297,298,299,300],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},{"_":207,"ana":208,"type":209,"subtype":304,"resp":213,"ref":38},[211,212],{"layout":306},{"p":307,"rs":308,"damage":39},"Text over six lines, set in a recessed panel in the style of a temple facade, but without guidelines. Some use of interpuncts and vacats in the text.",{"_":44,"ana":45,"ref":46},{"lettering":310,"dimensions":311},"Text is deeply incised in letters of slightly varying size. Extensive use of serifs, with several letters tending to the cursive. Alpha has straight bar, curving ends; epsilon is lunate with equal length mid-bar; zeta is large and curved; kappa has near full-length arms; mu has slanting strokes that reach the lower line, but often join before the top and have extended upper strokes; pi has overlapping cross bar; rho has closed eye; sigma is lunate. Elegant hedera in line 2; use of vacats in age at death.",[312,315,319,322,323,325,329],{"type":51,"l":161,"from":53,"to":53,"h":313,"unit":56,"atLeast":228,"atMost":314},"25-31","31",{"type":51,"l":226,"from":62,"to":62,"h":316,"unit":56,"atLeast":317,"atMost":318},"20-22","20","22",{"type":51,"l":230,"from":54,"to":54,"h":320,"unit":56,"atLeast":321,"atMost":228},"19-25","19",{"type":51,"l":232,"from":233,"to":233,"h":320,"unit":56,"atLeast":321,"atMost":228},{"type":51,"l":237,"from":238,"to":238,"h":324,"unit":56,"atLeast":321,"atMost":235},"19-21",{"type":51,"l":326,"from":327,"to":327,"h":328,"unit":56,"atLeast":317,"atMost":235},"Line 6","line6","20-21",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":241,"notBefore":65,"notAfter":242,"evidence":67},[332,333],{"_":245,"type":71,"ref":246,"region":73},{"_":86,"type":76,"ref":248,"region":73},[335],[251,252],[254,255],{"_":88,"role":89,"ref":90},{"_":258,"type":93},{"_":95,"mainLang":96,"languages":340},[95],{"n":262,"url":342,"height":264,"width":265,"desc":266,"surfaceType":267},"ISic001872_tiled.tif",[344,346,349,351,352,353],{"atLeast":273,"atMost":345},31,{"atLeast":347,"atMost":348},20,22,{"atLeast":350,"atMost":273},19,{"atLeast":350,"atMost":273},{"atLeast":350,"atMost":276},{"atLeast":347,"atMost":276},[103],[107],[357,358,359,26,203,284,285,118,116,117,118,119,120,96],"isic001872","funerary inscription for mousa",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Μοῦσα\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Μοῦσα\">Μοῦσα\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"χρηστὰ\">χρηστὰ\u003C/span> ❦ \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-text=\"ἄμεμπτε\">ἄμεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"μῆνες\">μῆνες\u003C/span>  \u003Cbr id=\"al6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>ι´ ·\u003Cspan dir=\"ltr\">(vac.1)\u003C/span> ἡμέρας \u003Cspan dir=\"ltr\">(vac.1)\u003C/span> κε´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":288,"ptr":362,"ref":363,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":125},{"_":127,"target":127},{"file":365,"uri":365,"title":366,"status":367,"editions":368,"editionAuthor":24,"type":374,"objectType":375,"material":376,"condition":39,"layoutDesc":378,"handNote":386,"date":403,"places":404,"geo":407,"country":73,"provenance":245,"provenanceGeo":409,"region":85,"settlement":86,"repository":410,"idno":411,"textLang":412,"tmNumber":39,"facsimile":414,"letterHeights":416,"publications":426,"zotero":427,"keywords":428,"html":432,"bibl":433,"bulletinDateSort":128,"citedRangeSort":288,"languageSort":95,"materialSort":207,"typeSort":26},"ISic001873","Funerary inscription for Kopria",{"_":12},[369,370,371,372,373],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},{"_":207,"ana":208,"type":209,"subtype":377,"resp":213,"ref":38},[211,212],{"layout":379},{"p":380,"rs":381,"damage":39},"Text over five lines, neatly respecting gridlines to the base of each line and with marginal lines to left and right - that on the left is approximately followed, that on the right is ignored; an additional gridline below is unused. Some use of interpuncts and vacats in the text. The first line shows clear traces of red paint in the letters.",[382,383],{"_":44,"ana":45,"ref":46},{"_":384,"ana":385},"rubrication, red colour","#execution.rubrication.red",{"lettering":387,"dimensions":388},"Text is incised in fairly tall, thin, neat and plain letters mostly without serifs. Alpha has downward left sloping cross-bar; epsilon is lunate, with shorter and sometimes detached middle bar; zeta is straight; eta sometimes has detached cross-bar (line 4); kapa has short arms; mu has angled strokes, the mid-strokes only descending half-way, and no upward extension of the apexes; omicron is slightly smaller than other letters; pi does not overlap; rho i slcosed; sigma is lunate. Use of a simple/stylised hedera in lines 2 and 4, and letters are somewhat irregularly spaced especially in the final line.",[389,392,396,397,400,402],{"type":51,"l":161,"from":53,"to":53,"h":390,"unit":56,"atLeast":391,"atMost":224},"29-30 (omicron = 20)","29",{"type":51,"l":226,"from":62,"to":62,"h":393,"unit":56,"atLeast":394,"atMost":395},"26-32","26","32",{"type":51,"l":230,"from":54,"to":54,"h":227,"unit":56,"atLeast":228,"atMost":224},{"type":51,"l":232,"from":233,"to":233,"h":398,"unit":56,"atLeast":399,"atMost":224},"24-30","24",{"type":51,"l":237,"from":238,"to":238,"h":401,"unit":56,"atLeast":318,"atMost":395},"22-32",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":241,"notBefore":65,"notAfter":242,"evidence":67},[405,406],{"_":245,"type":71,"ref":246,"region":73},{"_":86,"type":76,"ref":248,"region":73},[408],[251,252],[254,255],{"_":88,"role":89,"ref":90},{"_":258,"type":93},{"_":95,"mainLang":96,"languages":413},[95],{"n":262,"url":415,"height":264,"width":265,"desc":266,"surfaceType":267},"ISic001873_tiled.tif",[417,419,422,423,425],{"atLeast":418,"atMost":271},29,{"atLeast":420,"atMost":421},26,32,{"atLeast":273,"a