η\n                    σεν\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σεν\u003C/span>  \u003Cspan data-text=\"ἔτη\">ἔτη\u003C/span> λ´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":298,"ptr":450,"ref":451,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":133},{"_":135,"target":135},{"file":453,"uri":453,"title":454,"status":455,"editions":456,"editionAuthor":24,"type":465,"objectType":469,"material":473,"condition":40,"layoutDesc":492,"handNote":496,"date":600,"places":605,"geo":608,"country":74,"provenance":257,"provenanceGeo":610,"region":86,"settlement":87,"repository":613,"idno":614,"textLang":616,"tmNumber":458,"facsimile":618,"letterHeights":621,"publications":629,"zotero":637,"keywords":645,"html":650,"bibl":651,"bulletinDateSort":136,"citedRangeSort":298,"languageSort":96,"materialSort":474,"typeSort":466},"ISic003331","The Syracusans honour King Gelon, son of Hieron II",{"_":12},[457,459,461,462,464],{"_":458,"type":15},"285063",{"_":460,"type":17},"114426",{"type":19},{"_":463,"type":21},"64900709",{"type":23},{"_":466,"ana":467,"ref":468},"honorific","#function.honorific","https://ontology.inscriptiones.org/type_of_inscription/Honorific",{"_":470,"ana":471,"ref":472},"base","#object.base","http://www.eagle-network.eu/voc/objtyp/lod/57.html",{"_":474,"ana":475,"type":476,"subtype":477,"resp":221,"ref":39,"placeName":479,"note":489},"light grey limestone with fine white veins, likely calcare di Taormina (DOA) (dolomitised ooidal/peloidal grainstone with sparite veins) (identification based on pXRF, digital microscopy, XRD, optical microscopy)\n","#material.inorganic.stone.sedimentary_rock.limestone.calcite_limestone.grey.calcare-lucidabile_grigio_sicilia-orientale","stone.limestone.polishable.grey",[478],"calcare_grigio_SiciliaOR_taormina",{"type":480,"ref":481,"location":484},"provenance",{"_":482,"target":483},"Taormina","https://www.geona