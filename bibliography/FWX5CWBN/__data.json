"type":21},{"type":23},{"_":148,"ana":149,"ref":150},"dedication","#function.dedication","https://ontology.inscriptiones.org/type_of_inscription/Dedication",{"_":152,"ana":153,"ref":154},"basin","#object.basin","https://www.eagle-network.eu/voc/objtyp/lod/144.html",{"_":156,"ana":157,"type":158,"subtype":159,"ref":160},"marble","#material.inorganic.stone.metamorphic_rock.marble","stone.marble",[38],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":162},{"p":163,"rs":164,"damage":40},"Single line of letters on the outward facing side of the rim.",{"_":45,"ana":46,"ref":47},{"lettering":166,"dimensions":167},"Presented as clearly incised archaic letters",[168,170],{"type":52,"l":169,"from":54,"to":54,"unit":57},"Line 1",{"type":61,"l":62,"from":54,"to":63,"unit":57},{"_":172,"notBefore":173,"notAfter":174,"evidence":68},"Archaic, on the basis of the lettering.",-600,-501,[176,177],{"_":71,"type":72,"ref":73,"region":74},{"_":76,"type":77,"ref":78,"region":74},[179],[81,82],[181,182],36.8729563,14.4421611,{"_":89,"role":90,"ref":91},{"_":185,"type":94},"16484",{"_":96,"mainLang":97,"languages":187},[96],[],[111,112,113],[115,116,117],[192,193,194,148,152,156,122,123,124,125,126,127,128,97],"isic001870","inscribed fragment of a marble basin",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΘΟΝΙ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":131,"ptr":197,"ref":198,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":133},{"_":135,"target":135},{"file":200,"uri":200,"title":201,"status":202,"editions":203,"editionAuthor":24,"type":209,"objectType":210,"material":214,"condition":40,"layoutDesc":226,"handNote":230,"date":252,"places":255,"geo":261,"country":74,"provenance":257,"provenanceGeo":265,"region":86,"settlement":87,"repository":268,"idno":269,"textLang":271,"tmNumber":40,"facsimile":273,"letterHeights":278,"publications":288,"zotero":289,"keywords":290,"html":296,"bibl":297,"bulletinDateSort":136,"citedRangeSort":298,"languageSort":96,"materialSort":215,"typeSort":26},"ISic001871","Funerary inscription for Gamike",{"_":12},[204,205,206,207,208],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":211,"ana":212,"ref":213},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259",{"_":215,"ana":216,"type":217,"subtype":218,"resp":221,"ref":39,"note":222},"whitish soft calcarenite, likely calcarenite degli Iblei (sand-grade limestone) (identification based on pXRF, digital microscopy)","#material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-orientali #material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-occidentali","stone.limestone.non-polishable.whitish",[219,220],"calcarenite_ibleiOR","calcarenite_ibleiOCC","#Coccato",{"_":223,"ref":224}," Petrographic imagery at ",{"_":225,"target":225},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic001871",{"layout":227},{"p":228,"rs":229,"damage":40},"Text over five lines, carefully following guidelines to the base of each line, with a marginal guideline to the left and right, with the left margin consistently observed. An additional guideline below is unused; the guidelines carefully align with the text to the right of this one. Use of a vacat prior to the age at death.",{"_":45,"ana":46,"ref":47},{"lettering":231,"dimensions":232},"Deep and wide slightly crude v-cut, producing consistent fairly square letters without serifs. Alpha has mostly downward left sloping cross-bar; epsilon is lunate with mostly shorter middle bar; zeta has slight curvature to the strokes; kappa has short arms; mu has four full-length diagonal strokes; lunate sigma, but note final square lunate for digamma / stigma for numeral 6.",[233,237,241,243,248,251],{"type":52,"l":169,"from":54,"to":54,"h":234,"unit":57,"atLeast":235,"atMost":236},"27-30","27","30",{"type":52,"l":238,"from":63,"to":63,"h":239,"unit":57,"atLeast":240,"atMost":236},"Line 2","25-30","25",{"type":52,"l":242,"from":55,"to":55,"h":239,"unit":57,"atLeast":240,"atMost":236},"Line 3",{"type":52,"l":244,"from":245,"to":245,"h":246,"unit":57,"atLeast":247,"atMost":236},"Line 4","line4","21-30","21",{"type":52,"l":249,"from":250,"to":250,"h":239,"unit":57,"atLeast":240,"atMost":236},"Line 5","line5",{"type":61,"l":62,"from":54,"to":63,"unit":57},{"_":253,"notBefore":66,"notAfter":254,"evidence":68},"Roman imperial in date",300,[256,259],{"_":257,"type":72,"ref":258,"region":74},"Syracusae","http://pleiades.stoa.org/places/462503",{"_":87,"type":77,"ref":260,"region":74},"http://sws.geonames.org/2523083",[262],[263,264],37.08415,15.27628,[266,267],37.0784545,15.2786827,{"_":89,"role":90,"ref":91},{"_":270,"type":94},"15083",{"_":96,"mainLang":97,"languages":272},[96],{"n":100,"url":274,"height":275,"width":276,"desc":277,"surfaceType":105},"ISic001871_tiled.tif","3680px","5520px","I.Sicily with the permission of the Parco archeologico e paesaggistico di Siracusa, Eloro, Villa del Tellaro e Akrai, and the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2022-04-29.",[279,282,284,285,287],{"atLeast":280,"atMost":281},27,30,{"atLeast":283,"atMost":281},25,{"atLeast":283,"atMost":281},{"atLeast":286,"atMost":281},21,{"atLeast":283,"atMost":281},[111],[115],[291,292,293,26,211,294,295,126,124,125,126,127,128,97],"isic001871","funerary inscription for gamike",{"_":12},"whitish soft calcarenite, likely calcarenite degli iblei (sand-grade limestone) (identification based on pxrf, digital microscopy)","syracusae","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Γαμική\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Γαμική\">Γαμική\u003C/span>\u003C/span>  \u003Cspan data-text=\"χρη\n                    στὰ\">χρη-\u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>στὰ\u003C/span>  \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cspan data-text=\"ἄ\n                    μεμπτε\">ἄ-\u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>μεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔτη\">ἔτη\u003C/span> κς´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":298,"ptr":299,"ref":300,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"400",{"target":133},{"_":135,"target":135},{"file":302,"uri":302,"title":303,"status":304,"editions":305,"editionAuthor":24,"type":311,"objectType":312,"material":313,"condition":40,"layoutDesc":318,"handNote":322,"date":343,"places":344,"geo":347,"country":74,"provenance":257,"provenanceGeo":349,"region":86,"settlement":87,"repository":350,"idno":351,"textLang":352,"tmNumber":40,"facsimile":354,"letterHeights":356,"publications":367,"zotero":368,"keywords":369,"html":373,"bibl":374,"bulletinDateSort":136,"citedRangeSort":298,"languageSort":96,"materialSort":215,"typeSort":26},"ISic001872","Funerary inscription for Mousa",{"_":12},[306,307,308,309,310],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":211,"ana":212,"ref":213},{"_":215,"ana":216,"type":217,"subtype":314,"resp":221,"ref":39,"note":315},[219,220],{"_":223,"ref":316},{"_":317,"target":317},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic001872",{"layout":319},{"p":320,"rs":321,"damage":40},"Text over six lines, set in a recessed panel in the style of a temple facade, but without guidelines. Some use of interpuncts and vacats in the text.",{"_":45,"ana":46,"ref":47},{"lettering":323,"dimensions":324},"Text is deeply incised in letters of slightly varying size. Extensive use of serifs, with several letters tending to the cursive. Alpha has straight bar, curving ends; epsilon is lunate with equal length mid-bar; zeta is large and curved; kappa has near full-length arms; mu has slanting strokes that reach the lower line, but often join before the top and have extended upper strokes; pi has overlapping cross bar; rho has closed eye; sigma is lunate. Elegant hedera in line 2; use of vacats in age at death.",[325,328,332,335,336,338,342],{"type":52,"l":169,"from":54,"to":54,"h":326,"unit":57,"atLeast":240,"atMost":327},"25-31","31",{"type":52,"l":238,"from":63,"to":63,"h":329,"unit":57,"atLeast":330,"atMost":331},"20-22","20","22",{"type":52,"l":242,"from":55,"to":55,"h":333,"unit":57,"atLeast":334,"atMost":240},"19-25","19",{"type":52,"l":244,"from":245,"to":245,"h":333,"unit":57,"atLeast":334,"atMost":240},{"type":52,"l":249,"from":250,"to":250,"h":337,"unit":57,"atLeast":334,"atMost":247},"19-21",{"type":52,"l":339,"from":340,"to":340,"h":341,"unit":57,"atLeast":330,"atMost":247},"Line 6","line6","20-21",{"type":61,"l":62,"from":54,"to":63,"unit":57},{"_":253,"notBefore":66,"notAfter":254,"evidence":68},[345,346],{"_":257,"type":72,"ref":258,"region":74},{"_":87,"type":77,"ref":260,"region":74},[348],[263,264],[266,267],{"_":89,"role":90,"ref":91},{"_":270,"type":94},{"_":96,"mainLang":97,"languages":353},[96],{"n":100,"url":355,"height":275,"width":276,"desc":277,"surfaceType":105},"ISic001872_tiled.tif",[357,359,362,364,365,366],{"atLeast":283,"atMost":358},31,{"atLeast":360,"atMost":361},20,22,{"atLeast":363,"atMost":283},19,{"atLeast":363,"atMost":283},{"atLeast":363,"atMost":286},{"atLeast":360,"atMost":286},[111],[115],[370,371,372,26,211,294,295,126,124,125,126,127,128,97],"isic001872","funerary inscription for mousa",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Μοῦσα\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Μοῦσα\">Μοῦσα\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"χρηστὰ\">χρηστὰ\u003C/span> ❦ \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-text=\"ἄμεμπτε\">ἄμεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"μῆνες\">μῆνες\u003C/span>  \u003Cbr id=\"al6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>ι´ ·\u003Cspan dir=\"ltr\">(vac.1)\u003C/span> ἡμέρας \u003Cspan dir=\"ltr\">(vac.1)\u003C/span> κε´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":298,"ptr":375,"ref":376,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":133},{"_":135,"target":135},{"file":378,"uri":378,"title":379,"status":380,"editions":381,"editionAuthor":24,"type":387,"objectType":388,"material":389,"condition":40,"layoutDesc":394,"handNote":402,"date":419,"places":420,"geo":423,"country":74,"provenance":257,"provenanceGeo":425,"region":86,"settlement":87,"repository":426,"idno":427,"textLang":428,"tmNumber":40,"facsimile":430,"letterHeights":432,"publications":442,"zotero":443,"keywords":444,"html":448,"bibl":449,"bulletinDateSort":136,"citedRangeSort":298,"languageSort":96,"materialSort":215,"typeSort":26},"ISic001873","Funerary inscription for Kopria",{"_":12},[382,383,384,385,386],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":211,"ana":212,"ref":213},{"_":215,"ana":216,"type":217,"subtype":390,"resp":221,"ref":39,"note":391},[219,220],{"_":223,"ref":392},{"_":393,"target":393},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic001873",{"layout":395},{"p":396,"rs":397,"damage":40},"Text over five lines, neatly respecting gridlines to the base of each line and with marginal lines to left and right - that on the left is approximately followed, that on the right is ignored; an additional gridline below is unused. Some use of interpuncts and vacats in the text. The first line shows clear traces of red paint in the letters.",[398,399],{"_":45,"ana":46,"ref":47},{"_":400,"ana":401},"rubrication, red colour","#execution.rubrication.red",{"lettering":403,"dimensions":404},"Text is incised in fairly tall, thin, neat and plain letters mostly without serifs. Alpha has downward left sloping cross-bar; epsilon is lunate, with shorter and sometimes detached middle bar; zeta is straight; eta sometimes has detached cross-bar (line 4); kapa has short arms; mu has angled strokes, the mid-strokes only descending half-way, and no upward extension of the apexes; omicron is slightly smaller than other letters; pi does not overlap; rho i slcosed; sigma is lunate. Use of a simple/stylised hedera in lines 2 and 4, and letters are somewhat irregularly spaced especially in the final line.",[405,408,412,413,416,418],{"type":52,"l":169,"from":54,"to":54,"h":406,