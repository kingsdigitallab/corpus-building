,"#function.dedication","https://ontology.inscriptiones.org/type_of_inscription/Dedication",{"_":151,"ana":152,"ref":153},"basin","#object.basin","https://www.eagle-network.eu/voc/objtyp/lod/144.html",{"_":155,"ana":156,"type":157,"subtype":158,"ref":159},"marble","#material.inorganic.stone","stone.unspecified",[37],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":161},{"p":162,"rs":163,"damage":39},"Single line of letters on the outward facing side of the rim.",{"_":44,"ana":45,"ref":46},{"lettering":165,"dimensions":166},"Presented as clearly incised archaic letters",[167,169],{"type":51,"l":168,"from":53,"to":53,"unit":56},"Line 1",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":171,"notBefore":172,"notAfter":173,"evidence":67},"Archaic, on the basis of the lettering.",-600,-501,[175,176],{"_":70,"type":71,"ref":72,"region":73},{"_":75,"type":76,"ref":77,"region":73},[178],[80,81],[180,181],36.8729563,14.4421611,{"_":88,"role":89,"ref":90},{"_":184,"type":93},"16484",{"_":95,"mainLang":96,"languages":186},[95],[],[110,111,112],[114,115,116],[191,192,193,147,151,155,121,122,123,124,125,126,127,96],"isic001870","inscribed fragment of a marble basin",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΘΟΝΙ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":130,"ptr":196,"ref":197,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":132},{"_":134,"target":134},{"file":199,"uri":199,"title":200,"status":201,"editions":202,"editionAuthor":24,"type":208,"objectType":209,"material":213,"condition":39,"layoutDesc":225,"handNote":229,"date":251,"places":254,"geo":260,"country":73,"provenance":256,"provenanceGeo":264,"region":85,"settlement":86,"repository":267,"idno":268,"textLang":270,"tmNumber":39,"facsimile":272,"letterHeights":277,"publications":287,"zotero":288,"keywords":289,"html":295,"bibl":296,"bulletinDateSort":135,"citedRangeSort":297,"languageSort":95,"materialSort":214,"typeSort":26},"ISic001871","Funerary inscription for Gamike",{"_":12},[203,204,205,206,207],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":210,"ana":211,"ref":212},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259",{"_":214,"ana":215,"type":216,"subtype":217,"resp":220,"ref":38,"note":221},"whitish soft calcarenite, likely calcarenite degli Iblei (sand-grade limestone) (identification based on pXRF, digital microscopy)","#material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-orientali #material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish.iblei-occidentali","stone.limestone.non-polishable.whitish",[218,219],"calcarenite_ibleiOR","calcarenite_ibleiOCC","#Coccato",{"_":222,"ref":223}," Petrographic imagery at ",{"_":224,"target":224},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic001871",{"layout":226},{"p":227,"rs":228,"damage":39},"Text over five lines, carefully following guidelines to the base of each line, with a marginal guideline to the left and right, with the left margin consistently observed. An additional guideline below is unused; the guidelines carefully align with the text to the right of this one. Use of a vacat prior to the age at death.",{"_":44,"ana":45,"ref":46},{"lettering":230,"dimensions":231},"Deep and wide slightly crude v-cut, producing consistent fairly square letters without serifs. Alpha has mostly downward left sloping cross-bar; epsilon is lunate with mostly shorter middle bar; zeta has slight curvature to the strokes; kappa has short arms; mu has four full-length diagonal strokes; lunate sigma, but note final square lunate for digamma / stigma for numeral 6.",[232,236,240,242,247,250],{"type":51,"l":168,"from":53,"to":53,"h":233,"unit":56,"atLeast":234,"atMost":235},"27-30","27","30",{"type":51,"l":237,"from":62,"to":62,"h":238,"unit":56,"atLeast":239,"atMost":235},"Line 2","25-30","25",{"type":51,"l":241,"from":54,"to":54,"h":238,"unit":56,"atLeast":239,"atMost":235},"Line 3",{"type":51,"l":243,"from":244,"to":244,"h":245,"unit":56,"atLeast":246,"atMost":235},"Line 4","line4","21-30","21",{"type":51,"l":248,"from":249,"to":249,"h":238,"unit":56,"atLeast":239,"atMost":235},"Line 5","line5",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":252,"notBefore":65,"notAfter":253,"evidence":67},"Roman imperial in date",300,[255,258],{"_":256,"type":71,"ref":257,"region":73},"Syracusae","http://pleiades.stoa.org/places/462503",{"_":86,"type":76,"ref":259,"region":73},"http://sws.geonames.org/2523083",[261],[262,263],37.08415,15.27628,[265,266],37.0784545,15.2786827,{"_":88,"role":89,"ref":90},{"_":269,"type":93},"15083",{"_":95,"mainLang":96,"languages":271},[95],{"n":99,"url":273,"height":274,"width":275,"desc":276,"surfaceType":104},"ISic001871_tiled.tif","3680px","5520px","I.Sicily with the permission of the Parco archeologico e paesaggistico di Siracusa, Eloro, Villa del Tellaro e Akrai, and the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei Beni Culturali e dell’Identità Siciliana; photo J. Prag 2022-04-29.",[278,281,283,284,286],{"atLeast":279,"atMost":280},27,30,{"atLeast":282,"atMost":280},25,{"atLeast":282,"atMost":280},{"atLeast":285,"atMost":280},21,{"atLeast":282,"atMost":280},[110],[114],[290,291,292,26,210,293,294,125,123,124,125,126,127,96],"isic001871","funerary inscription for gamike",{"_":12},"whitish soft calcarenite, likely calcarenite degli iblei (sand-grade limestone) (identification based on pxrf, digital microscopy)","syracusae","\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Γαμική\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Γαμική\">Γαμική\u003C/span>\u003C/span>  \u003Cspan data-text=\"χρη\n                    στὰ\">χρη-\u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>στὰ\u003C/span>  \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cspan data-text=\"ἄ\n                    μεμπτε\">ἄ-\u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>μεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔτη\">ἔτη\u003C/span> κς´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":297,"ptr":298,"ref":299,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"400",{"target":132},{"_":134,"target":134},{"file":301,"uri":301,"title":302,"status":303,"editions":304,"editionAuthor":24,"type":310,"objectType":311,"material":312,"condition":39,"layoutDesc":317,"handNote":321,"date":342,"places":343,"geo":346,"country":73,"provenance":256,"provenanceGeo":348,"region":85,"settlement":86,"repository":349,"idno":350,"textLang":351,"tmNumber":39,"facsimile":353,"letterHeights":355,"publications":366,"zotero":367,"keywords":368,"html":372,"bibl":373,"bulletinDateSort":135,"citedRangeSort":297,"languageSort":95,"materialSort":214,"typeSort":26},"ISic001872","Funerary inscription for Mousa",{"_":12},[305,306,307,308,309],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":210,"ana":211,"ref":212},{"_":214,"ana":215,"type":216,"subtype":313,"resp":220,"ref":38,"note":314},[218,219],{"_":222,"ref":315},{"_":316,"target":316},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic001872",{"layout":318},{"p":319,"rs":320,"damage":39},"Text over six lines, set in a recessed panel in the style of a temple facade, but without guidelines. Some use of interpuncts and vacats in the text.",{"_":44,"ana":45,"ref":46},{"lettering":322,"dimensions":323},"Text is deeply incised in letters of slightly varying size. Extensive use of serifs, with several letters tending to the cursive. Alpha has straight bar, curving ends; epsilon is lunate with equal length mid-bar; zeta is large and curved; kappa has near full-length arms; mu has slanting strokes that reach the lower line, but often join before the top and have extended upper strokes; pi has overlapping cross bar; rho has closed eye; sigma is lunate. Elegant hedera in line 2; use of vacats in age at death.",[324,327,331,334,335,337,341],{"type":51,"l":168,"from":53,"to":53,"h":325,"unit":56,"atLeast":239,"atMost":326},"25-31","31",{"type":51,"l":237,"from":62,"to":62,"h":328,"unit":56,"atLeast":329,"atMost":330},"20-22","20","22",{"type":51,"l":241,"from":54,"to":54,"h":332,"unit":56,"atLeast":333,"atMost":239},"19-25","19",{"type":51,"l":243,"from":244,"to":244,"h":332,"unit":56,"atLeast":333,"atMost":239},{"type":51,"l":248,"from":249,"to":249,"h":336,"unit":56,"atLeast":333,"atMost":246},"19-21",{"type":51,"l":338,"from":339,"to":339,"h":340,"unit":56,"atLeast":329,"atMost":246},"Line 6","line6","20-21",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":252,"notBefore":65,"notAfter":253,"evidence":67},[344,345],{"_":256,"type":71,"ref":257,"region":73},{"_":86,"type":76,"ref":259,"region":73},[347],[262,263],[265,266],{"_":88,"role":89,"ref":90},{"_":269,"type":93},{"_":95,"mainLang":96,"languages":352},[95],{"n":99,"url":354,"height":274,"width":275,"desc":276,"surfaceType":104},"ISic001872_tiled.tif",[356,358,361,363,364,365],{"atLeast":282,"atMost":357},31,{"atLeast":359,"atMost":360},20,22,{"atLeast":362,"atMost":282},19,{"atLeast":362,"atMost":282},{"atLeast":362,"atMost":285},{"atLeast":359,"atMost":285},[110],[114],[369,370,371,26,210,293,294,125,123,124,125,126,127,96],"isic001872","funerary inscription for mousa",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Μοῦσα\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Μοῦσα\">Μοῦσα\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-text=\"χρηστὰ\">χρηστὰ\u003C/span> ❦ \u003Cspan data-text=\"καὶ\">καὶ\u003C/span>  \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-text=\"ἄμεμπτε\">ἄμεμπτε\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-text=\"χαῖρε\">χαῖρε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"ἔζη\n                    σε\">ἔζη-\u003Cbr id=\"al5-interpretive\">\u003Cspan class=\"linenumber\">5\u003C/span>σε\u003C/span>  \u003Cspan dir=\"ltr\">(vac.1)\u003C/span>  \u003Cspan data-text=\"μῆνες\">μῆνες\u003C/span>  \u003Cbr id=\"al6-interpretive\">\u003Cspan class=\"linenumber\">6\u003C/span>ι´ ·\u003Cspan dir=\"ltr\">(vac.1)\u003C/span> ἡμέρας \u003Cspan dir=\"ltr\">(vac.1)\u003C/span> κε´ \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":297,"ptr":374,"ref":375,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":132},{"_":134,"target":134},{"file":377,"uri":377,"title":378,"status":379,"editions":380,"editionAuthor":24,"type":386,"objectType":387,"material":388,"condition":39,"layoutDesc":393,"handNote":401,"date":418,"places":419,"geo":422,"country":73,"provenance":256,"provenanceGeo":424,"region":85,"settlement":86,"repository":425,"idno":426,"textLang":427,"tmNumber":39,"facsimile":429,"letterHeights":431,"publications":441,"zotero":442,"keywords":443,"html":447,"bibl":448,"bulletinDateSort":135,"citedRangeSort":297,"languageSort":95,"materialSort":214,"typeSort":26},"ISic001873","Funerary inscription for Kopria",{"_":12},[381,382,383,384,385],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":210,"ana":211,"ref":212},{"_":214,"ana":215,"type":216,"subtype":389,"resp":220,"ref":38,"note":390},[218,219],{"_":222,"ref":391},{"_":392,"target":392},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic001873",{"layout":394},{"p":395,"rs":396,"damage":39},"Text over five lines, neatly respecting gridlines to the base of each line and with marginal lines to left and right - that on the left is approximately followed, that on the right is ignored; an additional gridline below is unused. Some use of interpuncts and vacats in the text. The first line shows clear traces of red paint in the letters.",[397,398],{"_":44,"ana":45,"ref":46},{"_":399,"ana":400},"rubrication, red colour","#execution.rubrication.red",{"lettering":402,"dimensions":403},"Text is incised in fairly tall, thin, neat and plain letters mostly without serifs. Alpha has downward left sloping cross-bar; epsilon is lunate, with shorter and sometimes detached middle bar; zeta is straight; eta sometimes has detached cross-bar (line 4); kapa has short arms; mu has angled strokes, the mid-strokes only descending half-way, and no upward extension of the apexes; omicron is slightly smaller than other letters; pi does not overlap; rho i slcosed; sigma is lunate. Use of a simple/stylised hedera in lines 2 and 4, and letters are somewhat irregularly spaced especially in the final line.",[404,407,411,412,415,417],{"type":51,"l":168,"from":53,"to":53,"h":405,"unit":56,"atLeast":406,"atMost":235},"29-30 (omicron = 20)","29",{"type":51,"l":237,"