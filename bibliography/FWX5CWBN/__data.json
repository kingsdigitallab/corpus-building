ions":159},"Presented as clearly incised archaic letters",[160,162],{"type":51,"l":161,"from":53,"to":53,"unit":56},"Line 1",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":164,"notBefore":165,"notAfter":166,"evidence":67},"Archaic, on the basis of the lettering.",-600,-501,[168,169],{"_":70,"type":71,"ref":72,"region":73},{"_":75,"type":76,"ref":77,"region":73},[171],[80,81],[173,174],36.8729563,14.4421611,{"_":88,"role":89,"ref":90},{"_":177,"type":93},"16484",{"_":95,"mainLang":96,"languages":179},[95],[],[103,104,105],[107,108,109],[184,185,186,140,144,148,114,115,116,117,118,119,120,96],"isic001870","inscribed fragment of a marble basin",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>]ΘΟΝΙ[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":123,"ptr":189,"ref":190,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":125},{"_":127,"target":127},{"file":192,"uri":192,"title":193,"status":194,"editions":195,"editionAuthor":24,"type":201,"objectType":202,"material":206,"condition":39,"layoutDesc":210,"handNote":214,"date":236,"places":239,"geo":245,"country":73,"provenance":241,"provenanceGeo":249,"region":85,"settlement":86,"repository":252,"idno":253,"textLang":255,"tmNumber":39,"facsimile":257,"letterHeights":264,"publications":274,"zotero":275,"keywords":276,"html":281,"bibl":282,"bulletinDateSort":128,"citedRangeSort":283,"languageSort":95,"materialSort":34,"typeSort":26},"ISic001871","Funerary inscription for Gamike",{"_":12},[196,197,198,199,200],{"type":15},{"type":17},{"type":19},{"type":21},{"type":23},{"_":26,"ana":27,"ref":28},{"_":203,"ana":204,"ref":205},"plaque","#object.plaque","http://www.eagle-network.eu/voc/objtyp/lod/259",{"_":34,"type":207,"resp":208,"ref":38,"subtype":209},"stone.calcarenite","#Coccato",[],{"layout":211},{"p":212,"rs":213,"damage":39},"Text over five lines, carefully following guidelines to the base of each line, with a marginal guideline to the left and right, with the left margin consistently observed. An additional guideline below is unused; the guidelines carefully align with the text to the right of this one. Use of a vacat prior to the age at death.",{"_":44,"ana":45,"ref":46},{"lettering":215,"dimensions":216},"Deep and wide slightly crude v-cut, producing consistent fairly square letters without serifs. Alpha has mostly downward left sloping cross-bar; epsilon is lunate with mostly shorter middle bar; zeta has slight curvature to the strokes; kappa has short arms; mu has four full-length diagonal strokes; lunate sigma, but note final square lunate for digamma / stigma for numeral 6.",[217,221,225,227,232,235],{"type":51,"l":161,"from":53,"to":53,"h":218,"unit":56,"atLeast":219,"atMost":220},"27-30","27","30",{"type":51,"l":222,"from":62,"to":62,"h":223,"unit":56,"atLeast":224,"atMost":220},"Line 2","25-30","25",{"type":51,"l":226,"from":54,"to":54,"h":223,"unit":56,"atLeast":224,"atMost":220},"Line 3",{"type":51,"l":228,"from":229,"to":229,"h":230,"unit":56,"atLeast":231,"atMost":220},"Line 4","line4","21-30","21",{"type":51,"l":233,"from":234,"to":234,"h":223,"unit":56,"atLeast":224,"atMost":220},"Line 5","line5",{"type":60,"l":61,"from":53,"to":62,"unit":56},{"_":237,"notBefore":65,"notAfter":238,"evidence":67},"Roman imperial in date",300,[240,243],{"_":241,"type":71,"ref":242,"region":73},"Syracusae","http://pleiades.stoa.org/places/462503",{"_":86,"type":76,"ref":244,"region":73},"http://sws.geonames.org/2523083",[246],[247,248],37.08415,15.27628,[250,251],37.0784545,15.2786827,{"_":88,"role":89,"ref":90},{"_":254,"type":93},"15083",{"_":95,"mainLang":96,"languages":256},[95],{"n":258,"url":259,"height":260,"width":261,"desc":262,"surfaceType":263},"scre