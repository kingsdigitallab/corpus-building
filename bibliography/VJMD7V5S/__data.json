"lettering":51,"dimensions":52},"The letters are neatly cut, with short serifs. P is open on both texts, R is closed. Text A has tall I in line three. The primary difference between Text A and Text B is in the technique, with the letters in A having a flat cut, whereas B is engraved with a more elegant 'v-cut' and more elegant interpuncts. It is likely that the two were carved by different stone-masons.",[53,61,67,73,76,80,85,89,94,97],{"type":54,"l":55,"from":56,"to":56,"h":57,"unit":58,"atLeast":59,"atMost":60},"letterHeight","Line A 1","lineA1","37-39","mm","37","39",{"type":54,"l":62,"from":63,"to":63,"h":64,"unit":58,"atLeast":65,"atMost":66},"Line A 2","lineA2","32-35","32","35",{"type":54,"l":68,"from":69,"to":69,"h":70,"unit":58,"atLeast":71,"atMost":72},"Line A 3","lineA3","27-33","27","33",{"type":54,"l":74,"from":75,"to":75,"h":66,"unit":58,"atLeast":66,"atMost":66},"Line B 1","lineB1",{"type":54,"l":77,"from":78,"to":78,"h":79,"unit":58,"atLeast":79,"atMost":79},"Line B 2","lineB2","30",{"type":54,"l":81,"from":82,"to":82,"h":83,"unit":58,"atLeast":71,"atMost":84},"Line B 3","lineB3","27-29","29",{"type":86,"l":87,"from":56,"to":63,"h":88,"unit":58,"atLeast":88,"atMost":88},"interlinear","Interlineation line A1 to A2","12",{"type":86,"l":90,"from":63,"to":69,"h":91,"unit":58,"atLeast":92,"atMost":93},"Interlineation line A2 to A3","11-13","11","13",{"type":86,"l":95,"from":75,"to":78,"h":96,"unit":58,"atLeast":96,"atMost":96},"Interlineation line B1-B2","10",{"type":86,"l":98,"from":78,"to":82,"h":96,"unit":58,"atLeast":96,"atMost":96},"Interlineation line B2-B3",{"_":100,"notBefore":101,"notAfter":102},"Perhaps between 16 BCE and 4 CE",-16,4,[104,109],{"_":105,"type":106,"ref":107,"region":108},"Agrigentum","ancient","http://pleiades.stoa.org/places/462086","Sicilia",{"_":110,"type":111,"ref":112,"region":108},"Agrigento","modern","http://sws.geonames.org/6541860",[114],[115,116],37.32084,13.58876,[118,119],37.297479,13.589125,"Sicily",{"_":122,"role":1