oc/material/lod/66.html",{"type":46,"ref":47,"location":50},"provenance",{"_":48,"target":49},"Taormina","https://www.geonames.org/2522975/taormina.html",{"geo":51,"precision":52},"37.85358,15.28851",{"match":53,"n":54},"preceding-sibling::geo","5000",{"_":56,"ref":57}," Petrographic imagery at ",{"_":58,"target":58},"https://iiif.csad.ox.ac.uk/viewer/isicily/ISic000823",{"ana":60},"#condition.damaged",{"layout":62},{"p":63,"rs":64,"damage":68},"The text is set out over three lines filling the upper half of the front face of the block. The lines get very slightly larger from line 1 to line 3, with an initial vacat of 4-5 cm, and a less regular line-end.",{"_":65,"ana":66,"ref":67},"chiselled","#execution.chiselled","http://www.eagle-network.eu/voc/writing/lod/1",{"ana":69},"#text_condition.incomplete",{"lettering":71,"dimensions":164},[72,73],"Very carefully and neatly carved, widely spaced letters, with a narrow simple v-cut and without serifs. Alpha with straight bar; beta with equal closed loops; epsilon with shorter middle bar; theta is small, circular, above the line, with a central dot (32 mm); kappa has nearly full length equal arms; nu is enitrely regular; omicron is small and above the line (25-27 mm); pi has a shorter right hasta, and the cross-bar does not overextend; rho has a large closed loop; sigma has slightly open outer strokes; omega is almost full size, nearly circular, open with horizontal feet.",{"_":74,"source":75,"ref":76},"\n                                    Types list:\n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                                    \n                      