ακλε[ῖ]\u003C/span>\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":325,"ptr":326,"ref":327,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"248-249",{"target":232},{"_":234,"target":234},{"file":329,"uri":329,"title":330,"status":331,"editions":332,"editionAuthor":28,"type":339,"objectType":343,"material":347,"condition":46,"layoutDesc":353,"handNote":357,"date":403,"places":407,"geo":410,"country":173,"provenance":170,"provenanceGeo":412,"region":185,"settlement":175,"repository":415,"idno":416,"textLang":419,"tmNumber":334,"facsimile":423,"letterHeights":426,"publications":449,"zotero":456,"keywords":463,"html":469,"bibl":470,"bulletinDateSort":235,"citedRangeSort":471,"languageSort":420,"materialSort":348,"typeSort":340},"ISic003324","Two dedications to a Caesar by the Annii",{"_":12},[333,335,336,337,338],{"_":334,"type":16},"645577",{"type":19},{"type":21},{"type":24},{"type":27},{"_":340,"ana":341,"ref":342},"honorific","#function.honorific","https://ontology.inscriptiones.org/type_of_inscription/Honorific",{"_":344,"ana":345,"ref":346},"base","#object.base","http://www.eagle-network.eu/voc/objtyp/lod/57.html",{"_":348,"ana":349,"type":350,"subtype":351,"resp":44,"ref":352},"marble\n                                    ","#material.inorganic.stone.metamorphic_rock.marble","stone.marble",[43],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":354},{"p":355,"rs":356,"damage":46},"Three lines of Latin letters centred on each of front and rear face, first line larger in both cases",{"_":51,"ana":52,"ref":53},{"lettering":358,"dimensions":359},"The letters are neatly cut, with short serifs. P is open on both texts, R is closed. Text A has tall I in line three. The primary difference between Text A and Text B is in the technique, with the letters in A having a flat cut, whereas B is engraved with a more elegant 'v-cut' and more elegant interpuncts. It is likely that the two were 