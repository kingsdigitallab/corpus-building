terpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan dir=\"ltr\">(vac.)\u003C/span> [\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] δυῶν δὲ ἀ[νδ]ρῶν \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Σέξτου Ἐγνατίου Σέξτου υἱοῦ Ῥούφου\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Σέξτου\">Σέξτου\u003C/span>  \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἐγνατίου\">Ἐ[γν]ατί̣ου̣\u003C/span>  \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Σέξτου\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Σέξτου\">Σ[έ]ξ[τ]ο[υ\u003C/span>\u003C/span> υἱοῦ \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ῥούφου\">Ῥ]ούφου\u003C/span>\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Λούκιος ς Λουκίου υἱὸς ο\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Λούκιος\">Λούκιος\u003C/span>  \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"ς\">[\u003Cspan dir=\"ltr\" class=\"gap\">. 5.\u003C/span>]ς\u003C/span>  \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Λουκίου\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Λουκίου\">Λουκίου\u003C/span>\u003C/span> υἱὸ[ς \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"ο\">\u003Cspan dir=\"ltr\" class=\"gap\">..\u003C/span>]ο[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>\u003C/span>\u003C/span> γυμνασίαρχος τῶν τε ἐφήβων καὶ νε]ωτέρων τοὺς ἀν[κ]λίτας ἐκ τῶν ἰδίων \u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἑρμᾶι\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἑρμᾶι\">Ἑρμᾶι\u003C/span>\u003C/span> καὶ \u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἡρακλεῖ\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἡρακλεῖ\">Ἡρακλε[ῖ]\u003C/span>\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":326,"ptr":327,"ref":328,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"248-249",{"target":233},{"_":235,"target":235},{"file":330,"uri":330,"title":331,"status":332,"editions":333,"editionAuthor":28,"type":340,"objectType":344,"material":348,"condition":46,"layoutDesc":354,"handNote":358,"date":404,"places":408,"geo":411,"country":174,"provenance":171,"provenanceGeo":413,"region":186,"settlement":176,"repository":416,"idno":417,"textLang":420,"tmNumber":335,"facsimile":424,"letterHeights":427,"publications":450,"zotero":457,"keywords":464,"html":470,"bibl":471,"bulletinDateSort":236,"citedRangeSort":472,"languageSort":421,"materialSort":349,"typeSort":341},"ISic003324","Two dedications to a Caesar by the Annii",{"_":12},[334,336,337,338,339],{"_":335,"type":16},"645577",{"type":19},{"type":21},{"type":24},{"type":27},{"_":341,"ana":342,"ref":343},"honorific","#function.honorific","https://ontology.inscriptiones.org/type_of_inscription/Honorific",{"_":345,"ana":346,"ref":347},"base","#object.base","http://www.eagle-network.eu/voc/objtyp/lod/57.html",{"_":349,"ana":350,"type":351,"subtype":352,"resp":44,"ref":353},"marble\n                                    ","#material.inorganic.stone.metamorphic_rock.marble","stone.marble",[43],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":355},{"p":356,"rs":357,"damage":46},"Three lines of Latin letters centred on each of front and rear face, first line larger in both cases",{"_":51,"ana":52,"ref":53},{"lettering":359,"dimensions":360},"The letters are neatly cut, with short serifs. P is open on both texts, R is closed. Text A has tall I in line three. The primary difference between Text A and Text B is in the technique, with the letters in A having a flat cut, whereas B is engraved with a more elegant 'v-cut' and more elegant interpuncts. It is likely that the two were carved by different stone-masons.",[361,367,373,379,382,386,391,394,399,402],{"type":150,"l":362,"from":363,"to":363,"h":364,"unit":155,"atLeast":365,"atMost":366},"Line A 1","lineA1","37-39","37","39",{"type":150,"l":368,"from":369,"to":369,"h":370,"unit":155,"atLeast":371,"atMost":372},"Line A 2","lineA2","32-35","32","35",{"type":150,"l":374,"from":375,"to":375,"h":376,"unit":155,"atLeast":377,"atMost":378},"Line A 3","lineA3","27-33","27","33",{"type":150,"l":380,"from":381,"to":381,"h":372,"unit":155,"atLeast":372,"atMost":372},"Line B 1","lineB1",{"type":150,"l":383,"from":384,"to":384,"h":385,"unit":155,"atLeast":385,"atMost":385},"Line B 2","lineB2","30",{"type":150,"l":387,"from":388,"to":388,"h":389,"unit":155,"atLeast":377,"atMost":390},"Line B 3","lineB3","27-29","29",{"type":159,"l":392,"from":363,"to":369,"h":393,"unit":155,"atLeast":393,"atMost":393},"Interlineation line A1 to A2","12",{"type":159,"l":395,"from":369,"to":375,"h":396,"unit":155,"atLeast":397,"atMost":398},"Interlineation line A2 to A3","11-13","11","13",{"type":159,"l":400,"from":381,"to":384,"h":401,"unit":155,"atLeast":401,"atMost":401},"Interlineation line B1-B2","10",{"type":159,"l":403,"from":384,"to":388,"h":401,"unit":155,"atLeast":401,"atMost":401},"Interlineation line B2-B3",{"_":405,"notBefore":406,"notAfter":407},"Perhaps between 16 BCE and 4 CE",-16,4,[409,410],{"_":171,"type":172,"ref":173,"region":174},{"_":176,"type":177,"ref":178,"region":174},[412],[181,182],[414,415],37.297479,13.589125,{"_":188,"role":189,"ref":190},{"_":418,"type":419},"22522","inventory",{"_":421,"mainLang":422,"languages":423},"Latin","la",[421],{"n":196,"url":425,"height":198,"width":199,"desc":426,"surfaceType":201},"ISic003324A_tiled.tif","Photo J. Prag, courtesy Museo Regionale Archeologico Pietro Griffo, Agrigento",[428,431,434,437,438,440,442,444,447,449],{"atLeast":429,"atMost":430},37,39,{"atLeast":432,"atMost":433}