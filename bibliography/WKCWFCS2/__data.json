retive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan dir=\"ltr\">(vac.)\u003C/span> [\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] δυῶν δὲ ἀ[νδ]ρῶν \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Σέξτου Ἐγνατίου Σέξτου υἱοῦ Ῥούφου\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Σέξτου\">Σέξτου\u003C/span>  \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἐγνατίου\">Ἐ[γν]ατί̣ου̣\u003C/span>  \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Σέξτου\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Σέξτου\">Σ[έ]ξ[τ]ο[υ\u003C/span>\u003C/span> υἱοῦ \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ῥούφου\">Ῥ]ούφου\u003C/span>\u003C/span>  \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Λούκιος ς Λουκίου υἱὸς ο\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Λούκιος\">Λούκιος\u003C/span>  \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"ς\">[\u003Cspan dir=\"ltr\" class=\"gap\">. 5.\u003C/span>]ς\u003C/span>  \u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Λουκίου\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Λουκίου\">Λουκίου\u003C/span>\u003C/span> υἱὸ[ς \u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"ο\">\u003Cspan dir=\"ltr\" class=\"gap\">..\u003C/span>]ο[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>\u003C/span>\u003C/span> γυμνασίαρχος τῶν τε ἐφήβων καὶ νε]ωτέρων τοὺς ἀν[κ]λίτας ἐκ τῶν ἰδίων \u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἑρμᾶι\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἑρμᾶι\">Ἑρμᾶι\u003C/span>\u003C/span> καὶ \u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἡρακλεῖ\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἡρακλεῖ\">Ἡρακλε[ῖ]\u003C/span>\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":318,"ptr":319,"ref":320,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"248-249",{"target":232},{"_":234,"target":234},{"file":322,"uri":322,"title":323,"status":324,"editions":325,"editionAuthor":28,"type":332,"objectType":336,"material":340,"condition":46,"layoutDesc":346,"handNote":350,"date":396,"places":400,"geo":403,"country":173,"provenance":170,"provenanceGeo":405,"region":185,"settlement":175,"repository":408,"idno":409,"textLang":412,"tmNumber":327,"facsimile":416,"letterHeights":419,"publications":442,"zotero":449,"keywords":456,"html":462,"bibl":463,"bulletinDateSort":235,"citedRangeSort":464,"languageSort":413,"materialSort":341,"typeSort":333},"ISic003324","Two dedications to a Caesar by the Annii",{"_":12},[326,328,329,330,331],{"_":327,"type":16},"645577",{"type":19},{"type":21},{"type":24},{"type":27},{"_":333,"ana":334,"ref":335},"honorific","#function.honorific","https://ontology.inscriptiones.org/type_of_inscription/Honorific",{"_":337,"ana":338,"ref":339},"base","#object.base","http://www.eagle-network.eu/voc/objtyp/lod/57.html",{"_":341,"ana":342,"type":343,"subtype":344,"resp":44,"ref":345},"marble\n                                    ","#material.inorganic.stone.metamorphic_rock.marble","stone.marble",[43],"http://www.eagle-network.eu/voc/material/lod/48.html",{"layout":347},{"p":348,"rs":349,"damage":46},"Three lines of Latin letters centred on each of front and rear face, first line larger in both cases",{"_":51,"ana":52,"ref":53},{"lettering":351,"dimensions":352},"The letters are neatly cut, with short serifs. P is open on both texts, R is closed. Text A has tall I in line three. The primary difference between Text A and Text B is in the technique, with the letters in A having a flat cut, whereas B is engraved with a more elegant 'v-cut' and more elegant interpuncts. It is likely that the two were carved by different stone-masons.",[353,359,365,371,374,378,383,386,391,394],{"type":149,"l":354,"from":355,"to":355,"h":356,"unit":154,"atLeast":357,"atMost":358},"Line A 1","lineA1","37-39","37","39",{"type":149,"l":360,"from":361,"to":361,"h":362,"unit":154,"atLeast":363,"atMost":364},"Line A 2","lineA2","32-35","32","35",{"type":149,"l":366,"from":367,"to":367,"h":368,"unit":154,"atLeast":369,"atMost":370},"Line A 3","lineA3","27-33","27","33",{"type":149,"l":372,"from":373,"to":373,"h":364,"unit":154,"atLeast":364,"atMost":364},"Line B 1","lineB1",{"type":149,"l":375,"from":376,"to":376,"h":377,"unit":154,"atLeast":377,"atMost":377},"Line B 2","lineB2","30",{"type":149,"l":379,"from":380,"to":380,"h":381,"unit":154,"atLeast":369,"atMost":382},"Line B 3","lineB3","27-29","29",{"type":158,"l":384,"from":355,"to":361,"h":385,"unit":154,"atLeast":385,"atMost":385},"Interlineation line A1 to A2","12",{"type":158,"l":387,"from":361,"to":367,"h":388,"unit":154,"atLeast":389,"atMost":390},"Interlineation line A2 to A3","11-13","11","13",{"type":158,"l":392,"from":373,"to":376,"h":393,"unit":154,"atLeast":393,"atMost":393},"Interlineation line B1-B2","10",{"type":158,"l":395,"from":376,"to":380,"h":393,"unit":154,"atLeast":393,"atMost":393},"Interlineation line B2-B3",{"_":397,"notBefore":398,"notAfter":399},"Perhaps between 16 BCE and 4 CE",-16,4,[401,402],{"_":170,"type":171,"ref":172,"region":173},{"_":175,"type":176,"ref":177,"region":173},[404],[180,181],[406,407],37.297479,13.589125,{"_":187,"role":188,"ref":189},{"_":410,"type":411},"22522","inventory",{"_":413,"mainLang":414,"languages":415},"Latin","la",[413],{"n":195,"url":417,"height":197,"width":198,"desc":418,"surfaceType":200},"ISic003324A_tiled.tif","Photo J. Prag, courtesy Museo Regionale Archeologico Pietro Griffo, Agrigento",[420,423,426,429,430,432,434,436,439,441],{"atLeast":421,"atMost":422},37,39,{"atLeast":424,"atMost":425},32,