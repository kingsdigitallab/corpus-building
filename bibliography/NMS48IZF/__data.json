ve\">\u003Cspan class=\"linenumber\">2\u003C/span>[\u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>  \u003Cspan data-text=\"ψηφίσμα\" data-n=\"50\" data-lemma=\"ψήφισμα\">ψηφί]σμα\u003C/span>  \u003Cspan data-text=\"παρὰ\" data-n=\"55\" data-lemma=\"παρά\">πα̣[ρὰ?\u003C/span>  \u003Cspan dir=\"ltr\" class=\"gap\">---\u003C/span>] \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":133,"ptr":203,"ref":204,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},{"target":135},{"_":137,"target":137},{"file":206,"uri":206,"title":207,"status":208,"editions":209,"editionAuthor":26,"type":216,"objectType":218,"material":220,"condition":230,"layoutDesc":231,"handNote":237,"date":249,"places":252,"geo":256,"country":78,"provenance":75,"provenanceGeo":258,"region":88,"settlement":80,"repository":259,"textLang":262,"tmNumber":211,"facsimile":266,"letterHeights":271,"publications":278,"zotero":280,"keywords":282,"html":289,"bibl":290,"bulletinDateSort":138,"citedRangeSort":291,"languageSort":263,"materialSort":221,"typeSort":28},"ISic003420","Fragment of an imperial honorific",{"_":12},[210,212,213,214,215],{"_":211,"type":16},"644815",{"type":18},{"type":20},{"type":22},{"type":25},{"_":28,"ana":29,"ref":217},"https://www.eagle-network.eu/voc/objtyp/lod/69.html",{"_":32,"ana":33,"ref":219},"https://www.eagle-network.eu/voc/objtyp/lod/259.html",{"_":221,"ana":222,"type":38,"subtype":223,"resp":41,"ref":42},"Coarse-grained, homogeneous, white marble, likely Aphrodisian, Parian-2, Parian-3, Parian-4, Proconnesian, Thasian-3 (identification based on digital microscopy)","#material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Aphrodisian #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Parian-2 #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Parian-3 #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Parian-4 #material.inorganic.stone.metamorphic_rock.marble.calcitic_marble.Proconnesian #material.inorganic.stone.metamorphic_rock.marble.dolomitic_marble.Thasian-3",[224,225,226,227,228,229],"Aphrodisian","Parian-2","Parian-3","Parian-4","Proconnesian","Thasian-3",{"ana":44},{"layout":232},{"p":233,"rs":234,"damage":235},"The beginning of two lines of monumental letters are preserved on the stone. A substantial left margin is preserved at the start of each line. Unless the lines below were substantially further indented, there was no text below; the preserved vacat above line 1 (90mm)  is significantly greater than that between lines 1 and 2 (57mm), so it is unclear if another line originally stood above (the top of the stone appears intact) - if it did, it was either significantly above the preserved first line and/or indented several letters to the right.",{"_":48,"ana":49,"ref":50},{"ana":236},"#text_condition.incomplete",{"lettering":238,"dimensions":239},"Deep, very regular, v-cut letters, with a broad v-cut, hair-line extensions to wedge serifs, and a quite wide square module. The I in line one is extended.",[240,244,247],{"type":56,"l":241,"from":58,"to":58,"h":242,"unit":61,"atLeast":243,"atMost":243},"Line 1","68 (I = 87)","68",{"type":56,"l":245,"from":67,"to":67,"h":246,"unit":61,"atLeast":246,"atMost":246},"Line 2","58",{"type":65,"l":66,"from":58,"to":67,"h":248,"unit":61,"atLeast":248,"atMost":248},"57",{"_":250,"notBefore":176,"notAfter":72,"evidence":251},"First or second century","lettering",[253,255],{"_":75,"type":76,"ref":77,"corresp":254,"region":78},"#findspot",{"_":80,"type":81,"ref":82,"region":78},[257],[85,86],[],{"_":260,"role":91,"ref":261},"Teatro Romano di Catania","http://sicily.classics.ox.ac.uk/museum/017",{"_":263,"mainLang":264,"languages":265},"Latin","la",[263],{"n":101,"url":267,"height":268,"width":269,"desc":270,"surfaceType":106},"ISic003420_tiled.tif","4080px","3072px","I.Sicily with the permission of the Assessorato Regionale dei Beni Culturali e dell’Identità Siciliana - Dipartimento dei B