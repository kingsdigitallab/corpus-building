e=\"persname\" data-name-type=\"divine\" data-text=\"Ἑρμᾶι\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἑρμᾶι\">\u003Cspan data-text=\"Ἑρμᾶι\" data-n=\"20\" data-lemma=\"\">Ἑρμᾶι\u003C/span>\u003C/span>\u003C/span> #triple-colon \u003Cspan data-text=\"ἀνέθηκε\" data-n=\"30\" data-lemma=\"\">ἀνέθηκε\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":332,"ptr":333,"ref":334,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"32-33 no.3 pl.4",{"target":176},{"_":178,"target":178},{"file":336,"uri":336,"title":337,"status":338,"editionAuthor":13,"type":339,"objectType":340,"material":344,"condition":30,"layoutDesc":346,"handNote":350,"date":382,"places":387,"geo":390,"country":108,"provenance":105,"provenanceGeo":392,"region":118,"settlement":110,"repository":395,"idno":396,"textLang":398,"tmNumber":400,"facsimile":401,"letterHeights":403,"publications":420,"zotero":423,"keywords":426,"html":430,"bibl":431,"bulletinDateSort":179,"citedRangeSort":432,"languageSort":127,"materialSort":165,"typeSort":185},"ISic001082","I.Sicily inscription 001082",{"_":12},{"_":185,"ana":186,"ref":187},{"_":341,"ana":342,"ref":343},"altar","#object.altar","http://www.eagle-network.eu/voc/objtyp/lod/29.html",{"_":165,"ana":24,"type":25,"subtype":345,"resp":28,"ref":29},[27],{"layout":347},{"p":348,"rs":349,"damage":30},"Four lines of Greek letters, all crudely incised in the epigraphic field on the front face.",{"_":34,"ana":35,"ref":36},{"lettering":351,"dimensions":352},"The first two lines are deeply incised, the second two very lightly incised. Alpha has straight bar, with an apex; epsilon has equal length horizontals; mu in line 3 has extended apices, in anticipation of the cursive form; omicron is circular in lines 1 and 3, angular (made up of straight lines) in lines 3 and 4; sigma is and open four bar sigma in lines 1-2, a quadrate lunate sigma in lines 3-4; phi has a small elongated eye; omega is open in lines 1-2, lunate in line 4. It is therefore likely that lines 1-2 were incised by a different hand from lines 3-4.",[353,357,361,367,372,375,378],{"type":91,"l":92,"from":93,"to":93,"h":354,"unit":94,"atLeast":355,"atMost":356},"6-15","6","15",{"type":91,"l":285,"from":98,"to":98,"h":358,"unit":94,"atLeast":359,"atMost":360},"9-16","9","16",{"type":91,"l":362,"from":363,"to":363,"h":364,"unit":94,"atLeast":365,"atMost":366},"Line 3","line3","5-8","5","8",{"type":91,"l":368,"from":369,"to":369,"h":370,"unit":94,"atLeast":355,"atMost":371},"Line 4","line4","6-14","14",{"type":96,"l":97,"from":93,"to":98,"h":373,"unit":94,"atLeast":359,"atMost":374},"9-12","12",{"type":96,"l":376,"from":98,"to":363,"h":377,"unit":94,"atLeast":365,"atMost":359},"Interlineation line 2 to 3","5-9",{"type":96,"l":379,"from":363,"to":369,"h":380,"unit":94,"atLeast":381,"atMost":365},"Interlineation line 3 to 4","2-5","2",{"_":383,"notBefore":384,"notAfter":385,"evidence":386},"Potentially lines 1-2 (Hellenistic) predate lines 3-4 (late Hellenistic or Roman) by a century or two.",-200,200,"lettering",[388,389],{"_":105,"type":106,"ref":107,"region":108},{"_":110,"type":111,"ref":112,"region":108},[391],[115,116],[393,394],37.2966681,13.5882617,{"_":120,"role":121,"ref":122},{"_":397,"type":125},"C311",{"_":127,"mainLang":128,"languages":399},[127],"492710",{"n":132,"url":402,"height":134,"width":135,"desc":136,"surfaceType":137},"ISic001082_tiled.tif",[404,407,410,413,415,417,418],{"atLeast":405,"atMost":406},6,15,{"atLeast":408,"atMost":409},9,16,{"atLeast":411,"atMost":412},5,8,{"atLeast":405,"atMost":414},14,{"atLeast":408,"atMost":416},12,{"atLeast":411,"atMost":408},{"atLeast":419,"atMost":411},2,[421,140,422,146],"Kaibel, 1890, IG","Bulletin épigraphique, 1888-",[424,151,425,157],"Q2SBPG9F","77P5MNIR",[427,428,429,185,341,165,166,167,168,169,167,170,171,128],"isic001082","i.sicily inscription 001082",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" 