ted\" data-text=\"Θευδώρου\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Θευδώρου\">\u003Cspan data-text=\"Θευδώρου\" data-n=\"15\" data-lemma=\"\">Θευδώρου\u003C/span>\u003C/span>\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἑρμᾶι\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἑρμᾶι\">\u003Cspan data-text=\"Ἑρμᾶι\" data-n=\"20\" data-lemma=\"\">Ἑρμᾶι\u003C/span>\u003C/span>\u003C/span> #triple-colon \u003Cspan data-text=\"ἀνέθηκε\" data-n=\"30\" data-lemma=\"\">ἀνέθηκε\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":353,"ptr":354,"ref":355,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"32-33 no.3 pl.4",{"target":189},{"_":191,"target":191},{"file":357,"uri":357,"title":358,"status":359,"editions":360,"editionAuthor":27,"type":374,"objectType":375,"material":379,"condition":44,"layoutDesc":381,"handNote":385,"date":417,"places":422,"geo":425,"country":122,"provenance":119,"provenanceGeo":427,"region":132,"settlement":124,"repository":430,"idno":431,"textLang":433,"tmNumber":362,"facsimile":435,"letterHeights":437,"publications":454,"zotero":457,"keywords":460,"html":464,"bibl":465,"bulletinDateSort":192,"citedRangeSort":466,"languageSort":141,"materialSort":178,"typeSort":207},"ISic001082","I.Sicily inscription 001082",{"_":12},[361,363,365,366,368,370,372],{"_":362,"type":16},"492710",{"_":364,"type":19},"136140",{"type":21},{"_":367,"type":23},"70900050",{"_":369,"type":23},"39102239",{"_":371,"type":26},"140564",{"_":373,"type":26},"331328",{"_":207,"ana":208,"ref":209},{"_":376,"ana":377,"ref":378},"altar","#object.altar","http://www.eagle-network.eu/voc/objtyp/lod/29.html",{"_":178,"ana":38,"type":39,"subtype":380,"resp":42,"ref":43},[41],{"layout":382},{"p":383,"rs":384,"damage":44},"Four lines of Greek letters, all crudely incised in the epigraphic field on the front face.",{"_":48,"ana":49,"ref":50},{"lettering":386,"dimensions":387},"The first two lines are deeply incised, the second two very lightly incised. Alpha has straight bar, with an apex; epsilon has equal length horizontals; mu in line 3 has extended apices, in anticipation of the cursive form; omicron is circular in lines 1 and 3, angular (made up of straight lines) in lines 3 and 4; sigma is and open four bar sigma in lines 1-2, a quadrate lunate sigma in lines 3-4; phi has a small elongated eye; omega is open in lines 1-2, lunate in line 4. It is therefore likely that lines 1-2 were incised by a different hand from lines 3-4.",[388,392,396,402,407,410,413],{"type":105,"l":106,"from":107,"to":107,"h":389,"unit":108,"atLeast":390,"atMost":391},"6-15","6","15",{"type":105,"l":307,"from":112,"to":112,"h":393,"unit":108,"atLeast":394,"atMost":395},"9-16","9","16",{"type":105,"l":397,"from":398,"to":398,"h":399,"unit":108,"atLeast":400,"atMost":401},"Line 3","line3","5-8","5","8",{"type":105,"l":403,"from":404,"to":404,"h":405,"unit":108,"atLeast":390,"atMost":406},"Line 4","line4","6-14","14",{"type":110,"l":111,"from":107,"to":112,"h":408,"unit":108,"atLeast":394,"atMost":409},"9-12","12",{"type":110,"l":411,"from":112,"to":398,"h":412,"unit":108,"atLeast":400,"atMost":394},"Interlineation line 2 to 3","5-9",{"type":110,"l":414,"from":398,"to":404,"h":415,"unit":108,"atLeast":416,"atMost":400},"Interlineation line 3 to 4","2-5","2",{"_":418,"notBefore":419,"notAfter":420,"evidence":421},"Potentially lines 1-2 (Hellenistic) predate lines 3-4 (late Hellenistic or Roman) by a century or two.",-200,200,"lettering",[423,424],{"_":119,"type":120,"ref":121,"region":122},{"_":124,"type":125,"ref":126,"region":122},[426],[129,130],[428,429],37.2966681,13.5882617,{"_":134,"role":135,"ref":136},{"_":432,"type":139},"C311",{"_":141,"mainLang":142,"languages":434},[141],{"n":145,"url":436,"height":147,"width":148,"desc":149,"sur