persname\" data-name-type=\"attested\" data-text=\"Θευδώρου\">\u003Cspan data-type=\"name\" data-name-type=\"patronym\" data-text=\"Θευδώρου\">\u003Cspan data-text=\"Θευδώρου\" data-n=\"15\" data-lemma=\"\">Θευδώρου\u003C/span>\u003C/span>\u003C/span>\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Ἑρμᾶι\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ἑρμᾶι\">\u003Cspan data-text=\"Ἑρμᾶι\" data-n=\"20\" data-lemma=\"\">Ἑρμᾶι\u003C/span>\u003C/span>\u003C/span> #triple-colon \u003Cspan data-text=\"ἀνέθηκε\" data-n=\"30\" data-lemma=\"\">ἀνέθηκε\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">\u003C/p>",{"author":3,"date":4,"citedRange":353,"ptr":354,"ref":355,"inscriptionDate":4,"title":2,"citation":5,"uri":6,"year":4},"32-33 no.3 pl.4",{"target":189},{"_":191,"target":191},{"file":357,"uri":357,"title":358,"status":359,"editions":360,"editionAuthor":27,"type":374,"objectType":375,"material":379,"condition":44,"layoutDesc":383,"handNote":387,"date":419,"places":424,"geo":427,"country":122,"provenance":119,"provenanceGeo":429,"region":132,"settlement":124,"repository":432,"idno":433,"textLang":435,"tmNumber":362,"facsimile":437,"letterHeights":439,"publications":456,"zotero":459,"keywords":462,"html":466,"bibl":467,"bulletinDateSort":192,"citedRangeSort":468,"languageSort":141,"materialSort":178,"typeSort":207},"ISic001082","I.Sicily inscription 001082",{"_":12},[361,363,365,366,368,370,372],{"_":362,"type":16},"492710",{"_":364,"type":19},"136140",{"type":21},{"_":367,"type":23},"70900050",{"_":369,"type":23},"39102239",{"_":371,"type":26},"140564",{"_":373,"type":26},"331328",{"_":207,"ana":208,"ref":209},{"_":376,"ana":377,"ref":378},"altar","#object.altar","http://www.eagle-network.eu/voc/objtyp/lod/29.html",{"_":178,"ana":380,"type":381,"subtype":382,"resp":42,"ref":43},"#material.inorganic.stone.sedimentary_rock.limestone.calcarenite.whitish","stone.limestone.non-polishable.whitish",[41],{"layout":384},{"p":385,"rs":386,"damage":44},"Four lines of Greek letters, all crudely incised in the epigraphic field on the front face.",{"_":48,"ana":49,"ref":50},{"lettering":388,"dimensions":389},"The first two lines are deeply incised, the second two very lightly incised. Alpha has straight bar, with an apex; epsilon has equal length horizontals; mu in line 3 has extended apices, in anticipation of the cursive form; omicron is circular in lines 1 and 3, angular (made up of straight lines) in lines 3 and 4; sigma is and open four bar sigma in lines 1-2, a quadrate lunate sigma in lines 3-4; phi has a small elongated eye; omega is open in lines 1-2, lunate in line 4. It is therefore likely that lines 1-2 were incised by a different hand from lines 3-4.",[390,394,398,404,409,412,415],{"type":105,"l":106,"from":107,"to":107,"h":391,"unit":108,"atLeast":392,"atMost":393},"6-15","6","15",{"type":105,"l":307,"from":112,"to":112,"h":395,"unit":108,"atLeast":396,"atMost":397},"9-16","9","16",{"type":105,"l":399,"from":400,"to":400,"h":401,"unit":108,"atLeast":402,"atMost":403},"Line 3","line3","5-8","5","8",{"type":105,"l":405,"from":406,"to":406,"h":407,"unit":108,"atLeast":392,"atMost":408},"Line 4","line4","6-14","14",{"type":110,"l":111,"from":107,"to":112,"h":410,"unit":108,"atLeast":396,"atMost":411},"9-12","12",{"type":110,"l":413,"from":112,"to":400,"h":414,"unit":108,"atLeast":402,"atMost":396},"Interlineation line 2 to 3","5-9",{"type":110,"l":416,"from":400,"to":406,"h":417,"unit":108,"atLeast":418,"atMost":402},"Interlineation line 3 to 4","2-5","2",{"_":420,"notBefore":421,"notAfter":422,"evidence":423},"Potentially lines 1-2 (Hellenistic) predate lines 3-4 (late Hellenistic or Roman) by a century or two.",-200,200,"lettering",[425,426],{"_":119,"type":120,"ref":121,"region":122},{"_":124,"type":125,"ref":126,"region":122},[428],[129,130],[430,431],37.2966681,13.5882617,{"_":134,"role":135,"ref":136},{"_":434,"type":139},"C311",{"_":141,"mainLang":142,"languages":436},[141],{"n":145,"url":438,"height":147,"width":148,"desc":149,"surfaceType":150},"ISic001082_tiled.tif",[440,443,446,449,451,453,454],{"atLeast":441,"atMost":442},6,15,{"atLeast":444,"atMost":445},9,16,{"atLeast":447,"atMost":448},5,8,{"atLeast":441,"atMost":450},14,{"atLeast":444,"atMost":452},12,{"atLeast":447,"atMost":444},{"atLeast":455,"atMost":447},2,[457,153,458,159],"Kaibel, 1890, IG","Bulletin épigraphique, 1888-",[460,164,461,170],"Q2SBPG9F","77P5MNIR",[463,464,465,207,376,178,179,180,181,182,180,183,184,142],"isic001082","i.sicily inscription 001082",{"_":12},"\u003Cdiv class=\"textpart\" lang=\"grc\">\u003Cspan class=\"ab\" id=\"div-interpretive\">  \u003Ca id=\"al1-interpretive\">\u003C!--0-->\u003C/a>\u003Cspan class=\"linenumber\">1\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"Πολυστεφάνῳ\n                    Σωτείρᾳ\">\u003Cspan data-type=\"name\" data-name-type=\"epithet\" data-text=\"Πολυστεφάνῳ\">Πολυστεφάνῳ\u003C/span>  \u003Cbr id=\"al2-interpretive\">\u003Cspan class=\"linenumber\">2\u003C/span>\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Σωτείρᾳ\">Σωτείρᾳ\u003C/span>\u003C/span>  \u003Cbr id=\"al3-interpretive\">\u003Cspan class=\"linenumber\">3\u003C/span>\u003Cspan data-type=\"persname\" data-name-type=\"attested\" data-text=\"Νικομήδης ὁ καὶ\n                    Ὄνυς\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Νικομήδης\">Νικομήδης\u003C/span> ὁ καὶ \u003Cbr id=\"al4-interpretive\">\u003Cspan class=\"linenumber\">4\u003C/span>\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"Ὄνυς\">Ὄνυς\u003C/span>\u003C/span>  \u003Cspan data-type=\"persname\" data-name-type=\"divine\" data-text=\"ΣωτίρᾳΣωτείρᾳ\">\u003Cspan data-type=\"name\" data-name-type=\"\" data-text=\"ΣωτίρᾳΣωτείρᾳ\">Σωτίρᾳ\u003C/span>\u003C/span>  \u003C/span>\u003C/div>  \u003Cp class=\"miniapp\">l.4 reg., orig. 