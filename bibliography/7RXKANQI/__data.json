led","http://www.eagle-network.eu/voc/writing/lod/1",{"lettering":51,"dimensions":52},"The letters are well cut in a relatively refined v-cut, with modest serifs. The letters are tend towards the tall and narrow and are very regular and evenly spaced.  P and R are open, O is somewhat ovoid, E has bars of equal length, D is quite full, the diagonal of the N does not always start from the top of the first hasta. Interpuncts are not consistently used, with one elegant example in line 2",[53,60],{"type":54,"l":55,"from":56,"to":57,"h":58,"unit":59,"atLeast":58,"atMost":58},"letterHeight","Lines 1-6","line1","line6","72","mm",{"type":61,"l":62,"from":56,"to":63,"h":64,"unit":59},"interlinear","Line 1-2","line2","not measured",{"_":66,"notBefore":67,"notAfter":68,"evidence":69},"later 2nd or 3rd century CE (Vallarino on palaeographic grounds)",151,300,"lettering",[71,76],{"_":72,"type":73,"ref":74,"region":75},"Agrigentum","ancient","http://pleiades.stoa.org/places/462086","Sicilia",{"_":77,"type":78,"ref":79,"region":75},"Agrigento","modern","http://sws.geonames.org/6541860",[81],[82,83],37.32084,13.58876,[85,86],37.298238,13.589125,"Sicily",{"_":89,"role":90,"ref":91},"Museo Regionale Archeologico Pietro Griffo","museum","http://sicily.classics.ox.ac.uk/museum/130",{"type":93},"inventory",{"_":95,"mainLang":96,"languages":97},"Latin","la",[95],{"n":99,"url":100,"height":101,"width":102,"desc":103,"surfaceType":104},"screen","ISic004373_tiled.tif","2767px","2562px","Image courtesy of Giulio Vallarino","front",[106],{"atLeast":107,"atMost":107},72,[109,110,111,112],"L'année épigraphique: revue des publications épigraphiques relatives a l'antiquité romaine., 1888-","Vallarino, 2017, L'epigrafe dall'area del Tempio ellenistico-romano","Vallarino, 2018, Un nuovo \"curator rei publicae\" Liparese da Agrigento","Vallarino, 2022, L'epigrafe del curator rei publicae Liparitanorum",[114,115,116,117],"R46KDTZX","7RXKANQI","C395ZWLV","9SN32HDD",[119,120,121,122,31,35,123,124,125,12