      "html": "<div class=\"textpart\" lang=\"grc\"><span class=\"ab\" id=\"div-diplomatic\"><a id=\"al1-diplomatic\"><!--0--></a><span class=\"linenumber\">1</span><span data-text=\"οἴκος\">ΟΙΚΟΣ</span><span data-text=\"αἰώνος\">ΑΙΩΝΟΣ</span><span data-text=\"ἐν\">ΕΝ</span>☧Ω<br id=\"al2-diplomatic\"><span class=\"linenumber\">2</span><span data-type=\"persname\" data-name-type=\"attested\" data-text=\"Μακαρία Εὐανγέλις\"><span data-type=\"name\" data-name-type=\"\" data-text=\"Μακαρία\">ΜΑΚΑΡΙΑ</span><span data-type=\"name\" data-name-type=\"\" data-text=\"Εὐανγέλις\">ΕΥΑΝΓΕΛΙΣ</span></span><br id=\"al3-diplomatic\"><span class=\"linenumber\">3</span><span data-text=\"πιστὴ\">ΠΙΣΤΗ</span><span data-text=\"ἐν\">ΕΝ</span>☧Ω<span data-text=\"ἔζησεν\">ΕΖΗΣΕΝ</span><span data-text=\"ἄ\n                    μεμπτος\">Α<br id=\"al4-diplomatic\"><span class=\"linenumber\">4</span>ΜΕΜΠΤΟΣ</span><span data-text=\"ἔτη\">ΕΤΗ</span><span class=\"supraline\" title=\"line above\">Κ</span><span data-text=\"μῆ\n                    νας \">ΜΗ<br id=\"al5-diplomatic\"><span class=\"linenumber\">5</span>ΝΑΣ</span>Θ<span data-text=\"ἡμέρας\">ΗΜΕΡΑΣ</span><span class=\"supraline\" title=\"line above\">ΙΖ</span><span data-text=\"παρ\n                    θένος\">ΠΑΡ<br id=\"al6-diplomatic\"><span class=\"linenumber\">6</span>ΘΕΝΟΣ</span><span data-text=\"ἁγνοτάτη\">ΑΓΝΟΤΑΤΗ</span><span data-text=\"νυνφευ\n                    θεῖσα\">ΝΥΝΦΕΥ<br id=\"al7-diplomatic\"><span class=\"linenumber\">7</span>[.....</span><span data-text=\"ἐν\">..</span><span data-text=\"γαμῷ\">..]ΜΩ</span><span data-text=\"νομίμῳ\">ΝΟΜΙΜΩ</span><br id=\"al8-diplomatic\"><span class=\"linenumber\">8</span><span data-text=\"ἐτελεύτησεν\">[........]ΣΕΝ</span><span data-text=\"πρὸ\"><span class=\"petraeligature\" title=\"Ligature: these characters are joined\">Π͡Ρ</span>Ο</span>Α<span data-text=\"καλανδῶν\">ΚΑΛΑΝΔΩΝ</span><br id=\"al9-diplomatic\"><span class=\"linenumber\">9</span>[<span dir=\"ltr\" class=\"g