span>ΤΑΤΗ</span><span data-text=\"χαῖρε\">ΧΑΙΡ[.</span><span data-text=\"ἔζη\n                    σας\">...]<br id=\"al4-diplomatic\"><span class=\"linenumber\">4</span>ΣΑΣ</span><span data-text=\"ἔτη\">ΕΤΗ</span>[<span dir=\"ltr\" class=\"gap\">---</span>]<br id=\"al5-diplomatic\"><span class=\"linenumber\">5</span><span data-text=\"τύχης\">ΤΥΧΗΣ</span>Ν[<span dir=\"ltr\" class=\"gap\">---</span>]<br id=\"al6-diplomatic\"><span class=\"linenumber\">6</span>Ο.<span data-text=\"πεπ\">ΠΕΠ[<span dir=\"ltr\" class=\"gap\">---</span>]</span></span></div><p class=\"miniapp\"></p></div>"
    },
