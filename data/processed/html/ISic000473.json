gentinus\"><span class=\"apex\" title=\"apex over: A\">A</span>GRIGENTI<br id=\"al2-diplomatic\"><span class=\"linenumber\">2</span> &nbsp;&nbsp;&nbsp;&nbsp;NORUM</span></span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <span data-text=\"sacrum\" data-n=\"30\" data-lemma=\"sacer\">SACRUM</span> &nbsp;&nbsp;&nbsp;&nbsp; <br id=\"al3-diplomatic\"><span class=\"linenumber\">3</span><span data-text=\"res\" data-n=\"40\" data-lemma=\"res\">RES</span><span data-text=\"publica\" data-n=\"45\" data-lemma=\"publicus\">PUBLICA</span><span data-type=\"name\" data-name-type=\"\" data-text=\"Lilybitano\n                    rum\"><span data-text=\"Lilybitano\n                    rum\" data-n=\"50\" data-lemma=\"Lilybitanus\"><span class=\"apex\" title=\"apex over: L\">L</span>ILYBITANO<br id=\"al4-diplomatic\"><span class=\"linenumber\">4</span>RUM</span></span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <span data-text=\"dedicantibus\" data-n=\"60\" data-lemma=\"dedico\">DEDICANTIBUS</span><br id=\"al5-diplomatic\"><span class=\"linenumber\">5</span><span data-type=\"name\" data-name-type=\"\" data-text=\"Marco\"><span data-text=\"Marco\" data-n=\"65\" data-lemma=\"Marcus\">M</span></span>·<span data-type=\"name\" data-name-type=\"\" data-text=\"Haterio\"><span data-text=\"Haterio\" data-n=\"75\" data-lemma=\"Haterius\">HATERIO</span></span><span data-type=\"name\" data-name-type=\"\" data-text=\"Candido\"><span data-text=\"Candido\" data-n=\"80\" data-lemma=\"Candidus\">CANDIDO</span></span><span data-text=\"proconsule\" data-n=\"85\" data-lemma=\"proconsul\">PR<span class=\"petraeligature\" title=\"Ligature: these characters are joined\">O͡C</span><span class=\"small\" title=\"small character: o\">O</span>S</span><br id=\"al6-diplomatic\"><span class=\"linenumber\">6</span><span data-text=\"et\" data-n=\"90\" data-lemma=\"et\">ET</span><span data-type=\"name\" data-name-type=\"\" data-text=\"Lucio\"><span data-text=\"Lucio\" data-n=\"95\" data-lemma=\"Lucius\">L</span></span>·<span data-t