rpretive-simple-lemmatized\">  <div class=\"textpart\"><span class=\"ab\" id=\"div-interpretive\">  <span data-text=\"Θεοῖς\" data-n=\"5\" data-lemma=\"θεός\">Θεοῖς</span>  <span data-text=\"καταχθονίοις\" data-n=\"10\" data-lemma=\"καταχθόνιος\">καταχθονίοις</span>  <span data-text=\"Δαίμοσι\" data-n=\"12\" data-lemma=\"δαιμόνιος\">Δαίμοσι</span>  <span data-text=\"Βειψάνιος\" data-n=\"15\" data-lemma=\"Βειψάνιος\">Βειψάνιος</span>  <span data-text=\"Ζώτικος\" data-n=\"20\" data-lemma=\"Ζώτικος\">Ζώτικος</span>  <span data-text=\"ἔζησεν\" data-n=\"25\" data-lemma=\"ζάω\">ἔζησεν</span>  <span data-text=\"ἔτη\" data-n=\"30\" data-lemma=\"ἔτος\">ἔτη</span>  <span data-text=\"λ\" data-n=\"40\" data-lemma=\"λ\">λ</span>  <span data-text=\"Ἡρακλεία\" data-n=\"50\" data-lemma=\"Ἡρακλεία\">Ἡρακλεία</span>  <span data-text=\"ἀνδρὶ\" data-n=\"55\" data-lemma=\"ἀνήρ\">ἀνδρὶ</span>  <span data-text=\"εὐσεβεστάτῳ\" data-n=\"60\" data-lemma=\"εὐσεβής\">εὐσεβεστάτῳ</span>  </span></div>  <p class=\"miniapp\"></p></div><div class=\"attribution\">Text encoding: Jonathan Prag</div><div id=\"edition-diplomatic\" lang=\"grc\"><div class=\"textpart\" lang=\"grc\"><span class=\"ab\" id=\"div-diplomatic\"><a id=\"al1-diplomatic\"><!--0--></a><span class=\"linenumber\">1</span><span data-text=\"Θεοῖς\" data-n=\"5\" data-lemma=\"θεός\">Θ</span><span data-text=\"καταχθονίοις\" data-n=\"10\" data-lemma=\"καταχθόνιος\">Κ.</span><span data-text=\"Δαίμοσι\" data-n=\"12\" data-lemma=\"δαιμόνιος\">Δ</span><br id=\"al2-diplomatic\"><span class=\"linenumber\">2</span><span data-type=\"persname\" data-name-type=\"attested\" data-text=\"Βειψάνιος\n                    Ζώτικος\"><span data-type=\"name\" data-name-type=\"\" data-text=\"Βειψάνιος\"><span data-text=\"Βειψάνιος\" data-n=\"15\" data-lemma=\"Βειψάνιος\">ΒΕΙΨΑΝΙΟ[.]</span></span><br id=\"al3-diplomatic\"><span class=\"linenumber\">3</span><span data-type=\"name\" data-name-type=\"\" data-text=\"Ζώτικος\"><span data-text=\"Ζώτικος\" data-n=\"2