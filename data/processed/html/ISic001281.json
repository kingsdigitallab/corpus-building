g=\"grc\"><span class=\"ab\" id=\"div-diplomatic\"><a id=\"al1-diplomatic\"><!--0--></a><span class=\"linenumber\">1</span><span data-text=\"Θεοις\" data-n=\"5\" data-lemma=\"Θεός\">[..]ΟΙΣ</span><span data-text=\"χθονίοις\" data-n=\"10\" data-lemma=\"χθόνιος\">ΧΘΟ[.....]</span><br id=\"al2-diplomatic\"><span class=\"linenumber\">2</span><span data-type=\"persname\" data-name-type=\"attested\" data-text=\"Ἀγαθη\"><span data-type=\"name\" data-name-type=\"\" data-text=\"Ἀγαθη\"><span data-text=\"Ἀγαθη\" data-n=\"15\" data-lemma=\"Ἀγαθή\">ΑΓΑΘΗ</span></span></span><span data-text=\"χαῖρε\" data-n=\"20\" data-lemma=\"χαίρω\">Χ[....]</span><br id=\"al3-diplomatic\"><span class=\"linenumber\">3</span><span data-text=\"ἔζησεν\" data-n=\"25\" data-lemma=\"ζάω\">[.]ΖΗΣΕΝ</span><span data-text=\"ἔτη\" data-n=\"30\" data-lemma=\"ἔτος\">[...</span><span dir=\"ltr\" class=\"gap\">---</span>]</span></div><p class=\"miniapp\"></p></div><div class=\"attribution\">Text encoding: Victoria Fendel, Robert Crellin</div><div id=\"edition-diplomatic-simple-lemmatized\"><div class=\"textpart\"><span class=\"ab\" id=\"div-diplomatic\"><span data-text=\"Θεοις\" data-n=\"5\" data-lemma=\"Θεός\">ΘΕΟΙΣ</span><span data-text=\"χθονίοις\" data-n=\"10\" data-lemma=\"χθόνιος\">ΧΘΟΝΙΟΙΣ</span><span data-text=\"Ἀγαθη\" data-n=\"15\" data-lemma=\"Ἀγαθή\">ΑΓΑΘΗ</span><span data-text=\"χαῖρε\" data-n=\"20\" data-lemma=\"χαίρω\">ΧΑΙΡΕ</span><span data-text=\"ἔζησεν\" data-n=\"25\" data-lemma=\"ζάω\">ΕΖΗΣΕΝ</span><span data-text=\"ἔτη\" data-n=\"30\" data-lemma=\"ἔτος\">ΕΤΗ</span>[<span dir=\"ltr\" class=\"gap\">---</span>]</span></div><p class=\"miniapp\"></p></div>"
    },
