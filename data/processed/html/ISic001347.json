 data-name-type=\"attested\" data-text=\"Ἀντώνιος\"><span data-type=\"name\" data-name-type=\"\" data-text=\"Ἀντώνιος\">[..]<span data-text=\"τών\">ΤΩΝ</span>[...</span></span><span dir=\"ltr\" class=\"gap\">---</span>]<br id=\"al3-diplomatic\"><span class=\"linenumber\">3</span><span data-text=\"ἔτη\">ΕΤΗ</span>Ο[<span dir=\"ltr\" class=\"gap\">---</span>]<br id=\"al4-diplomatic\"><span class=\"linenumber\">4</span><span data-text=\"ἔζησεν\">ΕΖΗΣΕΝ</span><span data-text=\"ὁ\">Ο</span><span data-type=\"persname\" data-name-type=\"attested\" data-text=\"Σα\n                    τορνῖλος\"><span data-type=\"name\" data-name-type=\"\" data-text=\"Σα\n                    τορνῖλος\">Σ[.]<br id=\"al5-diplomatic\"><span class=\"linenumber\">5</span>ΤΟΡΝΙΛΟΣ</span></span><span data-text=\"ἔτη\">Ε[..</span><span dir=\"ltr\" class=\"gap\">---</span><span data-text=\"τελευτᾷ\">....]</span><br id=\"al6-diplomatic\"><span class=\"linenumber\">6</span><span data-text=\"τῇ\">ΤΗ</span><span data-text=\"πρὸ\">ΠΡ</span>Δ<span data-text=\"καλανδῶν\">ΚΑ[.</span><span dir=\"ltr\" class=\"gap\">---</span>]</span></div><p class=\"miniapp\"></p></div>"
